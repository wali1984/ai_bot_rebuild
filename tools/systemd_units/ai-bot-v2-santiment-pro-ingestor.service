[Unit]
Description=AI Bot V2 Santiment Pro ingestor (SANBASE PRO lagged-window context; 6h cadence; V2 namespace only; paper-shadow)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/wali/Desktop/AI BOT REBUILD
ExecStartPre=/usr/bin/env bash -lc 'exec ./claude_worklog/tools/v2_automation_safety_preflight.sh ai-bot-v2-santiment-pro-ingestor'
ExecStart=/usr/bin/env bash -lc 'mkdir -p claude_worklog/agent_supervisor/logs/control_plane; exec ./.venv/bin/python3 -m v2.backend.app.cli.v2_santiment_pro_ingestor --loop --execution-interval-seconds 21600 >> claude_worklog/agent_supervisor/logs/control_plane/ai-bot-v2-santiment-pro-ingestor.log 2>&1'
Restart=always
RestartSec=60
NoNewPrivileges=true

[Install]
WantedBy=default.target
