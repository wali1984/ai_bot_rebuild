[Unit]
Description=AI Bot V2 Binance aggTrades ingestor loop (public REST read-only; V2 namespace only; paper-shadow)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/wali/Desktop/AI BOT REBUILD
ExecStartPre=/usr/bin/env bash -lc 'exec ./claude_worklog/tools/v2_automation_safety_preflight.sh ai-bot-v2-agg-trades-ingestor-loop'
ExecStart=/usr/bin/env bash -lc 'mkdir -p claude_worklog/agent_supervisor/logs/control_plane; exec ./.venv/bin/python3 -m v2.backend.app.cli.v2_agg_trades_ingestor_loop --loop --interval-seconds 60 --symbols-per-cycle 40 --limit 200 --ttl-seconds 900 >> claude_worklog/agent_supervisor/logs/control_plane/ai-bot-v2-agg-trades-ingestor-loop.log 2>&1'
Restart=always
RestartSec=15
NoNewPrivileges=true

[Install]
WantedBy=default.target
