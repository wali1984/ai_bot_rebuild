[Unit]
Description=AI Bot V2 microstructure runtime supervisor (direct orderbook recorder batches + feed monitor; V2 namespace only; paper-shadow)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/wali/Desktop/AI BOT REBUILD
ExecStartPre=/usr/bin/env bash -lc 'exec ./claude_worklog/tools/v2_automation_safety_preflight.sh ai-bot-v2-microstructure-runtime-supervisor'
ExecStart=/usr/bin/env bash -lc 'mkdir -p claude_worklog/agent_supervisor/logs/control_plane; exec ./.venv/bin/python3 -m v2.backend.app.cli.v2_microstructure_runtime_supervisor --paper-candidates --filter-provider-supported-symbols --run-managed --managed-until-stopped --restart-exited-children --direct-loop-max-runs 0 --direct-interval-seconds 0.5 --direct-max-messages 600 --binance-speed 250ms >> claude_worklog/agent_supervisor/logs/control_plane/ai-bot-v2-microstructure-runtime-supervisor.log 2>&1'
Restart=always
RestartSec=15
NoNewPrivileges=true

[Install]
WantedBy=default.target
