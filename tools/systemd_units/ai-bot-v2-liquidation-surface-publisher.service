[Unit]
Description=AI BOT V2 prospective liquidation-surface publisher (observation only)
After=network-online.target ai-bot-v2-binance-usdm-leverage-bracket-evidence.service ai-bot-v2-binance-mark-price-wss-seeder.service
Wants=network-online.target ai-bot-v2-binance-usdm-leverage-bracket-evidence.service ai-bot-v2-binance-mark-price-wss-seeder.service
ConditionFileIsExecutable=/home/wali/Desktop/AI BOT REBUILD/.venv/bin/python3
ConditionPathExists=%h/.config/ai-bot-v2/credentials/binance-bracket-evidence/evidence-hmac.cred
ConditionPathExists=%h/.config/ai-bot-v2/credentials/binance-bracket-evidence/surface-publication-hmac.cred
ConditionPathExists=%h/.local/share/ai-bot-v2/worktrees/liquidation-publisher/v2/backend/app/cli/v2_liquidation_surface_publisher.py
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/.local/share/ai-bot-v2/worktrees/liquidation-publisher
Environment="PYTHONPATH=%h/.local/share/ai-bot-v2/worktrees/liquidation-publisher/v2/backend:%h/.local/share/ai-bot-v2/worktrees/liquidation-publisher"
Environment="PYTHONDONTWRITEBYTECODE=1"
Environment="LIVE_GATE=blocked_human_only"
Environment="ALPHAFORGE_INITIAL_TRADER_ID=trader-wajidali1984"
Environment="ALPHAFORGE_INITIAL_TRADER_BINANCE_CREDENTIAL_REF=ALPHAFORGE_BINANCE_WAJIDALI1984_READONLY"
Environment="BINANCE_USDM_REST_BASE_URL=https://fapi.binance.com"
Environment="BINANCE_BRACKET_EVIDENCE_HMAC_KEY_ID=binance-bracket-evidence-v1"
Environment="LIQUIDATION_SURFACE_PUBLICATION_HMAC_KEY_ID=liquidation-surface-publication-v1"
Environment="REDIS_URL=redis://127.0.0.1:6379/0"
LoadCredential=binance_bracket_evidence_hmac_key:%h/.config/ai-bot-v2/credentials/binance-bracket-evidence/evidence-hmac.cred
LoadCredential=liquidation_surface_publication_hmac_key:%h/.config/ai-bot-v2/credentials/binance-bracket-evidence/surface-publication-hmac.cred
ExecStart="/home/wali/Desktop/AI BOT REBUILD/.venv/bin/python3" -B -m v2.backend.app.cli.v2_liquidation_surface_publisher --loop
Restart=always
RestartSec=15
TimeoutStartSec=90
TimeoutStopSec=30
UMask=0077
CPUQuota=150%
MemoryHigh=768M
MemoryMax=1536M
TasksMax=64
LimitNOFILE=4096
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ai-bot-v2-liquidation-surface-publisher
LogRateLimitIntervalSec=60
LogRateLimitBurst=30

[Install]
WantedBy=default.target
