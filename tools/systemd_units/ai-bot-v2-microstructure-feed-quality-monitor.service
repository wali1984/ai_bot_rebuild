[Unit]
Description=AI Bot V2 microstructure feed quality + trust score monitor (V2 namespace only; paper-shadow)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/wali/Desktop/AI BOT REBUILD
ExecStartPre=/usr/bin/env bash -lc 'exec ./claude_worklog/tools/v2_automation_safety_preflight.sh ai-bot-v2-microstructure-feed-quality-monitor'
ExecStart=/usr/bin/env bash -lc 'mkdir -p claude_worklog/agent_supervisor/logs/control_plane; exec ./.venv/bin/python3 -m v2.backend.app.cli.v2_microstructure_feed_quality_monitor --loop --loop-log-mode compact --interval-seconds 2 --write-redis --write-status --ttl-seconds 180 >> claude_worklog/agent_supervisor/logs/control_plane/ai-bot-v2-microstructure-feed-quality-monitor.log 2>&1'
Restart=always
RestartSec=15
NoNewPrivileges=true

[Install]
WantedBy=default.target
