{
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/node_modules/**": true,
    "**/legacy_reference/**": true,
    "**/legacy_trainer_design_requirements_from_docs.json": true,
    "**/legacy_hybrid_trainer_behavior_parity_matrix.json": true,
    "**/legacy_hybrid_trainer_line_inventory.json": true,
    "**/legacy_hybrid_trainer_import_call_graph.json": true,
    "**/trainer_related_markdown_inventory.json": true,
    "**/__pycache__/**": true,
    "**/*.pyc": true,
    "**/logs/**": true,
    "**/screenshots/**": true,
    "**/test-results/**": true,
    "**/claude_worklog/**": true,
    "**/v2/runtime/**": true,
    "**/v2/frontend/dist/**": true,
    "**/v2/frontend/node_modules/**": true,
    "**/v2/frontend/public/**": true,
    "**/v2/screenshots/**": true,
    "**/v2/v2/**": true,
    "**/v2/backend/claude_worklog/**": true,
    "**/v2/backend/v2/**": true,
    "**/v2/claude_worklog/**": true,
    "**/audits/**": true,
    "**/raw_evidence/**": true,
    "**/replay_data/**": true,
    "**/ollama/outputs/**": true,
    "**/goal_state/**": true,
    "**/recorded_state_verification_pass*/**": true,
    "**/pipeline_trust_quarantine/**": true
  },
  "files.exclude": {
    "**/.venv": true,
    "**/node_modules": true,
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/legacy_reference": true,
    "**/v2/frontend/dist": true,
    "**/v2/frontend/public/operator_runtime": true,
    "**/goal_state": true,
    "**/recorded_state_verification_pass2a": true,
    "**/recorded_state_verification_pass4a": true,
    "**/pipeline_trust_quarantine": true
  },
  "search.exclude": {
    "**/.venv/**": true,
    "**/node_modules/**": true,
    "**/legacy_reference/**": true,
    "**/__pycache__/**": true,
    "**/logs/**": true,
    "**/screenshots/**": true,
    "**/test-results/**": true,
    "**/claude_worklog/**": true,
    "**/v2/runtime/**": true,
    "**/v2/frontend/dist/**": true,
    "**/v2/frontend/public/**": true,
    "**/audits/**": true,
    "**/raw_evidence/**": true,
    "**/replay_data/**": true,
    "**/ollama/outputs/**": true,
    "**/goal_state/**": true,
    "**/recorded_state_verification_pass*/**": true,
    "**/pipeline_trust_quarantine/**": true,
    "**/*.json": false
  },
  "python.analysis.exclude": [
    ".venv/**",
    "node_modules/**",
    "legacy_reference/**",
    "__pycache__/**",
    "claude_worklog/**",
    "v2/frontend/public/**",
    "goal_state/**",
    "audits/**",
    "raw_evidence/**",
    "replay_data/**",
    "recorded_state_verification_pass2a/**",
    "recorded_state_verification_pass4a/**",
    "pipeline_trust_quarantine/**"
  ],
  "python.analysis.indexing": true,
  "python.analysis.packageIndexDepths": [
    {
      "name": "",
      "depth": 2,
      "includeAllSymbols": false
    }
  ],
  "editor.largeFileOptimizations": true,
  "files.maxMemoryForLargeFilesMB": 128,
  "git.ignoreLimitWarning": true,
  "git.autoRepositoryDetection": false,
  "git.decorations.enabled": false,
  "git.autoFetch": false,
  "git.statusDecorationColors": false,
  "git.untrackedChanges": "hidden",
  "scm.statusLimit": 500
}
