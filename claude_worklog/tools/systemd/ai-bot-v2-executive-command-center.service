[Unit]
Description=AI BOT V2 Executive Recovery and Production-Readiness Command Center (one-shot)
Documentation=file:%h/Desktop/AI%%20BOT%%20REBUILD/claude_worklog/final_readiness/v2_executive_command_center/latest/GO_NO_GO.md
ConditionPathExists=%h/Desktop/AI BOT REBUILD/claude_worklog/tools/v2_executive_command_center.py
After=network.target

[Service]
Type=oneshot
WorkingDirectory=%h/Desktop/AI BOT REBUILD
Environment=PYTHONUNBUFFERED=1
Environment="PYTHONPATH=%h/Desktop/AI BOT REBUILD"
# Paths must be quoted because "AI BOT REBUILD" contains spaces.
ExecStart="%h/Desktop/AI BOT REBUILD/.venv/bin/python3" "%h/Desktop/AI BOT REBUILD/claude_worklog/tools/v2_executive_command_center.py"
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false

[Install]
WantedBy=default.target
