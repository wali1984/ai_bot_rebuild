@@ -0,0 +1,284 @@
+"""Change 1 fixtures: bounded information-gain exploration eligibility at the
+preemptive edge-control layer.
+
+These prove that the new ``paper_risk_controller_information_gain_exploration``
+sibling eligibility relaxes ONLY the exploitation ``expected_edge > 0`` sign and
+keeps every protected rail enforced.
+
+Because the preemptive loss model forces ``pre_trade_loss_probability >= 0.90``
+for ``expected_edge <= 0`` (candidate_loss_risk.py) and the exit-feasibility
+model caps the score at ``<= 0.4`` for ``expected_edge <= 0``
+(exit_feasibility.py), the info-gain tier is UNREACHABLE at this layer for a
+genuinely non-positive-edge candidate WITHOUT lowering those two protected rails.
+The rail-isolation tests therefore hold the loss-probability and exit-feasibility
+inputs at passing values (via test doubles) so that each remaining protected
+conjunct can be exercised independently; a separate test proves the loss and
+exit rails still block a real non-positive-edge candidate when NOT doubled.
+"""
+
+from __future__ import annotations
+
+import copy
+
+import pytest
+
+import v2.backend.app.services.preemptive_edge_control.decision as decision_module
+from v2.backend.app.services.preemptive_edge_control.decision import (
+    evaluate_candidate,
+    replay_preemptive_decision,
+)
+from v2.backend.tests.unit.services.preemptive_edge_control.test_decision_snapshot_contract import (  # noqa: E501
+    ALTDATA,
+    DECISION_TIME,
+    GUARDIAN,
+    TUNING_STATE,
+    _candidate,
+    _healthy_bucket_health,
+)
+
+INFO_GAIN_DECISION = "PAPER_RISK_CONTROLLER_INFORMATION_GAIN_EXPLORATION"
+HALTED_GUARDIAN = {
+    "status": "HALTED",
+    "new_entries_allowed": False,
+    "a_grade_new_entries_allowed": False,
+}
+
+
+def _scoped_negative_edge_candidate(**overrides: object) -> dict[str, object]:
+    candidate = _candidate(
+        expected_move_bps=3.0,
+        expected_move_after_cost_bps=-1.0,  # expected edge <= 0 but estimable
+        paper_only=True,
+        routes_to_live=False,
+        places_real_order=False,
+        paper_cohort_preemptive_controls_scoped=True,
+        paper_cohort_breaker_new_entries_allowed=True,
+    )
+    candidate.update(overrides)
+    return candidate
+
+
+def _evaluate(
+    candidate: dict[str, object],
+    *,
+    monkeypatch: pytest.MonkeyPatch | None = None,
+    guardian: dict[str, object] = HALTED_GUARDIAN,
+    bucket_health: dict[str, dict[str, object]] | None = None,
+    bucket_quarantine_status: dict[str, object] | None = None,
+    altdata: dict[str, object] | None = None,
+    exit_score: float | None = 0.60,
+    loss: float | None = 0.40,
+    allow_information_gain: bool = True,
+) -> dict[str, object]:
+    if monkeypatch is not None and loss is not None:
+        monkeypatch.setattr(
+            decision_module,
+            "assess_candidate_loss_risk",
+            lambda **_: {
+                "pre_trade_loss_probability": loss,
+                "pre_trade_loss_risk_reasons": [],
+                "adaptive_microstructure_trust_threshold_used": 0.41,
+            },
+        )
+    if monkeypatch is not None and exit_score is not None:
+        original_exit = decision_module.assess_exit_feasibility
+
+        def _fake_exit(candidate: dict, cost_edge: dict) -> dict:
+            result = original_exit(candidate, cost_edge)
+            result["exit_feasibility_score"] = exit_score
+            return result
+
+        monkeypatch.setattr(decision_module, "assess_exit_feasibility", _fake_exit)
+    return evaluate_candidate(
+        candidate,
+        closed_rows=[],
+        bucket_health=(
+            bucket_health if bucket_health is not None else _healthy_bucket_health()
+        ),
+        continuous_edge_guardian_gate=guardian,
+        bucket_quarantine_status=bucket_quarantine_status,
+        adaptive_tuning_state=TUNING_STATE,
+        altdata_confluence=(altdata if altdata is not None else copy.deepcopy(ALTDATA)),
+        allow_paper_risk_controller_information_gain_exploration=allow_information_gain,
+        decision_time=DECISION_TIME,
+    )
+
+
+def test_information_gain_exploration_fires_when_rails_clean(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """Fixture 1 (decision layer): rail-clean, edge<=0 candidate is admitted as
+    a paper-only information-gain exploration decision."""
+
+    result = _evaluate(_scoped_negative_edge_candidate(), monkeypatch=monkeypatch)
+
+    assert result["preemptive_decision"] == INFO_GAIN_DECISION
+    assert result["preemptive_action"] == "ALLOW_PAPER_INFORMATION_GAIN_EXPLORATION"
+    assert result["allow_paper_fill"] is True
+    assert result["paper_risk_controller_information_gain_exploration_eligible"] is True
+    assert result["allow_paper_risk_controller_information_gain_exploration"] is True
+    # Live authority stays blocked: paper-only, no live dry-run.
+    assert result["paper_only"] is True
+    assert result["routes_to_live"] is False
+    assert result["places_real_order"] is False
+    assert result["allow_live_dry_run"] is False
+    # Edge is genuinely non-positive; only the edge-sign requirement was relaxed.
+    assert float(result["expected_edge_after_cost_bps"]) <= 0.0
+    # Folding into the scoped lane suppresses the adaptive-loss threshold gate.
+    assert result["adaptive_loss_probability_threshold_applied"] is False
+
+
+@pytest.mark.parametrize(
+    "rail",
+    [
+        "bucket_negative",
+        "atr_stop_cluster",
+        "matched_quarantine",
+        "advanced_block",
+        "altdata_high_risk_conflict",
+        "exit_score_below_min",
+        "guardian_not_halted",
+        "scoped_lane_not_authorized",
+    ],
+)
+def test_information_gain_exploration_blocked_per_rail(
+    monkeypatch: pytest.MonkeyPatch, rail: str
+) -> None:
+    """Fixture 2 (decision layer): with loss/exit held at passing values, each
+    protected rail independently prevents the info-gain tier from firing."""
+
+    kwargs: dict[str, object] = {"monkeypatch": monkeypatch}
+    candidate = _scoped_negative_edge_candidate()
+
+    if rail == "bucket_negative":
+        bucket = _healthy_bucket_health()
+        bucket["symbol:BTCUSDT"].update(
+            {
