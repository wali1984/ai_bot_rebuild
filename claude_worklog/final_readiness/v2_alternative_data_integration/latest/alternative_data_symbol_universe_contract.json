{
  "schema_version": "v2_alternative_data_symbol_universe_contract_v2",
  "purpose": "Contract for how V2 symbol-universe automation consumes alternative-data signals. PLAN ONLY; symbol_universe automation is NOT modified in this packet.",
  "v2_redis_namespace": "v2:symbol_universe:altdata_candidates",
  "input_signals_required": [
    "smart_money_score",
    "social_momentum_score",
    "social_volume_velocity",
    "entity_flow_score",
    "altdata_freshness_score",
    "provider_availability_score",
    "altdata_symbol_rank"
  ],
  "output_fields_in_payload": [
    "schema_version",
    "generated_utc",
    "candidate_symbol_list",
    "candidate_count",
    "rank_per_candidate",
    "altdata_symbol_score_per_candidate",
    "altdata_symbol_rank_per_candidate",
    "providers_consulted_per_candidate",
    "missing_signal_per_candidate",
    "stale_signal_per_candidate",
    "dynamic_discovered_symbols_continued",
    "training_symbols_continued",
    "paper_symbols_continued",
    "live_symbols_continued"
  ],
  "ranking_strategy": {
    "default": "weighted_average_of_smart_money_score_and_social_momentum_score_and_entity_flow_score",
    "weights_default_free_tier": {
      "smart_money_score": 0.5,
      "social_momentum_score": 0.3,
      "social_volume_velocity": 0.1,
      "entity_flow_score": 0.0,
      "freshness_penalty_weight": 0.1
    },
    "weights_paid_tier": {
      "smart_money_score": 0.45,
      "social_momentum_score": 0.25,
      "social_volume_velocity": 0.10,
      "entity_flow_score": 0.15,
      "freshness_penalty_weight": 0.05
    },
    "tie_breaker": "v2_native_24h_volume_quote",
    "minimum_signal_freshness_seconds_for_inclusion": 1800
  },
  "fallback_rules": {
    "on_all_providers_missing": "fall_back_to_v2_native_universe_only",
    "on_provider_rate_limit": "use_cached_signals_if_within_cache_ttl",
    "on_stale_signal": "mark_signal_stale_and_apply_freshness_penalty",
    "never_block_v2_runtime_on_provider_failure": true
  },
  "preserved_invariants_from_existing_symbol_universe": {
    "dynamic_discovered_symbols": "continue_honoring",
    "training_symbols": "continue_honoring",
    "paper_symbols": "continue_honoring",
    "live_symbols_must_remain_empty": true
  },
  "credential_handling_invariants": {
    "no_raw_credentials_in_candidate_payload": true,
    "no_raw_credentials_in_any_v2_redis_value": true,
    "credential_redaction_required_in_dashboard_payload": true
  },
  "implementation_state": "PLAN_ONLY_NOT_WIRED",
  "live_gate": "blocked_human_only",
  "live_symbols": [],
  "approves_live": false,
  "approves_canary": false,
  "approves_legacy_shutdown": false,
  "approves_redis_trim": false
}
