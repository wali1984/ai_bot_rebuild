  "v2_redis_namespace_contract": {
    "v2:altdata:nansen:status": "global Nansen client heartbeat / budget / availability state",
    "v2:altdata:nansen:symbol:{symbol}": "per-symbol Nansen feature dict + missing/stale flags",
    "v2:altdata:lunarcrush:status": "global LunarCrush client heartbeat / budget / availability state",
    "v2:altdata:lunarcrush:symbol:{symbol}": "per-symbol LunarCrush feature dict + missing/stale flags",
    "v2:altdata:arkham:status": "Arkham future-state placeholder; remains absent until operator approves implementation",
    "v2:altdata:symbol_score:{symbol}": "aggregated alt-data score per symbol",
    "v2:symbol_universe:altdata_candidates": "candidate symbol set from alt-data ranking"
  },
  "rate_limit_policy": {
    "default_tier": "free",
    "env_vars_documented_only": {
      "ALT_DATA_TIER": "free | paid (default free)",
      "ALT_DATA_ENABLE_PAID": "true | false (default false)"
    },
    "cache_ttl_per_provider_seconds_free": {
      "nansen": 600,
      "lunarcrush": 600,
      "arkham_future": null
    },
    "cache_ttl_per_provider_seconds_paid": {
      "nansen": 60,
      "lunarcrush": 60,
      "arkham_future": null
    },
    "daily_request_budget_per_provider_free": {
      "nansen": 1000,
      "lunarcrush": 1000
    },
    "daily_request_budget_per_provider_paid": {
      "nansen": 50000,
      "lunarcrush": 50000
    },
    "per_symbol_cooldown_seconds_free": 300,
    "per_symbol_cooldown_seconds_paid": 30,
    "batch_symbol_prioritization": "top_k_by_paper_position_and_universe_rank",
    "stale_but_safe_fallback": true,
    "provider_failure_isolation": "no_provider_failure_may_break_v2_runtime"
  },
  "paid_upgrade_design": {
    "single_switch": {
      "env_change_documented": [
        "ALT_DATA_TIER=paid",
        "ALT_DATA_ENABLE_PAID=true"
      ],
      "no_code_rewrite_required": true,
      "paid_endpoints_remain_disabled_until_codex_validates_provider_docs_and_config": true,
      "operator_decision_required": true
    },
    "free_and_paid_capabilities_defined_separately_per_provider": true
  },
  "credential_handling_invariants": {
    "no_raw_credentials_in_this_packet": true,
    "no_raw_credentials_in_any_v2_payload_or_log": true,
    "no_raw_credentials_in_any_task_descriptor": true,
    "no_raw_credentials_in_any_frontend_payload": true,
    "no_raw_credentials_in_stdout": true,
    "credential_storage_location": ".local_secrets/ (gitignored)",
    "credential_load_path_at_runtime_documented_only": "v2.backend.app.services.native_ingestors.secret_decision pattern (env-name probe only, never value)",
