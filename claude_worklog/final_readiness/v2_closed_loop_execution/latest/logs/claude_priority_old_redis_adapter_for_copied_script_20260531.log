```python
"""Contract proof: copied legacy-origin ingest scripts never write to
non-V2 Redis namespaces.

Scope:
- v2/legacy_owned_runtime/ingest/liquidation_bridge.py (PID 2370 per
  V2_VS_LEGACY_AUDIT_2026-05-31.md:49)
- v2/legacy_owned_runtime/ingest/liquidation_levels_engine.py (PID 5847
  per V2_VS_LEGACY_AUDIT_2026-05-31.md:64)

Two proofs:

(A) Static AST proof: every redis client/pipeline write call site in
    each script has a first-key argument that is provably v2-prefixed.
    The proof permits:
      - direct `_v2_key(...)` call
      - string literal starting with `v2:`
      - f-string whose first segment is `v2:...`
      - f-string whose first formatted value is a previously-approved
        name (e.g. `f"{unified_key}:latest"` when `unified_key` was
        bound via `_v2_key(...)`)
      - a Name bound (anywhere in the module) from any of the above
    A fixed-point pass propagates approvals through variable bindings.

(B) Runtime proof: the `LegacyNamespaceGuard` adapter fail-closes on
    every command shape the two scripts actually emit (SET, HSET,
    EXPIRE, XADD, XACK, XGROUP CREATE/SETID/DELCONSUMER, DEL), and
    accepts the same commands when keys are v2-prefixed.

If both proofs pass, the read-only bridge contract is enforced:
no V2 runtime path can mutate legacy-namespace keys via these scripts.
"""
from __future__ import annotations

import ast
from pathlib import Path

import pytest

from app.adapters.redis_v2.legacy_namespace_guard import (
    LegacyNamespaceWriteRejected,
    assert_v2_namespace,
    gated_write_commands,
)


REPO_ROOT = Path(__file__).resolve().parents[4]
COPIED_SCRIPTS: tuple[Path, ...] = (
    REPO_ROOT / "v2" / "legacy_owned_runtime" / "ingest" / "liquidation_bridge.py",
    REPO_ROOT / "v2" / "legacy_owned_runtime" / "ingest" / "liquidation_levels_engine.py",
)

REDIS_CLIENT_NAMES: frozenset[str] = frozenset({"r", "pipe"})

# redis-py method names that mutate state. Mirrors
# `legacy_namespace_guard.gated_write_commands()` translated to the
# attribute form (`SET` -> `set`, `XGROUP CREATE` -> `xgroup_create`).
REDIS_WRITE_METHODS: frozenset[str] = frozenset({
    "set", "setex", "psetex", "setnx", "getset", "append",
    "incr", "incrby", "incrbyfloat", "decr", "decrby",
    "expire", "expireat", "pexpire", "pexpireat", "persist",
    "rename", "renamenx", "copy", "restore",
    "hset", "hsetnx", "hmset", "hincrby", "hincrbyfloat", "hdel",
    "lpush", "lpushx", "rpush", "rpushx", "lpop", "rpop",
    "lrem", "lset", "ltrim", "linsert",
    "sadd", "srem", "spop", "smove",
    "zadd", "zrem", "zincrby", "zpopmin", "zpopmax",
    "xadd", "xack", "xdel", "xtrim", "xclaim", "xautoclaim",
    "xgroup_create", "xgroup_destroy", "xgroup_setid",
    "xgroup_createconsumer", "xgroup_delconsumer",
    "publish",
    "delete", "unlink", "mset", "msetnx",
    "flushdb", "flushall",
})


def _is_v2_safe_expr(node: ast.AST, safe_names: set[str]) -> bool:
    if isinstance(node, ast.Call):
        if isinstance(node.func, ast.Name) and node.func.id == "_v2_key":
            return True
        return False
    if isinstance(node, ast.Constant) and isinstance(node.value, str):
        return node.value.startswith("v2:")
    if isinstance(node, ast.Name):
        return node.id in safe_names
    if isinstance(node, ast.JoinedStr):
        return _joined_str_is_v2_safe(node, safe_names)
    return False


def _joined_str_is_v2_safe(node: ast.JoinedStr, safe_names: set[str]) -> bool:
    for part in node.values:
        if isinstance(part, ast.Constant) and isinstance(part.value, str):
            if part.value == "":
                continue
            return part.value.startswith("v2:")
        if isinstance(part, ast.FormattedValue):
            inner = part.value
            if isinstance(inner, ast.Name) and inner.id in safe_names:
                return True
            if isinstance(inner, ast.JoinedStr) and _joined_str_is_v2_safe(
                inner, safe_names
            ):
                return True
            return False
        return False
    return False


def _collect_safe_names(tree: ast.AST) -> set[str]:
    """Iterate to fixed point collecting names whose every binding is
    a v2-safe expression."""
    safe: set[str] = set()
    while True:
        new_safe = set(safe)
        for node in ast.walk(tree):
            if not isinstance(node, ast.Assign):
                continue
            if len(node.targets) != 1:
                continue
            tgt = node.targets[0]
            if not isinstance(tgt, ast.Name):
                continue
            if tgt.id in new_safe:
                continue
            if _is_v2_safe_expr(node.value, new_safe):
                new_safe.add(tgt.id)
        if new_safe == safe:
            return safe
        safe = new_safe


def _collect_write_call_sites(tree: ast.AST) -> list[ast.Call]:
    sites: list[ast.Call] = []
    for node in ast.walk(tree):
        if not isinstance(node, ast.Call):
            continue
        func = node.func
        if not isinstance(func, ast.Attribute):
            continue
        if func.attr not in REDIS_WRITE_METHODS:
            continue
        value = func.value
        if not isinstance(value, ast.Name):
            continue
        if value.id not in REDIS_CLIENT_NAMES:
            continue
        sites.append(node)
    return sites


@pytest.mark.parametrize("script_path", COPIED_SCRIPTS, ids=lambda p: p.name)
def test_copied_script_writes_only_to_v2_namespace(script_path: Path) -> None:
    source = script_path.read_text(encoding="utf-8")
    tree = ast.parse(source, filename=str(script_path))

    safe_names = _collect_safe_names(tree)
    assert "STREAM" in safe_names or "STREAM_NAME" in safe_names, (
        f"{script_path.name}: stream constant should be derived from _v2_key()"
    )

    sites = _collect_write_call_sites(tree)
    assert sites, f"{script_path.name}: no redis write call sites found"

    violations: list[str] = []
    for call in sites:
        method = call.func.attr  # type: ignore[union-attr]
        if not call.args:
            continue
        first = call.args[0]
        if not _is_v2_safe_expr(first, safe_names):
            violations.append(
                f"line {call.lineno}: {method}() with non-v2-safe key "
                f"(ast={ast.dump(first)[:160]})"
            )
        if method in {"delete", "unlink"}:
            for extra in call.args[1:]:
                if not _is_v2_safe_expr(extra, safe_names):
                    violations.append(
                        f"line {call.lineno}: {method}() extra key not v2-safe"
                    )

    assert not violations, (
        f"{script_path.name} has redis write sites that cannot be proven "
        f"v2-namespaced:\n  - " + "\n  - ".join(violations)
    )


@pytest.mark.parametrize("script_path", COPIED_SCRIPTS, ids=lambda p: p.name)
def test_copied_script_has_nonempty_v2_prefix_default(script_path: Path) -> None:
    source = script_path.read_text(encoding="utf-8")
    tree = ast.parse(source, filename=str(script_path))
    found_default = None
    for node in ast.walk(tree):
        if not isinstance(node, ast.Assign):
            continue
        if not (
            len(node.targets) == 1
            and isinstance(node.targets[0], ast.Name)
            and node.targets[0].id == "V2_REDIS_PREFIX"
        ):
            continue
        value = node.value
        if (
            isinstance(value, ast.Call)
            and isinstance(value.func, ast.Attribute)
            and value.func.attr == "getenv"
            and len(value.args) >= 2
            and isinstance(value.args[1], ast.Constant)
        ):
            found_default = value.args[1].value
            break
    assert isinstance(found_default, str) and found_default != "", (
        f"{script_path.name}: V2_REDIS_PREFIX must have a non-empty default "
        f"so the namespace separator cannot silently collapse"
    )
    assert found_default.endswith(":"), (
        f"{script_path.name}: V2_REDIS_PREFIX default {found_default!r} "
        f"should end with ':' to avoid prefix-collision (e.g. 'v2foo:bar')"
    )


# --- Runtime fail-closed proof ---------------------------------------


def test_guard_rejects_set_on_legacy_key() -> None:
    with pytest.raises(LegacyNamespaceWriteRejected) as exc:
        assert_v2_namespace(("SET", "features:coinank:BTCUSDT", "1"), v2_prefix="v2:")
    assert exc.value.command == "SET"
    assert exc.value.key == "features:coinank:BTCUSDT"


def test_guard_accepts_set_on_v2_key() -> None:
    assert_v2_namespace(("SET", "v2:cursor:liq_bridge:foo", "1"), v2_prefix="v2:")


@pytest.mark.parametrize(
    "command,args",
    [
        ("HSET", ("HSET", "unified_features:BTCUSDT:1m", "f", "v")),
        ("EXPIRE", ("EXPIRE", "unified_features:BTCUSDT:1m", 900)),
        ("XADD", ("XADD", "liquidations:events", "*", "ts", "1")),
        ("XACK", ("XACK", "liquidations:events", "v2_liq_levels", "id")),
        ("DEL", ("DEL", "v2:ok:key", "features:coinank:tail")),
        ("UNLINK", ("UNLINK", "ta:BTCUSDT:5m")),
        ("PUBLISH", ("PUBLISH", "signals:trading:primary", "{}")),
    ],
)
def test_guard_rejects_each_write_shape(command: str, args: tuple) -> None:
    with pytest.raises(LegacyNamespaceWriteRejected) as exc:
        assert_v2_namespace(args, v2_prefix="v2:")
    assert command in exc.value.command


@pytest.mark.parametrize(
    "args",
    [
        ("XGROUP", "CREATE", "liquidations:events", "g", "0"),
        ("XGROUP", "SETID", "liquidations:events", "g", "$"),
        ("XGROUP", "DELCONSUMER", "liquidations:events", "g", "c"),
    ],
)
def test_guard_rejects_xgroup_subcommand_on_legacy_stream(args: tuple) -> None:
    with pytest.raises(LegacyNamespaceWriteRejected) as exc:
        assert_v2_namespace(args, v2_prefix="v2:")
    assert exc.value.command.startswith("XGROUP")


@pytest.mark.parametrize(
    "args",
    [
        ("XGROUP", "CREATE", "v2:liquidations:events", "g", "0"),
        ("XGROUP", "SETID", "v2:liquidations:events", "g", "$"),
    ],
)
def test_guard_accepts_xgroup_subcommand_on_v2_stream(args: tuple) -> None:
    assert_v2_namespace(args, v2_prefix="v2:")


@pytest.mark.parametrize(
    "command",
    ["FLUSHDB", "FLUSHALL", "SHUTDOWN", "CONFIG", "SCRIPT", "SWAPDB"],
)
def test_guard_forbids_catastrophic_commands(command: str) -> None:
    with pytest.raises(LegacyNamespaceWriteRejected):
        assert_v2_namespace((command,), v2_prefix="v2:")


def test_guard_accepts_byte_keys_with_v2_prefix() -> None:
    assert_v2_namespace(("SET", b"v2:cursor:x", b"1"), v2_prefix="v2:")


def test_guard_rejects_byte_keys_without_v2_prefix() -> None:
    with pytest.raises(LegacyNamespaceWriteRejected):
        assert_v2_namespace(("SET", b"legacy:cursor:x", b"1"), v2_prefix="v2:")


def test_gated_write_commands_covers_every_script_emitted_command() -> None:
    """Every redis method the two copied scripts call MUST appear in
    the guard's `gated_write_commands()` enumeration (or be a read)."""
    method_to_command = {
        "set": "SET", "setex": "SETEX", "expire": "EXPIRE",
        "hset": "HSET", "hsetnx": "HSETNX",
        "xadd": "XADD", "xack": "XACK", "xdel": "XDEL", "xtrim": "XTRIM",
        "xgroup_create": "XGROUP", "xgroup_setid": "XGROUP",
        "xgroup_delconsumer": "XGROUP",
        "publish": "PUBLISH", "delete": "DEL", "unlink": "UNLINK",
    }
    gated = set(gated_write_commands())
    script_methods: set[str] = set()
    for script_path in COPIED_SCRIPTS:
        tree = ast.parse(script_path.read_text(encoding="utf-8"))
        for call in _collect_write_call_sites(tree):
            script_methods.add(call.func.attr)  # type: ignore[union-attr]
    uncovered = [
        m for m in script_methods
        if method_to_command.get(m) and method_to_command[m] not in gated
    ]
    assert not uncovered, (
        f"guard does not cover script-emitted methods: {sorted(uncovered)}"
    )
