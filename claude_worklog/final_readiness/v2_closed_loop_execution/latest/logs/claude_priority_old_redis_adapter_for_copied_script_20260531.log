```python
"""Fail-closed guard that rejects writes to non-V2 Redis namespaces.

Policy (CLAUDE.md):
- The V2 runtime must not write to old (legacy) Redis namespaces.
- Legacy and V2 share a single Redis instance at `redis://localhost:6379/0`.
- The only separator between legacy and V2 keyspaces is the
  `V2_REDIS_PREFIX` string prefix (default `v2:`).

This adapter wraps a `redis.Redis` client and intercepts every command that
mutates Redis state. If the command's key argument(s) do not begin with
the configured V2 prefix, the call raises `LegacyNamespaceWriteRejected`
BEFORE the command is sent to the server.

Reads are not gated; the policy permits read-only bridging from any
namespace. This adapter is read-pass-through, write-fail-closed.

Contract-tested against the two copied legacy-origin scripts still in
production at the time of writing:
- v2/legacy_owned_runtime/ingest/liquidation_bridge.py
- v2/legacy_owned_runtime/ingest/liquidation_levels_engine.py

Both scripts already route every write through `_v2_key(...)` or a literal
`v2:` prefix; this adapter is the runtime backstop that converts that
convention into an enforced invariant.
"""
from __future__ import annotations

from typing import Any, Iterable

import redis
from redis.client import Pipeline


class LegacyNamespaceWriteRejected(Exception):
    """Raised when a write command targets a non-V2 namespace key."""

    def __init__(self, *, command: str, key: str, v2_prefix: str) -> None:
        self.command = command
        self.key = key
        self.v2_prefix = v2_prefix
        super().__init__(
            f"refused {command} on key {key!r}: "
            f"must start with V2 prefix {v2_prefix!r}"
        )


_WRITE_KEY_AT_ARG1: frozenset[str] = frozenset({
    "SET", "SETEX", "PSETEX", "SETNX", "GETSET", "APPEND",
    "INCR", "INCRBY", "INCRBYFLOAT", "DECR", "DECRBY",
    "EXPIRE", "EXPIREAT", "PEXPIRE", "PEXPIREAT", "PERSIST",
    "RENAME", "RENAMENX", "COPY", "RESTORE",
    "HSET", "HSETNX", "HMSET", "HINCRBY", "HINCRBYFLOAT", "HDEL",
    "LPUSH", "LPUSHX", "RPUSH", "RPUSHX", "LPOP", "RPOP",
    "LREM", "LSET", "LTRIM", "LINSERT",
    "SADD", "SREM", "SPOP", "SMOVE",
    "ZADD", "ZREM", "ZINCRBY", "ZPOPMIN", "ZPOPMAX",
    "XADD", "XACK", "XDEL", "XTRIM", "XCLAIM", "XAUTOCLAIM",
    "PUBLISH",
})

_WRITE_VARIADIC_KEYS: frozenset[str] = frozenset({
    "DEL", "UNLINK",
})

_WRITE_SUBCMD_KEY_AT_ARG2: frozenset[str] = frozenset({
    "XGROUP",
})

_FORBIDDEN_COMMANDS: frozenset[str] = frozenset({
    "FLUSHDB", "FLUSHALL", "SHUTDOWN", "DEBUG", "CONFIG", "ACL",
    "SCRIPT", "SWAPDB", "MIGRATE", "MOVE",
})


def _is_v2_key(key: Any, v2_prefix: str) -> bool:
    if isinstance(key, bytes):
        try:
            key = key.decode("utf-8")
        except UnicodeDecodeError:
            return False
    if not isinstance(key, str):
        return False
    return key.startswith(v2_prefix)


def assert_v2_namespace(args: tuple, *, v2_prefix: str) -> None:
    """Validate a Redis command tuple before dispatch.

    `args` is the raw `(COMMAND, *params)` tuple as redis-py constructs
    it for `execute_command`. Raises `LegacyNamespaceWriteRejected` if
    any gated write touches a non-V2 key.
    """
    if not args:
        return
    command = str(args[0]).upper()

    if command in _FORBIDDEN_COMMANDS:
        raise LegacyNamespaceWriteRejected(
            command=command,
            key="<no-key>",
            v2_prefix=v2_prefix,
        )

    if command in _WRITE_KEY_AT_ARG1:
        if len(args) < 2:
            return
        key = args[1]
        if not _is_v2_key(key, v2_prefix):
            raise LegacyNamespaceWriteRejected(
                command=command,
                key=str(key),
                v2_prefix=v2_prefix,
            )
        return

    if command in _WRITE_VARIADIC_KEYS:
        for key in args[1:]:
            if not _is_v2_key(key, v2_prefix):
                raise LegacyNamespaceWriteRejected(
                    command=command,
                    key=str(key),
                    v2_prefix=v2_prefix,
                )
        return

    if command in _WRITE_SUBCMD_KEY_AT_ARG2:
        if len(args) < 3:
            return
        key = args[2]
        if not _is_v2_key(key, v2_prefix):
            raise LegacyNamespaceWriteRejected(
                command=f"{command} {str(args[1]).upper()}",
                key=str(key),
                v2_prefix=v2_prefix,
            )
        return


class _GuardedPipeline(Pipeline):
    def __init__(self, *args: Any, v2_prefix: str, **kwargs: Any) -> None:
        super().__init__(*args, **kwargs)
        self._v2_prefix = v2_prefix

    def execute_command(self, *args: Any, **kwargs: Any) -> Any:
        assert_v2_namespace(args, v2_prefix=self._v2_prefix)
        return super().execute_command(*args, **kwargs)


class LegacyNamespaceGuard(redis.Redis):
    """`redis.Redis` subclass that fail-closes any non-V2 write."""

    def __init__(self, *args: Any, v2_prefix: str = "v2:", **kwargs: Any) -> None:
        if not isinstance(v2_prefix, str) or v2_prefix == "":
            raise ValueError("v2_prefix must be a non-empty string")
        super().__init__(*args, **kwargs)
        self._v2_prefix = v2_prefix

    @property
    def v2_prefix(self) -> str:
        return self._v2_prefix

    def execute_command(self, *args: Any, **options: Any) -> Any:
        assert_v2_namespace(args, v2_prefix=self._v2_prefix)
        return super().execute_command(*args, **options)

    def pipeline(self, transaction: bool = True, shard_hint: Any = None) -> Pipeline:
        return _GuardedPipeline(
            connection_pool=self.connection_pool,
            response_callbacks=self.response_callbacks,
            transaction=transaction,
            shard_hint=shard_hint,
            v2_prefix=self._v2_prefix,
        )


def gated_write_commands() -> Iterable[str]:
    """Stable enumeration of every command this guard mediates."""
    return sorted(
        set(_WRITE_KEY_AT_ARG1)
        | set(_WRITE_VARIADIC_KEYS)
        | set(_WRITE_SUBCMD_KEY_AT_ARG2)
        | set(_FORBIDDEN_COMMANDS)
    )
```
