```python
def test_false_negative_evidence_uses_explicit_gate_reasons_when_present() -> None:
    from v2.backend.app.services.edge_proof.replay_miner import (
        _false_negative_strict_gate_evidence,
    )
    b = _baseline_bundle(
        decision="SHADOW_OBSERVATION_ONLY", paper_fill_allowed=False,
        block_reasons=["EDGE_BELOW_THRESHOLD"],
    )
    ev = _false_negative_strict_gate_evidence(b)
    assert ev["evidence_state"] == "STRICT_GATE_BLOCK_REASONS_PRESENT"
    assert "EDGE_BELOW_THRESHOLD" in ev["block_reasons"]
    assert "paper_gate_decision.paper_fill_gate_block_reasons" in ev["source_pointers"]


def test_false_negative_evidence_marks_missing_source_when_no_reason_available() -> None:
    from v2.backend.app.services.edge_proof.replay_miner import (
        _false_negative_strict_gate_evidence,
    )
    b = _baseline_bundle(decision="UNKNOWN", paper_fill_allowed=False)
    b["paper_gate_decision"]["paper_fill_gate_block_reasons"] = []
    b["paper_intent"]["paper_fill_gate_block_reasons"] = []
    b["trainer_output"] = {"selected_action": "long"}
    ev = _false_negative_strict_gate_evidence(b)
    assert ev["evidence_state"] == "MISSING_SOURCE"
    assert ev["block_reasons"] == ["MISSING_SOURCE"]


def test_false_negative_evidence_uses_shadow_observation_only_decision_when_no_explicit_reason() -> None:
    from v2.backend.app.services.edge_proof.replay_miner import (
        _false_negative_strict_gate_evidence,
    )
    b = _baseline_bundle(decision="SHADOW_OBSERVATION_ONLY", paper_fill_allowed=False)
    ev = _false_negative_strict_gate_evidence(b)
    assert ev["evidence_state"] == "STRICT_GATE_BLOCK_REASONS_PRESENT"
    assert "SHADOW_OBSERVATION_ONLY_NO_PAPER_FILL_INTENT" in ev["block_reasons"]


def test_fill_outcomes_attaches_false_negative_evidence_without_changing_label() -> None:
    anchor = 1_779_500_000.0
    timeline = [(anchor, 100.0), (anchor + 5 * 60, 101.5)]  # +143 bps after cost
    b = _baseline_bundle(decision="SHADOW_OBSERVATION_ONLY", paper_fill_allowed=False)
    b["anchor_ts"] = anchor
    out = fill_outcomes(b, timeline_by_symbol={"BTCUSDT": timeline})
    # Strict paper gate preserved: label is still FALSE_NEGATIVE, not blocked.
    assert out["label"] == ReplayLabel.FALSE_NEGATIVE.value
    ev = out["false_negative_evidence"]
    assert ev["evidence_state"] == "STRICT_GATE_BLOCK_REASONS_PRESENT"
    assert "SHADOW_OBSERVATION_ONLY_NO_PAPER_FILL_INTENT" in ev["block_reasons"]


def test_fill_outcomes_does_not_attach_false_negative_evidence_to_correct_no_trade() -> None:
    anchor = 1_779_500_000.0
    timeline = [(anchor, 100.0), (anchor + 5 * 60, 99.5)]  # negative after-cost
    b = _baseline_bundle(decision="SHADOW_OBSERVATION_ONLY", paper_fill_allowed=False)
    b["anchor_ts"] = anchor
    out = fill_outcomes(b, timeline_by_symbol={"BTCUSDT": timeline})
    assert out["label"] == ReplayLabel.CORRECT_NO_TRADE.value
    assert "false_negative_evidence" not in out
```

