        "path_exists": p.is_file(),
        "keys": redacted,
        "key_count": len(parsed),
        "required_key_names": list(required),
        "alias_key_names": list(aliases),
        "optional_key_names_present": optional_present,
        "missing_required_by_name": missing_required,
