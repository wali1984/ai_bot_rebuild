   141	class MarketIngestService:
   142	    """V2 market ingest service.
   143	
   144	    All persistence is into the in-memory ``data_plane`` dict, keyed by
   145	    V2-namespaced strings (``v2:market:*``). The CLI snapshots this dict to a
   146	    JSON file. No legacy Redis key is ever written.
   147	    """
   148	
   149	    def __init__(
   150	        self,
   151	        *,
   152	        http_get: Optional[HttpGetCallable] = None,
   153	        clock: Optional[Callable[[], float]] = None,
   154	        data_plane: Optional[Dict[str, Any]] = None,
   155	        enable_kucoin: bool = False,
   156	        coinapi_daily_budget: int = 10000,
   157	        coinapi_v1_budget_pct: float = 0.30,
   158	    ) -> None:
   159	        self._http_get = http_get if http_get is not None else _default_http_get
   160	        self._clock = clock if clock is not None else time.time
   161	        self.data_plane: Dict[str, Any] = data_plane if data_plane is not None else {}
   162	        self._enable_kucoin = enable_kucoin
   163	        self._coinapi_daily_budget = coinapi_daily_budget
   164	        self._coinapi_v1_budget_pct = coinapi_v1_budget_pct
   165	        self._coinapi_v1_msgs_today = 0
   166	        self._coinapi_v1_last_ts: Optional[float] = None
   167	        self._consecutive_5xx = 0
   168	        self._consecutive_bans = 0
   169	        self._consecutive_geo_blocks = 0
   170	        self._backoff_until = 0.0
   171	        self._rate_limit_state = "ok"
   172	        self._klines_persisted_total = 0
   173	        self._last_kline_ts: Optional[int] = None
   174	
   175	    # ------------------------------------------------------------------
   176	    # public surface
   177	    # ------------------------------------------------------------------
   178	
   179	    @property
   180	    def klines_persisted_total(self) -> int:
   181	        return self._klines_persisted_total
   182	
   183	    @property
   184	    def last_kline_ts(self) -> Optional[int]:
   185	        return self._last_kline_ts
   186	
   187	    @property
   188	    def rate_limit_state(self) -> str:
   189	        return self._rate_limit_state
   190	
   191	    @property
   192	    def backoff_until(self) -> float:
   193	        return self._backoff_until
   194	
   195	    def ingest_klines(
   196	        self,
   197	        symbol: str,
   198	        timeframe: str = "1m",
   199	        limit: int = 6,
   200	    ) -> IngestResult:
   201	        """Ingest OHLCV klines using the data-source priority table.
   202	
   203	        Preserved legacy behavior: CoinAPI V1 primary, Binance REST fallback.
   204	        Fail-closed on 5xx and during rate-limit backoff windows.
   205	        """
   206	        result = IngestResult(symbol=symbol, timeframe=timeframe)
   207	        now = self._clock()
   208	        if now < self._backoff_until:
   209	            result.rate_limit_state = self._rate_limit_state
   210	            result.errors.append(
   211	                f"backoff_active until {self._backoff_until} ({self._rate_limit_state})"
   212	            )
   213	            return result
   214	
   215	        # Per the data-source priority table: CoinAPI V1 primary -> Binance REST fallback.
   216	        # Cold start must still attempt CoinAPI first; health only records whether
   217	        # the prior CoinAPI sample was fresh enough.
   218	        source = "coinapi_v1"
   219	        bars = self._coinapi_v1_klines(symbol, timeframe, limit)
   220	        if bars is None:
   221	            result.errors.append("coinapi_v1_unavailable_fallback_binance_rest")
   222	            source = "binance_rest"
   223	            bars = self._binance_rest_klines(symbol, timeframe, limit, result)
   224	
   225	        if bars is None:
   226	            result.source = source
   227	            result.rate_limit_state = self._rate_limit_state
   228	            return result
   229	
   230	        # Persist into V2 namespace (NEVER legacy Redis).
   231	        bars_key = f"{V2_KEY_PREFIX}:{symbol}:ohlcv:{timeframe}"
   232	        price_key = f"{V2_KEY_PREFIX}:{symbol}:price"
   233	        self.data_plane[bars_key] = bars
   234	        last_bar = bars[-1] if bars else None
   235	        if last_bar is not None:
   236	            close = last_bar.get("close")
   237	            ts = int(last_bar.get("ts", 0))
   238	            self.data_plane[price_key] = {
   239	                "symbol": symbol,
   240	                "price": float(close) if close is not None else None,
   241	                "ts_ms": ts,
   242	                "source": source,
   243	            }
   244	            self._last_kline_ts = ts
   245	        result.klines_persisted = len(bars)
   246	        result.last_kline_ts = self._last_kline_ts
   247	        result.source = source
   248	        self._rate_limit_state = "ok"
   249	        result.rate_limit_state = self._rate_limit_state
   250	        result.v2_keys_written = [bars_key, price_key]
   251	        self._klines_persisted_total += len(bars)
   252	        self._consecutive_5xx = 0
   253	        return result
