    15	   :data:`SYMBOL_UNIVERSE_PUBLIC_PAYLOAD` exists, read its
    16	   ``discovered_symbols`` (or fallback fields) and merge with the
    17	   25-symbol baseline.
    18	4. Otherwise fall back to the 25-symbol legacy baseline.
    19	
    20	The resolver never returns the smoke-test 3 set unless the caller
    21	explicitly opted into smoke-test mode.
    22	"""
    23	from __future__ import annotations
    24	
    25	import json
    26	import os
    27	from pathlib import Path
    28	from typing import Iterable, List, Optional, Sequence, Set, Tuple
    29	
    30	
    31	REPO = Path("/home/wali/Desktop/AI BOT REBUILD")
    32	
    33	SYMBOL_UNIVERSE_PUBLIC_PAYLOAD = (
    34	    REPO
    35	    / "v2/frontend/public/operator_runtime/symbol_universe/latest/"
    36	      "symbol_universe_status.json"
    37	)
    38	
    39	# 25-symbol legacy migration baseline.
    40	BASELINE_25_SYMBOLS: Tuple[str, ...] = (
    41	    "1000BONKUSDT", "1000FLOKIUSDT", "1000PEPEUSDT", "1000SHIBUSDT",
    42	    "ALICEUSDT", "ASTERUSDT", "AUCTIONUSDT", "AVNTUSDT",
    43	    "BANKUSDT", "BARDUSDT", "BTCUSDT", "DOGEUSDT",
    44	    "ETHUSDT", "FARTCOINUSDT", "HIGHUSDT", "LINKUSDT",
    45	    "LTCUSDT", "PENGUUSDT", "PIPPINUSDT", "RAVEUSDT",
    46	    "RIVERUSDT", "SOLUSDT", "UNIUSDT", "WIFUSDT", "XRPUSDT",
    47	)
    48	
    49	# Smoke-test only. NEVER the production default.
    50	SMOKE_TEST_SYMBOLS: Tuple[str, ...] = ("BTCUSDT", "ETHUSDT", "SOLUSDT")
    51	
    52	SMOKE_TEST_ENV_VAR = "V2_SYMBOL_PROFILE"
    53	SMOKE_TEST_ENV_VALUE = "smoke_test"
    54	
    55	
    56	def _parse_explicit(symbols: Optional[Iterable[str]]) -> List[str]:
    57	    if symbols is None:
    58	        return []
    59	    if isinstance(symbols, str):
    60	        return [s.strip().upper() for s in symbols.split(",") if s.strip()]
    61	    return [s.strip().upper() for s in symbols if s and s.strip()]
    62	
    63	
    64	def _read_published_symbols() -> Tuple[List[str], Optional[str]]:
    65	    p = SYMBOL_UNIVERSE_PUBLIC_PAYLOAD
    66	    if not p.is_file():
    67	        return [], None
    68	    try:
    69	        d = json.loads(p.read_text())
    70	    except Exception:
    71	        return [], None
    72	    # Prefer the exchange-confirmed training/paper scope for live data workers.
    73	    # ``discovered_symbols`` can include market-intelligence-only or stale
    74	    # observed symbols that should not be fetched by Binance ingestors.
    75	    for key in (
    76	        "training_symbols",
    77	        "paper_symbols",
    78	        "live_data_symbols",
    79	        "trainer_live_symbols",
    80	        "paper_shadow_live_symbols",
    81	        "discovered_symbols",
    82	        "dynamic_discovered_symbols",
    83	        "observed_symbols",
    84	        "symbols",
    85	        "universe",
    86	    ):
    87	        v = d.get(key)
    88	        if isinstance(v, list) and all(isinstance(x, str) for x in v) and v:
    89	            return list(v), str(p)
    90	    return [], str(p)
    91	
    92	
    93	def resolve_symbols(
    94	    *,
    95	    explicit: Optional[Iterable[str]] = None,
    96	    smoke_test: bool = False,
    97	    include_baseline: bool = True,
    98	) -> List[str]:
    99	    """Return the runtime symbol list per the resolution order above."""
   100	    env_smoke = os.environ.get(SMOKE_TEST_ENV_VAR) == SMOKE_TEST_ENV_VALUE
   101	
   102	    # 1. Explicit caller list wins, except the 3-symbol smoke-test set
   103	    # must still carry an explicit smoke-test opt-in.
   104	    explicit_list = _parse_explicit(explicit)
   105	    if explicit_list:
   106	        if explicit_list == list(SMOKE_TEST_SYMBOLS) and not (smoke_test or env_smoke):
   107	            raise ValueError(
   108	                "V2_SYMBOL_DEFAULT_DRIFT: explicit BTC/ETH/SOL symbol set "
   109	                "requires --smoke-test or V2_SYMBOL_PROFILE=smoke_test"
   110	            )
   111	        return explicit_list
   112	
   113	    # 2. Smoke-test override (flag OR env).
   114	    if smoke_test or env_smoke:
   115	        return list(SMOKE_TEST_SYMBOLS)
   116	
   117	    # 3. Published symbol-universe payload.
   118	    discovered, _src = _read_published_symbols()
   119	    if include_baseline:
   120	        merged: List[str] = []
   121	        seen: Set[str] = set()
   122	        for s in list(BASELINE_25_SYMBOLS) + discovered:
   123	            if s and s.upper() not in seen:
   124	                seen.add(s.upper())
   125	                merged.append(s.upper())
   126	        if merged:
   127	            return merged
   128	    elif discovered:
   129	        return list(discovered)
   130	
   131	    # 4. Final fallback: 25-symbol baseline.
   132	    return list(BASELINE_25_SYMBOLS)
   133	
   134	
   135	def resolve_symbols_with_provenance(
   136	    *,
   137	    explicit: Optional[Iterable[str]] = None,
   138	    smoke_test: bool = False,
   139	    include_baseline: bool = True,
   140	) -> dict:
   141	    """Same as :func:`resolve_symbols` but also returns provenance."""
   142	    explicit_list = _parse_explicit(explicit)
   143	    env_smoke = os.environ.get(SMOKE_TEST_ENV_VAR) == SMOKE_TEST_ENV_VALUE
   144	    if explicit_list:
   145	        if explicit_list == list(SMOKE_TEST_SYMBOLS) and not (smoke_test or env_smoke):
   146	            raise ValueError(
   147	                "V2_SYMBOL_DEFAULT_DRIFT: explicit BTC/ETH/SOL symbol set "
   148	                "requires --smoke-test or V2_SYMBOL_PROFILE=smoke_test"
   149	            )
   150	        return {
   151	            "symbols": explicit_list,
   152	            "symbol_profile": "explicit",
   153	            "smoke_test": False,
   154	            "source_path": None,
   155	            "count": len(explicit_list),
   156	        }
   157	    if smoke_test or env_smoke:
   158	        return {
   159	            "symbols": list(SMOKE_TEST_SYMBOLS),
   160	            "symbol_profile": "smoke_test",
   161	            "smoke_test": True,
   162	            "source_path": None,
   163	            "count": len(SMOKE_TEST_SYMBOLS),
   164	            "warning": (
   165	                "smoke_test profile active; should not be used outside "
   166	                "explicit smoke tests"
   167	            ),
   168	        }
   169	    discovered, src = _read_published_symbols()
   170	    symbols = resolve_symbols(
   171	        explicit=None, smoke_test=False, include_baseline=include_baseline
   172	    )
   173	    return {
   174	        "symbols": symbols,
   175	        "symbol_profile": "dynamic_or_baseline",
   176	        "smoke_test": False,
   177	        "source_path": src,
   178	        "discovered_count": len(discovered),
   179	        "baseline_count": len(BASELINE_25_SYMBOLS),
   180	        "count": len(symbols),
   181	    }
