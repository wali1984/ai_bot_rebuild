+    except Exception:
+        return None
+    try:
+        redis_factory = getattr(redis, "Redis")
+        client = redis_factory(
+            host="127.0.0.1",
+            port=6379,
+            db=0,
+            decode_responses=True,
+            socket_connect_timeout=2,
+            socket_timeout=3,
+        )
+        client.ping()
+        return client
+    except Exception:
+        return None
