    timeframes: List[str],
    last_kline_ts: Optional[int],
    symbol_scope: Dict[str, Any],
) -> Dict[str, Any]:
    freshness = _freshness_seconds(last_kline_ts)
    return {
        "worker_id": WORKER_ID,
        "last_run_ts": run_started_ts,
        "snapshot_source": snapshot_source,
        "symbols": symbols,
        **symbol_scope,
        "timeframes": timeframes,

