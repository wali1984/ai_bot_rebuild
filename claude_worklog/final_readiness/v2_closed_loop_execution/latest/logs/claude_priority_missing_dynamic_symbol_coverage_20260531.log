```python
"""Tests for the 5-bucket symbol coverage contract.

Verifies disjoint-set invariants and the no-auto-enrollment safety pins
that close `missing_dynamic_symbol_coverage` in the priority autoseed
director ledger (2026-05-31).
"""
from __future__ import annotations

from v2.backend.app.services.symbol_universe.coverage_buckets import (
    LIVE_GATE_BLOCKED,
    evaluate_invariants,
    load_buckets_from_payload,
    summarize,
)


_CURRENT_RUNTIME_PAYLOAD = {
    "generated_at": "2026-05-31T05:46:02Z",
    "discovered_symbols": [
        "1000BONKUSDT", "BTCUSDT", "ETHUSDT", "SOLUSDT", "DOGEUSDT",
        "COINANK_ONLY_USDT", "KUCOIN_ONLY_USDT",
    ],
    "observed_symbols": ["1000BONKUSDT", "BTCUSDT"],
    "training_symbols": ["BTCUSDT", "ETHUSDT"],
    "paper_symbols": ["BTCUSDT"],
    "live_blocked_symbols": ["BTCUSDT", "ETHUSDT", "SOLUSDT"],
}


def _all_findings_named(findings):
    return {f.invariant: f for f in findings}


def test_buckets_load_from_payload():
    buckets = load_buckets_from_payload(_CURRENT_RUNTIME_PAYLOAD)
    assert "BTCUSDT" in buckets.discovered
    assert buckets.training == ("BTCUSDT", "ETHUSDT")
    assert buckets.paper == ("BTCUSDT",)
    # live_blocked is the union of discovered + training + paper + explicit
    assert "COINANK_ONLY_USDT" in buckets.live_blocked
    assert "SOLUSDT" in buckets.live_blocked


def test_training_subset_violation_surfaces_for_eth_not_observed():
    buckets = load_buckets_from_payload(_CURRENT_RUNTIME_PAYLOAD)
    findings = _all_findings_named(evaluate_invariants(buckets))
    training_finding = findings["TRAINING_subset_of_OBSERVED"]
    assert training_finding.satisfied is False
    assert "ETHUSDT" in training_finding.offending_symbols


def test_paper_subset_satisfied_for_btc_only():
    buckets = load_buckets_from_payload(_CURRENT_RUNTIME_PAYLOAD)
    findings = _all_findings_named(evaluate_invariants(buckets))
    assert findings["PAPER_subset_of_OBSERVED"].satisfied is True


def test_auto_enrollment_rejected_when_training_equals_discovered():
    payload = dict(_CURRENT_RUNTIME_PAYLOAD)
    payload["training_symbols"] = list(payload["discovered_symbols"])
    payload["observed_symbols"] = list(payload["discovered_symbols"])
    buckets = load_buckets_from_payload(payload)
    findings = _all_findings_named(evaluate_invariants(buckets))
    assert findings["TRAINING_not_equal_DISCOVERED_unless_force_train_all"].satisfied is False


def test_force_train_all_override_permits_full_universe_training():
    payload = dict(_CURRENT_RUNTIME_PAYLOAD)
    payload["training_symbols"] = list(payload["discovered_symbols"])
    payload["observed_symbols"] = list(payload["discovered_symbols"])
    buckets = load_buckets_from_payload(payload)
    findings = _all_findings_named(evaluate_invariants(buckets, force_train_all=True))
    assert findings["TRAINING_not_equal_DISCOVERED_unless_force_train_all"].satisfied is True


def test_auto_paper_rejected_when_paper_equals_discovered():
    payload = dict(_CURRENT_RUNTIME_PAYLOAD)
    payload["paper_symbols"] = list(payload["discovered_symbols"])
    payload["observed_symbols"] = list(payload["discovered_symbols"])
    buckets = load_buckets_from_payload(payload)
    findings = _all_findings_named(evaluate_invariants(buckets))
    assert findings["PAPER_not_equal_DISCOVERED_unless_force_paper_all"].satisfied is False


def test_live_symbols_must_be_empty_under_default_block():
    buckets = load_buckets_from_payload(_CURRENT_RUNTIME_PAYLOAD)
    findings = _all_findings_named(
        evaluate_invariants(
            buckets,
            live_gate=LIVE_GATE_BLOCKED,
            live_symbols=["BTCUSDT"],
        )
    )
    assert findings["LIVE_SYMBOLS_empty_while_live_gate_blocked"].satisfied is False


def test_live_blocked_covers_discovered():
    buckets = load_buckets_from_payload(_CURRENT_RUNTIME_PAYLOAD)
    findings = _all_findings_named(evaluate_invariants(buckets))
    assert findings["LIVE_BLOCKED_covers_DISCOVERED"].satisfied is True


def test_summary_carries_safety_pins():
    buckets = load_buckets_from_payload(_CURRENT_RUNTIME_PAYLOAD)
    summary = summarize(buckets, evaluate_invariants(buckets))
    assert summary["live_gate"] == LIVE_GATE_BLOCKED
    assert summary["live_symbols"] == []
    assert summary["approves_live"] is False
    assert summary["auto_enrolls_training_symbols"] is False
    assert summary["auto_enrolls_paper_symbols"] is False
    assert summary["trains_all_discovered_symbols"] is False
    assert summary["trades_all_discovered_symbols"] is False
    assert summary["writes_old_redis"] is False
    assert summary["writes_exchange_orders"] is False
    assert summary["bucket_counts"]["discovered"] == 7
    assert summary["bucket_counts"]["training"] == 2
```
