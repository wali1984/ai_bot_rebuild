```python
"""Dynamic symbol coverage — explicit 5-bucket disjoint-set contract.

Closes the `missing_dynamic_symbol_coverage` omission in the priority autoseed
director ledger (2026-05-31). Provides the *committed artifact* enumerating
the five symbol buckets and the invariants that hold between them:

    DISCOVERED   - known by any source feed (CoinAnk, Binance USDM, KuCoin,
                   CoinAPI, future ingestors). Pure observation, no policy.
    OBSERVED     - subset of DISCOVERED with live v2:market:* freshness proof.
    TRAINING     - operator-approved allowlist eligible for trainer enrollment.
                   MUST satisfy TRAINING subset of OBSERVED (else invariant
                   violation surfaced to operator).
                   MUST NOT equal DISCOVERED unless the explicit
                   FORCE_TRAIN_ALL override is set.
    PAPER        - operator-approved allowlist eligible for paper trading.
                   MUST satisfy PAPER subset of OBSERVED.
                   MUST NOT equal DISCOVERED unless the explicit
                   FORCE_PAPER_ALL override is set.
    LIVE_BLOCKED - the full known universe under default-deny live trading.
                   Enforced at HTTP boundary by
                   v2/backend/app/api/middleware/live_block_guard.py.

The module never auto-promotes a symbol. Promotion to TRAINING or PAPER
requires an explicit operator override, recorded via the Symbol Universe
governance gate. The buckets are computed from the published runtime payload
at v2/frontend/public/operator_runtime/symbol_universe/latest/symbol_universe_status.json
and validated against the invariants above.

This module performs:
    - read of a single JSON payload
    - pure-function bucket derivation
    - invariant evaluation

It NEVER:
    - writes to Redis (legacy or v2)
    - calls an exchange endpoint
    - mutates training_symbols / paper_symbols / live_symbols
    - flips the live gate
    - enrolls discovered symbols automatically into TRAINING or PAPER
"""
from __future__ import annotations

import json
from dataclasses import dataclass, field
from pathlib import Path
from typing import Any, Iterable, Mapping, Optional


REPO = Path("/home/wali/Desktop/AI BOT REBUILD")

SYMBOL_UNIVERSE_PUBLIC_PAYLOAD = (
    REPO
    / "v2/frontend/public/operator_runtime/symbol_universe/latest/"
      "symbol_universe_status.json"
)

LIVE_GATE_BLOCKED = "blocked_human_only"

# Real source feeds expected by the dynamic symbol publisher. `future_ingestors`
# is a forward-compat placeholder and is not validated as a real feed.
REAL_SOURCE_FEEDS = (
    "binance_futures",
    "coinank",
    "coinank_odt",
    "coinapi",
    "kucoin",
)
PLACEHOLDER_SOURCE_FEEDS = ("future_ingestors",)


@dataclass(frozen=True)
class SymbolCoverageBuckets:
    """Five disjoint-ish (see invariants) symbol sets at a point in time."""

    discovered: tuple[str, ...]
    observed: tuple[str, ...]
    training: tuple[str, ...]
    paper: tuple[str, ...]
    live_blocked: tuple[str, ...]
    generated_utc: str
    source_payload_path: str


@dataclass(frozen=True)
class InvariantFinding:
    invariant: str
    satisfied: bool
    detail: Optional[str] = None
    offending_symbols: tuple[str, ...] = field(default_factory=tuple)


def _norm(symbols: Iterable[str]) -> tuple[str, ...]:
    return tuple(sorted({s.strip().upper() for s in symbols if s and s.strip()}))


def load_buckets_from_payload(payload: Mapping[str, Any]) -> SymbolCoverageBuckets:
    """Build the bucket struct from an already-parsed payload dict."""
    discovered = _norm(payload.get("discovered_symbols") or [])
    observed = _norm(payload.get("observed_symbols") or [])
    training = _norm(payload.get("training_symbols") or [])
    paper = _norm(payload.get("paper_symbols") or [])
    explicit_blocked = _norm(payload.get("live_blocked_symbols") or [])
    # LIVE_BLOCKED is the union of every symbol the system knows about.
    # The explicit `live_blocked_symbols` list is a subset that has been
    # individually called out; the rest are covered by the HTTP default-deny
    # middleware. We union them so the bucket reflects total coverage.
    live_blocked = _norm(set(discovered) | set(training) | set(paper) | set(explicit_blocked))
    generated = str(payload.get("generated_at") or "")
    return SymbolCoverageBuckets(
        discovered=discovered,
        observed=observed,
        training=training,
        paper=paper,
        live_blocked=live_blocked,
        generated_utc=generated,
        source_payload_path=str(SYMBOL_UNIVERSE_PUBLIC_PAYLOAD),
    )


def load_buckets_from_disk(
    path: Optional[Path] = None,
) -> Optional[SymbolCoverageBuckets]:
    p = Path(path) if path else SYMBOL_UNIVERSE_PUBLIC_PAYLOAD
    if not p.is_file():
        return None
    try:
        payload = json.loads(p.read_text())
    except (OSError, json.JSONDecodeError):
        return None
    return load_buckets_from_payload(payload)


def evaluate_invariants(
    buckets: SymbolCoverageBuckets,
    *,
    force_train_all: bool = False,
    force_paper_all: bool = False,
    live_gate: str = LIVE_GATE_BLOCKED,
    live_symbols: Iterable[str] = (),
) -> list[InvariantFinding]:
    """Apply the disjoint-set invariants and return per-rule findings.

    A `False` finding is a violation that the operator must resolve before
    the runtime can be considered coverage-correct. The evaluator never
    mutates the buckets — it only reports.
    """
    findings: list[InvariantFinding] = []

    disc = set(buckets.discovered)
    obs = set(buckets.observed)
    train = set(buckets.training)
    paper = set(buckets.paper)
    blocked = set(buckets.live_blocked)

    # 1. OBSERVED subset of DISCOVERED
    missing = sorted(obs - disc)
    findings.append(
        InvariantFinding(
            invariant="OBSERVED_subset_of_DISCOVERED",
            satisfied=not missing,
            detail=(
                None
                if not missing
                else "observed symbols not in discovered universe"
            ),
            offending_symbols=tuple(missing),
        )
    )

    # 2. TRAINING subset of OBSERVED
    missing = sorted(train - obs)
    findings.append(
        InvariantFinding(
            invariant="TRAINING_subset_of_OBSERVED",
            satisfied=not missing,
            detail=(
                None
                if not missing
                else "training symbols without proven market observation"
            ),
            offending_symbols=tuple(missing),
        )
    )

    # 3. PAPER subset of OBSERVED
    missing = sorted(paper - obs)
    findings.append(
        InvariantFinding(
            invariant="PAPER_subset_of_OBSERVED",
            satisfied=not missing,
            detail=(
                None
                if not missing
                else "paper symbols without proven market observation"
            ),
            offending_symbols=tuple(missing),
        )
    )

    # 4. TRAINING != DISCOVERED unless force-train-all override
    auto_train_all = bool(disc) and train == disc and not force_train_all
    findings.append(
        InvariantFinding(
            invariant="TRAINING_not_equal_DISCOVERED_unless_force_train_all",
            satisfied=not auto_train_all,
            detail=(
                "training set equals discovered set without FORCE_TRAIN_ALL override"
                if auto_train_all
                else None
            ),
        )
    )

    # 5. PAPER != DISCOVERED unless force-paper-all override
    auto_paper_all = bool(disc) and paper == disc and not force_paper_all
    findings.append(
        InvariantFinding(
            invariant="PAPER_not_equal_DISCOVERED_unless_force_paper_all",
            satisfied=not auto_paper_all,
            detail=(
                "paper set equals discovered set without FORCE_PAPER_ALL override"
                if auto_paper_all
                else None
            ),
        )
    )

    # 6. LIVE_BLOCKED covers DISCOVERED
    not_blocked = sorted(disc - blocked)
    findings.append(
        InvariantFinding(
            invariant="LIVE_BLOCKED_covers_DISCOVERED",
            satisfied=not not_blocked,
            detail=(
                None
                if not not_blocked
                else "discovered symbols not represented in live_blocked union"
            ),
            offending_symbols=tuple(not_blocked),
        )
    )

    # 7. live_symbols == [] while live_gate == blocked_human_only
    live_set = _norm(live_symbols)
    live_blocked_default = live_gate == LIVE_GATE_BLOCKED
    findings.append(
        InvariantFinding(
            invariant="LIVE_SYMBOLS_empty_while_live_gate_blocked",
            satisfied=not (live_blocked_default and live_set),
            detail=(
                None
                if not (live_blocked_default and live_set)
                else "live_symbols non-empty while live gate is blocked"
            ),
            offending_symbols=live_set,
        )
    )

    return findings


def summarize(
    buckets: SymbolCoverageBuckets,
    findings: Iterable[InvariantFinding],
    *,
    live_gate: str = LIVE_GATE_BLOCKED,
) -> dict[str, Any]:
    """Operator-readable summary suitable for snapshot artifacts."""
    findings_list = list(findings)
    return {
        "schema_version": "v2_symbol_coverage_buckets_v1",
        "generated_utc": buckets.generated_utc,
        "source_payload_path": buckets.source_payload_path,
        "live_gate": live_gate,
        "live_symbols": [],
        "approves_live": False,
        "approves_canary": False,
        "approves_legacy_shutdown": False,
        "approves_redis_trim": False,
        "writes_old_redis": False,
        "writes_exchange_orders": False,
        "leverage_changed": False,
        "margin_mode_changed": False,
        "auto_enrolls_paper_symbols": False,
        "auto_enrolls_training_symbols": False,
        "trades_all_discovered_symbols": False,
        "trains_all_discovered_symbols": False,
        "buckets": {
            "discovered": list(buckets.discovered),
            "observed": list(buckets.observed),
            "training": list(buckets.training),
            "paper": list(buckets.paper),
            "live_blocked": list(buckets.live_blocked),
        },
        "bucket_counts": {
            "discovered": len(buckets.discovered),
            "observed": len(buckets.observed),
            "training": len(buckets.training),
            "paper": len(buckets.paper),
            "live_blocked": len(buckets.live_blocked),
        },
        "invariant_findings": [
            {
                "invariant": f.invariant,
                "satisfied": f.satisfied,
                "detail": f.detail,
                "offending_symbols": list(f.offending_symbols),
            }
            for f in findings_list
        ],
        "all_invariants_satisfied": all(f.satisfied for f in findings_list),
        "real_source_feeds": list(REAL_SOURCE_FEEDS),
        "placeholder_source_feeds": list(PLACEHOLDER_SOURCE_FEEDS),
    }
```
