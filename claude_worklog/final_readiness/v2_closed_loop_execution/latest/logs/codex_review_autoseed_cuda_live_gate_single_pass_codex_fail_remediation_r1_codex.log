   704	    def _dedup_check(self, source: str, src_id: str) -> bool:
   705	        key = f"{source}:{src_id}"
   706	        now_ms = self.now_ms()
   707	        # Sweep stale entries (cheap; the in-memory map is small).
   708	        ttl_ms = self._dedup_ttl_sec * 1000
   709	        for k in list(self._dedup_index.keys()):
   710	            if now_ms - self._dedup_index[k] > ttl_ms:
   711	                del self._dedup_index[k]
   712	        if key in self._dedup_index:
   713	            return False
   714	        self._dedup_index[key] = now_ms
   715	        # Persist a stable record in the V2 data plane.
   716	        self.data_plane[f"{V2_LIQUIDATIONS_PREFIX}:dedup_index"] = dict(self._dedup_index)
   717	        return True
