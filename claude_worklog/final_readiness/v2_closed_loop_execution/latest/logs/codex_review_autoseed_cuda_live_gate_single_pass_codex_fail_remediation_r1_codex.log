         ev = LiquidationEvent(
             ts=ts, symbol=symbol, side=side, price=price, qty=qty, notional=notional,
             source="binance",
             src_key="binance:force:raw",
             src_id=src_id,
             ingest_ts=self.now_ms(),
         )
         self._publish_event(ev)
         return ev
 
