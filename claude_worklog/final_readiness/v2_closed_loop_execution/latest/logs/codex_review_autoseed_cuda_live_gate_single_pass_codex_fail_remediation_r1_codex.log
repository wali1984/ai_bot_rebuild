   627	def parse_args(argv: Optional[List[str]] = None) -> argparse.Namespace:
   628	    parser = argparse.ArgumentParser(prog=WORKER_ID)
   629	    parser.add_argument("--symbols", nargs="*", default=None)
   630	    parser.add_argument("--smoke-test", action="store_true",
   631	                        help="opt in to the 3-symbol smoke-test set "
   632	                             "(never the production default)")
   633	    parser.add_argument("--tf", default="15m")
   634	    parser.add_argument("--interval", type=int, default=5)
   635	    parser.add_argument("--cycle-id-seed", type=int, default=1)
   636	    parser.add_argument("--coinank-history-days", type=int, default=30)
   637	    parser.add_argument("--enable-coinank-rest", action="store_true")
   638	    parser.add_argument(
   639	        "--no-v2-redis-features",
   640	        action="store_true",
   641	        help="Do not read V2 Redis feature/market keys as global-aggregator inputs.",
   642	    )
   643	    parser.add_argument(
   644	        "--write-v2-redis",
   645	        action="store_true",
   646	        help="Write global aggregate mirrors to V2-prefixed Redis keys only.",
   647	    )
   648	    parser.add_argument("--v2-redis-ttl-seconds", type=int, default=600)
   649	    parser.add_argument("--once", action="store_true")
   650	    parser.add_argument("--loop", action="store_true")
   651	    parser.add_argument("--no-write", action="store_true")
   652	    parser.add_argument("--verify-baseline-shas", action="store_true")
   653	    args = parser.parse_args(argv)
   654	    if not args.loop and not args.once:
   655	        args.once = True
   656	    return args
   657	
   658	
   659	def main(argv: Optional[List[str]] = None) -> int:
   660	    args = parse_args(argv)
   661	    if args.verify_baseline_shas:
   662	        report = verify_baseline_shas()
   663	        print(json.dumps(report, indent=2, sort_keys=True))
   664	        return 0 if report["ok"] else 2
   665	    if args.once:
   666	        run_once(args)
   667	        return 0
   668	    while True:
   669	        try:
   670	            run_once(args)
   671	        except KeyboardInterrupt:
   672	            return 0
   673	        except Exception:
   674	            pass
   675	        time.sleep(max(1, int(args.interval)))
   676	
   677	
   678	if __name__ == "__main__":
   679	    sys.exit(main())

