         "close": _safe_float(item.get("price_close")),
         "volume": _safe_float(item.get("volume_traded")),
         "source": "coinapi_v1",
     }
 
 
 def _safe_float(value: Any) -> Optional[float]:
     if value is None:
         return None
     try:
         return float(value)
     except Exception:
         return None
 
 
