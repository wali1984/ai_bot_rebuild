   208	def _redis_hgetall(redis_client: Any, key: str) -> Dict[str, Any]:
   209	    if redis_client is None or not key.startswith(V2_REDIS_PREFIX):
   210	        return {}
   211	    try:
   212	        data = redis_client.hgetall(key) or {}
   213	    except Exception:
   214	        return {}
   215	    return dict(data) if isinstance(data, dict) else {}
