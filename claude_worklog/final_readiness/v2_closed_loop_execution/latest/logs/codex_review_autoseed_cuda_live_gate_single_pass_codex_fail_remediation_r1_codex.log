 def _content_hash(payload: Dict[str, Any]) -> str:
     return hashlib.sha256(
         json.dumps(payload, sort_keys=True, default=str).encode("utf-8")
     ).hexdigest()[:16]
 
 
 def build_fail_closed_status(
     *,
     reason: str,
     source_payload_path: str,
