   182	def _safe_redis_set_json(redis_client: Any, key: str, payload: Mapping[str, Any], *, ex: int = 600) -> bool:
   183	    if redis_client is None:
   184	        return False
   185	    if not key.startswith(V2_REDIS_PREFIX):
   186	        raise ValueError(f"refused non-V2 Redis key: {key!r}")
   187	    setter = getattr(redis_client, "set")
   188	    setter(key, json.dumps(dict(payload), sort_keys=True, default=str), ex=int(ex))
   189	    return True
   190	
   191	
   192	def _redis_get_json(redis_client: Any, key: str) -> Optional[Dict[str, Any]]:
   193	    if redis_client is None or not key.startswith(V2_REDIS_PREFIX):
   194	        return None
   195	    try:
   196	        raw = redis_client.get(key)
   197	    except Exception:
   198	        return None
   199	    if not raw:
   200	        return None
   201	    try:
   202	        data = json.loads(raw)
   203	    except Exception:
   204	        return None
   205	    return data if isinstance(data, dict) else None
   206	
