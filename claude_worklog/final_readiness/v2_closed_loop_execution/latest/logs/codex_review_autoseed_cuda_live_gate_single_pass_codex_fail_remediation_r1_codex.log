"""`/ingestors/` — native V2 ingestor status and safe service controls.

The control surface is intentionally allowlisted to data/feature/altdata
ingestor services. It cannot control the trader, canary executor, leverage,
margin, model training, or order placement.
"""

from __future__ import annotations

import json
import subprocess
from pathlib import Path
from typing import Any, Literal

from fastapi import APIRouter, HTTPException
from pydantic import BaseModel

router = APIRouter(prefix="/ingestors", tags=["ingestors"])

STATUS_PATH = Path(
    "v2/frontend/public/operator_runtime/v2_ingestors_status/latest/v2_ingestors_status.json"
)

ALLOWED_INGESTOR_SERVICES: dict[str, dict[str, Any]] = {
    "ai-bot-v2-native-ingestors-live-loop.service": {
