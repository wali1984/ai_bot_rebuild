    if audit_rows:
        blockers_simple.append("V2 is not fully migrated yet. The trainer, RL environment, feature pipeline, ingestors, orchestrator arbitration, and exit engines are missing or bridge-only.")
    if "EDGE_PENDING" in str(paper_edge_status):
        blockers_simple.append("Paper edge has not proven it can beat fees.")
    if "BLOCKS_LEGACY_SHUTDOWN" in str(trainer_parity_status):
        blockers_simple.append("Trainer runtime is online, but full legacy shutdown parity is still not claimed.")
    if shutdown_rec and "BLOCK_LEGACY_SHUTDOWN" in shutdown_rec:
        blockers_simple.append("Legacy shutdown is blocked until parity is proven.")
    if router and router.get("routing", {}).get("p0_blockers_remaining", 0) > 0:
        blockers_simple.append("There are P0 runtime blockers still open.")
    if native_core.get("codex_go_no_go") == "V2_NATIVE_ALGORITHMIC_CORE_MIGRATION_CODEX_FAIL":
        blockers_simple.append("Native algorithmic core migration is not complete.")
    if (native_sprint.get("go_no_go") or native_sprint.get("codex_go_no_go")) in {
        "V2_NATIVE_CORE_P0_TRUE_MIGRATION_SPRINT_BLOCKED",
        "V2_NATIVE_CORE_P0_TRUE_MIGRATION_CODEX_FAIL",
    }:
        blockers_simple.append("The true native-core P0 sprint is still blocked: feature pipeline, RL/MASA/PPO, orchestrator arbitration, trade management, and ingestor proof are not complete.")
    if zero_miss.get("codex_go_no_go") == "ZERO_MISS_LEGACY_CORE_TO_V2_CODEX_FAIL":
        blockers_simple.append("Zero-miss legacy core lift failed Codex review: copied runtime coverage, dependency closure, parse validation, and atlas evidence are not complete.")
    if not expected_move_review_current:
        blockers_simple.append(
            "Expected-move review is behind the latest shadow outcomes; keep the strict gate until a fresh review passes."
        )

    blockers_technical = []
    selected = (router or {}).get("routing", {}).get("selected_blocker") or {}
    if selected:
        blockers_technical.append({
            "id": selected.get("id"),
            "category": selected.get("category"),
            "remediation_task_id": selected.get("remediation_task_id"),
            "source": selected.get("source"),
            "evidence": selected.get("evidence"),
        })
    if not expected_move_review_current:
        blockers_technical.append({
            "id": "EXPECTED_MOVE_MODEL_REVIEW_STALE_AGAINST_SHADOW_OUTCOMES",
            "category": "P0_SHUTDOWN_BLOCKER",
