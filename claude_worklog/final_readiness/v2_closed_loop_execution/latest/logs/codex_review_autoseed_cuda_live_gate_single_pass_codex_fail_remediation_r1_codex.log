   405	def write_status(status: Dict[str, Any], data_plane: Dict[str, Any]) -> None:
   406	    PUBLIC_RUNTIME_DIR.mkdir(parents=True, exist_ok=True)
   407	    LOCAL_RUNTIME_DIR.mkdir(parents=True, exist_ok=True)
