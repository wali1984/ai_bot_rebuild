    PLAN3_INTERVAL_LIMITS,
    REQUIRED_COINANK_TFS,
    STALENESS_STALE_MS,
    V2_COINANK_PREFIX,
    V2_LIQUIDATIONS_PREFIX,
)


REQUIRED_PUBLIC_PAYLOAD_FIELDS: tuple = (
    "worker_id",
    "last_run_ts",
    "liquidations_persisted_total",
    "funding_freshness",
    "oi_freshness",
