            "native_algorithmic_core_migration": "v2/frontend/public/native_algorithmic_core_migration/latest/operator_dashboard_payload.json",
            "native_core_p0_true_migration_sprint": "v2/frontend/public/v2_native_core_p0_true_migration_sprint/latest/operator_dashboard_payload.json",
            "zero_miss_legacy_core_lift": "v2/frontend/public/zero_miss_legacy_core_lift/latest/operator_dashboard_payload.json",
            "audit_source_doc": "migration-audit.md",
        },
    }


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(description="Frontend truth payload builder")
    p.add_argument("--dry-run", action="store_true", help="Print payload without writing.")
    p.add_argument("--out", type=Path, default=OUTPUT_PATH, help="Output path override.")
    args = p.parse_args(argv)

    payload = build_payload()

    if args.dry_run:
        print(json.dumps(payload, indent=2, sort_keys=True))
        return 0

    args.out.parent.mkdir(parents=True, exist_ok=True)
    args.out.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")
    print(f"frontend_truth_payload_written path={args.out} live_gate={payload['live_gate']}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

