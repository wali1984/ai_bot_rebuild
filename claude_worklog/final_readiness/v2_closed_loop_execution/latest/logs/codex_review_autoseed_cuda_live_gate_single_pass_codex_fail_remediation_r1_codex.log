        result: Dict[str, Any] = {
            "symbol": symbol,
            "primary": "binance_rest",
            "fallback": "coinank_deferred_to_next_worker",
            "v2_key": key,
            "status": "pending",
        }
        if self._blocked_by_backoff(result):
            return result
        status, payload = self._http_get(
            f"https://fapi.binance.com/fapi/v1/openInterest?symbol={symbol}"
        )
        if not self._public_http_ok(status, payload, result):
            return result
        if not isinstance(payload, dict):
            result["status"] = "unexpected_payload"
            return result
        self.data_plane[key] = {
            "symbol": symbol,
            "open_interest": _safe_float(payload.get("openInterest")),
            "ts_ms": int(payload.get("time") or self._clock() * 1000),
            "source": "binance_rest",
        }
        result["status"] = "ok"
        result["persisted"] = True
        return result

    def ingest_long_short_ratio(
        self,
        symbol: str,
        *,
        period: str = "5m",
        limit: int = 1,
    ) -> Dict[str, Any]:
        """Ingest public Binance global long/short account ratio.

        The endpoint is public/keyless. If Binance returns a non-list error
        payload (for example a restricted-location message), the method records
        the blocker and writes no neutral fallback value.
        """
        key = f"{V2_KEY_PREFIX}:{symbol}:long_short"
        result: Dict[str, Any] = {
            "symbol": symbol,
            "primary": "binance_rest",
            "fallback": "coinank_deferred_to_next_worker",
            "period": period,
            "limit": int(limit),
            "v2_key": key,
            "status": "pending",
        }
        if self._blocked_by_backoff(result):
            return result
        status, payload = self._http_get(
            "https://fapi.binance.com/futures/data/globalLongShortAccountRatio?"
            f"symbol={symbol}&period={period}&limit={int(limit)}"
        )
        if not self._public_http_ok(status, payload, result):
            return result
        if isinstance(payload, dict) and payload.get("code") is not None:
            result["status"] = "binance_error_payload"
            result["binance_code"] = payload.get("code")
            result["binance_msg"] = str(payload.get("msg") or "")[:240]
            if "restricted location" in result["binance_msg"].lower():
                result["status"] = "geo_or_terms_restricted"
            return result
        if not isinstance(payload, list) or not payload or not isinstance(payload[-1], dict):
            result["status"] = "unexpected_payload"
            return result
        row = payload[-1]
        self.data_plane[key] = {
            "symbol": str(row.get("symbol") or symbol).upper(),
            "period": period,
            "longShortRatio": row.get("longShortRatio"),
            "longAccount": row.get("longAccount"),
            "shortAccount": row.get("shortAccount"),
            "timestamp": _safe_int(row.get("timestamp")),
            "long_short_ratio": _safe_float(row.get("longShortRatio")),
            "long_account_ratio": _safe_float(row.get("longAccount")),
            "short_account_ratio": _safe_float(row.get("shortAccount")),
            "source": "binance_global_long_short_account_ratio",
        }
        result["status"] = "ok"
        result["persisted"] = True
        return result


