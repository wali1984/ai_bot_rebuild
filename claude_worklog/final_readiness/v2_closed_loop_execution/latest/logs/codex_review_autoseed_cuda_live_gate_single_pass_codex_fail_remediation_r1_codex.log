 def _bool_with_default(value: Any, default: bool = False) -> bool:
     if value is None:
         return default
     if isinstance(value, bool):
         return value
     if isinstance(value, str):
         text = value.strip().lower()
         if text in {"true", "1", "yes", "y"}:
             return True
         if text in {"false", "0", "no", "n"}:
             return False
     return bool(value)
 
 
