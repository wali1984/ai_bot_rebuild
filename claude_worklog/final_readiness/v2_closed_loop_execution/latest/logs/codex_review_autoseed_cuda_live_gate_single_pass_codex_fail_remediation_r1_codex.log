   280	        "paper_all_discovered_symbols": set(paper) >= set(discovered) if discovered else False,
   281	        "trade_all_discovered_symbols": False,
   282	        "symbol_scope_policy": "train_and_paper_monitor_all_dynamic_discovered_symbols_live_execution_remains_blocked",
   283	        "symbol_selection_score_factors": list(SYMBOL_SELECTION_SCORE_FACTORS),
   284	    }
   285	
   286	
   287	def write_payload(payload: Mapping[str, Any]) -> None:
   288	    for directory in (PUBLIC_DIR, LOCAL_DIR, FINAL_DIR):
   289	        _write_json(directory / PAYLOAD_NAME, payload)
   290	
   291	
   292	def main(argv: list[str] | None = None) -> int:
   293	    parser = argparse.ArgumentParser(description="Publish the V2 Symbol Universe public payload.")
   294	    parser.add_argument("--write", action="store_true")
   295	    args = parser.parse_args(argv)
   296	    payload = build_payload()
   297	    if args.write:
   298	        write_payload(payload)
   299	    print(json.dumps(payload, indent=2, sort_keys=True))
   300	    return 0
   301	
   302	
   303	if __name__ == "__main__":
   304	    raise SystemExit(main())

