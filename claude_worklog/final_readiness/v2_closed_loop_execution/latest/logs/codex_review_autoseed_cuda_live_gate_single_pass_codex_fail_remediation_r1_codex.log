   227	def _merge_feature_snapshot(target: Dict[str, Any], snapshot: Mapping[str, Any], tf: str) -> None:
   228	    features = snapshot.get("features")
   229	    if not isinstance(features, dict):
   230	        return
   231	    target.update(features)
   232	    if "rsi_14" in features:
   233	        target.setdefault(f"ind_ta_RSI_14_{tf}", features.get("rsi_14"))
   234	    if "htf_rsi_14" in features:
   235	        target.setdefault("ind_ta_RSI_21_15m", features.get("htf_rsi_14"))
   236	    price = _safe_float(features.get("micro_price"))
   237	    atr = _safe_float(features.get("atr_14"))
   238	    if price and atr is not None:
   239	        target.setdefault(f"ind_ta_NATR_28_{tf}", (atr / price) if price else 0.0)
   240	    if "funding_rate" in features:
   241	        target.setdefault("funding_rate", features.get("funding_rate"))
