     args.out.parent.mkdir(parents=True, exist_ok=True)
     args.out.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")
     print(f"frontend_truth_payload_written path={args.out} live_gate={payload['live_gate']}")
