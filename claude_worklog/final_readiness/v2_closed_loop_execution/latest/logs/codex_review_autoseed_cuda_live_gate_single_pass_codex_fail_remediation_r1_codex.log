 def _freshness_seconds(ts_ms: Optional[int]) -> int:
     if not ts_ms:
         return -1
     try:
         now_ms = int(time.time() * 1000)
         return max(0, int((now_ms - int(ts_ms)) / 1000))
     except Exception:
         return -1
 
 
