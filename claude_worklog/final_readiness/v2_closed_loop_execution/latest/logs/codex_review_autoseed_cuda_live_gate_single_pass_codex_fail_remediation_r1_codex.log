   519	def verify_baseline_shas(manifest_path: Path = COPIED_BASELINE_MANIFEST) -> Dict[str, Any]:
   520	    """Verify each baseline file we depend on has a SHA matching
   521	    ``LEGACY_BASELINE_SHA256`` against the copied_baseline_manifest.json.
   522	    """
   523	    result: Dict[str, Any] = {"checked": [], "mismatches": [], "ok": True}
   524	    try:
   525	        manifest = json.loads(manifest_path.read_text())
   526	    except Exception as exc:
   527	        return {"checked": [], "mismatches": [], "ok": False, "error": f"manifest_load_failed: {exc}"}
   528	    by_path: Dict[str, str] = {}
   529	    for record in manifest.get("records", []):
   530	        v2_path = record.get("v2_preserved_path")
   531	        sha = record.get("sha256")
   532	        if v2_path and sha:
   533	            by_path[v2_path] = sha
   534	    for v2_path, expected in LEGACY_BASELINE_SHA256.items():
   535	        actual = by_path.get(v2_path)
   536	        result["checked"].append({"path": v2_path, "expected": expected, "actual": actual})
   537	        if actual != expected:
   538	            result["mismatches"].append({"path": v2_path, "expected": expected, "actual": actual})
   539	            result["ok"] = False
   540	    return result
