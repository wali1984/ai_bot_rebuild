   156	def _connect_redis():
   157	    """Best-effort Redis connector used only when explicit V2 Redis flags run.
   158	
   159	    The worker keeps imports lazy so normal module import and tests remain
   160	    offline-safe. All mutation paths route through ``_safe_redis_set_json``.
   161	    """
   162	    try:
   163	        import redis  # type: ignore
   164	    except Exception:
   165	        return None
   166	    try:
   167	        redis_factory = getattr(redis, "Redis")
   168	        client = redis_factory(
   169	            host="127.0.0.1",
   170	            port=6379,
   171	            db=0,
   172	            decode_responses=True,
   173	            socket_connect_timeout=2,
   174	            socket_timeout=3,
   175	        )
   176	        client.ping()
   177	        return client
   178	    except Exception:
   179	        return None
