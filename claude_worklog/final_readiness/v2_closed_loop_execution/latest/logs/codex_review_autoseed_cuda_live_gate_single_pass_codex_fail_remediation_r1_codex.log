         "live_gate": LIVE_GATE_BLOCKED,
         "live_symbols": [],
         "approves_live": False,
         "approves_canary": False,
         "approves_legacy_shutdown": False,
         "approves_redis_trim": False,
         "bundles_total": bundles_total,
         "dataset_total_rows": len(dataset["rows"]),
         "train_rows": len(dataset["train_rows"]),
