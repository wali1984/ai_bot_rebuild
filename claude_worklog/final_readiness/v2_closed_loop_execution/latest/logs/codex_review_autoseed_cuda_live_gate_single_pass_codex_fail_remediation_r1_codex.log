            "why_it_matters": "User pages must consume V2 payloads only, never legacy Redis directly.",
            "what_needs_to_happen_next": "n/a",
            "evidence_paths": [
                "v2/frontend/public/operator_runtime/symbol_universe/latest/symbol_universe_status.json",
            ],
