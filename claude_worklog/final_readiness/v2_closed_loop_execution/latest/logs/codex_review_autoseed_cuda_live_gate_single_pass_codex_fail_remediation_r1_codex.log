   136	def _review_current_enough(*, reviewed: int, current: int) -> bool:
   137	    if current <= reviewed:
   138	        return True
   139	    drift = current - reviewed
   140	    tolerance = max(10, int(max(reviewed, 1) * 0.25))
   141	    return drift <= tolerance
