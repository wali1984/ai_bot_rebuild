   418	def _fetch_coinank_liquidation_orders(
   419	    fetcher,
   420	    *,
   421	    days_back: int,
   422	    record_blocker,
   423	) -> List[Dict[str, Any]]:
   424	    """Attempt a public CoinAnk Plan-3 liquidation_orders fetch. If the
   425	    endpoint is not reachable without credentials (the typical case in V2
   426	    REST-without-API-key mode), we label a missing_api_blocker and return
   427	    an empty list. We NEVER synthesize events.
   428	    """
   429	    url = "https://open-api.coinank.com/api/liquidation/orders"
   430	    try:
   431	        status, body = fetcher(url)
   432	    except Exception as exc:
   433	        record_blocker(
   434	            "coinank_liquidation_orders_endpoint_unreachable",
   435	            f"fetcher raised: {exc!r}",
   436	        )
   437	        return []
   438	    if not (200 <= int(status) < 300) or not isinstance(body, dict):
   439	        record_blocker(
   440	            "coinank_liquidation_orders_endpoint_unreachable",
   441	            f"http_status={status}",
   442	        )
   443	        return []
   444	    data = body.get("data") or {}
   445	    items = data.get("data") if isinstance(data, dict) else None
   446	    if not isinstance(items, list):
   447	        record_blocker(
   448	            "coinank_endpoint_no_current_key",
   449	            "liquidation_orders response had no data.data list",
   450	        )
   451	        return []
   452	    return items
