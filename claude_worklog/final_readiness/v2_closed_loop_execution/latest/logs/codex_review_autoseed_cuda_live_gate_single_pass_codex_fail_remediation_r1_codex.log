    BINANCE_WS = ("binance_ws", 2)
    BINANCE_REST = ("binance_rest", 3)
    CCXT_REST = ("ccxt_rest", 4)
    KUCOIN_REST = ("kucoin_rest", 5)
    REDIS_CACHE = ("redis_cache", 99)

    @property
    def label(self) -> str:
        return self.value[0]

    @property
