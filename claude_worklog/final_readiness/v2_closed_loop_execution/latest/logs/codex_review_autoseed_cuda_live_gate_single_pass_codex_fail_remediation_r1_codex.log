 def _resolve_source_path(path_or_paths: Path | tuple[Path, ...]) -> Path:
     if isinstance(path_or_paths, tuple):
         for candidate in path_or_paths:
             if candidate.exists():
                 return candidate
         return path_or_paths[0]
     return path_or_paths
 
 
 def _read_json(path: Path) -> Any:
