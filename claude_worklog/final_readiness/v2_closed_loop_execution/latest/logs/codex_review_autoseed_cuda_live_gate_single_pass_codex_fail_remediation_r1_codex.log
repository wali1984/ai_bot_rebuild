     decision_dict: Optional[Dict[str, Any]],
     symbol_scope: Dict[str, Any],
     missing_runtime_evidence: bool,
 ) -> Dict[str, Any]:
     decision_symbol = ""
     risk_decision_id = ""
     input_risk_action = ""
     input_risk_reason_code = ""
     risk_decision_ts_ms: Optional[int] = None
     if decision_dict:
         decision_symbol = str(decision_dict.get("symbol", "")).upper()
