    97	def load_sources() -> tuple[dict[str, Any], dict[str, str], list[str], list[str]]:
    98	    """Return (payloads, status_per_source, stale_payloads, missing_payloads)."""
    99	    payloads: dict[str, Any] = {}
   100	    status: dict[str, str] = {}
   101	    stale: list[str] = []
   102	    missing: list[str] = []
   103	
   104	    for key, path_or_paths in SOURCES.items():
   105	        path = _resolve_source_path(path_or_paths)
   106	        data = _read_json(path)
   107	        age = _payload_age_seconds(path)
   108	        if data is None:
   109	            payloads[key] = None
   110	            status[key] = "MISSING_EVIDENCE"
   111	            missing.append(key)
   112	            continue
   113	        payloads[key] = data
   114	        if age is not None and age > STALE_AFTER_SECONDS:
   115	            status[key] = "STALE"
   116	            stale.append(key)
   117	        else:
   118	            status[key] = "FRESH"
   119	
   120	    return payloads, status, stale, missing
