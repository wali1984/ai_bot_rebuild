         return None
     try:
         return json.loads(path.read_text())
     except Exception:
         return None
 
 
 def _payload_age_seconds(path: Path) -> int | None:
     if not path.exists():
         return None
     try:
         mtime = dt.datetime.fromtimestamp(path.stat().st_mtime, tz=dt.timezone.utc)
         return int((_utc_now() - mtime).total_seconds())
     except Exception:
