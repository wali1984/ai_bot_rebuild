   581	def main(argv: list[str] | None = None) -> int:
   582	    p = argparse.ArgumentParser(description="Frontend truth payload builder")
   583	    p.add_argument("--dry-run", action="store_true", help="Print payload without writing.")
   584	    p.add_argument("--out", type=Path, default=OUTPUT_PATH, help="Output path override.")
   585	    args = p.parse_args(argv)
   586	
   587	    payload = build_payload()
   588	
   589	    if args.dry_run:
   590	        print(json.dumps(payload, indent=2, sort_keys=True))
   591	        return 0
   592	
   593	    args.out.parent.mkdir(parents=True, exist_ok=True)
   594	    args.out.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")
   595	    print(f"frontend_truth_payload_written path={args.out} live_gate={payload['live_gate']}")
   596	    return 0
