"""`/ingestors/` — native V2 ingestor status and safe service controls.

The control surface is intentionally allowlisted to data/feature/altdata
ingestor services. It cannot control the trader, canary executor, leverage,
margin, model training, or order placement.
"""

from __future__ import annotations

import json
import subprocess
from pathlib import Path
from typing import Any, Literal

from fastapi import APIRouter, HTTPException
from pydantic import BaseModel

router = APIRouter(prefix="/ingestors", tags=["ingestors"])

STATUS_PATH = Path(
    "v2/frontend/public/operator_runtime/v2_ingestors_status/latest/v2_ingestors_status.json"
)

ALLOWED_INGESTOR_SERVICES: dict[str, dict[str, Any]] = {
    "ai-bot-v2-native-ingestors-live-loop.service": {
        "label": "Binance USDM native ingestor",
        "kind": "market_data",
    },
    "ai-bot-v2-feature-pipeline-native-loop.service": {
        "label": "Native feature pipeline",
        "kind": "feature_pipeline",
    },
    "ai-bot-v2-full-talib-ta-loop.service": {
        "label": "Full TA-Lib compatibility loop",
        "kind": "technical_analysis",
    },
    "ai-bot-v2-kucoin-public-rest-loop.service": {
        "label": "KuCoin native public REST",
        "kind": "market_data",
    },
    "ai-bot-v2-coinapi-rest-fallback-loop.service": {
        "label": "CoinAPI native REST/OHLCV",
        "kind": "market_data",
    },
    "ai-bot-v2-coinank-global-bridge-loop.service": {
        "label": "CoinAnk global bridge",
        "kind": "altdata",
    },
    "ai-bot-v2-liquidation-wss-paper-shadow.service": {
        "label": "Liquidation WSS paper-shadow client",
        "kind": "liquidations",
    },
    "ai-bot-v2-liquidation-levels-engine.service": {
        "label": "Native liquidation levels engine",
        "kind": "liquidations",
    },
    "ai-bot-v2-nansen-altdata-loop.service": {
        "label": "Nansen altdata ingestor",
        "kind": "altdata",
    },
    "ai-bot-v2-lunarcrush-altdata-loop.service": {
        "label": "LunarCrush altdata ingestor",
        "kind": "altdata",
    },
    "ai-bot-v2-public-intel-free-tier-loop.service": {
        "label": "Public intel free-tier ingestor",
        "kind": "altdata",
    },
    "ai-bot-v2-aicoin-whale-intel-loop.service": {
        "label": "AICoin + whale-wall free-tier intel",
        "kind": "altdata",
    },
    "ai-bot-v2-alt-data-symbol-scoring-loop.service": {
        "label": "Alt-data symbol scoring",
        "kind": "altdata",
    },
    "ai-bot-v2-alt-data-candidate-publisher-loop.service": {
        "label": "Alt-data candidate publisher",
        "kind": "altdata",
    },
    "ai-bot-v2-alternative-data-status-loop.service": {
        "label": "Alternative-data provider registry status",
        "kind": "altdata",
    },
    "ai-bot-v2-dynamic-symbol-discovery-loop.service": {
        "label": "Dynamic symbol discovery",
        "kind": "symbol_universe",
    },
    "ai-bot-v2-ingestors-status-publisher.service": {
        "label": "Ingestor status publisher",
        "kind": "status_publisher",
    },
}

BLOCKED_CONTROL_TARGET_TERMS = (
    "trader",
    "canary",
    "executor",
    "execution",
    "order",
    "leverage",
    "margin",
    "trainer",
    "hybrid",
)

ROUTE_METADATA: dict[str, Any] = {
    "group": "ingestors",
    "prefix": "/ingestors",
    "endpoints": ("/", "/{service_id}", "/{service_id}/control"),
    "rbac": "admin",
    "milestone_d_status": "native_v2_safe_controls",
    "allowed_actions": ("status", "start", "stop", "restart"),
    "blocked_targets": BLOCKED_CONTROL_TARGET_TERMS,
    "live_order_capable": False,
}


class IngestorControlRequest(BaseModel):
    action: Literal["status", "start", "stop", "restart"]


def _load_status_payload() -> dict[str, Any]:
    try:
        return json.loads(STATUS_PATH.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {
            "classification": "INGESTORS_STATUS_PAYLOAD_MISSING",
            "path": str(STATUS_PATH),
            "ingestors": [],
        }


def _assert_allowed_service(service_id: str) -> None:
    lowered = service_id.lower()
    if any(term in lowered for term in BLOCKED_CONTROL_TARGET_TERMS):
        raise HTTPException(
            status_code=403,
            detail={
                "error": "blocked_control_target",
                "service_id": service_id,
                "live_gate": "blocked_human_only",
            },
        )
    if service_id not in ALLOWED_INGESTOR_SERVICES:
        raise HTTPException(
            status_code=404,
            detail={
                "error": "unknown_or_not_allowlisted_ingestor_service",
                "service_id": service_id,
            },
        )


def _systemctl(args: list[str]) -> dict[str, Any]:
    proc = subprocess.run(
        ["systemctl", "--user", "--no-pager", *args],
        check=False,
        text=True,
        capture_output=True,
        timeout=20,
    )
    return {
        "returncode": proc.returncode,
        "stdout": proc.stdout[-4000:],
        "stderr": proc.stderr[-4000:],
    }


def _service_state(service_id: str) -> dict[str, Any]:
    active = _systemctl(["is-active", service_id])
    enabled = _systemctl(["is-enabled", service_id])
    return {
        "service_id": service_id,
        "metadata": ALLOWED_INGESTOR_SERVICES[service_id],
        "active_state": active["stdout"].strip() or "unknown",
        "enabled_state": enabled["stdout"].strip() or "unknown",
        "active_returncode": active["returncode"],
        "enabled_returncode": enabled["returncode"],
        "runtime_mode": "LIVE_DATA_AND_LIVE_DECISION_INPUTS_TRADER_EXECUTION_DISABLED",
        "live_gate": "blocked_human_only",
        "trader_execution_enabled": False,
        "exchange_order_controls_available": False,
    }


@router.options("/", include_in_schema=False)
async def _route_metadata() -> dict[str, Any]:
    return ROUTE_METADATA


@router.get("/")
async def list_ingestors() -> dict[str, Any]:
    payload = _load_status_payload()
    services = {
        service_id: _service_state(service_id)
        for service_id in ALLOWED_INGESTOR_SERVICES
    }
    return {
        "schema_version": "v2_ingestors_api_status_v1",
        "payload": payload,
        "services": services,
        "allowed_actions": ["status", "start", "stop", "restart"],
        "blocked_actions": [
            "place_order",
            "cancel_order",
            "enable_trader",
            "enable_canary",
            "change_leverage",
            "change_margin",
            "modify_trainer",
        ],
    }


@router.get("/{service_id}")
async def get_ingestor(service_id: str) -> dict[str, Any]:
    _assert_allowed_service(service_id)
    return _service_state(service_id)


@router.post("/{service_id}/control")
async def control_ingestor(
    service_id: str,
    request: IngestorControlRequest,
) -> dict[str, Any]:
    _assert_allowed_service(service_id)
    if request.action == "status":
        result = _systemctl(["status", service_id])
    else:
        result = _systemctl([request.action, service_id])
    return {
        "schema_version": "v2_ingestor_control_result_v1",
        "service_id": service_id,
        "action": request.action,
        "systemctl": result,
        "state": _service_state(service_id),
        "live_gate": "blocked_human_only",
        "trader_execution_enabled": False,
        "exchange_action_taken": False,
    }

