    62	STALE_AFTER_SECONDS = 24 * 60 * 60  # 24h
    63	
    64	
    65	def _utc_now() -> dt.datetime:
    66	    return dt.datetime.now(dt.timezone.utc)
    67	
    68	
    69	def _resolve_source_path(path_or_paths: Path | tuple[Path, ...]) -> Path:
    70	    if isinstance(path_or_paths, tuple):
    71	        for candidate in path_or_paths:
    72	            if candidate.exists():
    73	                return candidate
    74	        return path_or_paths[0]
    75	    return path_or_paths
    76	
    77	
    78	def _read_json(path: Path) -> Any:
    79	    if not path.exists():
    80	        return None
    81	    try:
    82	        return json.loads(path.read_text())
    83	    except Exception:
    84	        return None
    85	
    86	
    87	def _payload_age_seconds(path: Path) -> int | None:
    88	    if not path.exists():
    89	        return None
    90	    try:
    91	        mtime = dt.datetime.fromtimestamp(path.stat().st_mtime, tz=dt.timezone.utc)
    92	        return int((_utc_now() - mtime).total_seconds())
    93	    except Exception:
    94	        return None
