import { useEffect, useState } from 'react';

export interface PayloadFileResult<T> {
  data: T | null;
  error: string | null;
  ageSeconds: number | null;
  loading: boolean;
}

/** Poll any static JSON file under /operator_runtime/ at a given interval. */
export function usePayloadFile<T>(
  path: string,
  intervalMs = 10_000,
): PayloadFileResult<T> {
  const [data, setData] = useState<T | null>(null);
  const [error, setError] = useState<string | null>(null);
  const [ageSeconds, setAgeSeconds] = useState<number | null>(null);
  const [loading, setLoading] = useState<boolean>(true);

  useEffect(() => {
    let active = true;
    let timer: number | undefined;

    const load = (): void => {
      const freshPath = new URL(path, window.location.origin);
      freshPath.searchParams.set('_rt', String(Date.now()));
      fetch(freshPath.toString(), {
        cache: 'no-store',
        headers: {
          Accept: 'application/json',
          'Cache-Control': 'no-cache',
          Pragma: 'no-cache',
        },
      })
        .then((r) => {
          if (!r.ok) throw new Error(`HTTP ${r.status}`);
          return r.json() as Promise<T>;
        })
        .then((d) => {
          if (!active) return;
          setData(d);
          setError(null);
          setLoading(false);
          const gen = (d as Record<string, unknown>).generated_at ?? (d as Record<string, unknown>).generated_utc;
          if (typeof gen === 'string') {
            const ms = new Date(gen).getTime();
            const age = isNaN(ms) ? null : Math.max(0, Math.round((Date.now() - ms) / 1000));
            setAgeSeconds(age);
          } else {
            setAgeSeconds(null);
          }
        })
        .catch((e: unknown) => {
          if (!active) return;
          setError(e instanceof Error ? e.message : String(e));
          setLoading(false);
        });
    };

    load();
    if (intervalMs > 0) {
      timer = window.setInterval(load, intervalMs);
    }
    return () => {
      active = false;
      if (timer !== undefined) window.clearInterval(timer);
    };
  }, [path, intervalMs]);

  return { data, error, ageSeconds, loading };
}

/** Format seconds into a human-readable age string. */
export function fmtAge(s: number | null): string {
  if (s === null) return '—';
  if (s < 60) return `${s}s ago`;
  if (s < 3600) return `${Math.floor(s / 60)}m ago`;
  if (s < 86400) return `${Math.floor(s / 3600)}h ago`;
  return `${Math.floor(s / 86400)}d ago`;
}

/** Return a CSS class suffix based on age. */
export function ageClass(s: number | null, staleThreshold = 120): 'ok' | 'warn' | 'block' {
  if (s === null) return 'block';
  if (s > staleThreshold * 10) return 'block';
  if (s > staleThreshold) return 'warn';
  return 'ok';
}

