+import { Panel, Metric } from '../cockpitComponents';
+import { usePayloadFile, fmtAge, ageClass } from '../../hooks/usePayloadFile';
+
+const TRAINER_REC_PATH = '/operator_runtime/paper_online/latest/trainer_prediction_current_record.json';
+const TRAINER_BRIDGE_PATH = '/operator_runtime/v2_trainer_bridge/latest/v2_trainer_bridge_status.json';
+const RISK_DECISIONS_PATH = '/operator_runtime/paper_online/latest/current_risk_decisions.json';
+
+interface TrainerRecord {
+  generated_at: string;
+  prediction_id: string;
+  confidence_calibrated: number;
+  confidence_raw: number;
+  expected_move_bps: number;
+  freshness_state: string;
+  model_checkpoint: string;
+  model_version: string;
+  market_age_seconds: number;
+  raw_output?: {
+    cross_timeframe_expected_move: boolean;
+    expected_move_bps: number;
+    timeframe_alignment_score?: number;
+    top_feature_contributions?: Record<string, number>;
+  };
+}
+
+interface TrainerBridge {
+  generated_at: string;
+  calibrated_confidence: number;
+  checkpoint_id: string;
+  binance_usdm_confirmed_symbols: string[];
+  current_gate_state: string;
+  model_version?: string;
+  canary_threshold?: number;
+  gate_blocked_reason?: string;
+}
+
+interface RiskDecision {
+  canary_profile_tightening?: {
+    action: string;
+    automation_can_enable_live: boolean;
+    blockers: string[];
+    classification: string;
+    confidence: number;
+    confidence_threshold?: number;
+    reason?: string;
+  };
+}
+
+interface RiskDecisions {
+  generated_at: string;
+  decisions: RiskDecision[];
+}
+
+function finiteNumber(value: unknown): number | null {
+  const n = typeof value === 'number' ? value : typeof value === 'string' ? Number(value) : NaN;
+  return Number.isFinite(n) ? n : null;
+}
+
+function formatPctFraction(value: unknown, digits = 1): string {
+  const n = finiteNumber(value);
+  return n == null ? 'missing' : `${(n * 100).toFixed(digits)}%`;
+}
+
+function formatBps(value: unknown, digits = 2): string {
+  const n = finiteNumber(value);
+  return n == null ? 'missing' : `${n.toFixed(digits)} bps`;
+}
+
+function ConfidenceBar({ value, threshold, label }: { value: number | null | undefined; threshold?: number | null; label: string }) {
+  const numericValue = finiteNumber(value);
+  const numericThreshold = finiteNumber(threshold);
+  const pct = numericValue == null ? 0 : Math.min(100, numericValue * 100);
+  const threshPct = numericThreshold == null ? null : Math.min(100, numericThreshold * 100);
+  const ok = numericValue == null ? false : numericThreshold == null ? numericValue >= 0.65 : numericValue >= numericThreshold;
+  return (
+    <div className="confidence-meter">
+      <div className="confidence-meter__label">
+        <span>{label}</span>
+        <strong className={`num ${ok ? 'text-ok' : 'text-warn'}`}>
+          {numericValue == null ? 'missing' : `${pct.toFixed(1)}%`}
+        </strong>
+      </div>
+      <div className="confidence-meter__track">
+        <div
+          className={`confidence-meter__fill confidence-meter__fill--${ok ? 'ok' : 'warn'}`}
+          style={{ width: `${pct}%` }}
+        />
+        {threshPct !== null && (
+          <div className="confidence-meter__threshold" style={{ left: `${threshPct}%` }} title={`threshold: ${(threshPct).toFixed(0)}%`} />
+        )}
+      </div>
+      {numericThreshold !== null && (
+        <small style={{ color: 'var(--text-mid)', fontSize: '11px' }}>
+          threshold: {(numericThreshold * 100).toFixed(0)}% · {ok ? 'above gate' : 'below gate - blocked'}
+        </small>
+      )}
+    </div>
+  );
+}
 
