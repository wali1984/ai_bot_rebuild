   210	                  <strong className={`num ${(finiteNumber(weight) ?? 0) >= 0 ? 'text-ok' : 'text-block'}`}>
   211	                    {finiteNumber(weight) == null
   212	                      ? 'missing'
   213	                      : `${finiteNumber(weight)! >= 0 ? '+' : ''}${finiteNumber(weight)!.toFixed(4)}`}
   214	                  </strong>
   215	                </div>
   216	              ))}
   217	          </div>
   218	        </Panel>
   219	      )}
   220	
   221	      {/* Risk gate decision */}
   222	      <Panel id="risk-gate-outcome" title="Risk Gate Outcome"
   223	        right={
   224	          <span className={`chip solid-${mainDecision?.classification?.includes('BLOCKED') ? 'block' : 'ok'}`}>
   225	            {mainDecision?.classification ?? 'LOADING'}
   226	          </span>
   227	        }>
   228	        {mainDecision ? (
   229	          <div>
   230	            <div className="cockpit-card-grid">
   231	              <div className={`truth-state-card truth-state-card--${mainDecision.classification.includes('BLOCKED') ? 'bad' : 'good'}`}>
   232	                <span className="truth-state-card__label">Action</span>
   233	                <strong>{mainDecision.action}</strong>
   234	              </div>
   235	              <div className="truth-state-card truth-state-card--paper">
   236	                <span className="truth-state-card__label">Confidence at Decision</span>
   237	                <strong className="num">{formatPctFraction(mainDecision.confidence)}</strong>
   238	              </div>
   239	              <div className={`truth-state-card truth-state-card--${mainDecision.automation_can_enable_live ? 'good' : 'bad'}`}>
   240	                <span className="truth-state-card__label">Auto Enable Live</span>
   241	                <strong>{mainDecision.automation_can_enable_live ? 'Eligible' : 'Blocked'}</strong>
   242	              </div>
   243	            </div>
   244	            {blockers.length > 0 && (
   245	              <div style={{ marginTop: '12px' }}>
   246	                <p className="eyebrow" style={{ marginBottom: '6px' }}>Blockers</p>
   247	                <div style={{ display: 'flex', flexWrap: 'wrap', gap: '6px' }}>
   248	                  {blockers.map((b) => (
   249	                    <span key={b} className="chip solid-block">{b.replace(/_/g, ' ')}</span>
   250	                  ))}
   251	                </div>
   252	              </div>
   253	            )}
   254	          </div>
   255	        ) : (
   256	          <p className="ent-placeholder">Risk decision loading…</p>
   257	        )}
   258	      </Panel>
   259	
   260	      {/* Trainer bridge detail */}
   261	      <Panel id="trainer-bridge" title="V2 Trainer Bridge Status"
   262	        right={<span className={`chip solid-${ageClass(bridgeAge, 120)}`}>{fmtAge(bridgeAge)}</span>}>
   263	        {bridge ? (
   264	          <div className="cockpit-card-grid">
   265	            <Metric label="Bridge Confidence" value={formatPctFraction(bridge.calibrated_confidence)} detail="latest calibrated output" />
   266	            <Metric label="Gate State" value={bridge.current_gate_state} detail="bridge-side gate" />
   267	            <Metric label="Symbols Confirmed" value={`${bridge.binance_usdm_confirmed_symbols?.length ?? 0}`} detail="live Binance USDM" />
   268	            <Metric label="Checkpoint" value={bridge.checkpoint_id ? `${bridge.checkpoint_id.slice(0, 28)}...` : 'missing'} detail="active model version" />
   269	          </div>
   270	        ) : (
   271	          <p className="ent-placeholder">{bridgeError ?? 'Trainer bridge loading…'}</p>
   272	        )}
   273	      </Panel>
   274	
   275	      {/* Placeholder for training history */}
   276	      <Panel id="training-history-placeholder" title="Training History &amp; Model Comparison"
   277	        right={<span className="chip solid-warn">PLACEHOLDER — V2 TRAINER NOT PORTED</span>}>
