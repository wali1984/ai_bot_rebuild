+                <span>{p.quantity}</span>
+                <span className={`num ${(p.unrealized_pnl ?? 0) >= 0 ? 'text-ok' : 'text-block'}`}>
+                  ${p.unrealized_pnl?.toFixed(2) ?? '—'}
+                </span>
+                <span style={{ fontSize: '11px' }}>{p.entry_time?.slice(11, 19) ?? '—'}</span>
+              </div>
+            ))}
+          </div>
+        )}
+      </Panel>
+
+      {/* Live positions placeholder */}
+      <Panel id="live-positions-placeholder" title="Live Exchange Positions"
+        right={<span className="chip solid-block">BLOCKED — HUMAN APPROVAL REQUIRED</span>}>
+        <div className="placeholder-panel">
+          <div className="placeholder-panel__icon">🔒</div>
+          <div>
+            <strong>Live Positions Locked</strong>
+            <p>The system is in paper-only simulation mode. Live gate status: <code>blocked_human_only</code></p>
+            <p>No live approval control is exposed on this page. Any future live/canary gate remains outside Phase 1 and requires a separate human-only approval process.</p>
+            <p>Current gate: <code>blocked_human_only</code>. Candidate symbols are not adopted automatically.</p>
+          </div>
+        </div>
+      </Panel>
+
+      {/* Risk config */}
+      <Panel id="risk-config" title="Risk Configuration"
+        right={<span className={`chip solid-${ageClass(riskAge, 60)}`}>{fmtAge(riskAge)}</span>}>
+        <div className="cockpit-card-grid">
+          <Metric label="Confidence Gate Threshold" value={risk?.confidence_gate_threshold != null ? `${(risk.confidence_gate_threshold * 100).toFixed(0)}%` : 'canary default'} detail="minimum confidence for signal execution" />
+          <Metric label="Max Position Size" value={risk?.max_position_size_usdt != null ? `$${risk.max_position_size_usdt}` : 'profile default'} detail="maximum single trade notional" />
+          <Metric label="Funding Rate Active" value={risk?.funding_rate_active != null ? (risk.funding_rate_active ? 'Yes' : 'No') : '—'} detail="funding cost awareness enabled" />
+          <Metric label="Paper PnL" value={`$${pos?.paper_pnl?.toFixed(2) ?? '—'}`} detail="total paper simulation PnL" />
+        </div>
+      </Panel>
+
+      {/* Historical PnL placeholder */}
+      <Panel id="historical-pnl-placeholder" title="PnL Curve — Historical"
+        right={<span className="chip solid-warn">PLACEHOLDER — CHART LIBRARY NEEDED</span>}>
+        <div className="placeholder-panel">
+          <div className="placeholder-panel__icon">📉</div>
+          <div>
+            <strong>Daily PnL Equity Curve</strong>
+            <p>Data source: <code>/operator_runtime/paper_online/latest/paper_ledger_tail.json</code> — available right now</p>
+            <p>Needs: A charting library (recharts or lightweight-charts) to render. Can be added as a new npm package with user permission.</p>
+            <p>Would show: Cumulative equity curve, daily PnL bars, win/loss ratio, average trade size.</p>
+          </div>
+        </div>
+      </Panel>
+    </article>
+  );
 }
