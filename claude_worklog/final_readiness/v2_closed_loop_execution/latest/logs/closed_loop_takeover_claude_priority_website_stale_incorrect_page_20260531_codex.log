+import { Panel } from '../cockpitComponents';
+import { usePayloadFile, fmtAge, ageClass } from '../../hooks/usePayloadFile';
+
+/* ── ingestor status ── */
+const INGESTORS_PATH = '/operator_runtime/v2_native_ingestors/latest/v2_native_ingestors_status.json';
+const TRAINER_BRIDGE_PATH = '/operator_runtime/v2_trainer_bridge/latest/v2_trainer_bridge_status.json';
+const PAPER_RUNTIME_PATH = '/operator_runtime/paper_online/latest/paper_runtime_status.json';
+const RISK_RUNTIME_PATH = '/operator_runtime/paper_online/latest/risk_runtime_payload.json';
+const FEATURE_PIPELINE_PATH = '/operator_runtime/v2_feature_pipeline_native/latest/v2_feature_pipeline_native_status.json';
+const LINEAGE_WORKER_PATH = '/operator_runtime/v2_signal_lineage_worker/latest/v2_signal_lineage_worker_status.json';
+const RISK_GATEWAY_PATH = '/operator_runtime/v2_risk_gateway_runtime_worker/latest/v2_risk_gateway_runtime_worker_status.json';
+const SIGNAL_PUBLISHER_PATH = '/operator_runtime/v2_signal_publisher/latest/v2_signal_publisher_status.json';
+const PAPER_EXECUTION_PATH = '/operator_runtime/v2_paper_execution_worker/latest/v2_paper_execution_worker_status.json';
+
+interface IngestorEntry {
+  name: string;
+  legacy_path: string;
+  classification: string;
+  rationale: string;
+  status?: string;
+  age_seconds?: number | null;
+}
+
+interface IngestorStatus {
+  generated_at: string;
+  total_ingestors: number;
+  ingestors: IngestorEntry[];
+  worker_health?: string;
+}
+
+interface TrainerBridge {
+  generated_at: string;
+  calibrated_confidence: number;
+  checkpoint_id: string;
+  binance_usdm_confirmed_symbols: string[];
+  current_gate_state: string;
+  model_version?: string;
+  worker_health?: string;
+}
+
+interface WorkerStatus {
+  generated_at: string;
+  worker_health?: string;
+  status?: string;
+  loop_count?: number;
+  cycles_completed?: number;
+  last_cycle_at?: string;
+  error_count?: number;
+}
+
+function WorkerTile({
+  name, path, threshold = 120
+}: { name: string; path: string; threshold?: number }) {
+  const { data, error, ageSeconds } = usePayloadFile<WorkerStatus>(path, 30_000);
+  const ac = error ? 'bad' : ageClass(ageSeconds, threshold);
+  return (
+    <div className={`worker-tile worker-tile--${ac}`}>
+      <span className="eyebrow">{name}</span>
+      <strong className={`worker-tile__status worker-tile__status--${ac}`}>
+        {error ? '✗ ERROR' : ageSeconds === null ? '…' : ac === 'ok' ? '✓ Alive' : ac === 'warn' ? '⚠ Slow' : '✗ Stale'}
+      </strong>
+      <small>{error ? error.slice(0, 40) : fmtAge(ageSeconds)}</small>
+      {data?.worker_health && <small style={{ marginTop: '2px', fontSize: '10px' }}>{data.worker_health}</small>}
+    </div>
+  );
+}
