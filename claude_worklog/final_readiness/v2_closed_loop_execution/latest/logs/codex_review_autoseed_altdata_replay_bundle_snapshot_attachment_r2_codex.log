   861	REQUIRED_COST_MODEL_LITERAL = "OPERATOR_DECISION_REQUIRED"
   862	LEGACY_COST_MODEL_MARKER = "DEFAULT_PAPER_COST_MODEL_PENDING_OPERATOR_OVERRIDE"
   863	REQUIRED_COST_MODEL_MARKER = COST_MODEL_NOTE
   864	
   865	REQUIRED_MARKET_SNAPSHOT_KEYS: tuple[str, ...] = (
   866	    "cost_model_source",
   867	    "operator_decision_required",
