   737	
   738	    - if the primary window's after_cost is unknown -> INSUFFICIENT_EVIDENCE
   739	    - if the trade was taken (paper_fill_allowed=True or decision=ACCEPTED):
   740	      - after_cost > 0 -> CORRECT_TRADE
   741	      - after_cost <= 0 -> FALSE_POSITIVE
   742	    - if the trade was held by the gate (block reasons present):
   743	      - after_cost > 0 (counterfactual would have been profitable) -> FALSE_BLOCK
   744	      - after_cost <= 0 -> CORRECT_NO_TRADE
   745	    - if the model held (not blocked, no fill):
   746	      - after_cost > 0 -> FALSE_NEGATIVE
   747	      - after_cost <= 0 -> CORRECT_NO_TRADE
   748	    """
   749	    outcome = (bundle.get("future_outcomes") or {}).get(primary_window_id) or {}
   750	    after_cost = outcome.get("after_cost_return_bps")
   751	    if after_cost is None:
   752	        return ReplayLabel.INSUFFICIENT_EVIDENCE.value
   753	    gate = bundle.get("paper_gate_decision") or {}
   754	    paper_intent = bundle.get("paper_intent") or {}
   755	    intent_decision = (paper_intent.get("decision") or "").upper()
   756	    block_reasons = gate.get("paper_fill_gate_block_reasons") or []
   757	    blocked = intent_decision in ("HELD_BY_PAPER_FILL_GATE", "BLOCKED") or (
   758	        gate.get("paper_fill_allowed") is False and bool(block_reasons)
   759	    )
   760	    traded = (
   761	        intent_decision == "ACCEPTED_PAPER_FILL"
   762	        or bool(gate.get("paper_fill_allowed"))
   763	    )
   764	    if traded:
   765	        return (
   766	            ReplayLabel.CORRECT_TRADE.value
   767	            if after_cost > 0
   768	            else ReplayLabel.FALSE_POSITIVE.value
   769	        )
   770	    if blocked:
   771	        return (
   772	            ReplayLabel.FALSE_BLOCK.value
   773	            if after_cost > 0
   774	            else ReplayLabel.CORRECT_NO_TRADE.value
   775	        )
   776	    # Model held without gate-block evidence.
   777	    return (
   778	        ReplayLabel.FALSE_NEGATIVE.value
   779	        if after_cost > 0
   780	        else ReplayLabel.CORRECT_NO_TRADE.value
   781	    )
