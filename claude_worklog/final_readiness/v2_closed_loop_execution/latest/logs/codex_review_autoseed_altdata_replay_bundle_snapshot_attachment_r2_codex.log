   982	def validate_bundle_row(row: Mapping[str, Any]) -> list[str]:
   983	    """Return a list of validation error tokens for one row. Empty list
   984	    means the row passes. Used by tests and by the CLI backfill to
   985	    guarantee no stale row escapes."""
   986	    errors: list[str] = []
   987	    market = row.get("market_snapshot") or {}
