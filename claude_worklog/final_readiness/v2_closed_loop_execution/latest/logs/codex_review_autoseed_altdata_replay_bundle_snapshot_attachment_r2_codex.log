   931	
   932	def backfill_bundle_replay_context(row: Mapping[str, Any]) -> tuple[dict[str, Any], bool]:
   933	    """Attach explicit paper-gate lineage and alt-data source state.
   934	
   935	    This remediation is intentionally evidence-only. It records existing
   936	    gate reasons and explicit missing-source states, but it does not
   937	    fabricate a block reason and does not recalculate labels/outcomes.
   938	    """
   939	    out = dict(row)
   940	    changed = False
   941	    symbol = str(out.get("symbol") or "").upper()
   942	    if not isinstance(out.get("altdata_snapshot"), Mapping):
   943	        out["altdata_snapshot"] = build_altdata_snapshot(symbol)
   944	        changed = True
   945	
   946	    paper_gate = dict(out.get("paper_gate_decision") or {})
   947	    if "paper_fill_allowed" not in paper_gate and "paper_fill_allowed" in out:
   948	        paper_gate["paper_fill_allowed"] = out.get("paper_fill_allowed")
   949	    trainer_output = dict(out.get("trainer_output") or {})
   950	    resolver_row = dict(out)
