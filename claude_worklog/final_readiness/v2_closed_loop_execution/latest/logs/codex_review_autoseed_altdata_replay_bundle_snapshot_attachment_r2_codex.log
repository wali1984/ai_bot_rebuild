   991	    source = market.get("cost_model_source")
   992	    if not isinstance(source, str) or REQUIRED_COST_MODEL_LITERAL not in source:
   993	        errors.append("cost_model_source_missing_required_literal")
   994	    for key in (
   995	        "operator_decision_required",
   996	        "operator_override_required",
   997	    ):
   998	        if market.get(key) is not True:
   999	            errors.append(f"missing_or_falsy_{key}")
  1000	    if "default_fee_bps_visible" not in market:
  1001	        errors.append("missing_default_fee_bps_visible")
  1002	    if "default_slippage_estimate_bps_visible" not in market:
  1003	        errors.append("missing_default_slippage_estimate_bps_visible")
  1004	    altdata = row.get("altdata_snapshot")
  1005	    if not isinstance(altdata, Mapping):
  1006	        errors.append("missing_altdata_snapshot_state")
  1007	    else:
  1008	        source_label = altdata.get("source_label")
  1009	        source_key = altdata.get("source_key")
  1010	        status = altdata.get("status")
  1011	        if source_label not in {"V2_NATIVE_PUBLIC_PAYLOAD", PAPER_FILL_GATE_MISSING_SOURCE}:
  1012	            errors.append("invalid_altdata_snapshot_source_label")
  1013	        if isinstance(source_key, str) and not source_key.startswith("v2:"):
  1014	            errors.append("altdata_snapshot_non_v2_source_key")
  1015	        if status == PAPER_FILL_GATE_MISSING_SOURCE and source_label != PAPER_FILL_GATE_MISSING_SOURCE:
  1016	            errors.append("altdata_missing_source_label_mismatch")
  1017	    gate = row.get("paper_gate_decision") or {}
  1018	    if isinstance(gate, Mapping):
  1019	        paper_fill_allowed = gate.get("paper_fill_allowed")
  1020	        reasons = gate.get("paper_fill_gate_block_reasons") or []
  1021	        lineage = gate.get("paper_fill_gate_block_reasons_lineage")
  1022	        if paper_fill_allowed is False and not reasons:
  1023	            if not isinstance(lineage, Mapping) or lineage.get("state") != PAPER_FILL_GATE_MISSING_SOURCE:
  1024	                errors.append("paper_fill_gate_block_reason_missing_without_lineage")
  1025	        if reasons and (
  1026	            not isinstance(lineage, Mapping)
  1027	            or lineage.get("state") != PAPER_FILL_GATE_REASON_STATE_RECORDED
  1028	        ):
  1029	            errors.append("paper_fill_gate_block_reasons_missing_recorded_lineage")
  1030	    # Future outcomes must not be fabricated. INSUFFICIENT windows must
  1031	    # have ``after_cost_return_bps == None``.
  1032	    outcomes = row.get("future_outcomes") or {}
  1033	    for wid, win in outcomes.items():
  1034	        if not isinstance(win, Mapping):
  1035	            errors.append(f"window_not_object:{wid}")
  1036	            continue
  1037	        src = win.get("source")
  1038	        ac = win.get("after_cost_return_bps")
  1039	        if isinstance(src, str) and src.startswith("INSUFFICIENT_EVIDENCE") and ac is not None:
  1040	            errors.append(f"insufficient_window_with_fabricated_outcome:{wid}")
  1041	    label = row.get("label")
  1042	    valid_labels = {l.value for l in ReplayLabel}
  1043	    if label not in valid_labels:
