   455	
   456	def _resolve_paper_fill_gate_block_reasons(
   457	    row: Mapping[str, Any],
   458	) -> tuple[list[str], dict[str, Any]]:
   459	    raw = row.get("raw_row") if isinstance(row.get("raw_row"), Mapping) else {}
   460	    paper_gate = row.get("paper_gate_decision") if isinstance(
   461	        row.get("paper_gate_decision"), Mapping
   462	    ) else {}
   463	    trainer_output = row.get("trainer_output") if isinstance(
   464	        row.get("trainer_output"), Mapping
   465	    ) else {}
   466	
   467	    reasons: list[str] = []
   468	    evidence_sources: list[dict[str, Any]] = []
   469	
   470	    def _add_reasons(field: str, values: Any) -> None:
   471	        extracted = _list_from_any(values)
   472	        if not extracted:
   473	            return
   474	        reasons.extend(extracted)
   475	        evidence_sources.append({
   476	            "field": field,
   477	            "state": PAPER_FILL_GATE_REASON_STATE_RECORDED,
   478	            "count": len(extracted),
   479	        })
   480	
   481	    _add_reasons(
   482	        "paper_fill_gate_block_reasons",
   483	        row.get("paper_fill_gate_block_reasons") or raw.get("paper_fill_gate_block_reasons"),
   484	    )
   485	    _add_reasons(
   486	        "paper_gate_decision.paper_fill_gate_block_reasons",
   487	        paper_gate.get("paper_fill_gate_block_reasons"),
   488	    )
   489	    _add_reasons(
   490	        "trainer_output.paper_fill_gate_block_reasons",
   491	        trainer_output.get("paper_fill_gate_block_reasons"),
   492	    )
   493	
   494	    explicit_bool_reasons: list[tuple[str, str, bool]] = [
   495	        ("pre_trade_allowed", "PRE_TRADE_GATE_BLOCKED", row.get("pre_trade_allowed") is False),
   496	        ("fee_gate_allowed", "FEE_GATE_BLOCKED", row.get("fee_gate_allowed") is False),
   497	        ("churn_blocked", "CHURN_BLOCKED", row.get("churn_blocked") is True),
   498	    ]
   499	    for field, reason, triggered in explicit_bool_reasons:
   500	        if not triggered:
   501	            continue
   502	        reasons.append(reason)
   503	        evidence_sources.append({
   504	            "field": field,
   505	            "state": PAPER_FILL_GATE_REASON_STATE_RECORDED,
   506	            "reason": reason,
   507	        })
   508	
   509	    unique_reasons = _dedupe_strings(reasons)
   510	    paper_fill_allowed = row.get("paper_fill_allowed")
   511	    if paper_fill_allowed is None:
   512	        paper_fill_allowed = paper_gate.get("paper_fill_allowed")
   513	    paper_intent = row.get("paper_intent") if isinstance(row.get("paper_intent"), Mapping) else {}
   514	    decision = str(row.get("decision") or paper_intent.get("decision") or "").upper()
   515	    expected = paper_fill_allowed is False or decision in {
   516	        "HELD_BY_PAPER_FILL_GATE",
   517	        "BLOCKED",
   518	    }
   519	    if unique_reasons:
   520	        state = PAPER_FILL_GATE_REASON_STATE_RECORDED
   521	        missing_reason = None
   522	    elif expected:
   523	        state = PAPER_FILL_GATE_MISSING_SOURCE
   524	        missing_reason = "paper_fill_gate_block_reason_missing_from_v2_sources"
   525	    else:
   526	        state = PAPER_FILL_GATE_REASON_STATE_NOT_APPLICABLE
   527	        missing_reason = None
   528	    return unique_reasons, {
   529	        "state": state,
   530	        "missing_reason": missing_reason,
   531	        "evidence_sources_considered": list(PAPER_FILL_GATE_EVIDENCE_SOURCES),
   532	        "evidence_sources": evidence_sources,
   533	    }
