   728	
   729	def _label_from_outcome(
   730	    *,
   731	    bundle: dict[str, Any],
   732	    primary_window_id: str = "5m",
   733	) -> str:
   734	    """Compute objective label from realized after-cost outcome.
   735	
   736	    Honest rules:
   737	
   738	    - if the primary window's after_cost is unknown -> INSUFFICIENT_EVIDENCE
   739	    - if the trade was taken (paper_fill_allowed=True or decision=ACCEPTED):
   740	      - after_cost > 0 -> CORRECT_TRADE
   741	      - after_cost <= 0 -> FALSE_POSITIVE
   742	    - if the trade was held by the gate (block reasons present):
   743	      - after_cost > 0 (counterfactual would have been profitable) -> FALSE_BLOCK
   744	      - after_cost <= 0 -> CORRECT_NO_TRADE
   745	    - if the model held (not blocked, no fill):
   746	      - after_cost > 0 -> FALSE_NEGATIVE
   747	      - after_cost <= 0 -> CORRECT_NO_TRADE
   748	    """
   749	    outcome = (bundle.get("future_outcomes") or {}).get(primary_window_id) or {}
   750	    after_cost = outcome.get("after_cost_return_bps")
   751	    if after_cost is None:
   752	        return ReplayLabel.INSUFFICIENT_EVIDENCE.value
   753	    gate = bundle.get("paper_gate_decision") or {}
   754	    paper_intent = bundle.get("paper_intent") or {}
   755	    intent_decision = (paper_intent.get("decision") or "").upper()
   756	    block_reasons = gate.get("paper_fill_gate_block_reasons") or []
   757	    blocked = intent_decision in ("HELD_BY_PAPER_FILL_GATE", "BLOCKED") or (
   758	        gate.get("paper_fill_allowed") is False and bool(block_reasons)
   759	    )
   760	    traded = (
   761	        intent_decision == "ACCEPTED_PAPER_FILL"
   762	        or bool(gate.get("paper_fill_allowed"))
   763	    )
   764	    if traded:
   765	        return (
   766	            ReplayLabel.CORRECT_TRADE.value
   767	            if after_cost > 0
   768	            else ReplayLabel.FALSE_POSITIVE.value
   769	        )
   770	    if blocked:
   771	        return (
   772	            ReplayLabel.FALSE_BLOCK.value
   773	            if after_cost > 0
   774	            else ReplayLabel.CORRECT_NO_TRADE.value
   775	        )
   776	    # Model held without gate-block evidence.
   777	    return (
   778	        ReplayLabel.FALSE_NEGATIVE.value
   779	        if after_cost > 0
   780	        else ReplayLabel.CORRECT_NO_TRADE.value
   781	    )
   782	
   783	
   784	def fill_outcomes(
   785	    bundle: dict[str, Any],
   786	    *,
   787	    timeline_by_symbol: dict[str, list[tuple[float, float]]],
   788	) -> dict[str, Any]:
   789	    symbol = bundle.get("symbol") or ""
   790	    timeline = timeline_by_symbol.get(symbol.upper()) or []
   791	    anchor_ts = bundle.get("anchor_ts")
   792	    entry_price = _coerce_float(bundle.get("entry_price"))
   793	    side = bundle.get("side")
   794	    market = bundle.get("market_snapshot") or {}
   795	    fee_bps = _coerce_float(market.get("fee_bps")) or DEFAULT_FEE_BPS
   796	    slippage_bps = _coerce_float(market.get("slippage_estimate_bps")) or DEFAULT_SLIPPAGE_BPS
   797	    new_outcomes: dict[str, Any] = {}
   798	    for wid, secs in OUTCOME_WINDOWS_SECONDS:
   799	        old = (bundle.get("future_outcomes") or {}).get(wid) or {}
   800	        if old.get("after_cost_return_bps") is not None:
   801	            # Already filled — keep.
   802	            new_outcomes[wid] = old
   803	            continue
   804	        new_outcomes[wid] = _compute_window(
   805	            timeline=timeline,
   806	            anchor_ts=anchor_ts,
   807	            entry_price=entry_price,
   808	            side=side,
   809	            window_id=wid,
   810	            window_seconds=secs,
   811	            fee_bps=fee_bps,
   812	            slippage_bps=slippage_bps,
   813	        )
   814	    bundle["future_outcomes"] = new_outcomes
   815	    # outcome_after_cost mirrors the primary (5m) window.
   816	    primary = new_outcomes.get("5m") or {}
   817	    bundle["outcome_after_cost"] = primary.get("after_cost_return_bps")
   818	    bundle["label"] = _label_from_outcome(bundle=bundle, primary_window_id="5m")
   819	    return bundle
