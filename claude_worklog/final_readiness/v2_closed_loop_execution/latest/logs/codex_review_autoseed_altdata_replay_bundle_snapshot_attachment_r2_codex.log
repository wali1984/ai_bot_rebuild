   826	def mine_once(
   827	    *,
   828	    symbols: tuple[str, ...] = ("BTCUSDT", "ETHUSDT", "SOLUSDT"),
   829	) -> dict[str, Any]:
   830	    STATE_DIR.mkdir(parents=True, exist_ok=True)
   831	    # 1. Append current price snapshots.
   832	    appended = [append_price_snapshot(s) for s in symbols]
   833	    # 2. Harvest paper evidence and merge into bundle store.
   834	    paper_rows = _harvest_paper_evidence()
   835	    existing = _read_bundles()
   836	    merged, added = _merge_new_paper_rows(existing, paper_rows)
   837	    # 3. Fill outcomes for any bundle whose windows are now sourceable.
   838	    timeline_by_symbol = {s: load_price_timeline(s) for s in symbols}
   839	    filled: list[dict[str, Any]] = []
   840	    for b in merged:
   841	        filled.append(fill_outcomes(b, timeline_by_symbol=timeline_by_symbol))
   842	    _write_bundles(filled)
   843	    return {
   844	        "symbols": list(symbols),
   845	        "price_snapshots": appended,
   846	        "paper_rows_observed": len(paper_rows),
   847	        "bundles_total": len(filled),
   848	        "bundles_added_this_cycle": added,
   849	        "timeline_lengths": {s: len(timeline_by_symbol[s]) for s in symbols},
   850	    }
   851	
   852	
   853	def load_filled_bundles() -> list[dict[str, Any]]:
   854	    return _read_bundles()
