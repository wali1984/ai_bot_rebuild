    ROW_STALE_FEATURES,
    ROW_MISSING_FEATURES,
    ROW_LABEL_MISSING,
    ROW_HELD_OUT_VALIDATION,
)

# Hold-out split: deterministic by hash(feature_snapshot_id).
HELD_OUT_FRACTION = 0.2

# Minimum sample threshold below which the dataset cannot be called
