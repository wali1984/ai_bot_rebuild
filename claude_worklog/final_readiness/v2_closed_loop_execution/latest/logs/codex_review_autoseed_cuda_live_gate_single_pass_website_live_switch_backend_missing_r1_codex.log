   130	def _mount_frontend_spa(app: FastAPI) -> None:
   131	    """Serve the built React SPA + public payload tree from the
   132	    backend so dashboard.wajidali.us (or any local consumer)
   133	    reaches /market and /admin/war-room directly.
   134	
   135	    Two filesystem trees are mounted:
   136	
   137	    - ``v2/frontend/public/`` at ``/`` — served first so JSON payloads
   138	      consumed by the SPA (status files, dashboard payloads, public
   139	      operator-runtime mirrors) resolve at their canonical relative
   140	      paths.
   141	    - ``v2/frontend/dist/`` SPA — index.html catch-all for client-side
   142	      routes so /market and /admin/war-room return the SPA HTML.
   143	
   144	    Both mounts are read-only. No mount changes Redis, no mount
   145	    enables live trading, no mount exposes raw credentials."""
   146	    import os
   147	    from pathlib import Path
   148	
   149	    from fastapi import Response
   150	    from fastapi.responses import FileResponse, JSONResponse
   151	    from fastapi.staticfiles import StaticFiles
   152	
   153	    repo_root = Path(os.environ.get("V2_REPO_ROOT", "/home/wali/Desktop/AI BOT REBUILD"))
   154	    public_dir = repo_root / "v2" / "frontend" / "public"
   155	    dist_dir = repo_root / "v2" / "frontend" / "dist"
   156	    if not dist_dir.exists():
   157	        # Frontend hasn't been built yet — leave the API-only app
   158	        # untouched. The operator can build later with `npm run build`.
   159	        return
   160	
   161	    # Public payload mirror: every nested JSON/MD file the SPA needs.
   162	    if public_dir.exists():
   163	        app.mount(
   164	            "/public",
   165	            StaticFiles(directory=str(public_dir), html=False),
   166	            name="v2_public_mirror",
   167	        )
   168	
   169	    # SPA assets/static files.
   170	    assets_dir = dist_dir / "assets"
   171	    if assets_dir.exists():
   172	        app.mount(
   173	            "/assets",
   174	            StaticFiles(directory=str(assets_dir), html=False),
   175	            name="v2_spa_assets",
   176	        )
   177	
   178	    index_html = dist_dir / "index.html"
   179	
   180	    @app.get("/", include_in_schema=False, response_class=FileResponse)
   181	    async def _spa_index():  # type: ignore[no-untyped-def]
   182	        return FileResponse(index_html)
   183	
   184	    # SPA history-mode catch-all: any path that did NOT match an
   185	    # /api/* route or /assets/* static file falls through to here.
   186	    # The route is mounted LAST so /api/* and /assets/* always win.
   187	    @app.get(
   188	        "/{full_path:path}",
   189	        include_in_schema=False,
   190	        response_class=FileResponse,
   191	    )
   192	    async def _spa_catch_all(full_path: str):  # type: ignore[no-untyped-def]
   193	        # Don't serve the SPA for API paths — those should 404 if not
   194	        # registered. The middleware stack already rejects live-only
   195	        # paths before reaching here.
   196	        if full_path.startswith("api/") or full_path.startswith("public/"):
   197	            return JSONResponse(
   198	                {"error": "not_found", "path": full_path}, status_code=404
   199	            )
   200	        # IMPORTANT: prefer the live ``public/`` directory before falling
   201	        # back to ``dist/``. Vite's build copies ``public/`` into ``dist/``,
   202	        # so ``dist/`` is only a snapshot frozen at build time. If we
   203	        # served the payload mirror from ``dist/`` the SPA would see stale
   204	        # JSON until the next ``npx vite build``. Operator runtime
   205	        # payloads are refreshed continuously by the freshness refresher
   206	        # and per-worker publishers — we must read them from ``public/``.
   207	        # Both directories are read-only mounts; no Redis or exchange
   208	        # call happens here.
   209	        if public_dir.exists():
   210	            live_candidate = public_dir / full_path
   211	            if live_candidate.is_file():
   212	                # no-store: never cache live operator payloads in
   213	                # intermediate proxies or in the browser.
   214	                return FileResponse(
   215	                    live_candidate,
   216	                    headers={
   217	                        "Cache-Control": "no-store, max-age=0",
   218	                        "Pragma": "no-cache",
   219	                    },
   220	                )

