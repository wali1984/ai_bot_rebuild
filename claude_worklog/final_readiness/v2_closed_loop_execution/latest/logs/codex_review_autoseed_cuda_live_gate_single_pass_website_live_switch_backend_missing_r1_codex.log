+    def scan(pattern: str, parser) -> set[str]:
+        symbols: set[str] = set()
+        try:
+            iterator = client.scan_iter(match=pattern, count=500)
+            for key in iterator:
+                symbol = parser(str(key))
+                normalized = symbol.strip().upper() if symbol else ""
+                if normalized.endswith("USDT"):
+                    symbols.add(normalized)
+        except Exception:
+            return set()
+        return symbols
