                "live_symbols": [],
                "execution_live_symbols": [],
                "trader_execution_enabled": False,
                "places_real_order": False,
                "exact_blockers": ["BACKTEST_EDGE_BLOCKED_NO_EDGE_CLAIM"],
            }
        ),
        encoding="utf-8",
