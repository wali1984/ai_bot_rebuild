+def _mount_frontend_spa(app: FastAPI) -> None:
+    """Serve the built React SPA + public payload tree from the
+    backend so dashboard.wajidali.us (or any local consumer)
+    reaches /market and /admin/war-room directly.
+
+    Two filesystem trees are mounted:
+
+    - ``v2/frontend/public/`` at ``/`` — served first so JSON payloads
+      consumed by the SPA (status files, dashboard payloads, public
+      operator-runtime mirrors) resolve at their canonical relative
+      paths.
+    - ``v2/frontend/dist/`` SPA — index.html catch-all for client-side
+      routes so /market and /admin/war-room return the SPA HTML.
+
