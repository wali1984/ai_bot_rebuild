   252	    )
   253	    parser.add_argument("--timeframe", default="1m")
   254	    parser.add_argument("--limit", type=int, default=6)
   255	    parser.add_argument("--interval", type=int, default=15)
   256	    parser.add_argument("--once", action="store_true")
   257	    parser.add_argument("--loop", action="store_true")
   258	    parser.add_argument("--no-write", action="store_true")
   259	    parser.add_argument("--enable-kucoin", action="store_true")
   260	    parser.add_argument("--depth-limit", type=int, default=20)
   261	    parser.add_argument("--long-short-period", default="5m")
   262	    parser.add_argument("--long-short-limit", type=int, default=1)
   263	    parser.add_argument("--coinapi-daily-budget", type=int, default=10000)
   264	    parser.add_argument("--coinapi-v1-budget-pct", type=float, default=0.30)
   265	    parser.add_argument("--verify-baseline-shas", action="store_true")
   266	    args = parser.parse_args(argv)
   267	    if not args.loop and not args.once:
   268	        args.once = True
   269	    return args
