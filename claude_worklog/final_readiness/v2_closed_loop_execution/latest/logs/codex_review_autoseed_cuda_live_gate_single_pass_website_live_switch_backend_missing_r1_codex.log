    98	def _collect_redis_symbol_sets() -> dict[str, list[str]]:
    99	    try:
   100	        import redis  # type: ignore
   101	    except ImportError:
   102	        return {}
   103	    try:
   104	        client = redis.Redis(host="127.0.0.1", port=6379, db=0, decode_responses=True)
   105	        client.ping()
   106	    except Exception:
   107	        return {}
   108	
   109	    def scan(pattern: str, parser) -> set[str]:
   110	        symbols: set[str] = set()
   111	        try:
   112	            iterator = client.scan_iter(match=pattern, count=500)
   113	            for key in iterator:
   114	                symbol = parser(str(key))
   115	                normalized = symbol.strip().upper() if symbol else ""
   116	                if normalized.endswith("USDT"):
   117	                    symbols.add(normalized)
   118	        except Exception:
   119	            return set()
   120	        return symbols
   121	
   122	    def last_part(key: str) -> str:
   123	        return key.rsplit(":", 1)[-1]
   124	
   125	    def part(index: int):
   126	        def parser(key: str) -> str:
   127	            pieces = key.split(":")
   128	            return pieces[index] if len(pieces) > index else ""
   129	
   130	        return parser
   131	
   132	    price_symbols = scan("v2:market:prices:*", last_part)
   133	    funding_symbols = scan("v2:market:funding:*", last_part)
   134	    open_interest_symbols = scan("v2:market:open_interest:*", last_part)
   135	    orderbook_symbols = scan("v2:market:orderbook:*", last_part)
   136	    feature_symbols = scan("v2:features:latest:*:*", part(3))
   137	    prediction_symbols = scan("v2:prediction:*:*", part(2))
   138	    binance_ohlcv_symbols = scan("v2:market:ohlcv:binance:*:*", part(4))
   139	    observed = sorted(
   140	        set().union(
   141	            price_symbols,
   142	            funding_symbols,
   143	            open_interest_symbols,
   144	            orderbook_symbols,
   145	            feature_symbols,
   146	            prediction_symbols,
   147	            binance_ohlcv_symbols,
   148	        )
   149	    )
   150	    return {
   151	        "redis_market_price_symbols": sorted(price_symbols),
   152	        "redis_market_funding_symbols": sorted(funding_symbols),
   153	        "redis_market_open_interest_symbols": sorted(open_interest_symbols),
   154	        "redis_orderbook_symbols": sorted(orderbook_symbols),
   155	        "redis_feature_latest_symbols": sorted(feature_symbols),
   156	        "redis_prediction_symbols": sorted(prediction_symbols),
   157	        "redis_binance_ohlcv_symbols": sorted(binance_ohlcv_symbols),
   158	        "redis_observed_symbols": observed,
   159	    }
