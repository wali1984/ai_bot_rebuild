   174	def verify_baseline_shas(manifest_path: Path = COPIED_BASELINE_MANIFEST) -> Dict[str, Any]:
   175	    """Read the copied_baseline_manifest.json and verify each baseline file
   176	    we depend on has a SHA matching ``LEGACY_BASELINE_SHA256``.
   177	    """
   178	    result: Dict[str, Any] = {"checked": [], "mismatches": [], "ok": True}
   179	    try:
   180	        manifest = json.loads(manifest_path.read_text())
   181	    except Exception as exc:
   182	        return {"checked": [], "mismatches": [], "ok": False, "error": f"manifest_load_failed: {exc}"}
   183	    by_path: Dict[str, str] = {}
   184	    for record in manifest.get("records", []):
   185	        v2_path = record.get("v2_preserved_path")
   186	        sha = record.get("sha256")
   187	        if v2_path and sha:
   188	            by_path[v2_path] = sha
   189	    for v2_path, expected in LEGACY_BASELINE_SHA256.items():
   190	        actual = by_path.get(v2_path)
   191	        result["checked"].append({"path": v2_path, "expected": expected, "actual": actual})
   192	        if actual != expected:
   193	            result["mismatches"].append({"path": v2_path, "expected": expected, "actual": actual})
   194	            result["ok"] = False
   195	    return result
