     1	class LivenessStreamGrowthDomainError(ValueError):
     2	    def __init__(self, reason: str, *, field: str | None = None) -> None:
     3	        self.reason = reason
     4	        self.field = field
     5	        message = reason if field is None else f"{field}: {reason}"
     6	        super().__init__(message)
===== v2/backend/app/domain/liveness_stream_growth/growth_calculator.py
     1	from __future__ import annotations
     2	
     3	from .errors import LivenessStreamGrowthDomainError
     4	from .growth_window_config import GrowthWindowConfig
     5	from .stream_observation import StreamIdObservation, _ensure_stream_name
     6	
     7	
     8	def compute_stream_id_growth_in_window(
     9	    observations: tuple[StreamIdObservation, ...],
    10	    config: GrowthWindowConfig,
    11	    now_ms: int,
    12	    *,
    13	    stream_name: str,
    14	) -> int:
    15	    if not isinstance(observations, tuple):
    16	        raise LivenessStreamGrowthDomainError("observations_not_tuple", field="observations")
    17	    if not isinstance(config, GrowthWindowConfig):
    18	        raise LivenessStreamGrowthDomainError("must_be_growth_window_config", field="config")
    19	    if type(now_ms) is not int:
    20	        raise LivenessStreamGrowthDomainError("must_be_int", field="now_ms")
    21	    if now_ms < 0:
    22	        raise LivenessStreamGrowthDomainError("must_be_nonnegative", field="now_ms")
    23	    _ensure_stream_name(stream_name, field="stream_name")
    24	
    25	    lo = now_ms - config.window_ms
    26	    distinct_stream_ids: set[str] = set()
    27	
    28	    for observation in observations:
    29	        if not isinstance(observation, StreamIdObservation):
    30	            raise LivenessStreamGrowthDomainError("must_be_stream_id_observation", field="observations")
    31	        # A future observation invalidates the entire supplied window before stream filtering.
    32	        if observation.observation_ts_ms > now_ms:
    33	            raise LivenessStreamGrowthDomainError("observation_in_future", field="observation_ts_ms")
    34	        if observation.stream_name != stream_name:
    35	            continue
    36	        if config.boundary_inclusive:
    37	            in_window = observation.observation_ts_ms >= lo
    38	        else:
    39	            in_window = observation.observation_ts_ms > lo
    40	        if in_window:
    41	            # Redis stream IDs are counted as literal observed IDs, not normalized numeric offsets.
    42	            distinct_stream_ids.add(observation.stream_id)
    43	
    44	    return len(distinct_stream_ids)
