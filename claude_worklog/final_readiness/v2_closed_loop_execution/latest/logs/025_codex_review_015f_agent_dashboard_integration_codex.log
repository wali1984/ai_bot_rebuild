    68	                {tid}
    69	              </li>
    70	            ))}
    71	          </ul>
    72	        )}
    73	      </div>
    74	
    75	      <div className="alert-group" data-testid="stale-state-no-event" data-count={noEvent.length}>
    76	        <h3>no_event</h3>
    77	        {noEvent.length === 0 ? (
    78	          empty
    79	        ) : (
    80	          <ul>
