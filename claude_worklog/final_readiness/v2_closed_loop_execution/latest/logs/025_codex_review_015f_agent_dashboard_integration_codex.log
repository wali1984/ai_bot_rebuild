    20	
    21	  if (isLoading) {
    22	    return (
    23	      <section className="dashboard-panel" data-testid="stale-state-alerts-panel" data-state="loading">
    24	        <h2>Stale-State Alerts</h2>
    25	        <p>Loading…</p>
    26	      </section>
    27	    );
    28	  }
    29	  if (error || !data || !data.data) {
    30	    return (
    31	      <section className="dashboard-panel" data-testid="stale-state-alerts-panel" data-state="error">
    32	        <h2>Stale-State Alerts</h2>
    33	        <p role="alert">Alert feed unavailable.</p>
    34	      </section>
    35	    );
    36	  }
    37	
    38	  const q = data.data;
    39	  const stale = q.stale_running_tasks;
    40	  const noEvent = q.no_event_tasks;
    41	  const noOutput = q.no_output_growth_tasks;
    42	  const quota = q.blocked_quota;
    43	  const human = q.human_attention_required_tasks;
    44	  const total =
    45	    stale.length +
    46	    noEvent.length +
    47	    noOutput.length +
    48	    (quota ? 1 : 0) +
    49	    human.length;
    50	
    51	  return (
    52	    <section
    53	      className="dashboard-panel"
    54	      data-testid="stale-state-alerts-panel"
    55	      data-state="ok"
    56	      data-alert-total={total}
    57	    >
    58	      <h2>Stale-State Alerts</h2>
