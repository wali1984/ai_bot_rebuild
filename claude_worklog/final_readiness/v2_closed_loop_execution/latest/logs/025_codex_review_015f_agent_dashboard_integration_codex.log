   158	async function mockSupervisorEndpoints(
   159	  page: Page,
   160	  queue: typeof ALERT_QUEUE_PAYLOAD,
   161	): Promise<void> {
   162	  // Keep the existing live-block banner mock honest: route any banner fetch
   163	  // to a "blocked" payload so the layout assertion in nav_smoke does not
   164	  // regress through this spec.
   165	  await page.route('**/api/v1/live/state', (route) =>
   166	    route.fulfill({
   167	      status: 200,
   168	      contentType: 'application/json',
   169	      body: JSON.stringify({ state: 'blocked', reason: 'default_deny' }),
   170	    }),
   171	  );
   172	  await page.route('**/api/v1/_meta/queue-status', (route) =>
   173	    route.fulfill({
   174	      status: 200,
   175	      contentType: 'application/json',
   176	      body: JSON.stringify(queue),
   177	    }),
   178	  );
   179	  await page.route('**/api/v1/_meta/agent-health', (route) =>
   180	    route.fulfill({
   181	      status: 200,
   182	      contentType: 'application/json',
   183	      body: JSON.stringify(HEALTH_PAYLOAD),
   184	    }),
   185	  );
   186	  await page.route('**/api/v1/_meta/build-status*', (route) =>
   187	    route.fulfill({
   188	      status: 200,
   189	      contentType: 'application/json',
   190	      body: JSON.stringify(BUILD_PAYLOAD),
   191	    }),
   192	  );
   193	  await page.route('**/api/v1/_meta/audit-chain*', (route) =>
   194	    route.fulfill({
   195	      status: 200,
   196	      contentType: 'application/json',
   197	      body: JSON.stringify(AUDIT_PAYLOAD),
   198	    }),
   199	  );
   200	}
