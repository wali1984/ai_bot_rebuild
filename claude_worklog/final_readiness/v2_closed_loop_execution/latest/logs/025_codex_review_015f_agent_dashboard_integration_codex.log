     3	/**
     4	 * StaleStateAlertsPanel — surfaces every alert category enumerated in
     5	 * `claude_worklog/agent_supervisor_reliability/02_IMPLEMENTATION_REPORT.md`
     6	 * §1.10 / §1.11:
     7	 *
     8	 *   - stale_running              (process dead / no pgrep / output mtime old)
     9	 *   - no_event                   (last_event_ts older than threshold)
    10	 *   - no_output_growth           (stdout/stderr/summary mtimes idle)
    11	 *   - blocked_quota              (Claude/Codex quota exhausted)
    12	 *   - human_attention_required   (retries exhausted; secret_scan blocked)
    13	 */
    14	export function StaleStateAlertsPanel(): JSX.Element {
    15	  const { data, isLoading, error } = useQueueStatus();
    16	
    17	  const empty = (
    18	    <p data-testid="stale-state-empty">No stale-state alerts active.</p>
