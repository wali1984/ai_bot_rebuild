# baseline_model.py — after existing label constants
INSUFFICIENT_EVIDENCE_LABEL = "insufficient_evidence"
MIN_CALIBRATION_SAMPLES = 16


@dataclass
class AfterCostCalibration:
    slope: float
    intercept: float
    sample_count: int
    insufficient_samples: bool
    minimum_samples: int = MIN_CALIBRATION_SAMPLES

    def predict_bps(self, p: float) -> float:
        return float(self.intercept + self.slope * float(p))

    def to_jsonable(self) -> dict[str, Any]:
        return {
            "slope": self.slope,
            "intercept": self.intercept,
            "sample_count": self.sample_count,
            "minimum_samples": self.minimum_samples,
            "insufficient_samples": self.insufficient_samples,
        }


def _fit_after_cost_calibration(
    train_rows: Sequence[DatasetRow],
    model: LogisticModel,
) -> AfterCostCalibration:
    """Simple OLS of after_cost_return_bps on predicted probability.

    Operates on V2-owned ``ROW_TRAINABLE`` rows only. Defensively excludes
    rows labelled ``insufficient_evidence`` and rows whose
    ``after_cost_return_bps`` is ``None``. Returns a calibration whose
    ``insufficient_samples`` flag is True when fewer than
    ``MIN_CALIBRATION_SAMPLES`` usable pairs were found, in which case the
    slope/intercept fall back to a no-op identity (slope=0, intercept=0).
    """
    xs: list[float] = []
    ys: list[float] = []
    for row in train_rows:
        if row.classification != ROW_TRAINABLE:
            continue
        if row.label == INSUFFICIENT_EVIDENCE_LABEL:
            continue
        after_cost = row.after_cost_return_bps
        if after_cost is None:
            continue
        p = model.predict_proba(_row_feature_vector(row))
        xs.append(float(p))
        ys.append(float(after_cost))
    n = len(xs)
    if n < MIN_CALIBRATION_SAMPLES:
        return AfterCostCalibration(
            slope=0.0,
            intercept=0.0,
            sample_count=n,
            insufficient_samples=True,
        )
    mean_x = sum(xs) / n
    mean_y = sum(ys) / n
    num = sum((xs[i] - mean_x) * (ys[i] - mean_y) for i in range(n))
    den = sum((xs[i] - mean_x) ** 2 for i in range(n))
    slope = num / den if den > 1e-12 else 0.0
    intercept = mean_y - slope * mean_x
    return AfterCostCalibration(
        slope=slope,
        intercept=intercept,
        sample_count=n,
        insufficient_samples=False,
    )
```

No call sites change; this is purely additive. The fail_blocker explicitly limits scope to "Add `AfterCostCalibration` dataclass + `_fit_after_cost_calibration(train_rows, model)`" so I'm not wiring it into `train_logistic_model` or `build_baseline_prediction` (that would be the broader r15-plan scope-creep the user CLAUDE.md cautions against).

