PAPER_FILL_GATE_REASON_STATE_NOT_APPLICABLE = "NOT_APPLICABLE"
PAPER_FILL_GATE_EVIDENCE_SOURCES: tuple[str, ...] = (
    "paper_fill_gate_block_reasons",
