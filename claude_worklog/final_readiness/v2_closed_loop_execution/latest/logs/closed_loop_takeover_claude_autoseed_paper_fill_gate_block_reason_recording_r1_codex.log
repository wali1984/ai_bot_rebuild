            f"{sym}:1m:{row.get('generated_utc')}"
        ),
        "prediction_id": row.get("intent_id") or f"{sym}:{row.get('generated_utc')}",
        "symbol": sym,
        "timeframe": "1m",
        "generated_at": row.get("generated_utc") or _utc_iso(),
