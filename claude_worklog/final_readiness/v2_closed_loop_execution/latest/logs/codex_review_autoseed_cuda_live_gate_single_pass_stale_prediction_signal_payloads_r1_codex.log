   192	        include_redis = root.resolve() == REPO_ROOT.resolve()
   193	    service = SymbolUniverseService()
   194	    worker_payloads = _collect_payloads(root)
   195	    discovered, discovered_sources = _union(
   196	        worker_payloads,
