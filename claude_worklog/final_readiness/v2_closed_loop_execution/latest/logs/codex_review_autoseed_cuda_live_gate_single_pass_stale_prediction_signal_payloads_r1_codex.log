        """
        now_ms = self.now_ms()
        feats = {sym: dict(h) for sym, h in unified_features_by_symbol.items()}

        # --- Open interest (universe-level) ---
        oi_by_sym: Dict[str, float] = {}
        for sym, h in feats.items():
            oi = self._first_float(
                h,
