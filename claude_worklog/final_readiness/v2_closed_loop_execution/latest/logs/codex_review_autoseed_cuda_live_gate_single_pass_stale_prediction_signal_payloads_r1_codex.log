+def _collect_redis_symbol_sets() -> dict[str, list[str]]:
+    try:
+        import redis  # type: ignore
+    except ImportError:
+        return {}
+    try:
+        client = redis.Redis(host="127.0.0.1", port=6379, db=0, decode_responses=True)
+        client.ping()
+    except Exception:
+        return {}
+
+    def scan(pattern: str, parser) -> set[str]:
+        symbols: set[str] = set()
+        try:
+            iterator = client.scan_iter(match=pattern, count=500)
+            for key in iterator:
+                symbol = parser(str(key))
+                normalized = symbol.strip().upper() if symbol else ""
+                if normalized.endswith("USDT"):
+                    symbols.add(normalized)
+        except Exception:
+            return set()
+        return symbols
+
+    def last_part(key: str) -> str:
+        return key.rsplit(":", 1)[-1]
+
+    def part(index: int):
+        def parser(key: str) -> str:
+            pieces = key.split(":")
+            return pieces[index] if len(pieces) > index else ""
+
+        return parser
+
+    price_symbols = scan("v2:market:prices:*", last_part)
+    funding_symbols = scan("v2:market:funding:*", last_part)
