        merged: List[str] = []
        seen: Set[str] = set()
        for s in list(BASELINE_25_SYMBOLS) + discovered:
            if s and s.upper() not in seen:
                seen.add(s.upper())
                merged.append(s.upper())
        if merged:
            return merged
    elif discovered:
        return list(discovered)

    # 4. Final fallback: 25-symbol baseline.
    return list(BASELINE_25_SYMBOLS)


