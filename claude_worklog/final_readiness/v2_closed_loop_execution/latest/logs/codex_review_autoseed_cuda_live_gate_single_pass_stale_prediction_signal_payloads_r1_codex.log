   512	    def _coinapi_v1_healthy(self, now: float) -> bool:
   513	        """Preserved from
   514	        legacy_preserved/startup_baseline/ingest/live_binance.py
   515	        ``_check_coinapi_ohlcv_healthy`` (L233-291). Considers the source
   516	        healthy when last OHLCV ts is within the legacy 120s threshold.
   517	        """
   518	        if self._coinapi_v1_last_ts is None:
   519	            return False
   520	        return (now - self._coinapi_v1_last_ts) <= COINAPI_OHLCV_STALE_THRESHOLD_SEC

