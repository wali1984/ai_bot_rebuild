+    def ingest_long_short_ratio(
+        self,
+        symbol: str,
+        *,
+        period: str = "5m",
+        limit: int = 1,
+    ) -> Dict[str, Any]:
+        """Ingest public Binance global long/short account ratio.
+
+        The endpoint is public/keyless. If Binance returns a non-list error
+        payload (for example a restricted-location message), the method records
+        the blocker and writes no neutral fallback value.
+        """
+        key = f"{V2_KEY_PREFIX}:{symbol}:long_short"
+        result: Dict[str, Any] = {
+            "symbol": symbol,
+            "primary": "binance_rest",
+            "fallback": "coinank_deferred_to_next_worker",
+            "period": period,
+            "limit": int(limit),
+            "v2_key": key,
+            "status": "pending",
+        }
+        if self._blocked_by_backoff(result):
+            return result
+        status, payload = self._http_get(
+            "https://fapi.binance.com/futures/data/globalLongShortAccountRatio?"
+            f"symbol={symbol}&period={period}&limit={int(limit)}"
+        )
+        if not self._public_http_ok(status, payload, result):
+            return result
+        if isinstance(payload, dict) and payload.get("code") is not None:
+            result["status"] = "binance_error_payload"
+            result["binance_code"] = payload.get("code")
+            result["binance_msg"] = str(payload.get("msg") or "")[:240]
+            if "restricted location" in result["binance_msg"].lower():
