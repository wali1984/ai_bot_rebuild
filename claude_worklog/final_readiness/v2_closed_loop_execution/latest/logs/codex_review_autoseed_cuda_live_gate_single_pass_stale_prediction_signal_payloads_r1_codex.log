def _as_int(value: Any) -> int:
    try:
        return int(value or 0)
    except (TypeError, ValueError):
        return 0


def _review_current_enough(*, reviewed: int, current: int) -> bool:
    if current <= reviewed:
        return True
    drift = current - reviewed
    tolerance = max(10, int(max(reviewed, 1) * 0.25))
    return drift <= tolerance


def derive_simple_summary(payloads: dict[str, Any]) -> dict[str, Any]:
    """Plain-English summary the frontend renders on every page."""
    em = payloads.get("expected_move_model_review") or {}
    tb = payloads.get("v2_trainer_bridge") or {}
    rl_core = payloads.get("v2_rl_core_live") or {}
    checkpoint_evidence = payloads.get("v2_trainer_checkpoint_evidence") or {}
    native_trainer_baseline = payloads.get("v2_native_trainer_dataset_baseline") or {}
    paper = payloads.get("paper_edge_recovery") or {}
    shadow = payloads.get("paper_shadow_outcome_observer") or {}
    shutdown = payloads.get("codex_shutdown_readiness_takeover") or {}
    router = payloads.get("permanent_migration_router") or {}
    native_core = payloads.get("native_algorithmic_core_migration") or {}
    native_sprint = payloads.get("native_core_p0_true_migration_sprint") or {}
    zero_miss = payloads.get("zero_miss_legacy_core_lift") or {}

    plain_english_summary = "The bot is watching only. It is not allowed to trade live."
    current_goal = "Build the native V2 trading core before revisiting paper edge, shutdown, or live work."
    shutdown_rec = shutdown.get("current_recommendation") or "BLOCK_LEGACY_SHUTDOWN_PARITY_INCOMPLETE"

    paper_edge_status = em.get("edge_status") or "EDGE_PENDING_MODEL_REVIEW_REQUIRED"
    trainer_parity_status = tb.get("trainer_parity_status") or em.get("trainer_parity_status") or "BLOCKS_LEGACY_SHUTDOWN"
    trainer_runtime_status = rl_core.get("classification") or "MISSING_V2_RL_CORE_EVIDENCE"
    trainer_online_mode = rl_core.get("trainer_online_mode") or checkpoint_evidence.get("trainer_online_mode") or "UNKNOWN"
    trainer_checkpoint_evidence_status = (
        checkpoint_evidence.get("checkpoint_evidence_status")
        or rl_core.get("checkpoint_evidence_status")
        or "MISSING_CHECKPOINT_EVIDENCE"
    )
    trainer_checkpoint_id = checkpoint_evidence.get("selected_checkpoint_id") or rl_core.get("checkpoint_id")
    reviewed_false_blocks = _as_int(em.get("false_block_count"))
    current_false_blocks = _as_int(shadow.get("false_block_count"))
    expected_move_review_current = _review_current_enough(
        reviewed=reviewed_false_blocks,
        current=current_false_blocks,
    )

    audit = payloads.get("independent_audit_reconciliation") or {}
    audit_rows = audit.get("rows") or []
    audit_downgrade_count = audit.get("global_downgrade_count")

    blockers_simple: list[str] = []
    if audit_rows:
        blockers_simple.append("V2 is not fully migrated yet. The trainer, RL environment, feature pipeline, ingestors, orchestrator arbitration, and exit engines are missing or bridge-only.")
    if "EDGE_PENDING" in str(paper_edge_status):
        blockers_simple.append("Paper edge has not proven it can beat fees.")
    if "BLOCKS_LEGACY_SHUTDOWN" in str(trainer_parity_status):
        blockers_simple.append("Trainer runtime is online, but full legacy shutdown parity is still not claimed.")
    if shutdown_rec and "BLOCK_LEGACY_SHUTDOWN" in shutdown_rec:
        blockers_simple.append("Legacy shutdown is blocked until parity is proven.")
    if router and router.get("routing", {}).get("p0_blockers_remaining", 0) > 0:
        blockers_simple.append("There are P0 runtime blockers still open.")
    if native_core.get("codex_go_no_go") == "V2_NATIVE_ALGORITHMIC_CORE_MIGRATION_CODEX_FAIL":
        blockers_simple.append("Native algorithmic core migration is not complete.")
    if (native_sprint.get("go_no_go") or native_sprint.get("codex_go_no_go")) in {
        "V2_NATIVE_CORE_P0_TRUE_MIGRATION_SPRINT_BLOCKED",
        "V2_NATIVE_CORE_P0_TRUE_MIGRATION_CODEX_FAIL",
    }:
        blockers_simple.append("The true native-core P0 sprint is still blocked: feature pipeline, RL/MASA/PPO, orchestrator arbitration, trade management, and ingestor proof are not complete.")
    if zero_miss.get("codex_go_no_go") == "ZERO_MISS_LEGACY_CORE_TO_V2_CODEX_FAIL":
        blockers_simple.append("Zero-miss legacy core lift failed Codex review: copied runtime coverage, dependency closure, parse validation, and atlas evidence are not complete.")
    if not expected_move_review_current:
        blockers_simple.append(
            "Expected-move review is behind the latest shadow outcomes; keep the strict gate until a fresh review passes."
        )

    blockers_technical = []
    selected = (router or {}).get("routing", {}).get("selected_blocker") or {}
    if selected:
        blockers_technical.append({
            "id": selected.get("id"),
            "category": selected.get("category"),
            "remediation_task_id": selected.get("remediation_task_id"),
            "source": selected.get("source"),
            "evidence": selected.get("evidence"),
        })
    if not expected_move_review_current:
        blockers_technical.append({
            "id": "EXPECTED_MOVE_MODEL_REVIEW_STALE_AGAINST_SHADOW_OUTCOMES",
            "category": "P0_SHUTDOWN_BLOCKER",
            "remediation_task_id": "claude_v2_expected_move_model_review_and_false_block_calibration",
            "source": "frontend_truth_payload_builder",
            "evidence": (
                f"reviewed_false_blocks={reviewed_false_blocks}; "
                f"current_false_blocks={current_false_blocks}"
            ),
        })
    if native_core.get("codex_go_no_go") == "V2_NATIVE_ALGORITHMIC_CORE_MIGRATION_CODEX_FAIL":
        blockers_technical.append({
            "id": "NATIVE_ALGORITHMIC_CORE_MIGRATION_CODEX_FAIL",
            "category": "P0_MIGRATION_BLOCKER",
            "remediation_task_id": native_core.get("delegated_claude_task_id"),
            "source": "native_algorithmic_core_migration",
            "evidence": "; ".join(native_core.get("primary_blockers") or []),
        })
    if (native_sprint.get("go_no_go") or native_sprint.get("codex_go_no_go")) in {
        "V2_NATIVE_CORE_P0_TRUE_MIGRATION_SPRINT_BLOCKED",
        "V2_NATIVE_CORE_P0_TRUE_MIGRATION_CODEX_FAIL",
    }:
        blockers_technical.append({
            "id": "NATIVE_CORE_P0_TRUE_MIGRATION_REQUIRED",
            "category": "P0_MIGRATION_BLOCKER",
            "remediation_task_id": native_sprint.get("delegated_claude_task_id") or "claude_v2_native_core_p0_true_migration_sprint",
            "source": "v2_native_core_p0_true_migration_sprint",
            "evidence": "; ".join(native_sprint.get("primary_blockers") or []),
        })
    if zero_miss.get("codex_go_no_go") == "ZERO_MISS_LEGACY_CORE_TO_V2_CODEX_FAIL":
        blockers_technical.append({
            "id": "ZERO_MISS_LEGACY_CORE_TO_V2_CODEX_FAIL",
            "category": "P0_MIGRATION_BLOCKER",
            "remediation_task_id": "claude_v2_native_core_p0_true_migration_sprint",
            "source": "zero_miss_legacy_core_lift",
            "evidence": "; ".join(zero_miss.get("primary_blockers") or []),
        })

    active_claude_task = (router or {}).get("routing", {}).get("next_task_id") or "n/a"

    migration_truth = {
        "headline": "V2 is not fully migrated yet.",
        "downgrade_count": audit_downgrade_count,
        "missing_or_bridge_only_components": [r.get("component") for r in audit_rows if isinstance(r, dict)],
        "next_claude_tasks_in_priority_order": [
