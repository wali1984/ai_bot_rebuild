        "paper_symbols",
        "live_data_symbols",
        "trainer_live_symbols",
        "paper_shadow_live_symbols",
        "discovered_symbols",
        "dynamic_discovered_symbols",
        "observed_symbols",
        "symbols",
        "universe",
    ):
        v = d.get(key)
        if isinstance(v, list) and all(isinstance(x, str) for x in v) and v:
            return list(v), str(p)
    return [], str(p)


def resolve_symbols(
    *,
