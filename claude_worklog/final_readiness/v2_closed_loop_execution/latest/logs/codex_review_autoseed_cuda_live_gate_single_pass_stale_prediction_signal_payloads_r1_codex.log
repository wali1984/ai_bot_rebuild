+
+
 @router.options("/", include_in_schema=False)
 async def _route_metadata() -> dict[str, Any]:
     return ROUTE_METADATA
+
+
+@router.get("/")
+async def list_ingestors() -> dict[str, Any]:
+    payload = _load_status_payload()
+    services = {
+        service_id: _service_state(service_id)
+        for service_id in ALLOWED_INGESTOR_SERVICES
+    }
+    return {
+        "schema_version": "v2_ingestors_api_status_v1",
+        "payload": payload,
+        "services": services,
+        "allowed_actions": ["status", "start", "stop", "restart"],
+        "blocked_actions": [
+            "place_order",
+            "cancel_order",
+            "enable_trader",
+            "enable_canary",
+            "change_leverage",
+            "change_margin",
+            "modify_trainer",
+        ],
+    }
+
+
+@router.get("/{service_id}")
+async def get_ingestor(service_id: str) -> dict[str, Any]:
+    _assert_allowed_service(service_id)
+    return _service_state(service_id)
+
+
+@router.post("/{service_id}/control")
+async def control_ingestor(
+    service_id: str,
+    request: IngestorControlRequest,
+) -> dict[str, Any]:
+    _assert_allowed_service(service_id)
+    if request.action == "status":
+        result = _systemctl(["status", service_id])
+    else:
+        result = _systemctl([request.action, service_id])
+    return {
+        "schema_version": "v2_ingestor_control_result_v1",
+        "service_id": service_id,
+        "action": request.action,
+        "systemctl": result,
+        "state": _service_state(service_id),
+        "live_gate": "blocked_human_only",
+        "trader_execution_enabled": False,
+        "exchange_action_taken": False,
+    }
diff --git a/v2/backend/app/cli/__init__.py b/v2/backend/app/cli/__init__.py
index e69de29b..c1bc90e4 100644
--- a/v2/backend/app/cli/__init__.py
+++ b/v2/backend/app/cli/__init__.py
@@ -0,0 +1,24 @@
+"""V2 backend CLI package.
+
+On import this package binds data-provider API keys from the canonical
+``v2/.env.local`` file (layered with ``.local_secrets/*.env``) into
+``os.environ`` so every ``v2.backend.app.cli.<worker>`` module invocation —
+including the systemd-managed paper/shadow loops, whose units set no
+EnvironmentFile — can reach the keys it needs.
+
+Only data-provider credentials are bound (see
+``safe_env_loader.DATA_PROVIDER_CREDENTIAL_NAMES``). Exchange private keys and
+behaviour/risk flags are intentionally NOT auto-bound, preserving the
+default-blocked trading posture. Raw secret values are never logged.
+
+The bootstrap is best-effort: any failure is swallowed so a missing or
+malformed credential file can never break worker startup.
+"""
+from __future__ import annotations
+
+try:  # pragma: no cover - defensive: never let credential bootstrap break import
+    from v2.backend.app.services.safe_env_loader import bootstrap_process_env
+
+    _CREDENTIAL_BOOTSTRAP_REPORT = bootstrap_process_env(apply=True)
+except Exception:  # noqa: BLE001 - intentionally broad; startup must not fail here
+    _CREDENTIAL_BOOTSTRAP_REPORT = {"applied_to_os_environ": False, "error": True}
