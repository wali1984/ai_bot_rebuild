   184	def build_payload(
   185	    root: Path = REPO_ROOT,
   186	    *,
   187	    generated_at: str | None = None,
   188	    include_redis: bool | None = None,
   189	) -> dict[str, Any]:
   190	    generated_at = generated_at or iso_now()
