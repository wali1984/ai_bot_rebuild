+        target.setdefault("ind_ta_RSI_21_15m", features.get("htf_rsi_14"))
+    price = _safe_float(features.get("micro_price"))
+    atr = _safe_float(features.get("atr_14"))
+    if price and atr is not None:
+        target.setdefault(f"ind_ta_NATR_28_{tf}", (atr / price) if price else 0.0)
+    if "funding_rate" in features:
+        target.setdefault("funding_rate", features.get("funding_rate"))
+
+
+def load_v2_global_feature_inputs(redis_client: Any, symbols: List[str], tf: str) -> Tuple[Dict[str, Dict[str, Any]], Dict[str, Any]]:
+    """Read current V2 Redis feature/market inputs for the global aggregator.
+
+    Reads only V2-prefixed keys. Legacy ``features:global_coinank:*`` keys are
+    named in payload metadata only and are never read or written.
+    """
+    by_symbol: Dict[str, Dict[str, Any]] = {}
+    read_keys: List[str] = []
+    for symbol in symbols:
+        s = symbol.upper()
+        merged: Dict[str, Any] = {}
+        for key in (f"v2:unified_features:{s}:{tf}", f"v2:unified_features:{s}:{tf}:latest"):
+            h = _redis_hgetall(redis_client, key)
+            if h:
+                merged.update(h)
+                read_keys.append(key)
+        for key in (f"v2:features:latest:{s}:{tf}", f"v2:features:latest:{s}:1m"):
+            snap = _redis_get_json(redis_client, key)
+            if snap:
+                _merge_feature_snapshot(merged, snap, tf)
+                read_keys.append(key)
+        oi = _redis_get_json(redis_client, f"v2:market:open_interest:{s}")
+        if oi:
+            merged.setdefault("open_interest", oi.get("openInterest") or oi.get("sumOpenInterest"))
+            read_keys.append(f"v2:market:open_interest:{s}")
+        funding = _redis_get_json(redis_client, f"v2:market:funding:{s}")
+        if funding:
+            merged.setdefault("funding_rate", funding.get("lastFundingRate") or funding.get("fundingRate"))
+            read_keys.append(f"v2:market:funding:{s}")
+        price = _redis_get_json(redis_client, f"v2:market:prices:{s}")
+        ticker = price.get("ticker_24hr") if isinstance(price, dict) else None
+        if isinstance(ticker, dict):
+            merged.setdefault("quote_volume", ticker.get("quoteVolume"))
+            merged.setdefault("ccxt_price_change_15m_pct", ticker.get("priceChangePercent"))
+            read_keys.append(f"v2:market:prices:{s}")
+        by_symbol[s] = merged
+    return by_symbol, {
+        "enabled": redis_client is not None,
+        "symbols_requested": len(symbols),
+        "symbols_with_any_input": sum(1 for v in by_symbol.values() if v),
+        "read_key_count": len(read_keys),
+        "read_keys_sample": read_keys[:25],
+    }
+
+
+def persist_global_aggregate_to_v2_redis(
+    redis_client: Any,
+    aggregate: Mapping[str, Any],
+    *,
+    ttl_seconds: int,
+) -> List[str]:
+    written: List[str] = []
+    if redis_client is None:
+        return written
+    now_ms = int(time.time() * 1000)
+    for name in (
+        "total_oi",
+        "total_volume",
+        "total_liquidations",
+        "long_short_ratio",
+        "funding_rate_avg",
+        "btc_dominance",
+        "eth_dominance",
+        "alt_season_index",
+        "fear_greed",
+        "market_sentiment",
+        "volatility_index",
+    ):
+        value = aggregate.get(name, 0.0)
+        payload = {
+            "value": value,
+            "ts_ms": now_ms,
+            "timestamp": now_ms,
+            "source": "v2_coinank_and_liquidation_bridge",
+            "trainer_contract_key": f"features:global_coinank:{name}:latest",
+            "live_gate": LIVE_GATE_STATUS,
+            "live_symbols": [],
+        }
+        for prefix in V2_REDIS_GLOBAL_KEY_PREFIXES:
+            key = f"{prefix}:{name}:latest"
+            if _safe_redis_set_json(redis_client, key, payload, ex=ttl_seconds):
+                written.append(key)
+    heartbeat = {
+        "ts_ms": now_ms,
+        "source": "v2_coinank_and_liquidation_bridge",
+        "global_key_count": len(written),
+        "live_gate": LIVE_GATE_STATUS,
+        "live_symbols": [],
+    }
+    if _safe_redis_set_json(redis_client, "v2:coinank:global:last_update", heartbeat, ex=ttl_seconds):
+        written.append("v2:coinank:global:last_update")
+    return written
+
+
 def compute_freshness_seconds(ts_ms: Optional[int]) -> int:
     if not ts_ms:
         return -1
     try:
         now_ms = int(time.time() * 1000)
         return max(0, int((now_ms - int(ts_ms)) / 1000))
     except Exception:
         return -1
 
 
 def build_status(
     service: CoinankBridgeService,
     *,
     symbols: List[str],
     tf: str,
     run_started_ts: str,
     cycle_id: int,
     duration_ms: int,
 ) -> Dict[str, Any]:
     """Build the public payload. The required field list is enforced by
     ``test_required_public_payload_fields_present``.
     """
     now_ms = int(time.time() * 1000)
     endpoint_freshness = service.endpoint_freshness_ms
     last_kline_ts = endpoint_freshness.get("global_aggregator")
     funding_freshness = compute_freshness_seconds(endpoint_freshness.get("funding_rate_avg"))
     oi_freshness = compute_freshness_seconds(endpoint_freshness.get("total_oi"))
     long_short_freshness = compute_freshness_seconds(endpoint_freshness.get("long_short_ratio"))
     return {
         "worker_id": WORKER_ID,
         "last_run_ts": run_started_ts,
         "generated_at": run_started_ts,
         "source": "V2_COINANK_AND_LIQUIDATION_BRIDGE",
         "live_gate": LIVE_GATE_STATUS,
         "live_gate_status": LIVE_GATE_STATUS,
         "live_symbols": [],
         "current_gate_state": LIVE_GATE_STATUS,
         "liquidations_persisted_total": service.liquidations_persisted_total,
         "funding_freshness": funding_freshness,
         "oi_freshness": oi_freshness,
         "long_short_freshness": long_short_freshness,
         "missing_api_blockers": service.missing_api_blockers,
         "legacy_baseline_source_paths": sorted(LEGACY_BASELINE_SHA256.keys()),
         "legacy_baseline_source_sha256_list": [
             {"path": path, "sha256": LEGACY_BASELINE_SHA256[path]}
             for path in sorted(LEGACY_BASELINE_SHA256.keys())
         ],
         "freshness_seconds": compute_freshness_seconds(last_kline_ts) if last_kline_ts else -1,
         "global_11_key_contract": list(GLOBAL_11_KEY_CONTRACT),
         "required_tfs": list(REQUIRED_COINANK_TFS),
         "plan3_interval_limits": dict(PLAN3_INTERVAL_LIMITS),
         "binance_force_ws_owner": LEGACY_BINANCE_FORCE_WS_DELEGATION,
         "cycle_id": cycle_id,
         "duration_ms": duration_ms,
         "endpoint_freshness_ms": dict(endpoint_freshness),
         "symbols": list(symbols),
         "tf": tf,
         "manual_redis_mutation_by_codex": False,
         "destructive_redis_mutation_by_codex": False,
         "exchange_actions_by_codex": False,
         "legacy_execution_code_touched": False,
         "legacy_source_file_hash": LEGACY_BASELINE_SHA256[
             "v2/legacy_preserved/startup_baseline/ingest/live_coinank.py"
         ],
     }
 
 
 def write_status(status: Dict[str, Any], data_plane: Dict[str, Any]) -> None:
     PUBLIC_RUNTIME_DIR.mkdir(parents=True, exist_ok=True)
     LOCAL_RUNTIME_DIR.mkdir(parents=True, exist_ok=True)
