+def _collect_redis_symbol_sets() -> dict[str, list[str]]:
+    try:
+        import redis  # type: ignore
+    except ImportError:
+        return {}
+    try:
+        client = redis.Redis(host="127.0.0.1", port=6379, db=0, decode_responses=True)
+        client.ping()
+    except Exception:
+        return {}
+
+    def scan(pattern: str, parser) -> set[str]:
+        symbols: set[str] = set()
+        try:
+            iterator = client.scan_iter(match=pattern, count=500)
+            for key in iterator:
+                symbol = parser(str(key))
+                normalized = symbol.strip().upper() if symbol else ""
+                if normalized.endswith("USDT"):
+                    symbols.add(normalized)
+        except Exception:
+            return set()
+        return symbols
+
+    def last_part(key: str) -> str:
+        return key.rsplit(":", 1)[-1]
+
+    def part(index: int):
+        def parser(key: str) -> str:
+            pieces = key.split(":")
+            return pieces[index] if len(pieces) > index else ""
+
+        return parser
+
+    price_symbols = scan("v2:market:prices:*", last_part)
+    funding_symbols = scan("v2:market:funding:*", last_part)
+    open_interest_symbols = scan("v2:market:open_interest:*", last_part)
+    orderbook_symbols = scan("v2:market:orderbook:*", last_part)
+    feature_symbols = scan("v2:features:latest:*:*", part(3))
+    prediction_symbols = scan("v2:prediction:*:*", part(2))
+    binance_ohlcv_symbols = scan("v2:market:ohlcv:binance:*:*", part(4))
+    observed = sorted(
+        set().union(
+            price_symbols,
+            funding_symbols,
+            open_interest_symbols,
+            orderbook_symbols,
+            feature_symbols,
+            prediction_symbols,
+            binance_ohlcv_symbols,
+        )
+    )
+    return {
+        "redis_market_price_symbols": sorted(price_symbols),
+        "redis_market_funding_symbols": sorted(funding_symbols),
+        "redis_market_open_interest_symbols": sorted(open_interest_symbols),
+        "redis_orderbook_symbols": sorted(orderbook_symbols),
+        "redis_feature_latest_symbols": sorted(feature_symbols),
+        "redis_prediction_symbols": sorted(prediction_symbols),
+        "redis_binance_ohlcv_symbols": sorted(binance_ohlcv_symbols),
+        "redis_observed_symbols": observed,
+    }
+
