   403	    def ingest_long_short_ratio(
   404	        self,
   405	        symbol: str,
   406	        *,
   407	        period: str = "5m",
   408	        limit: int = 1,
   409	    ) -> Dict[str, Any]:
   410	        """Ingest public Binance global long/short account ratio.
   411	
   412	        The endpoint is public/keyless. If Binance returns a non-list error
   413	        payload (for example a restricted-location message), the method records
   414	        the blocker and writes no neutral fallback value.
   415	        """
   416	        key = f"{V2_KEY_PREFIX}:{symbol}:long_short"
   417	        result: Dict[str, Any] = {
   418	            "symbol": symbol,
   419	            "primary": "binance_rest",
   420	            "fallback": "coinank_deferred_to_next_worker",
   421	            "period": period,
   422	            "limit": int(limit),
   423	            "v2_key": key,
   424	            "status": "pending",
   425	        }
   426	        if self._blocked_by_backoff(result):
   427	            return result
   428	        status, payload = self._http_get(
   429	            "https://fapi.binance.com/futures/data/globalLongShortAccountRatio?"
   430	            f"symbol={symbol}&period={period}&limit={int(limit)}"
   431	        )
   432	        if not self._public_http_ok(status, payload, result):
   433	            return result
   434	        if isinstance(payload, dict) and payload.get("code") is not None:
   435	            result["status"] = "binance_error_payload"
   436	            result["binance_code"] = payload.get("code")
   437	            result["binance_msg"] = str(payload.get("msg") or "")[:240]
   438	            if "restricted location" in result["binance_msg"].lower():
   439	                result["status"] = "geo_or_terms_restricted"
   440	            return result
   441	        if not isinstance(payload, list) or not payload or not isinstance(payload[-1], dict):
   442	            result["status"] = "unexpected_payload"
   443	            return result
   444	        row = payload[-1]
   445	        self.data_plane[key] = {
   446	            "symbol": str(row.get("symbol") or symbol).upper(),
   447	            "period": period,
   448	            "longShortRatio": row.get("longShortRatio"),
   449	            "longAccount": row.get("longAccount"),
   450	            "shortAccount": row.get("shortAccount"),
   451	            "timestamp": _safe_int(row.get("timestamp")),
   452	            "long_short_ratio": _safe_float(row.get("longShortRatio")),
   453	            "long_account_ratio": _safe_float(row.get("longAccount")),
   454	            "short_account_ratio": _safe_float(row.get("shortAccount")),
   455	            "source": "binance_global_long_short_account_ratio",
   456	        }
   457	        result["status"] = "ok"
   458	        result["persisted"] = True
   459	        return result
