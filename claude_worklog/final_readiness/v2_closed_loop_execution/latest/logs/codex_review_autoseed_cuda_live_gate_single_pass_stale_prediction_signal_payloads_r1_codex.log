             category=str(category),
             detail=str(detail),
             ts=self.now_ms(),
         )
         self._missing_blockers.append(blocker)
         # Persist into V2 namespace.
         existing = self.data_plane.setdefault(
             f"{V2_LIQUIDATIONS_PREFIX}:missing_api_blockers", []
