   162	def _selected_subset(
   163	    requested: list[str],
   164	    *,
   165	    discovered: list[str],
   166	    binance_confirmed: list[str],
   167	    evidence_sources: list[str],
   168	    default_to_discovered: bool = False,
   169	) -> tuple[list[str], list[str], list[str]]:
   170	    blockers: list[str] = []
   171	    requested = sorted(set((requested or []) + (discovered if default_to_discovered else [])))
   172	    if not requested:
   173	        return [], [], blockers
   174	    if not evidence_sources:
   175	        blockers.append("symbol_selection_defaulted_to_dynamic_discovered")
   176	    allowed = set(discovered or requested)
   177	    if binance_confirmed:
   178	        allowed &= set(binance_confirmed)
   179	    accepted = sorted(set(requested) & allowed)
   180	    rejected = sorted(set(requested) - set(accepted))
   181	    return accepted, rejected, blockers
