   603	def verify_baseline_shas(manifest_path: Path = COPIED_BASELINE_MANIFEST) -> Dict[str, Any]:
   604	    """Read the copied_baseline_manifest.json and verify each baseline file
   605	    we depend on has a SHA matching ``LEGACY_BASELINE_SHA256``.
   606	    """
   607	    result: Dict[str, Any] = {"checked": [], "mismatches": [], "ok": True}
   608	    try:
   609	        manifest = json.loads(manifest_path.read_text())
   610	    except Exception as exc:
   611	        return {"checked": [], "mismatches": [], "ok": False, "error": f"manifest_load_failed: {exc}"}
   612	    by_path: Dict[str, str] = {}
   613	    for record in manifest.get("records", []):
   614	        v2_path = record.get("v2_preserved_path")
   615	        sha = record.get("sha256")
   616	        if v2_path and sha:
   617	            by_path[v2_path] = sha
   618	    for v2_path, expected in LEGACY_BASELINE_SHA256.items():
   619	        actual = by_path.get(v2_path)
   620	        result["checked"].append({"path": v2_path, "expected": expected, "actual": actual})
   621	        if actual != expected:
   622	            result["mismatches"].append({"path": v2_path, "expected": expected, "actual": actual})
   623	            result["ok"] = False
   624	    return result
