   492	    def health_snapshot(self) -> HealthSnapshot:
   493	        now = self._clock()
   494	        coinapi_healthy = self._coinapi_v1_healthy(now)
   495	        snap = HealthSnapshot(
   496	            coinapi_v1_healthy=coinapi_healthy,
   497	            coinapi_v1_last_ts=self._coinapi_v1_last_ts,
   498	            binance_rest_healthy=now >= self._backoff_until,
   499	            consecutive_5xx=self._consecutive_5xx,
   500	            consecutive_bans=self._consecutive_bans,
   501	            consecutive_geo_blocks=self._consecutive_geo_blocks,
   502	            backoff_until=self._backoff_until,
   503	            rate_limit_state=self._rate_limit_state,
   504	        )
   505	        self.data_plane[f"{V2_KEY_PREFIX}:source_health"] = snap.to_dict()
   506	        return snap
