             price = float(raw.get("price") or 0)
             qty = float(raw.get("qty") or 0)
             side_raw = str(raw.get("side", "")).upper()
         except Exception:
             return None
         if not symbol or ts <= 0 or price <= 0 or qty <= 0:
             return None
         if side_raw == "BUY":
             side = "SHORT_LIQ"
         elif side_raw == "SELL":
             side = "LONG_LIQ"
         else:
