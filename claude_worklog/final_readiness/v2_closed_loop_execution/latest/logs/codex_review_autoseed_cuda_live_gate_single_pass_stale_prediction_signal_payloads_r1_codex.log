   237	def parse_args(argv: Optional[List[str]] = None) -> argparse.Namespace:
   238	    parser = argparse.ArgumentParser(prog=WORKER_ID)
   239	    parser.add_argument(
   240	        "--symbol",
   241	        default=None,
   242	        help=(
   243	            "Symbol to ingest. If omitted, falls back to the first symbol "
   244	            "returned by the dynamic universe resolver. Pass --smoke-test "
   245	            "to opt into the BTC/ETH/SOL smoke set."
   246	        ),
   247	    )
   248	    parser.add_argument(
   249	        "--smoke-test",
   250	        action="store_true",
   251	        help="Use the BTC/ETH/SOL smoke-test set (test only).",
   252	    )
   253	    parser.add_argument("--timeframe", default="1m")
   254	    parser.add_argument("--limit", type=int, default=6)
   255	    parser.add_argument("--interval", type=int, default=15)
   256	    parser.add_argument("--once", action="store_true")
   257	    parser.add_argument("--loop", action="store_true")
   258	    parser.add_argument("--no-write", action="store_true")
   259	    parser.add_argument("--enable-kucoin", action="store_true")
   260	    parser.add_argument("--depth-limit", type=int, default=20)
   261	    parser.add_argument("--long-short-period", default="5m")
   262	    parser.add_argument("--long-short-limit", type=int, default=1)
   263	    parser.add_argument("--coinapi-daily-budget", type=int, default=10000)
   264	    parser.add_argument("--coinapi-v1-budget-pct", type=float, default=0.30)
   265	    parser.add_argument("--verify-baseline-shas", action="store_true")
   266	    args = parser.parse_args(argv)
   267	    if not args.loop and not args.once:
   268	        args.once = True
   269	    return args
   270	
   271	
   272	def main(argv: Optional[List[str]] = None) -> int:
   273	    args = parse_args(argv)
   274	    if args.verify_baseline_shas:
   275	        report = verify_baseline_shas()
   276	        print(json.dumps(report, indent=2, sort_keys=True))
   277	        return 0 if report["ok"] else 2
   278	    if args.once:
   279	        status = run_once(args)
   280	        return 0 if status["klines_persisted_total"] > 0 else 2
   281	    while True:
   282	        try:
   283	            run_once(args)
   284	        except KeyboardInterrupt:
   285	            return 0
   286	        except Exception:
   287	            pass
   288	        time.sleep(max(1, args.interval))
   289	
   290	
   291	if __name__ == "__main__":
   292	    sys.exit(main())

