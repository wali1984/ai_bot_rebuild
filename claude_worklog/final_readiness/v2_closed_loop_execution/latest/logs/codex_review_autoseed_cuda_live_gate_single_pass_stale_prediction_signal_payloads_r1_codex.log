   213	def verify_baseline_shas(manifest_path: Path = COPIED_BASELINE_MANIFEST) -> Dict[str, Any]:
   214	    """Read the copied_baseline_manifest.json and verify each baseline file
   215	    we depend on has a SHA matching ``LEGACY_BASELINE_SHA256``.
   216	    """
   217	    result: Dict[str, Any] = {"checked": [], "mismatches": [], "ok": True}
   218	    try:
   219	        manifest = json.loads(manifest_path.read_text())
   220	    except Exception as exc:
   221	        return {"checked": [], "mismatches": [], "ok": False, "error": f"manifest_load_failed: {exc}"}
   222	    by_path: Dict[str, str] = {}
   223	    for record in manifest.get("records", []):
   224	        v2_path = record.get("v2_preserved_path")
   225	        sha = record.get("sha256")
   226	        if v2_path and sha:
   227	            by_path[v2_path] = sha
   228	    for v2_path, expected in LEGACY_BASELINE_SHA256.items():
   229	        actual = by_path.get(v2_path)
   230	        result["checked"].append({"path": v2_path, "expected": expected, "actual": actual})
   231	        if actual != expected:
   232	            result["mismatches"].append({"path": v2_path, "expected": expected, "actual": actual})
   233	            result["ok"] = False
   234	    return result
   235	
