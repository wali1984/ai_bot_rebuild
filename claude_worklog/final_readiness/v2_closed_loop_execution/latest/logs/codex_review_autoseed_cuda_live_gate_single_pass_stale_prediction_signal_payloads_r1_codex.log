   206	    binance_confirmed, binance_sources = _union(worker_payloads, "binance_usdm_confirmed_symbols", "tradable_symbols")
   207	    redis_symbol_sets = _collect_redis_symbol_sets() if include_redis else {}
   208	    redis_observed = redis_symbol_sets.get("redis_observed_symbols", [])
   209	    if redis_observed:
   210	        observed = sorted(set(observed) | set(redis_observed))
   211	        observed_sources = sorted(set(observed_sources + ["redis://127.0.0.1:6379/v2_runtime_market_feature_prediction_keys"]))
   212	    redis_binance_ohlcv = redis_symbol_sets.get("redis_binance_ohlcv_symbols", [])
   213	    if redis_binance_ohlcv:
   214	        binance_confirmed = sorted(set(binance_confirmed) | set(redis_binance_ohlcv))
   215	        binance_sources = sorted(set(binance_sources + ["redis://127.0.0.1:6379/v2_market_ohlcv_binance_keys"]))
   216	    legacy_active = service.legacy_active_symbols()
   217	    if not discovered:
   218	        discovered = sorted({identity.canonical_symbol_id.upper() for identity in service.all_discovered_symbols()})
   219	    if not dynamic_discovered:
   220	        dynamic_discovered = list(discovered)
   221	    training, rejected_training, training_blockers = _selected_subset(
   222	        requested_training,
   223	        discovered=discovered,
   224	        binance_confirmed=binance_confirmed,
   225	        evidence_sources=training_sources,
   226	        default_to_discovered=True,
   227	    )
   228	    paper, rejected_paper, paper_blockers = _selected_subset(
   229	        requested_paper,
   230	        discovered=discovered,
   231	        binance_confirmed=binance_confirmed,
   232	        evidence_sources=paper_sources,
   233	        default_to_discovered=True,
   234	    )
   235	    source_paths = sorted(set(discovered_sources + dynamic_sources + observed_sources + training_sources + paper_sources + binance_sources))
   236	    evidence_gaps = sorted(set(training_blockers + paper_blockers))
   237	    if not binance_confirmed:
   238	        evidence_gaps.append("missing_binance_usdm_confirmed_symbols")
   239	
   240	    return {
   241	        "generated_at": generated_at,
   242	        "source": "V2_SYMBOL_UNIVERSE_PUBLIC_PAYLOAD",
   243	        "source_paths": source_paths or [SYMBOL_UNIVERSE_SERVICE_PATH],
   244	        "symbol_universe_contract": SYMBOL_UNIVERSE_CONTRACT,
   245	        "symbol_universe_source_path": SYMBOL_UNIVERSE_SERVICE_PATH,
   246	        "legacy_active_symbols": legacy_active,
   247	        "legacy_active_symbol_source": LEGACY_ACTIVE_SYMBOL_SOURCE,
   248	        "legacy_active_symbols_are_full_universe": False,
   249	        "discovered_symbols": discovered,
   250	        "dynamic_discovered_symbols": dynamic_discovered,
   251	        "dynamic_symbol_sources": list(DYNAMIC_SYMBOL_SOURCES),
   252	        "observed_symbols": observed,
   253	        "redis_runtime_symbol_sets": redis_symbol_sets,
   254	        "training_symbols": training,
   255	        "paper_symbols": paper,
   256	        "requested_training_symbols": requested_training,
   257	        "requested_paper_symbols": requested_paper,
   258	        "rejected_training_symbols": rejected_training,
   259	        "rejected_paper_symbols": rejected_paper,
   260	        "symbol_selection_evidence": {
   261	            "training_source_paths": training_sources,
   262	            "paper_source_paths": paper_sources,
   263	            "binance_confirmation_source_paths": binance_sources,
