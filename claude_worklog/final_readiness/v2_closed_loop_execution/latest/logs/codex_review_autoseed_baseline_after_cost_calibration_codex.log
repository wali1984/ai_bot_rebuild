POSITIVE_LABELS = {"true_positive_after_cost_gain"}
NEGATIVE_LABELS = {
    "false_negative_after_cost_loss",
    "false_block_negative_outcome",
}
NEUTRAL_LABELS = {"neutral_no_edge", "correct_no_trade"}

ACTION_LONG = "LONG"
ACTION_FLAT = "FLAT"

