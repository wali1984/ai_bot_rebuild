   377	def build_feature_snapshot(market: MarketSnapshot, tick_id: str) -> dict[str, Any]:
   378	    closes = [float(candle["close"]) for candle in market.candles if "close" in candle]
   379	    volumes = [float(candle["volume"]) for candle in market.candles if "volume" in candle]
   380	    last = market.price if market.price is not None else (closes[-1] if closes else None)
   381	    prev_1 = closes[-2] if len(closes) >= 2 else None
   382	    prev_5 = closes[-6] if len(closes) >= 6 else None
   383	    prev_15 = closes[-16] if len(closes) >= 16 else None
   384	    ret_1m = 0.0 if last is None or prev_1 in (None, 0) else (last - prev_1) / prev_1
   385	    ret_5m = 0.0 if last is None or prev_5 in (None, 0) else (last - prev_5) / prev_5
   386	    ret_15m = 0.0 if last is None or prev_15 in (None, 0) else (last - prev_15) / prev_15
   387	    volume_last = volumes[-1] if volumes else 0.0
   388	    volume_avg_10 = sum(volumes[-10:]) / min(len(volumes), 10) if volumes else 0.0
   389	    volatility_10 = (
   390	        sum(abs(closes[index] - closes[index - 1]) for index in range(max(1, len(closes) - 9), len(closes)))
   391	        / max(min(len(closes) - 1, 9), 1)
   392	        / last
   393	        if last and len(closes) > 1
   394	        else 0.0
   395	    )
   396	    return {
   397	        "feature_snapshot_id": f"fs_{tick_id}",
   398	        "generated_at": market.generated_at,
   399	        "source_type": market.source_type,
   400	        "symbol": market.symbol,
   401	        "freshness_state": market.freshness_state,
   402	        "market_age_seconds": market.age_seconds,
   403	        "features": {
   404	            "return_1m": round(ret_1m, 8),
   405	            "return_5m": round(ret_5m, 8),
   406	            "return_15m": round(ret_15m, 8),
   407	            "volume_last": round(volume_last, 4),
   408	            "volume_avg_10": round(volume_avg_10, 4),
   409	            "volatility_10": round(volatility_10, 8),
   410	            "microstructure_toxicity_score_bps": round(volatility_10 * 10_000, 8),
   411	        },
   412	    }
