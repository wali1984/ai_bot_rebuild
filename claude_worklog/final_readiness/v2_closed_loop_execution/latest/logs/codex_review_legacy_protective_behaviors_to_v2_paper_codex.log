    37	                "V2_PAPER_TRAINER_WRAPPER",
    38	                "V2_TRAINER_BRIDGE",
    39	                "V2_NATIVE_TRAINER",
    40	            }
    41	        )
    42	    )
    43	
    44	
    45	def _number(value: Any) -> float | None:
    46	    if value in (None, ""):
    47	        return None
    48	    try:
    49	        return float(value)
    50	    except (TypeError, ValueError):
    51	        return None
    52	
    53	
    54	def _string(value: Any) -> str:
    55	    return str(value or "").strip()
    56	
    57	
    58	def _symbols(value: Any) -> list[str]:
    59	    if isinstance(value, str):
    60	        raw = [value]
    61	    elif isinstance(value, list):
    62	        raw = value
    63	    else:
    64	        raw = []
    65	    return sorted({_string(item).upper() for item in raw if _string(item)})
    66	
    67	
    68	def _bool_with_default(value: Any, default: bool = False) -> bool:
    69	    if value is None:
    70	        return default
    71	    if isinstance(value, bool):
    72	        return value
    73	    if isinstance(value, str):
    74	        text = value.strip().lower()
    75	        if text in {"true", "1", "yes", "y"}:
    76	            return True
    77	        if text in {"false", "0", "no", "n"}:
    78	            return False
    79	    return bool(value)
    80	
    81	
    82	def _first(record: Mapping[str, Any], *keys: str) -> Any:
    83	    for key in keys:
    84	        value = record.get(key)
    85	        if value not in (None, ""):
    86	            return value
    87	    return None
    88	
    89	
    90	def score_paper_edge(
    91	    record: Mapping[str, Any],
    92	    *,
    93	    paper_symbols: list[str],
    94	    live_symbols: list[str] | None = None,
    95	    live_gate: str = "blocked_human_only",
    96	    config: PaperEdgeScoringConfig | None = None,
    97	) -> dict[str, Any]:
    98	    cfg = config or PaperEdgeScoringConfig()
    99	    symbol = _string(record.get("symbol")).upper()
   100	    accepted_sources = {item.upper() for item in cfg.accepted_trainer_sources}
   101	    trainer_source = _string(record.get("trainer_source"))
   102	    feature_freshness_state = _string(
   103	        _first(record, "feature_freshness_state", "feature_snapshot_freshness_state")
   104	    ).upper()
   105	    confidence = _number(
   106	        _first(record, "confidence_calibrated", "input_prediction_confidence_calibrated")
   107	    )
   108	    expected_after_cost = _number(
   109	        _first(record, "expected_move_after_cost_bps", "expected_move_after_costs_bps")
   110	    )
   111	    expected_move = _number(_first(record, "expected_move_bps", "predicted_move_bps"))
   112	    fee_bps = _number(_first(record, "fee_bps", "estimated_fee_bps")) or 0.0
   113	    spread_bps = _number(_first(record, "spread_bps", "estimated_spread_bps")) or 0.0
   114	    slippage_bps = _number(_first(record, "slippage_bps", "estimated_slippage_bps")) or 0.0
   115	    funding_risk_bps = _number(
   116	        _first(record, "funding_risk_bps", "funding_bps", "estimated_funding_bps")
   117	    ) or 0.0
   118	    computed_after_cost = (
   119	        None
   120	        if expected_move is None
   121	        else round(expected_move - fee_bps - spread_bps - slippage_bps - funding_risk_bps, 8)
   122	    )
   123	
   124	    blockers: list[str] = []
   125	    if live_gate != "blocked_human_only":
   126	        blockers.append(LIVE_GATE_BLOCK)
   127	    if _symbols(live_symbols or []):
   128	        blockers.append(LIVE_SYMBOLS_BLOCK)
   129	    if symbol not in set(_symbols(paper_symbols)):
   130	        blockers.append(SYMBOL_NOT_PAPER_ELIGIBLE_BLOCK)
   131	    if not trainer_source or trainer_source.upper() not in accepted_sources:
   132	        blockers.append(TRAINER_SOURCE_MISSING_BLOCK)
   133	    if not feature_freshness_state:
   134	        blockers.append(FEATURE_FRESHNESS_MISSING_BLOCK)
   135	    elif feature_freshness_state != "CURRENT":
   136	        blockers.append(FEATURE_STALE_BLOCK)
   137	    if expected_after_cost is None:
   138	        blockers.append(EDGE_AFTER_COSTS_MISSING_BLOCK)
   139	    elif expected_after_cost < cfg.min_expected_move_after_cost_bps:
   140	        blockers.append(EDGE_AFTER_COSTS_NEGATIVE_BLOCK)
   141	    if confidence is None or confidence < cfg.min_confidence_calibrated:
   142	        blockers.append(CONFIDENCE_TOO_LOW_BLOCK)
   143	    if not _bool_with_default(record.get("cooldown_clear")):
   144	        blockers.append(COOLDOWN_BLOCK)
   145	    if not _bool_with_default(
   146	        _first(record, "flip_churn_clear", "churn_clear", "flip_clear"),
   147	    ):
   148	        blockers.append(FLIP_CHURN_BLOCK)
   149	    reduce_only_clear = _bool_with_default(
   150	        _first(record, "reduce_only_clear", "reduce_only_protection_clear")
   151	    )
   152	    intelligent_close_clear = _bool_with_default(
   153	        _first(record, "intelligent_close_guard_clear", "close_guard_clear")
   154	    )
   155	    microstructure_clear = _bool_with_default(
   156	        _first(record, "microstructure_toxicity_clear", "toxicity_clear")
   157	    )
   158	    if not reduce_only_clear:
   159	        blockers.append(REDUCE_ONLY_PROTECTION_BLOCK)
   160	    if not intelligent_close_clear:
   161	        blockers.append(INTELLIGENT_CLOSE_GUARD_BLOCK)
   162	    if not microstructure_clear:
   163	        blockers.append(MICROSTRUCTURE_TOXICITY_BLOCK)
   164	    if _string(record.get("risk_action")).lower() != "allow":
   165	        blockers.append(RISK_GATE_BLOCK)
   166	
   167	    allowed = not blockers
   168	    classification = EDGE_AFTER_COSTS_PASS if allowed else blockers[0]
   169	    edge_score = expected_after_cost if allowed and expected_after_cost is not None else None
   170	    return {
   171	        "fill_allowed": allowed,
   172	        "classification": classification,
   173	        "blockers": blockers,
   174	        "trainer_source": trainer_source,
   175	        "feature_freshness_state": feature_freshness_state or "",
   176	        "confidence_calibrated": confidence,
   177	        "expected_move_bps": expected_move,
   178	        "expected_move_after_cost_bps": expected_after_cost,
   179	        "computed_expected_move_after_cost_bps": computed_after_cost,
   180	        "fee_bps": fee_bps,
   181	        "spread_bps": spread_bps,
   182	        "slippage_bps": slippage_bps,
   183	        "funding_risk_bps": funding_risk_bps,
   184	        "edge_score": edge_score,
   185	        "paper_symbol_allowed": symbol in set(_symbols(paper_symbols)),
   186	        "live_gate": live_gate,
   187	        "live_symbols": _symbols(live_symbols or []),
   188	        "reduce_only_clear": reduce_only_clear,
   189	        "intelligent_close_guard_clear": intelligent_close_clear,
   190	        "microstructure_toxicity_clear": microstructure_clear,
   191	        "min_expected_move_after_cost_bps": cfg.min_expected_move_after_cost_bps,
   192	        "min_confidence_calibrated": cfg.min_confidence_calibrated,
   193	    }

