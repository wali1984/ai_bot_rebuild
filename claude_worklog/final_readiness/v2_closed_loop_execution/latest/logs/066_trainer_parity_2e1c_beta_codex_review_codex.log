0001: class LivenessStreamGrowthDomainError(ValueError):
0002:     def __init__(self, reason: str, *, field: str | None = None) -> None:
0003:         self.reason = reason
0004:         self.field = field
0005:         message = reason if field is None else f"{field}: {reason}"
0006:         super().__init__(message)
