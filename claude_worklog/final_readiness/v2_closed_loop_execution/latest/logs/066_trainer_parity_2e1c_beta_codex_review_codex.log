===== BEGIN v2/backend/app/domain/liveness_stream_growth/growth_calculator.py =====
0001: from __future__ import annotations
0002: 
0003: from .errors import LivenessStreamGrowthDomainError
0004: from .growth_window_config import GrowthWindowConfig
0005: from .stream_observation import StreamIdObservation, _ensure_stream_name
0006: 
0007: 
0008: def compute_stream_id_growth_in_window(
0009:     observations: tuple[StreamIdObservation, ...],
0010:     config: GrowthWindowConfig,
0011:     now_ms: int,
0012:     *,
0013:     stream_name: str,
0014: ) -> int:
0015:     if not isinstance(observations, tuple):
0016:         raise LivenessStreamGrowthDomainError("observations_not_tuple", field="observations")
0017:     if not isinstance(config, GrowthWindowConfig):
0018:         raise LivenessStreamGrowthDomainError("must_be_growth_window_config", field="config")
0019:     if type(now_ms) is not int:
0020:         raise LivenessStreamGrowthDomainError("must_be_int", field="now_ms")
0021:     if now_ms < 0:
0022:         raise LivenessStreamGrowthDomainError("must_be_nonnegative", field="now_ms")
0023:     _ensure_stream_name(stream_name, field="stream_name")
0024: 
0025:     lo = now_ms - config.window_ms
0026:     distinct_stream_ids: set[str] = set()
0027: 
0028:     for observation in observations:
0029:         if not isinstance(observation, StreamIdObservation):
0030:             raise LivenessStreamGrowthDomainError("must_be_stream_id_observation", field="observations")
0031:         # A future observation invalidates the entire supplied window before stream filtering.
0032:         if observation.observation_ts_ms > now_ms:
0033:             raise LivenessStreamGrowthDomainError("observation_in_future", field="observation_ts_ms")
0034:         if observation.stream_name != stream_name:
0035:             continue
0036:         if config.boundary_inclusive:
0037:             in_window = observation.observation_ts_ms >= lo
0038:         else:
0039:             in_window = observation.observation_ts_ms > lo
0040:         if in_window:
0041:             # Redis stream IDs are counted as literal observed IDs, not normalized numeric offsets.
0042:             distinct_stream_ids.add(observation.stream_id)
0043: 
0044:     return len(distinct_stream_ids)
===== END v2/backend/app/domain/liveness_stream_growth/growth_calculator.py =====
