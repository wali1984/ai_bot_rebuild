0001: from __future__ import annotations
0002: 
0003: from dataclasses import dataclass
0004: 
0005: from .errors import LivenessStreamGrowthDomainError
0006: 
0007: 
0008: _STREAM_NAME_ALLOWED = frozenset("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_:.-")
0009: 
0010: 
0011: def _ensure_stream_name(value: str, *, field: str) -> None:
0012:     if not isinstance(value, str):
0013:         raise LivenessStreamGrowthDomainError("must_be_str", field=field)
0014:     if value == "":
0015:         raise LivenessStreamGrowthDomainError("must_be_nonempty", field=field)
0016:     if value != value.strip():
0017:         raise LivenessStreamGrowthDomainError("must_not_have_edge_whitespace", field=field)
0018:     if any(char.isspace() for char in value):
0019:         raise LivenessStreamGrowthDomainError("must_not_have_whitespace", field=field)
0020:     if "/" in value or "\\" in value:
0021:         raise LivenessStreamGrowthDomainError("must_not_have_path_separator", field=field)
0022:     if any(char not in _STREAM_NAME_ALLOWED for char in value):
0023:         raise LivenessStreamGrowthDomainError("invalid_characters", field=field)
0024: 
0025: 
0026: def _parse_stream_id(value: str, *, field: str) -> tuple[int, int]:
0027:     if not isinstance(value, str):
0028:         raise LivenessStreamGrowthDomainError("must_be_str", field=field)
0029:     if value == "":
0030:         raise LivenessStreamGrowthDomainError("must_be_nonempty", field=field)
0031:     if value.count("-") != 1:
0032:         raise LivenessStreamGrowthDomainError("must_have_single_separator", field=field)
0033: 
0034:     ms_part, seq_part = value.split("-", 1)
0035:     if not _is_ascii_decimal(ms_part) or not _is_ascii_decimal(seq_part):
0036:         raise LivenessStreamGrowthDomainError("must_be_decimal_stream_id", field=field)
0037: 
0038:     ms = int(ms_part, 10)
0039:     seq = int(seq_part, 10)
0040:     if ms < 0 or seq < 0:
0041:         raise LivenessStreamGrowthDomainError("must_be_nonnegative", field=field)
0042:     return ms, seq
0043: 
0044: 
0045: def _is_ascii_decimal(value: str) -> bool:
0046:     return value != "" and all("0" <= char <= "9" for char in value)
0047: 
0048: 
0049: @dataclass(frozen=True, slots=True)
0050: class StreamIdObservation:
0051:     stream_name: str
0052:     stream_id: str
0053:     observation_ts_ms: int
0054: 
0055:     def __post_init__(self) -> None:
0056:         _ensure_stream_name(self.stream_name, field="stream_name")
0057:         _parse_stream_id(self.stream_id, field="stream_id")
0058:         if type(self.observation_ts_ms) is not int:
0059:             raise LivenessStreamGrowthDomainError("must_be_int", field="observation_ts_ms")
0060:         if self.observation_ts_ms < 0:
0061:             raise LivenessStreamGrowthDomainError("must_be_nonnegative", field="observation_ts_ms")
0062: 
0063:     def parsed_id(self) -> tuple[int, int]:
0064:         return _parse_stream_id(self.stream_id, field="stream_id")
===== END v2/backend/app/domain/liveness_stream_growth/stream_observation.py =====

