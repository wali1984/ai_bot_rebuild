   536	    def emit_trainer_consumable_snapshot(self, inputs: NativeFeatureInputs) -> dict[str, Any]:
   537	        """Produce a trainer-consumable snapshot payload.
   538	
   539	        Schema: v2_native_feature_snapshot_v1. Includes the full feature
   540	        dict, snapshot id, categories present, explicit missing/stale
   541	        flag arrays, source freshness, an overall feature_freshness_state,
   542	        and the trainer_consumable=true marker.
   543	        """
   544	        result = compute_feature_snapshot(
   545	            inputs,
   546	            ohlcv_max_age_seconds=self.ohlcv_max_age_seconds,
   547	            orderbook_max_age_seconds=self.orderbook_max_age_seconds,
   548	            funding_max_age_seconds=self.funding_max_age_seconds,
   549	            oi_max_age_seconds=self.oi_max_age_seconds,
   550	            liquidation_max_age_seconds=self.liquidation_max_age_seconds,
   551	            paper_position_max_age_seconds=self.paper_position_max_age_seconds,
   552	        )
   553	        any_input_present = any(v is not None for v in result.source_inputs_age_seconds.values())
   554	        if result.stale_feature_flags:
   555	            freshness_state = "STALE"
   556	        elif not any_input_present:
   557	            freshness_state = "MISSING"
   558	        else:
   559	            freshness_state = "CURRENT"
