   519	    def compute(self, inputs: NativeFeatureInputs) -> dict[str, Any]:
   520	        result = compute_feature_snapshot(
   521	            inputs,
   522	            ohlcv_max_age_seconds=self.ohlcv_max_age_seconds,
   523	            orderbook_max_age_seconds=self.orderbook_max_age_seconds,
   524	            funding_max_age_seconds=self.funding_max_age_seconds,
   525	            oi_max_age_seconds=self.oi_max_age_seconds,
   526	            liquidation_max_age_seconds=self.liquidation_max_age_seconds,
   527	            paper_position_max_age_seconds=self.paper_position_max_age_seconds,
   528	        )
   529	        # asdict converts the snapshot to a plain dict for JSON emission.
   530	        out = asdict(result)
   531	        out["legacy_behavior_mapping"] = {k: v for k, v in LEGACY_SOURCES.items()}
   532	        out["live_gate"] = LIVE_GATE_STATUS
   533	        out["live_symbols"] = []
   534	        return out
