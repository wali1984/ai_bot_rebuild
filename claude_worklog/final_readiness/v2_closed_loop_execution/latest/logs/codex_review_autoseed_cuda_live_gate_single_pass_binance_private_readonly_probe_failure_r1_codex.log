   965	def build_success_status(
   966	    *,
   967	    decision: RiskDecisionRecord,
   968	    ledger_entry: PaperExecutionLedgerEntry,
   969	    source_payload_path: str,
   970	    run_started_ts: str,
   971	    symbol_scope: Dict[str, Any],
   972	    source_record: Dict[str, Any],
   973	    edge_gate: Optional[Dict[str, Any]] = None,
   974	    paper_filter_status: Optional[Dict[str, Any]] = None,
   975	) -> Dict[str, Any]:
   976	    fill_block = _build_simulated_fill(risk_reason_code=decision.risk_reason_code)
   977	    is_allow = decision.risk_action == "allow"
   978	    fills_total = 1 if is_allow else 0
   979	    denials_total = 0 if is_allow else 1
