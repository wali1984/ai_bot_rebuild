   289	def persist_global_aggregate_to_v2_redis(
   290	    redis_client: Any,
   291	    aggregate: Mapping[str, Any],
   292	    *,
   293	    ttl_seconds: int,
   294	) -> List[str]:
   295	    written: List[str] = []
   296	    if redis_client is None:
   297	        return written
   298	    now_ms = int(time.time() * 1000)
   299	    for name in (
   300	        "total_oi",
   301	        "total_volume",
   302	        "total_liquidations",
   303	        "long_short_ratio",
   304	        "funding_rate_avg",
   305	        "btc_dominance",
   306	        "eth_dominance",
   307	        "alt_season_index",
   308	        "fear_greed",
   309	        "market_sentiment",
   310	        "volatility_index",
   311	    ):
   312	        value = aggregate.get(name, 0.0)
   313	        payload = {
   314	            "value": value,
   315	            "ts_ms": now_ms,
   316	            "timestamp": now_ms,
   317	            "source": "v2_coinank_and_liquidation_bridge",
   318	            "trainer_contract_key": f"features:global_coinank:{name}:latest",
   319	            "live_gate": LIVE_GATE_STATUS,
   320	            "live_symbols": [],
   321	        }
   322	        for prefix in V2_REDIS_GLOBAL_KEY_PREFIXES:
   323	            key = f"{prefix}:{name}:latest"
   324	            if _safe_redis_set_json(redis_client, key, payload, ex=ttl_seconds):
   325	                written.append(key)
   326	    heartbeat = {
   327	        "ts_ms": now_ms,
   328	        "source": "v2_coinank_and_liquidation_bridge",
   329	        "global_key_count": len(written),
   330	        "live_gate": LIVE_GATE_STATUS,
   331	        "live_symbols": [],
   332	    }
   333	    if _safe_redis_set_json(redis_client, "v2:coinank:global:last_update", heartbeat, ex=ttl_seconds):
   334	        written.append("v2:coinank:global:last_update")
   335	    return written
