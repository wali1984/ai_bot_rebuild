   856	def evaluate_paper_edge_gate(
   857	    *,
   858	    decision: RiskDecisionRecord,
   859	    source_record: Dict[str, Any],
   860	    symbol_scope: Dict[str, Any],
   861	) -> Dict[str, Any]:
   862	    enriched = {
   863	        **source_record,
   864	        "symbol": decision.symbol,
   865	        "risk_action": decision.risk_action,
   866	    }
   867	    # The paper execution worker owns cooldown/churn through the paper
   868	    # canary filter. Missing upstream clear flags should not cause the
   869	    # edge gate to mask filter-specific denials.
   870	    for key in (
   871	        "cooldown_clear",
   872	        "flip_churn_clear",
   873	        "reduce_only_clear",
   874	        "intelligent_close_guard_clear",
   875	        "microstructure_toxicity_clear",
   876	    ):
   877	        if enriched.get(key) in (None, ""):
   878	            enriched[key] = True
   879	    return score_paper_edge(
   880	        enriched,
   881	        paper_symbols=[str(item) for item in symbol_scope.get("paper_symbols", [])],
   882	        live_symbols=[],
   883	        live_gate=LIVE_GATE_STATUS,
   884	    )
