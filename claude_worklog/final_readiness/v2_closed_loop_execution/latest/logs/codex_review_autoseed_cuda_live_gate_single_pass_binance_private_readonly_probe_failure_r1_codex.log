    95	def _parse_env_file_names_and_values(path: Path) -> Dict[str, str]:
    96	    """Parse a dotenv-style file. Returns name->raw value mapping.
    97	
    98	    Raw values are kept *only* inside this function call's return value
    99	    and are never logged. Callers that don't need the values should call
   100	    :func:`load_credentials` instead, which strips values immediately.
   101	    """
   102	    out: Dict[str, str] = {}
   103	    if not path.is_file():
   104	        return out
   105	    for raw in path.read_text().splitlines():
   106	        line = raw.strip()
   107	        if not line or line.startswith("#"):
   108	            continue
   109	        if "=" not in line:
   110	            continue
   111	        k, v = line.split("=", 1)
   112	        k = k.strip()
   113	        v = v.strip()
   114	        # strip optional surrounding quotes without leaking content
   115	        if (len(v) >= 2) and ((v[0] == v[-1]) and v[0] in ("'", '"')):
   116	            v = v[1:-1]
   117	        if k:
   118	            out[k] = v
   119	    return out
