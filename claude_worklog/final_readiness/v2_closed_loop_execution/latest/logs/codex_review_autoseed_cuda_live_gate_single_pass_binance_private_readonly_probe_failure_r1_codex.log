   148	        f"https://fapi.binance.com/fapi/v1/ticker/bookTicker?{encoded}"
   149	    )
   150	    klines = _http_json(klines_url)
   151	    candles = [
   152	        {
   153	            "ts_ms": int(row[0]),
   154	            "open": float(row[1]),
   155	            "high": float(row[2]),
   156	            "low": float(row[3]),
   157	            "close": float(row[4]),
   158	            "volume": float(row[5]),
   159	        }
   160	        for row in klines
   161	    ]
   162	    last = candles[-1] if candles else {}
