   248	def run_once(args: argparse.Namespace) -> Dict[str, Any]:
   249	    run_started_ts = iso_now()
   250	    try:
   251	        payload, src = load_payload(args)
   252	    except Exception as exc:
   253	        status = emit_idle_status(f"payload_load_failed: {exc}")
   254	        write_status(status)
   255	        return status
   256	    try:
   257	        snapshot = FeatureSnapshotService().build_snapshot(payload)
   258	    except KeyError as exc:
   259	        status = emit_idle_status(f"required_field_missing_from_payload: {exc}")
   260	        status["source_payload_path"] = src
   261	        write_status(status)
   262	        return status
   263	    status = build_status(snapshot, src, run_started_ts)
   264	    write_status(status)
   265	    return status
