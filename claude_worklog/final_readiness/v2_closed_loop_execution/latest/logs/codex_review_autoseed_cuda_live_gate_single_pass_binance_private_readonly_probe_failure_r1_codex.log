   241	            report_keys[name] = KEY_PRESENT
   242	            source_of[name] = "os_environ_preexisting"
   243	            continue
   244	        resolved_value: Optional[str] = None
   245	        resolved_path: Optional[str] = None
   246	        for p, parsed in parsed_by_path:
