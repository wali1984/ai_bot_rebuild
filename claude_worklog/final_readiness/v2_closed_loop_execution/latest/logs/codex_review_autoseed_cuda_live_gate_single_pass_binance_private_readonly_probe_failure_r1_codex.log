   156	def _flatten_entry_fields(fields: dict[str, Any]) -> dict[str, Any]:
   157	    flattened = dict(fields)
   158	    for key in ("data", "payload", "json", "message", "event"):
   159	        value = fields.get(key)
   160	        if isinstance(value, dict):
   161	            for nested_key, nested_value in value.items():
   162	                flattened.setdefault(str(nested_key), nested_value)
   163	    return flattened
