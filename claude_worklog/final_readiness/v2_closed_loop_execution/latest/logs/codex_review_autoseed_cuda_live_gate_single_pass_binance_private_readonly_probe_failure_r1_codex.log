   455	def run_once(
   456	    args: argparse.Namespace,
   457	    *,
   458	    service: Optional[CoinankBridgeService] = None,
   459	    unified_features_by_symbol: Optional[Dict[str, Dict[str, Any]]] = None,
   460	    binance_force_events: Optional[List[Dict[str, Any]]] = None,
   461	    coinank_order_items: Optional[List[Dict[str, Any]]] = None,
   462	    current_prices: Optional[Dict[str, float]] = None,
   463	    fetcher=None,
   464	) -> Dict[str, Any]:
   465	    """Single bridge cycle.
   466	
   467	    Parameters other than ``args`` are dependency-injected by tests. In
   468	    production (when ``--once`` runs on a host), they default to:
   469	
   470	      - ``unified_features_by_symbol``: empty (no Redis client). The CLI
   471	        therefore reports zero-aggregate global values and labels
   472	        ``v2_liquidation_event_source_empty`` if no events were provided.
   473	      - ``binance_force_events``: empty. Labelled
   474	        ``binance_force_order_ws_owner_unbound``.
   475	      - ``coinank_order_items``: fetched via public REST when
   476	        ``--enable-coinank-rest`` is passed; otherwise empty.
   477	
   478	    The worker never synthesizes events.
   479	    """
   480	    run_started_ts = iso_now()
   481	    t0 = time.time()
   482	    if service is None:
   483	        service = CoinankBridgeService(clock=time.time)
   484	    if fetcher is None:
   485	        fetcher = http_get
   486	
   487	    redis_client = None
   488	    redis_input_status: Dict[str, Any] = {
   489	        "enabled": False,
   490	        "symbols_requested": 0,
   491	        "symbols_with_any_input": 0,
   492	        "read_key_count": 0,
   493	        "read_keys_sample": [],
   494	    }
   495	    # If the caller did not inject in-memory fixtures, the runtime path can
   496	    # read V2 Redis feature inputs. This never reads old Redis keys.
   497	    symbol_set = [
   498	        s.upper() for s in _v2_resolve_symbols(
   499	            explicit=args.symbols, smoke_test=getattr(args, "smoke_test", False),
   500	            include_baseline=True,
   501	        )
   502	    ]
   503	    if unified_features_by_symbol is None and not args.no_v2_redis_features:
   504	        redis_client = _connect_redis()
   505	        if redis_client is not None:
   506	            unified_features_by_symbol, redis_input_status = load_v2_global_feature_inputs(
   507	                redis_client,
   508	                symbol_set,
   509	                args.tf,
   510	            )
   511	
   512	    # 1. Global aggregator over V2 unified/feature inputs.
   513	    feats = unified_features_by_symbol or {}
   514	    if not feats:
   515	        service.record_missing_api_blocker(
   516	            "v2_unified_features_empty",
   517	            "no unified-feature input — V2 worker does not read legacy Redis",
   518	        )
   519	    agg = service.compute_global_11_keys(feats, tf=args.tf)
   520	
   521	    # 2. CoinAnk liquidation orders intake.
   522	    coinank_items: List[Dict[str, Any]] = list(coinank_order_items or [])
   523	    if args.enable_coinank_rest and not coinank_items:
   524	        coinank_items = _fetch_coinank_liquidation_orders(
   525	            fetcher,
   526	            days_back=args.coinank_history_days,
   527	            record_blocker=service.record_missing_api_blocker,
   528	        )
   529	    if coinank_items:
   530	        service.bridge_coinank_orders_into_v2_events(coinank_items)
   531	    else:
   532	        service.record_missing_api_blocker(
   533	            "v2_liquidation_event_source_empty",
   534	            "no coinank liquidation_orders source available this cycle",
   535	        )
   536	
   537	    # 3. Binance force-order intake (WS owner is a separate worker).
   538	    binance_events: List[Dict[str, Any]] = list(binance_force_events or [])
   539	    if binance_events:
   540	        service.bridge_binance_force_into_v2_events(binance_events)
   541	    else:
   542	        service.record_missing_api_blocker(
   543	            "binance_force_order_ws_owner_unbound",
   544	            "no binance force_order events provided; WS owner=separate_v2_ws_worker",
   545	        )
   546	
   547	    # 4. Window aggregations.
   548	    for window in service.AGG_WINDOWS_SECONDS:
   549	        service.aggregate_force_window(window)
   550	
   551	    # 5. Per-(symbol, tf) levels.
   552	    prices = current_prices or {}
   553	    for symbol in symbol_set:
   554	        for tf in service.BUCKET_WIDTH_PCT.keys():
   555	            service.compute_liquidation_levels_mapping(
   556	                symbol, tf, current_price=float(prices.get(symbol, 0.0))
   557	            )
   558	
   559	    # 6. Endpoint manifest + cycle runtime (V2-namespaced mirrors only).
   560	    service.endpoint_manifest_snapshot(
   561	        endpoints=list(GLOBAL_11_KEY_CONTRACT),
   562	        version="3.0.0",
   563	    )
   564	    duration_ms = int((time.time() - t0) * 1000)
   565	    service.cycle_complete_snapshot(
   566	        cycle_id=int(args.cycle_id_seed),
   567	        duration_ms=duration_ms,
   568	        endpoints_active=len(GLOBAL_11_KEY_CONTRACT),
   569	    )
   570	
   571	    status = build_status(
   572	        service,
   573	        symbols=symbol_set,
   574	        tf=args.tf,
   575	        run_started_ts=run_started_ts,
   576	        cycle_id=int(args.cycle_id_seed),
   577	        duration_ms=duration_ms,
   578	    )
   579	    status["global_aggregate_result"] = agg.to_dict()
   580	    if redis_client is None and not args.no_v2_redis_features:
   581	        redis_input_status["enabled"] = False
   582	        redis_input_status["error"] = "redis_unavailable"
   583	    status["v2_redis_feature_input"] = redis_input_status
   584	    status["v2_redis_global_write_enabled"] = bool(args.write_v2_redis)
   585	    status["v2_redis_global_keys_written"] = []
   586	    status["v2_redis_global_keys_written_count"] = 0
   587	    status["writes_legacy_redis"] = False
   588	    if args.write_v2_redis:
   589	        if redis_client is None:
   590	            redis_client = _connect_redis()
   591	        written = persist_global_aggregate_to_v2_redis(
   592	            redis_client,
   593	            agg.to_dict(),
   594	            ttl_seconds=max(60, int(args.v2_redis_ttl_seconds)),
   595	        )
   596	        status["v2_redis_global_keys_written"] = written
   597	        status["v2_redis_global_keys_written_count"] = len(written)
   598	    if not args.no_write:
   599	        write_status(status, service.data_plane)
   600	    return status
