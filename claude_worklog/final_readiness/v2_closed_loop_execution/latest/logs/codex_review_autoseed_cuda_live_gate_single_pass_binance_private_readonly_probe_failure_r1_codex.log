   464	            unified_keys.extend(unified.v2_keys_written)
   465	
   466	            candles = tf_snap.get("ohlcv_list") or []
   467	            if candles:
   468	                ta = service.compute_ta_indicators(sym, tf, candles, now_ms=now_ms)
   469	                if ta.v2_key:
