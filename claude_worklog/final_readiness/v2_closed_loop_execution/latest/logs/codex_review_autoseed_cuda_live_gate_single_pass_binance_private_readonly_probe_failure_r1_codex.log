def iso_now() -> str:
    return dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _try_json(body: str) -> Any:
    if not body:
        return None
    try:
        return json.loads(body)
    except Exception:
        return body


def http_get(url: str) -> Tuple[int, Any]:
    """Stdlib-only public GET fetcher. Used as the default for the service.
    Tests inject their own callable instead.
    """
    request = urllib.request.Request(
        url,
        method="GET",
        headers={"User-Agent": f"ai-bot-v2-{WORKER_ID}-readonly"},
    )
    try:
        with urllib.request.urlopen(request, timeout=8) as response:
            body = response.read().decode("utf-8")
            status = int(response.status)
    except urllib.error.HTTPError as exc:
        try:
            body = exc.read().decode("utf-8")
        except Exception:
            body = ""
        return int(exc.code), _try_json(body)
    except Exception:
        return 599, None
    return status, _try_json(body)


def _connect_redis():
    """Best-effort Redis connector used only when explicit V2 Redis flags run.

    The worker keeps imports lazy so normal module import and tests remain
    offline-safe. All mutation paths route through ``_safe_redis_set_json``.
    """
    try:
        import redis  # type: ignore
    except Exception:
        return None
    try:
        redis_factory = getattr(redis, "Redis")
        client = redis_factory(
            host="127.0.0.1",
            port=6379,
            db=0,
            decode_responses=True,
            socket_connect_timeout=2,
            socket_timeout=3,
        )
        client.ping()
        return client
    except Exception:
        return None


def _safe_redis_set_json(redis_client: Any, key: str, payload: Mapping[str, Any], *, ex: int = 600) -> bool:
    if redis_client is None:
        return False
    if not key.startswith(V2_REDIS_PREFIX):
        raise ValueError(f"refused non-V2 Redis key: {key!r}")
    setter = getattr(redis_client, "set")
    setter(key, json.dumps(dict(payload), sort_keys=True, default=str), ex=int(ex))
    return True


def _redis_get_json(redis_client: Any, key: str) -> Optional[Dict[str, Any]]:
    if redis_client is None or not key.startswith(V2_REDIS_PREFIX):
        return None
    try:
        raw = redis_client.get(key)
    except Exception:
        return None
    if not raw:
        return None
    try:
        data = json.loads(raw)
    except Exception:
        return None
    return data if isinstance(data, dict) else None


def _redis_hgetall(redis_client: Any, key: str) -> Dict[str, Any]:
    if redis_client is None or not key.startswith(V2_REDIS_PREFIX):
        return {}
    try:
        data = redis_client.hgetall(key) or {}
    except Exception:
        return {}
    return dict(data) if isinstance(data, dict) else {}


def _safe_float(value: Any, default: Optional[float] = None) -> Optional[float]:
    try:
        if value is None:
            return default
        return float(value)
    except Exception:
        return default


def _merge_feature_snapshot(target: Dict[str, Any], snapshot: Mapping[str, Any], tf: str) -> None:
    features = snapshot.get("features")
    if not isinstance(features, dict):
        return
    target.update(features)
    if "rsi_14" in features:
        target.setdefault(f"ind_ta_RSI_14_{tf}", features.get("rsi_14"))
    if "htf_rsi_14" in features:
        target.setdefault("ind_ta_RSI_21_15m", features.get("htf_rsi_14"))
    price = _safe_float(features.get("micro_price"))
    atr = _safe_float(features.get("atr_14"))
    if price and atr is not None:
        target.setdefault(f"ind_ta_NATR_28_{tf}", (atr / price) if price else 0.0)
    if "funding_rate" in features:
        target.setdefault("funding_rate", features.get("funding_rate"))


def load_v2_global_feature_inputs(redis_client: Any, symbols: List[str], tf: str) -> Tuple[Dict[str, Dict[str, Any]], Dict[str, Any]]:
    """Read current V2 Redis feature/market inputs for the global aggregator.

    Reads only V2-prefixed keys. Legacy ``features:global_coinank:*`` keys are
    named in payload metadata only and are never read or written.
    """
    by_symbol: Dict[str, Dict[str, Any]] = {}
    read_keys: List[str] = []
    for symbol in symbols:
        s = symbol.upper()
        merged: Dict[str, Any] = {}
        for key in (f"v2:unified_features:{s}:{tf}", f"v2:unified_features:{s}:{tf}:latest"):
            h = _redis_hgetall(redis_client, key)
            if h:
                merged.update(h)
                read_keys.append(key)
        for key in (f"v2:features:latest:{s}:{tf}", f"v2:features:latest:{s}:1m"):
            snap = _redis_get_json(redis_client, key)
            if snap:
                _merge_feature_snapshot(merged, snap, tf)
                read_keys.append(key)
        oi = _redis_get_json(redis_client, f"v2:market:open_interest:{s}")
        if oi:
            merged.setdefault("open_interest", oi.get("openInterest") or oi.get("sumOpenInterest"))
            read_keys.append(f"v2:market:open_interest:{s}")
        funding = _redis_get_json(redis_client, f"v2:market:funding:{s}")
        if funding:
            merged.setdefault("funding_rate", funding.get("lastFundingRate") or funding.get("fundingRate"))
            read_keys.append(f"v2:market:funding:{s}")
        price = _redis_get_json(redis_client, f"v2:market:prices:{s}")
        ticker = price.get("ticker_24hr") if isinstance(price, dict) else None
        if isinstance(ticker, dict):
            merged.setdefault("quote_volume", ticker.get("quoteVolume"))
            merged.setdefault("ccxt_price_change_15m_pct", ticker.get("priceChangePercent"))
            read_keys.append(f"v2:market:prices:{s}")
        by_symbol[s] = merged
    return by_symbol, {
        "enabled": redis_client is not None,
        "symbols_requested": len(symbols),
        "symbols_with_any_input": sum(1 for v in by_symbol.values() if v),
        "read_key_count": len(read_keys),
        "read_keys_sample": read_keys[:25],
    }


def persist_global_aggregate_to_v2_redis(
    redis_client: Any,
    aggregate: Mapping[str, Any],
    *,
    ttl_seconds: int,
) -> List[str]:
    written: List[str] = []
    if redis_client is None:
        return written
    now_ms = int(time.time() * 1000)
    for name in (
        "total_oi",
        "total_volume",
        "total_liquidations",
        "long_short_ratio",
        "funding_rate_avg",
        "btc_dominance",
        "eth_dominance",
        "alt_season_index",
        "fear_greed",
        "market_sentiment",
        "volatility_index",
    ):
        value = aggregate.get(name, 0.0)
        payload = {
            "value": value,
            "ts_ms": now_ms,
            "timestamp": now_ms,
            "source": "v2_coinank_and_liquidation_bridge",
            "trainer_contract_key": f"features:global_coinank:{name}:latest",
            "live_gate": LIVE_GATE_STATUS,
            "live_symbols": [],
        }
        for prefix in V2_REDIS_GLOBAL_KEY_PREFIXES:
            key = f"{prefix}:{name}:latest"
            if _safe_redis_set_json(redis_client, key, payload, ex=ttl_seconds):
                written.append(key)
    heartbeat = {
        "ts_ms": now_ms,
        "source": "v2_coinank_and_liquidation_bridge",
        "global_key_count": len(written),
        "live_gate": LIVE_GATE_STATUS,
        "live_symbols": [],
    }
    if _safe_redis_set_json(redis_client, "v2:coinank:global:last_update", heartbeat, ex=ttl_seconds):
        written.append("v2:coinank:global:last_update")
    return written


def compute_freshness_seconds(ts_ms: Optional[int]) -> int:
    if not ts_ms:
        return -1
    try:
        now_ms = int(time.time() * 1000)
        return max(0, int((now_ms - int(ts_ms)) / 1000))
    except Exception:
        return -1


