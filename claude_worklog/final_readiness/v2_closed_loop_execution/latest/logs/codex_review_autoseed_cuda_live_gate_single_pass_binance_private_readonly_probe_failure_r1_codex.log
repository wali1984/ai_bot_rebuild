   173	def run_redis_read_only(command: str, *args: str) -> subprocess.CompletedProcess[str]:
   174	    upper = command.upper()
   175	    if upper in FORBIDDEN_REDIS_COMMANDS or upper not in READ_ONLY_REDIS_COMMANDS:
   176	        raise ValueError(f"Redis command is not read-only for this bridge: {command}")
   177	    if upper == "MEMORY" and args and args[0].upper() != "USAGE":
   178	        raise ValueError("Only MEMORY USAGE is permitted")
   179	    return _run([*_redis_base_command(), command, *args], timeout=8)
