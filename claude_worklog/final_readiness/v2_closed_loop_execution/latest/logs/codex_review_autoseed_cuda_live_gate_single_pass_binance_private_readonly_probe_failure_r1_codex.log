   543	def parse_args(argv: Optional[List[str]] = None) -> argparse.Namespace:
   544	    parser = argparse.ArgumentParser(prog=WORKER_ID)
   545	    # V2_DYNAMIC_SYMBOL_AND_COPIED_COMPONENT_RUNTIME_REMEDIATION:
   546	    # the legacy ``BTCUSDT`` single-symbol default was flagged by Codex 5.5.
   547	    # The default is now resolved via
   548	    # ``v2.backend.app.services.v2_symbol_runtime_universe.resolve_symbols``
   549	    # which prefers the published dynamic universe and falls back to the
   550	    # 25-symbol baseline. The smoke-test 3-symbol set is only reachable
   551	    # via ``--smoke-test`` or ``V2_SYMBOL_PROFILE=smoke_test``.
   552	    parser.add_argument("--symbol", default=None,
   553	                        help="single symbol; defaults to first dynamic-universe symbol")
   554	    parser.add_argument("--smoke-test", action="store_true")
   555	    parser.add_argument("--timeframe", default="1m")
   556	    parser.add_argument("--interval", type=int, default=FAST_LANE_INTERVAL_SEC)
   557	    parser.add_argument("--once", action="store_true")
   558	    parser.add_argument("--loop", action="store_true")
   559	    parser.add_argument("--no-write", action="store_true")
   560	    parser.add_argument("--input-file", default=None,
   561	                        help="Read snapshot input (per-symbol/tf dict) from a JSON file.")
   562	    parser.add_argument(
   563	        "--paralysis-window-minutes",
   564	        type=float,
   565	        default=PARALYSIS_DETECTOR_DEFAULT_MINUTES,
   566	    )
   567	    parser.add_argument("--verify-baseline-shas", action="store_true")
   568	    args = parser.parse_args(argv)
   569	    if not args.loop and not args.once:
   570	        args.once = True
   571	    # Resolve --symbol if not explicitly provided.
   572	    if not args.symbol:
   573	        from v2.backend.app.services.v2_symbol_runtime_universe import (
   574	            resolve_symbols as _v2_resolve_symbols,
   575	        )
   576	        resolved = _v2_resolve_symbols(
   577	            explicit=None, smoke_test=args.smoke_test, include_baseline=True
   578	        )
   579	        if not resolved:
   580	            raise SystemExit(
   581	                "V2_SYMBOL_DEFAULT_DRIFT: cannot resolve any symbol from the "
   582	                "dynamic universe or 25-baseline; pass --symbol explicitly"
   583	            )
   584	        args.symbol = resolved[0]
   585	    return args
   586	
   587	
   588	def main(argv: Optional[List[str]] = None) -> int:
   589	    args = parse_args(argv)
   590	    if args.verify_baseline_shas:
   591	        report = verify_baseline_shas()
   592	        print(json.dumps(report, indent=2, sort_keys=True))
   593	        return 0 if report["ok"] else 2
