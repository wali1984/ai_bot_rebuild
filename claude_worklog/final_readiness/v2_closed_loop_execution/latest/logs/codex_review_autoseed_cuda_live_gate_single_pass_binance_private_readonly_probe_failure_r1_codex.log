   439	        record_blocker(
   440	            "coinank_liquidation_orders_endpoint_unreachable",
   441	            f"http_status={status}",
   442	        )
   443	        return []
   444	    data = body.get("data") or {}
   445	    items = data.get("data") if isinstance(data, dict) else None
   446	    if not isinstance(items, list):
   447	        record_blocker(
   448	            "coinank_endpoint_no_current_key",
   449	            "liquidation_orders response had no data.data list",
   450	        )
