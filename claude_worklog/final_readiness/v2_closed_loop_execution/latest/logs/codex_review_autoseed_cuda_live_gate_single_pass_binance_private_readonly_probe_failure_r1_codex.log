    91	def score_paper_edge(
    92	    record: Mapping[str, Any],
    93	    *,
    94	    paper_symbols: list[str],
    95	    live_symbols: list[str] | None = None,
    96	    live_gate: str = "blocked_human_only",
    97	    config: PaperEdgeScoringConfig | None = None,
    98	) -> dict[str, Any]:
    99	    cfg = config or PaperEdgeScoringConfig()
   100	    symbol = _string(record.get("symbol")).upper()
   101	    accepted_sources = {item.upper() for item in cfg.accepted_trainer_sources}
   102	    trainer_source = _string(record.get("trainer_source"))
   103	    feature_freshness_state = _string(
   104	        _first(record, "feature_freshness_state", "feature_snapshot_freshness_state")
   105	    ).upper()
   106	    confidence = _number(
   107	        _first(record, "confidence_calibrated", "input_prediction_confidence_calibrated")
   108	    )
   109	    expected_after_cost = _number(
   110	        _first(record, "expected_move_after_cost_bps", "expected_move_after_costs_bps")
   111	    )
   112	    expected_move = _number(_first(record, "expected_move_bps", "predicted_move_bps"))
   113	    fee_bps = _number(_first(record, "fee_bps", "estimated_fee_bps")) or 0.0
   114	    spread_bps = _number(_first(record, "spread_bps", "estimated_spread_bps")) or 0.0
   115	    slippage_bps = _number(_first(record, "slippage_bps", "estimated_slippage_bps")) or 0.0
   116	    funding_risk_bps = _number(
   117	        _first(record, "funding_risk_bps", "funding_bps", "estimated_funding_bps")
   118	    ) or 0.0
   119	    computed_after_cost = (
   120	        None
   121	        if expected_move is None
   122	        else round(expected_move - fee_bps - spread_bps - slippage_bps - funding_risk_bps, 8)
   123	    )
   124	
   125	    blockers: list[str] = []
   126	    if live_gate != "blocked_human_only":
   127	        blockers.append(LIVE_GATE_BLOCK)
   128	    if _symbols(live_symbols or []):
   129	        blockers.append(LIVE_SYMBOLS_BLOCK)
   130	    if symbol not in set(_symbols(paper_symbols)):
   131	        blockers.append(SYMBOL_NOT_PAPER_ELIGIBLE_BLOCK)
   132	    if not trainer_source or trainer_source.upper() not in accepted_sources:
   133	        blockers.append(TRAINER_SOURCE_MISSING_BLOCK)
   134	    if not feature_freshness_state:
   135	        blockers.append(FEATURE_FRESHNESS_MISSING_BLOCK)
   136	    elif feature_freshness_state != "CURRENT":
   137	        blockers.append(FEATURE_STALE_BLOCK)
   138	    if expected_after_cost is None:
   139	        blockers.append(EDGE_AFTER_COSTS_MISSING_BLOCK)
   140	    elif expected_after_cost < cfg.min_expected_move_after_cost_bps:
   141	        blockers.append(EDGE_AFTER_COSTS_NEGATIVE_BLOCK)
   142	    if confidence is None or confidence < cfg.min_confidence_calibrated:
   143	        blockers.append(CONFIDENCE_TOO_LOW_BLOCK)
   144	    if not _bool_with_default(record.get("cooldown_clear")):
   145	        blockers.append(COOLDOWN_BLOCK)
   146	    if not _bool_with_default(
   147	        _first(record, "flip_churn_clear", "churn_clear", "flip_clear"),
   148	    ):
   149	        blockers.append(FLIP_CHURN_BLOCK)
   150	    reduce_only_clear = _bool_with_default(
   151	        _first(record, "reduce_only_clear", "reduce_only_protection_clear")
   152	    )
   153	    intelligent_close_clear = _bool_with_default(
   154	        _first(record, "intelligent_close_guard_clear", "close_guard_clear")
   155	    )
   156	    microstructure_clear = _bool_with_default(
   157	        _first(record, "microstructure_toxicity_clear", "toxicity_clear")
   158	    )
   159	    if not reduce_only_clear:
   160	        blockers.append(REDUCE_ONLY_PROTECTION_BLOCK)
   161	    if not intelligent_close_clear:
   162	        blockers.append(INTELLIGENT_CLOSE_GUARD_BLOCK)
   163	    if not microstructure_clear:
   164	        blockers.append(MICROSTRUCTURE_TOXICITY_BLOCK)
   165	    if _string(record.get("risk_action")).lower() != "allow":
   166	        blockers.append(RISK_GATE_BLOCK)
   167	
   168	    allowed = not blockers
   169	    classification = EDGE_AFTER_COSTS_PASS if allowed else blockers[0]
   170	    edge_score = expected_after_cost if allowed and expected_after_cost is not None else None
   171	    return {
   172	        "fill_allowed": allowed,
   173	        "classification": classification,
   174	        "blockers": blockers,
   175	        "trainer_source": trainer_source,
   176	        "feature_freshness_state": feature_freshness_state or "",
   177	        "confidence_calibrated": confidence,
   178	        "expected_move_bps": expected_move,
   179	        "expected_move_after_cost_bps": expected_after_cost,
   180	        "computed_expected_move_after_cost_bps": computed_after_cost,
   181	        "fee_bps": fee_bps,
   182	        "spread_bps": spread_bps,
   183	        "slippage_bps": slippage_bps,
   184	        "funding_risk_bps": funding_risk_bps,
   185	        "edge_score": edge_score,
   186	        "paper_symbol_allowed": symbol in set(_symbols(paper_symbols)),
   187	        "live_gate": live_gate,
   188	        "live_symbols": _symbols(live_symbols or []),
   189	        "reduce_only_clear": reduce_only_clear,
   190	        "intelligent_close_guard_clear": intelligent_close_clear,
   191	        "microstructure_toxicity_clear": microstructure_clear,
   192	        "min_expected_move_after_cost_bps": cfg.min_expected_move_after_cost_bps,
   193	        "min_confidence_calibrated": cfg.min_confidence_calibrated,
   194	    }

