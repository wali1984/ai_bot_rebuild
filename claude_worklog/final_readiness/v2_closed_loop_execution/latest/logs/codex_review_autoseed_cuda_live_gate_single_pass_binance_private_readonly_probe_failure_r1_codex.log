   239	    PUBLIC_RUNTIME_DIR.mkdir(parents=True, exist_ok=True)
   240	    LOCAL_RUNTIME_DIR.mkdir(parents=True, exist_ok=True)
   241	    WORKER_STATUS_DIR.mkdir(parents=True, exist_ok=True)
   242	    payload = json.dumps(status, indent=2, sort_keys=True, default=str)
   243	    PUBLIC_STATUS_FILE.write_text(payload)
   244	    LOCAL_STATUS_FILE.write_text(payload)
