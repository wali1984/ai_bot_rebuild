   338	def compute_freshness_seconds(ts_ms: Optional[int]) -> int:
   339	    if not ts_ms:
   340	        return -1
   341	    try:
   342	        now_ms = int(time.time() * 1000)
   343	        return max(0, int((now_ms - int(ts_ms)) / 1000))
   344	    except Exception:
   345	        return -1
