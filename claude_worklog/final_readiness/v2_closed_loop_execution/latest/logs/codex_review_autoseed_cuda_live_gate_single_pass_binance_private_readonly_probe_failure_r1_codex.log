            "independent_audit_reconciliation": "claude_worklog/final_readiness/independent_migration_audit_reconciliation/latest/INDEPENDENT_AUDIT_RECONCILIATION_REPORT.md",
            "native_algorithmic_core_migration": "v2/frontend/public/native_algorithmic_core_migration/latest/operator_dashboard_payload.json",
