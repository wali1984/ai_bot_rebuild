   182	def read_latest_stream_entry(key: str) -> dict[str, Any]:
   183	    type_result = run_redis_read_only("TYPE", key)
   184	    redis_type = type_result.stdout.strip() if type_result.returncode == 0 else "unknown"
   185	    status: dict[str, Any] = {
   186	        "key": key,
   187	        "redis_type": redis_type,
   188	        "stream_length": None,
   189	        "latest_entry": None,
   190	        "status": "MISSING_OR_NON_STREAM",
   191	        "read_only": True,
   192	        "redis_write": False,
   193	    }
   194	    if redis_type != "stream":
   195	        return status
   196	    len_result = run_redis_read_only("XLEN", key)
   197	    if len_result.returncode == 0:
   198	        try:
   199	            status["stream_length"] = int(len_result.stdout.strip() or "0")
   200	        except ValueError:
   201	            status["stream_length"] = None
   202	    latest_result = run_redis_read_only("XREVRANGE", key, "+", "-", "COUNT", "1")
   203	    if latest_result.returncode != 0 or not latest_result.stdout.strip():
   204	        status["status"] = "STREAM_EMPTY_OR_UNREADABLE"
   205	        return status
   206	    lines = [line for line in latest_result.stdout.splitlines() if line != ""]
   207	    entry_id = lines[0]
   208	    field_lines = lines[1:]
   209	    fields: dict[str, Any] = {}
   210	    for index in range(0, len(field_lines) - 1, 2):
   211	        raw_key = field_lines[index]
   212	        raw_value = field_lines[index + 1]
   213	        fields[raw_key] = _redact_value(raw_key, _decode_redis_value(raw_value))
   214	    flat_fields = _flatten_entry_fields(fields)
   215	    last_event_at = stream_id_to_iso(entry_id)
   216	    status["latest_entry"] = {
   217	        "stream_id": entry_id,
   218	        "last_event_at": last_event_at,
   219	        "age_seconds": age_seconds_from_iso(last_event_at),
   220	        "fields": fields,
   221	        "flat_fields": flat_fields,
   222	    }
   223	    status["status"] = "STREAM_LATEST_ENTRY_OBSERVED"
   224	    return status
