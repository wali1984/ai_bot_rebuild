   244	def load_v2_global_feature_inputs(redis_client: Any, symbols: List[str], tf: str) -> Tuple[Dict[str, Dict[str, Any]], Dict[str, Any]]:
   245	    """Read current V2 Redis feature/market inputs for the global aggregator.
   246	
   247	    Reads only V2-prefixed keys. Legacy ``features:global_coinank:*`` keys are
   248	    named in payload metadata only and are never read or written.
   249	    """
   250	    by_symbol: Dict[str, Dict[str, Any]] = {}
   251	    read_keys: List[str] = []
   252	    for symbol in symbols:
   253	        s = symbol.upper()
   254	        merged: Dict[str, Any] = {}
   255	        for key in (f"v2:unified_features:{s}:{tf}", f"v2:unified_features:{s}:{tf}:latest"):
   256	            h = _redis_hgetall(redis_client, key)
   257	            if h:
   258	                merged.update(h)
   259	                read_keys.append(key)
   260	        for key in (f"v2:features:latest:{s}:{tf}", f"v2:features:latest:{s}:1m"):
   261	            snap = _redis_get_json(redis_client, key)
   262	            if snap:
   263	                _merge_feature_snapshot(merged, snap, tf)
   264	                read_keys.append(key)
   265	        oi = _redis_get_json(redis_client, f"v2:market:open_interest:{s}")
   266	        if oi:
   267	            merged.setdefault("open_interest", oi.get("openInterest") or oi.get("sumOpenInterest"))
   268	            read_keys.append(f"v2:market:open_interest:{s}")
   269	        funding = _redis_get_json(redis_client, f"v2:market:funding:{s}")
   270	        if funding:
   271	            merged.setdefault("funding_rate", funding.get("lastFundingRate") or funding.get("fundingRate"))
   272	            read_keys.append(f"v2:market:funding:{s}")
   273	        price = _redis_get_json(redis_client, f"v2:market:prices:{s}")
   274	        ticker = price.get("ticker_24hr") if isinstance(price, dict) else None
   275	        if isinstance(ticker, dict):
   276	            merged.setdefault("quote_volume", ticker.get("quoteVolume"))
   277	            merged.setdefault("ccxt_price_change_15m_pct", ticker.get("priceChangePercent"))
   278	            read_keys.append(f"v2:market:prices:{s}")
   279	        by_symbol[s] = merged
   280	    return by_symbol, {
   281	        "enabled": redis_client is not None,
   282	        "symbols_requested": len(symbols),
   283	        "symbols_with_any_input": sum(1 for v in by_symbol.values() if v),
   284	        "read_key_count": len(read_keys),
   285	        "read_keys_sample": read_keys[:25],
   286	    }
