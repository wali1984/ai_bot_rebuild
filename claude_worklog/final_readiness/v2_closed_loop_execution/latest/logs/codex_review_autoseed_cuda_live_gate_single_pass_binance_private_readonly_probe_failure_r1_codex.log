   124	def _redact_value(key: str, value: Any) -> Any:
   125	    if SECRET_FIELD_RE.search(key):
   126	        return "[redacted]"
   127	    if isinstance(value, dict):
   128	        return {str(k): _redact_value(str(k), v) for k, v in value.items()}
   129	    if isinstance(value, list):
   130	        return [_redact_value(key, item) for item in value[:20]]
   131	    if isinstance(value, str):
   132	        safe = value.replace("\n", " ").strip()
   133	        return safe[:500] + ("..." if len(safe) > 500 else "")
   134	    return value
