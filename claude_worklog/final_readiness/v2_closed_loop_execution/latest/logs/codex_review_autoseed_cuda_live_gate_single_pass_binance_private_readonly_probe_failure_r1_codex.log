   509	def load_risk_decision(
   510	    args: argparse.Namespace,
   511	) -> Tuple[Optional[Dict[str, Any]], str, str]:
   512	    """Return (risk_decision_dict_or_None, source_payload_path, status).
   513	
   514	    status ∈ {"present", "missing_runtime_evidence", "load_failed"}.
   515	    """
   516	    if args.decision_file:
   517	        path = Path(args.decision_file)
   518	        record = _load_risk_decision_from_file(path)
   519	        if record is None:
   520	            return None, str(path), "load_failed"
   521	        return record, str(path), "present"
   522	    for candidate in RISK_DECISION_PUBLIC_PAYLOAD_CANDIDATES:
   523	        if candidate.exists():
   524	            record = _load_risk_decision_from_file(candidate)
   525	            if record is None:
   526	                continue
   527	            try:
   528	                rel_str = str(candidate.relative_to(REPO_ROOT))
   529	            except ValueError:
   530	                rel_str = str(candidate)
   531	            return record, rel_str, "present"
   532	    return None, "", "missing_runtime_evidence"
