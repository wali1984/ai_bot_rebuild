   613	def _confidence_bucket(value: Any) -> str:
   614	    try:
   615	        confidence = float(value)
   616	    except (TypeError, ValueError):
   617	        return "missing"
   618	    if confidence < 0.58:
   619	        return "below_0.58"
   620	    if confidence < 0.65:
   621	        return "0.58_to_0.65"
   622	    if confidence < 0.75:
   623	        return "0.65_to_0.75"
   624	    return "0.75_plus"
