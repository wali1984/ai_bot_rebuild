   595	        status = run_once(args)
   596	        validation_passed = bool(status["universe_validation"]["result"].get("passed"))
   597	        return 0 if validation_passed else 2
   598	    while True:
   599	        try:
   600	            run_once(args)
   601	        except KeyboardInterrupt:
   602	            return 0
   603	        except Exception:
   604	            pass
   605	        time.sleep(max(1, args.interval))
   606	
   607	
   608	if __name__ == "__main__":
   609	    sys.exit(main())

