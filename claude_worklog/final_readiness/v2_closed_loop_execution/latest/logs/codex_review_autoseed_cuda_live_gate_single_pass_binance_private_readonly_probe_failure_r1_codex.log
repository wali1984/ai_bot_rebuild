   137	def _decode_redis_value(raw: str) -> Any:
   138	    text = raw.strip()
   139	    if not text:
   140	        return text
   141	    if text[0] in "{[":
   142	        try:
   143	            return json.loads(text)
   144	        except json.JSONDecodeError:
   145	            return text[:500]
   146	    if text.lower() in {"true", "false"}:
   147	        return text.lower() == "true"
   148	    try:
   149	        if "." in text:
   150	            return float(text)
   151	        return int(text)
   152	    except ValueError:
   153	        return text[:500]
