   177	                            "high": last.get("high", 0.0),
   178	                            "low": last.get("low", 0.0),
   179	                            "close": last.get("close", 0.0),
   180	                            "volume": last.get("volume", 0.0),
   181	                            "timestamp": last.get("ts_ms", int(time.time() * 1000)),
   182	                        },
   183	                        "ohlcv_list": candles,
   184	                        "unified": {
   185	                            "ts_ms": int(time.time() * 1000),
