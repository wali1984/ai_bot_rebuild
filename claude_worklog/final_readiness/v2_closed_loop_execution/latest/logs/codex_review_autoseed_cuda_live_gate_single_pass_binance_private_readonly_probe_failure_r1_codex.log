    55	def _register_middleware(app: FastAPI) -> None:
    56	    """Register middleware so MIDDLEWARE_ORDER[0] is the outermost layer.
    57	
    58	    Starlette wraps middleware via `reversed(self.user_middleware)`, and
    59	    `add_middleware()` inserts at index 0, so iterating MIDDLEWARE_ORDER in
    60	    its declared (outermost→innermost) order and calling `add_middleware`
    61	    each pass yields the correct stack: the first declared layer ends up
    62	    outermost at request time.
    63	    """
    64	    for cls in MIDDLEWARE_ORDER:
    65	        app.add_middleware(cls)
