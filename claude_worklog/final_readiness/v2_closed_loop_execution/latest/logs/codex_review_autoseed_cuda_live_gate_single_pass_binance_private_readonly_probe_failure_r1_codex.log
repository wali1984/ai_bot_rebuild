   163	def compute_freshness_seconds(generated_ts: str) -> int:
   164	    try:
   165	        gen = dt.datetime.fromisoformat(generated_ts.replace("Z", "+00:00"))
   166	    except Exception:
   167	        return -1
   168	    now = dt.datetime.now(dt.timezone.utc)
   169	    return max(0, int((now - gen).total_seconds()))
