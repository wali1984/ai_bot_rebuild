   268	def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
   269	    parser = argparse.ArgumentParser(prog=WORKER_ID)
   270	    parser.add_argument(
   271	        "--symbol",
   272	        default=None,
   273	        help="Explicit exchange symbol. Omit for dynamic universe plus 25-symbol baseline.",
   274	    )
   275	    parser.add_argument(
   276	        "--smoke-test",
   277	        action="store_true",
   278	        help="Use the first symbol from the BTC/ETH/SOL smoke-test set; never the default.",
   279	    )
   280	    parser.add_argument("--interval", type=int, default=30, help="seconds between loop iterations")
   281	    parser.add_argument("--once", action="store_true", help="run a single iteration and exit")
   282	    parser.add_argument("--loop", action="store_true", help="run continuously")
   283	    parser.add_argument("--payload-file", default=None, help="read input payload from a JSON file (overrides live fetch)")
   284	    parser.add_argument(
   285	        "--read-from-paper-runtime",
   286	        action="store_true",
   287	        help="prefer the paper_online runtime payload as input (if present)",
   288	    )
   289	    parser.add_argument("--no-write", action="store_true", help="dry-run; do not write any payload to disk")
   290	    args = parser.parse_args(argv)
   291	    args.symbol = resolve_symbols(
   292	        explicit=[args.symbol] if args.symbol else None,
   293	        smoke_test=args.smoke_test,
   294	        include_baseline=True,
   295	    )[0]
   296	    if not args.loop and not args.once:
   297	        args.once = True
   298	    return args
   299	
   300	
   301	def main(argv: list[str] | None = None) -> int:
   302	    args = parse_args(argv)
   303	    if args.no_write:
   304	        global write_status
   305	
   306	        def _skip(_status: Dict[str, Any]) -> None:
   307	            return None
   308	
   309	        write_status = _skip  # type: ignore[assignment]
   310	    if args.once:
   311	        status = run_once(args)
   312	        return 2 if status.get("trainer_readiness") == "BLOCKED_MISSING_REQUIRED" else 0
   313	    while True:
   314	        try:
   315	            run_once(args)
   316	        except KeyboardInterrupt:
   317	            return 0
   318	        except Exception as exc:
   319	            status = emit_idle_status(f"loop_iteration_failed: {exc}")
   320	            try:
   321	                write_status(status)
   322	            except Exception:
   323	                pass
   324	        time.sleep(max(1, args.interval))
   325	
   326	
   327	if __name__ == "__main__":
   328	    sys.exit(main())

