        "paper_gate_decision": paper_gate,
        "paper_fill_gate_block_reason_state": paper_reason_state,
        "risk_decision": risk_decision,
        "altdata_snapshot_present": altdata is not None,
        "altdata_snapshot_explicit_missing": (
            isinstance(altdata, dict) and altdata.get("status") == "MISSING_SOURCE"
        ),
        "trainer_selected_action": trainer_output.get("selected_action"),
        "root_causes": deduped,
        "notes": notes,
