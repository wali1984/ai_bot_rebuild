"""FastAPI application factory for AI BOT V2.

This module performs no I/O at import. The factory `create_app()`:

1. constructs a FastAPI app
2. registers middleware in the canonical order from
   `claude_worklog/v2_scaffold_planning/04_API_ROUTE_SCAFFOLD_PLAN.md` §3
3. registers v1 routers (every §7 endpoint group) under `/api/v1`
4. asserts the registered middleware order matches `MIDDLEWARE_ORDER`

Routers expose no handler bodies in this skeleton; only OPTIONS shims that
return route metadata. Handlers, validators, and DB/Redis I/O land in
milestone D proper.
"""

from __future__ import annotations

from fastapi import FastAPI

from app.api.middleware import MIDDLEWARE_ORDER
from app.api.v2 import router as v2_landing_router
from app.api.v1 import (
    accounts,
    audit,
    auth,
    claude_admin,
    codex_review,
    decisions,
    discovery,
    evidence,
    exchanges,
    features,
    fleet,
    governance,
    health,
    ingestors,
    intents,
    live_mode,
    live_readiness,
    mission_control,
    monitor,
    ollama_assistant,
    paper,
    predictions,
    replay,
    risk,
    risk_decisions,
    selection,
    signals,
    universe,
)


def _register_middleware(app: FastAPI) -> None:
    """Register middleware so MIDDLEWARE_ORDER[0] is the outermost layer.

    Starlette wraps middleware via `reversed(self.user_middleware)`, and
    `add_middleware()` inserts at index 0, so iterating MIDDLEWARE_ORDER in
    its declared (outermost→innermost) order and calling `add_middleware`
    each pass yields the correct stack: the first declared layer ends up
    outermost at request time.
    """
    for cls in MIDDLEWARE_ORDER:
        app.add_middleware(cls)


def _assert_middleware_order(app: FastAPI) -> None:
    """Startup assertion per §3: any reorder fails app construction."""
    actual = tuple(m.cls for m in app.user_middleware)
    expected = tuple(reversed(MIDDLEWARE_ORDER))
    if actual != expected:
        raise RuntimeError(
            "Middleware stack drifted from MIDDLEWARE_ORDER. "
            f"Expected {[c.__name__ for c in expected]}, "
            f"got {[c.__name__ for c in actual]}."
        )


def _register_routers(app: FastAPI) -> None:
    """Mount every §7 endpoint group under `/api/v1`."""
    routers = (
        # §7: /_meta/, /auth/, /accounts/
        health.router,
        auth.router,
        accounts.router,
        # §7: /exchanges/, /universe/, /discovery/, /selection/
        exchanges.router,
        universe.router,
        discovery.router,
        selection.router,
        # §7: lineage chain — /feature-snapshots/, /predictions/, /signals/,
        #                     /decisions/, /risk-decisions/, /execution-intents/,
        #                     /paper-trades/
        features.router,
        predictions.router,
        signals.router,
        decisions.router,
        risk_decisions.router,
        intents.router,
        paper.router,
        # §7: /risk/, /replay/, /fleet/, /monitor/, /evidence/, /audit/, /governance/
        risk.router,
        replay.router,
        fleet.router,
        monitor.router,
        evidence.router,
        audit.router,
        governance.router,
        # §7: /claude-admin/, /codex/, /ollama/
        claude_admin.router,
        codex_review.router,
        ollama_assistant.router,
        # §7: /live/ — default-denied by live_block_guard
        live_mode.router,
        # Module-map residuals (not in §7 but planned by 02): mission-control,
        # ingestors, live-readiness. These remain skeleton-only.
        mission_control.router,
        ingestors.router,
        live_readiness.router,
    )
    for r in routers:
        app.include_router(r, prefix="/api/v1")
    # Phase B v2 landing namespace (additive; routes prefixed with /api/v2).
    app.include_router(v2_landing_router)


def _mount_frontend_spa(app: FastAPI) -> None:
    """Serve the built React SPA + public payload tree from the
    backend so dashboard.wajidali.us (or any local consumer)
    reaches /market and /admin/war-room directly.

    Two filesystem trees are mounted:

    - ``v2/frontend/public/`` at ``/`` — served first so JSON payloads
      consumed by the SPA (status files, dashboard payloads, public
      operator-runtime mirrors) resolve at their canonical relative
      paths.
    - ``v2/frontend/dist/`` SPA — index.html catch-all for client-side
      routes so /market and /admin/war-room return the SPA HTML.

    Both mounts are read-only. No mount changes Redis, no mount
    enables live trading, no mount exposes raw credentials."""
    import os
    from pathlib import Path

    from fastapi import Response
    from fastapi.responses import FileResponse, JSONResponse
    from fastapi.staticfiles import StaticFiles

    repo_root = Path(os.environ.get("V2_REPO_ROOT", "/home/wali/Desktop/AI BOT REBUILD"))
    public_dir = repo_root / "v2" / "frontend" / "public"
    dist_dir = repo_root / "v2" / "frontend" / "dist"
    if not dist_dir.exists():
        # Frontend hasn't been built yet — leave the API-only app
        # untouched. The operator can build later with `npm run build`.
        return

    # Public payload mirror: every nested JSON/MD file the SPA needs.
    if public_dir.exists():
        app.mount(
            "/public",
            StaticFiles(directory=str(public_dir), html=False),
            name="v2_public_mirror",
        )

    # SPA assets/static files.
    assets_dir = dist_dir / "assets"
    if assets_dir.exists():
        app.mount(
            "/assets",
            StaticFiles(directory=str(assets_dir), html=False),
            name="v2_spa_assets",
        )

    index_html = dist_dir / "index.html"

    @app.get("/", include_in_schema=False, response_class=FileResponse)
    async def _spa_index():  # type: ignore[no-untyped-def]
        return FileResponse(index_html)

    # SPA history-mode catch-all: any path that did NOT match an
    # /api/* route or /assets/* static file falls through to here.
    # The route is mounted LAST so /api/* and /assets/* always win.
    @app.get(
        "/{full_path:path}",
        include_in_schema=False,
        response_class=FileResponse,
    )
    async def _spa_catch_all(full_path: str):  # type: ignore[no-untyped-def]
        # Don't serve the SPA for API paths — those should 404 if not
        # registered. The middleware stack already rejects live-only
        # paths before reaching here.
        if full_path.startswith("api/") or full_path.startswith("public/"):
            return JSONResponse(
                {"error": "not_found", "path": full_path}, status_code=404
            )
        # IMPORTANT: prefer the live ``public/`` directory before falling
        # back to ``dist/``. Vite's build copies ``public/`` into ``dist/``,
        # so ``dist/`` is only a snapshot frozen at build time. If we
        # served the payload mirror from ``dist/`` the SPA would see stale
        # JSON until the next ``npx vite build``. Operator runtime
        # payloads are refreshed continuously by the freshness refresher
        # and per-worker publishers — we must read them from ``public/``.
        # Both directories are read-only mounts; no Redis or exchange
        # call happens here.
        if public_dir.exists():
            live_candidate = public_dir / full_path
            if live_candidate.is_file():
                # no-store: never cache live operator payloads in
                # intermediate proxies or in the browser.
                return FileResponse(
                    live_candidate,
                    headers={
                        "Cache-Control": "no-store, max-age=0",
                        "Pragma": "no-cache",
                    },
                )
        # Direct-file passthroughs from the build: index.html, favicon,
        # robots.txt, anything that genuinely belongs to the bundle.
        candidate = dist_dir / full_path
        if candidate.is_file():
            return FileResponse(candidate)
        # Otherwise hand the SPA index so client-side routing takes over.
        return FileResponse(
            index_html,
            headers={"Cache-Control": "no-store, max-age=0"},
        )


def create_app() -> FastAPI:
    """Construct the FastAPI app. No startup side effects beyond router/middleware
    registration, the middleware-order assertion, and the read-only
    SPA static mount."""
    app = FastAPI(title="AI BOT V2", version="0.0.0", docs_url="/api/docs")
    _register_middleware(app)
    _register_routers(app)
    _assert_middleware_order(app)
    _mount_frontend_spa(app)
    return app

