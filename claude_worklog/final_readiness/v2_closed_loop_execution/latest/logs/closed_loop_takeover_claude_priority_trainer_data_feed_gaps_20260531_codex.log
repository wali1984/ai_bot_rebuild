            r.get("next_claude_task")
            for r in audit_rows
            if isinstance(r, dict) and r.get("next_claude_task")
        ],
        "audit_source": "migration-audit.md",
        "reconciliation_matrix_path": "claude_worklog/final_readiness/independent_migration_audit_reconciliation/latest/independent_audit_reconciliation_matrix.json",
        "next_true_migration_tasks_path": "claude_worklog/final_readiness/independent_migration_audit_reconciliation/latest/NEXT_TRUE_MIGRATION_TASKS.md",
        "native_algorithmic_core_status": native_core.get("codex_go_no_go") or "MISSING_EVIDENCE",
        "native_algorithmic_core_payload_path": "v2/frontend/public/native_algorithmic_core_migration/latest/operator_dashboard_payload.json",
        "native_core_p0_true_migration_status": native_sprint.get("go_no_go") or native_sprint.get("codex_go_no_go") or "MISSING_EVIDENCE",
        "native_core_p0_true_migration_payload_path": "v2/frontend/public/v2_native_core_p0_true_migration_sprint/latest/operator_dashboard_payload.json",
        "zero_miss_legacy_core_lift_status": zero_miss.get("codex_go_no_go") or "MISSING_EVIDENCE",
        "zero_miss_legacy_core_lift_payload_path": "v2/frontend/public/zero_miss_legacy_core_lift/latest/operator_dashboard_payload.json",
        "native_core_p0_sequence": [
            "claude_rebuild_v2_native_feature_pipeline_worker_from_legacy",
            "claude_rebuild_v2_trainer_full_rl_masa_ppo_reward_stack",
            "claude_rebuild_v2_orchestrator_arbitration_from_legacy",
            "claude_rebuild_v2_stop_tp_stealth_exit_engine_paper_first",
            "claude_verify_v2_ingestors_are_native_or_downgrade_to_bridge",
        ],
    }

    return {
        "plain_english_summary": plain_english_summary,
        "current_goal": current_goal,
        "shutdown_recommendation": shutdown_rec,
        "live_gate": LIVE_GATE_STATUS,
        "paper_edge_status": paper_edge_status,
        "trainer_parity_status": trainer_parity_status,
        "decision_quality_status": (payloads.get("legacy_v2_realtime_decision_observatory") or {}).get("decision_quality_status") or "INSUFFICIENT_SAMPLE",
        "active_claude_task": active_claude_task,
        "active_codex_task": "codex_shutdown_readiness_takeover",
        "last_completed_fix": "expected_move_false_block_calibration_review",
        "next_fix": active_claude_task,
        "blockers_simple": blockers_simple,
        "blockers_technical": blockers_technical,
        "expected_move_review_current": expected_move_review_current,
        "expected_move_reviewed_false_block_count": reviewed_false_blocks,
        "shadow_current_false_block_count": current_false_blocks,
        "migration_truth": migration_truth,
    }


def page_cards(payloads: dict[str, Any], status: dict[str, str]) -> list[dict[str, Any]]:
    """One card per route. Frontend renders by id."""
    def s(name: str) -> str:
        return status.get(name, "MISSING_EVIDENCE")

    em = payloads.get("expected_move_model_review") or {}
    shadow = payloads.get("paper_shadow_outcome_observer") or {}
    paper = payloads.get("paper_edge_recovery") or {}
    tb = payloads.get("v2_trainer_bridge") or {}
    reviewed_false_blocks = _as_int(em.get("false_block_count"))
    current_false_blocks = _as_int(shadow.get("false_block_count"))
    expected_move_review_current = _review_current_enough(
        reviewed=reviewed_false_blocks,
        current=current_false_blocks,
    )

    cards = [
        {
            "id": "admin.mission_control",
            "title": "Mission Control",
            "color": "yellow",
            "summary": "Bot is watching only. Live is blocked.",
            "why_it_matters": "Mission Control is the single source of truth for what Claude and Codex are doing right now.",
            "what_needs_to_happen_next": "Close P0 blockers in the router.",
            "evidence_paths": [
                "v2/frontend/public/permanent_migration_runtime/latest/router_status.json",
            ],
            "source_status": s("permanent_migration_router"),
        },
        {
            "id": "admin.migration",
            "title": "Migration Progress",
            "color": "red",
            "summary": "V2 is not fully migrated yet. 0 workers are MIGRATED_CODEX_PASS.",
            "why_it_matters": "The independent audit found that trainer, RL env, feature pipeline, ingestors, orchestrator arbitration, and exit engines are missing or bridge-only.",
            "what_needs_to_happen_next": "Route the P0 implementation tasks from the reconciliation matrix.",
            "evidence_paths": [
                "claude_worklog/final_readiness/permanent_migration_runtime/latest/MIGRATION_COMPLETION_CONTRACT.md",
                "claude_worklog/final_readiness/independent_migration_audit_reconciliation/latest/INDEPENDENT_AUDIT_RECONCILIATION_REPORT.md",
                "claude_worklog/final_readiness/independent_migration_audit_reconciliation/latest/independent_audit_reconciliation_matrix.json",
                "claude_worklog/final_readiness/independent_migration_audit_reconciliation/latest/NEXT_TRUE_MIGRATION_TASKS.md",
            ],
            "source_status": s("independent_audit_reconciliation"),
        },
        {
            "id": "admin.native_algorithmic_core",
            "title": "Native Algorithmic Core",
            "color": "red",
            "summary": (
                (payloads.get("native_algorithmic_core_migration") or {}).get("current_status_simple")
                or "Native algorithmic core migration evidence is missing."
            ),
            "why_it_matters": "RL/MASA/PPO, feature intelligence, trade management, and orchestrator arbitration must be native and fully evidenced before migration can pass.",
            "what_needs_to_happen_next": "Run the Claude native-core implementation task and require Codex review before any PASS.",
            "evidence_paths": [
                "v2/frontend/public/native_algorithmic_core_migration/latest/operator_dashboard_payload.json",
                "claude_worklog/final_readiness/v2_native_algorithmic_core_migration/latest/codex_review/CODEX_NATIVE_ALGORITHMIC_CORE_REVIEW.md",
            ],
            "source_status": s("native_algorithmic_core_migration"),
        },
        {
            "id": "admin.native_core_p0_sprint",
            "title": "Native Core P0 Sprint",
            "color": "red",
            "summary": (
                (payloads.get("native_core_p0_true_migration_sprint") or {}).get("current_status_simple")
                or "Native core P0 sprint evidence is missing."

