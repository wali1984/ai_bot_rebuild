        risk_action = "block"
        risk_result = "BLOCKED"
        risk_reason = "deny_missing_legacy_signal_evidence"
    elif missing_fields:
        risk_action = "block"
        risk_result = "BLOCKED"
        risk_reason = "deny_missing_required_lineage_fields"

