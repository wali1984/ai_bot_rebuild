}
FORBIDDEN_REDIS_COMMANDS = {
    "SET",
    "HSET",
    "XADD",
    "DEL",
    "XDEL",
    "XTRIM",
    "FLUSHALL",
    "FLUSHDB",
    "EXPIRE",
