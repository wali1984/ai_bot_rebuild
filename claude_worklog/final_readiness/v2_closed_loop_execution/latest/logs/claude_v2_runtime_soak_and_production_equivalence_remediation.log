## Patch 1 — `v2/backend/app/cli/v2_production_payload_freshness_refresher.py`

Insert before `run_once()`:

```python
def _refresh_replacement_readiness_scoreboard() -> dict:
    """Invoke the scoreboard generator so v2_replacement_readiness_scoreboard.json
    stays fresh. The script enforces approves_*=False and live_gate=blocked_human_only.
    """
    import subprocess
    script = Path("v2/backend/scripts/run_v2_replacement_readiness_scoreboard.py")
    if not script.exists():
        return {"name": "replacement_readiness_scoreboard", "ran": False, "reason": "SCRIPT_MISSING"}
    try:
        proc = subprocess.run(
            [sys.executable, str(script)],
            capture_output=True, text=True, timeout=45,
        )
        return {
            "name": "replacement_readiness_scoreboard",
            "ran": True,
            "returncode": proc.returncode,
            "refreshed_at": _utc_iso(),
            "stderr_tail": (proc.stderr or "").strip()[-300:],
        }
    except Exception as exc:
        return {"name": "replacement_readiness_scoreboard", "ran": False,
                "reason": f"INVOCATION_FAILED: {exc!r}"[:300]}
```

Then in `run_once()` add one line and one returned field:

```python
def run_once() -> dict:
    r = _connect_redis()
    results = [_refresh_target(t, r) for t in TARGETS]
    ft = _refresh_frontend_truth(r)
    scoreboard = _refresh_replacement_readiness_scoreboard()   # NEW
    return {
        "schema_version": "v2_production_payload_freshness_refresher_v1",
        "refreshed_utc": _utc_iso(),
        "targets_refreshed": results,
        "frontend_truth": ft,
        "replacement_readiness_scoreboard": scoreboard,        # NEW
        "live_gate": LIVE_GATE_REQUIRED,
        ...
    }
```

This makes every freshness refresher tick (already daemonized at `--interval-seconds 60`) re-stamp the scoreboard, eliminating staleness.

