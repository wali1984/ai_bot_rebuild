   208	def verify_baseline_shas(manifest_path: Path = COPIED_BASELINE_MANIFEST) -> Dict[str, Any]:
   209	    """Read the copied_baseline_manifest.json and verify each baseline file
   210	    we depend on has a SHA matching ``LEGACY_BASELINE_SHA256``.
   211	    """
