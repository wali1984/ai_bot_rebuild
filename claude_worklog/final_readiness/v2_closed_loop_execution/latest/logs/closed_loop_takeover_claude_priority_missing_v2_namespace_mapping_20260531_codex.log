   213	    try:
   214	        manifest = json.loads(manifest_path.read_text())
   215	    except Exception as exc:
   216	        return {"checked": [], "mismatches": [], "ok": False, "error": f"manifest_load_failed: {exc}"}
   217	    by_path: Dict[str, str] = {}
   218	    for record in manifest.get("records", []):
   219	        v2_path = record.get("v2_preserved_path")
   220	        sha = record.get("sha256")
   221	        if v2_path and sha:
   222	            by_path[v2_path] = sha
   223	    for v2_path, expected in LEGACY_BASELINE_SHA256.items():
   224	        actual = by_path.get(v2_path)
   225	        result["checked"].append({"path": v2_path, "expected": expected, "actual": actual})
   226	        if actual != expected:
   227	            result["mismatches"].append({"path": v2_path, "expected": expected, "actual": actual})
   228	            result["ok"] = False
   229	    return result
