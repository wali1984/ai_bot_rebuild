    with pytest.raises(LivenessStreamGrowthDomainError):
        compute_stream_id_growth_in_window(
            (_obs("prediction", "950-0", 950), _obs("prediction", "1001-0", 1001)),
            GrowthWindowConfig(window_ms=100),
