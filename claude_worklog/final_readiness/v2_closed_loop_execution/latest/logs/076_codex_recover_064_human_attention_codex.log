     1	from __future__ import annotations
     2	
     3	from dataclasses import dataclass
     4	
     5	from .errors import LivenessStreamGrowthDomainError
     6	
     7	
     8	_STREAM_NAME_ALLOWED = frozenset("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_:.-")
     9	
    10	
    11	def _ensure_stream_name(value: str, *, field: str) -> None:
    12	    if not isinstance(value, str):
    13	        raise LivenessStreamGrowthDomainError("must_be_str", field=field)
    14	    if value == "":
    15	        raise LivenessStreamGrowthDomainError("must_be_nonempty", field=field)
    16	    if value != value.strip():
    17	        raise LivenessStreamGrowthDomainError("must_not_have_edge_whitespace", field=field)
    18	    if any(char.isspace() for char in value):
    19	        raise LivenessStreamGrowthDomainError("must_not_have_whitespace", field=field)
    20	    if "/" in value or "\\" in value:
    21	        raise LivenessStreamGrowthDomainError("must_not_have_path_separator", field=field)
    22	    if any(char not in _STREAM_NAME_ALLOWED for char in value):
    23	        raise LivenessStreamGrowthDomainError("invalid_characters", field=field)
    24	
    25	
    26	def _parse_stream_id(value: str, *, field: str) -> tuple[int, int]:
    27	    if not isinstance(value, str):
    28	        raise LivenessStreamGrowthDomainError("must_be_str", field=field)
    29	    if value == "":
    30	        raise LivenessStreamGrowthDomainError("must_be_nonempty", field=field)
    31	    if value.count("-") != 1:
    32	        raise LivenessStreamGrowthDomainError("must_have_single_separator", field=field)
    33	
    34	    ms_part, seq_part = value.split("-", 1)
    35	    if not _is_ascii_decimal(ms_part) or not _is_ascii_decimal(seq_part):
    36	        raise LivenessStreamGrowthDomainError("must_be_decimal_stream_id", field=field)
    37	
    38	    ms = int(ms_part, 10)
    39	    seq = int(seq_part, 10)
    40	    if ms < 0 or seq < 0:
    41	        raise LivenessStreamGrowthDomainError("must_be_nonnegative", field=field)
    42	    return ms, seq
    43	
    44	
    45	def _is_ascii_decimal(value: str) -> bool:
    46	    return value != "" and all("0" <= char <= "9" for char in value)
    47	
    48	
    49	@dataclass(frozen=True, slots=True)
    50	class StreamIdObservation:
    51	    stream_name: str
    52	    stream_id: str
    53	    observation_ts_ms: int
    54	
    55	    def __post_init__(self) -> None:
    56	        _ensure_stream_name(self.stream_name, field="stream_name")
    57	        _parse_stream_id(self.stream_id, field="stream_id")
    58	        if type(self.observation_ts_ms) is not int:
    59	            raise LivenessStreamGrowthDomainError("must_be_int", field="observation_ts_ms")
    60	        if self.observation_ts_ms < 0:
    61	            raise LivenessStreamGrowthDomainError("must_be_nonnegative", field="observation_ts_ms")
    62	
    63	    def parsed_id(self) -> tuple[int, int]:
    64	        return _parse_stream_id(self.stream_id, field="stream_id")

