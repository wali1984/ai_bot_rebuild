    84	def fetch_live_payload(symbol: str) -> Dict[str, Any]:
    85	    """Build a minimal feature payload from Binance public REST.
    86	
    87	    Read-only. No credentials. No mutating endpoint. Designed for independence
    88	    from paper_online_runtime: this worker can build a snapshot without it.
    89	    """
    90	    encoded = urllib.parse.urlencode({"symbol": symbol})
    91	    ticker = _http_json(f"https://fapi.binance.com/fapi/v1/ticker/price?{encoded}")
    92	    klines = _http_json(
    93	        "https://fapi.binance.com/fapi/v1/klines?"
    94	        + urllib.parse.urlencode({"symbol": symbol, "interval": "1m", "limit": "6"})
    95	    )
    96	    closes = [float(row[4]) for row in klines]
    97	    return_1m = (closes[-1] / closes[-2] - 1.0) if len(closes) >= 2 else 0.0
    98	    return_5m = (closes[-1] / closes[-6] - 1.0) if len(closes) >= 6 else 0.0
    99	    generated = iso_now()
   100	    last_kline_ts = dt.datetime.fromtimestamp(
   101	        int(klines[-1][6]) / 1000.0, tz=dt.timezone.utc
   102	    ).strftime("%Y-%m-%dT%H:%M:%SZ")
