   351	            redis_client,
   352	            KEY_AGGREGATE_TEMPLATE.format(symbol=symbol),
   353	            json.dumps(aggregate_payload),
   354	            ex=ttl_seconds,
   355	        ),
   356	        KEY_PER_SYMBOL_TEMPLATE.format(symbol=symbol): _safe_redis_set(
   357	            redis_client,
   358	            KEY_PER_SYMBOL_TEMPLATE.format(symbol=symbol),
   359	            json.dumps(latest_payload),
   360	            ex=ttl_seconds,
   361	        ),
   362	    }
