    74	def _http_json(url: str, timeout: int = 8) -> Any:
    75	    request = urllib.request.Request(
    76	        url,
    77	        method="GET",
    78	        headers={"User-Agent": f"ai-bot-v2-{WORKER_ID}-readonly"},
