   126	def http_get(url: str) -> Tuple[int, Any]:
   127	    """Stdlib-only public GET fetcher. Used as the default for the service.
   128	    Tests inject their own callable instead.
   129	    """
   130	    request = urllib.request.Request(
   131	        url,
   132	        method="GET",
   133	        headers={"User-Agent": f"ai-bot-v2-{WORKER_ID}-readonly"},
   134	    )
   135	    try:
   136	        with urllib.request.urlopen(request, timeout=8) as response:
   137	            body = response.read().decode("utf-8")
   138	            status = int(response.status)
   139	    except urllib.error.HTTPError as exc:
   140	        try:
   141	            body = exc.read().decode("utf-8")
   142	        except Exception:
   143	            body = ""
   144	        return int(exc.code), _try_json(body)
   145	    except Exception:
   146	        return 599, None
   147	    return status, _try_json(body)
