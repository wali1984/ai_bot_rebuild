    return data


def run_once(symbols: tuple[str, ...]) -> dict:
    started_at = _utc_iso()
    r = _connect_redis()
    redis_ok = r is not None
    keys_written: list[str] = []
    symbol_results: list[dict] = []
    for sym in symbols:
        ticker = _fetch_ticker_24hr(sym)
        funding = _fetch_funding(sym)
        oi = _fetch_open_interest(sym)
        klines = _fetch_klines(sym, interval="1m", limit=100)
        orderbook = _fetch_orderbook_top(sym, depth=20)
        sym_info = {
            "symbol": sym,
            "ticker_present": ticker is not None,
            "funding_present": funding is not None,
            "open_interest_present": oi is not None,
            "klines_present": klines is not None,
            "orderbook_present": orderbook is not None,
        }
        if redis_ok:
            payload = {
                "symbol": sym,
                "source": "binance_public_rest",
                "ticker_24hr": ticker,
                "funding": funding,
                "open_interest": oi,
                "fetched_utc": _utc_iso(),
