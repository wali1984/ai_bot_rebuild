   411	async def consume_events(
   412	    *,
   413	    event_source: Callable[[], Awaitable[Iterable[str]]],
   414	    redis_client: Any,
   415	    symbols: tuple[str, ...] = ("BTCUSDT", "ETHUSDT", "SOLUSDT"),
   416	    max_events: int | None = None,
   417	    now_ms_func: Callable[[], int] = lambda: int(time.time() * 1000),
   418	    rings: dict[str, RetentionRing] | None = None,
   419	) -> ConsumeStats:
   420	    """Consume events from a single pulled batch (no reconnect loop here).
   421	
   422	    Reconnect/backoff lives in the WSS connection wrapper; this function
   423	    is exposed as the deterministic, testable inner loop.
   424	    """
   425	    if rings is None:
   426	        rings = {s.upper(): RetentionRing() for s in symbols}
   427	    stats = ConsumeStats()
   428	    raw_events = await event_source()
   429	    accepted_symbols = {s.upper() for s in symbols}
   430	    for raw in raw_events:
   431	        stats.events_received += 1
   432	        if max_events is not None and stats.events_written >= max_events:
   433	            break
   434	        parsed = parse_force_order_event(raw)
   435	        if parsed is None:
   436	            stats.parse_errors += 1
   437	            continue
   438	        stats.events_parsed += 1
   439	        if parsed.symbol not in accepted_symbols:
   440	            stats.events_filtered_by_symbol += 1
   441	            continue
   442	        ring = rings.setdefault(parsed.symbol, RetentionRing())
   443	        ring.append(parsed)
   444	        agg = ring.aggregate(now_ms=now_ms_func())
   445	        result = write_event_to_redis(
   446	            redis_client,
   447	            symbol=parsed.symbol,
   448	            latest_event=parsed,
   449	            aggregate=agg,
   450	        )
   451	        if all(result.values()):
   452	            stats.events_written += 1
   453	            stats.last_event_utc = _utc_iso()
   454	        else:
   455	            stats.redis_write_failures += 1
   456	    return stats
