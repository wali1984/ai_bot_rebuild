   119	def aggregator_keys_present(redis_client: Any, symbol: str) -> dict[str, bool]:
   120	    """Probe whether any V2 *per-symbol* liquidation Redis keys are
   121	    populated for the given symbol. The global heartbeat key is
   122	    excluded from per-symbol counting.
   123	    """
   124	    result: dict[str, bool] = {}
   125	    per_symbol_patterns = tuple(
   126	        p for p in V2_LIQUIDATION_KEY_PATTERNS if "{symbol}" in p
   127	    )
   128	    if redis_client is None:
   129	        for pat in per_symbol_patterns:
   130	            result[pat.format(symbol=symbol)] = False
   131	        return result
   132	    for pat in per_symbol_patterns:
   133	        key = pat.format(symbol=symbol)
   134	        try:
   135	            raw = redis_client.get(key)
   136	        except Exception:
   137	            raw = None
   138	        result[key] = bool(raw)
   139	    return result
