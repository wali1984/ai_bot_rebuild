   296	    if fetcher is None:
   297	        fetcher = http_get
   298	
   299	    # 1. Global aggregator over unified features (in-memory only).
   300	    feats = unified_features_by_symbol or {}
   301	    if not feats:
   302	        service.record_missing_api_blocker(
   303	            "v2_unified_features_empty",
   304	            "no unified-feature input — V2 worker does not read legacy Redis",
   305	        )
   306	    agg = service.compute_global_11_keys(feats, tf=args.tf)
   307	
   308	    # 2. CoinAnk liquidation orders intake.
   309	    coinank_items: List[Dict[str, Any]] = list(coinank_order_items or [])
   310	    if args.enable_coinank_rest and not coinank_items:
