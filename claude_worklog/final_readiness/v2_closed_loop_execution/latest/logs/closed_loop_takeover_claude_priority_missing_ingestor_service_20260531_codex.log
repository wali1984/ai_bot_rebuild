   100	
   101	def parse_force_order_event(raw: str | bytes) -> ParsedLiquidation | None:
   102	    """Parse a single Binance Futures forceOrder WSS event.
   103	
   104	    The forceOrder@arr payload shape:
   105	        {
   106	          "e": "forceOrder",
   107	          "E": <event_time_ms>,
   108	          "o": {
   109	              "s": "BTCUSDT",
   110	              "S": "SELL"  | "BUY",
   111	              "q": "<quantity>",
   112	              "p": "<price>",
   113	              "ap": "<avg_price>",
   114	              "X": "FILLED",
   115	              "T": <trade_time_ms>,
   116	              ...
   117	          }
   118	        }
   119	
   120	    Returns ``None`` for non-forceOrder events or malformed JSON.
   121	
   122	    Side convention:
   123	      - Binance ``S=SELL`` is a forced sell — the liquidated position
   124	        was LONG. We map this to side ``"short"`` (the *liquidation*
   125	        side is short on the book, but the *liquidated trader* held
   126	        long). To avoid ambiguity, we use the *liquidation tape side*:
   127	        ``S=SELL  -> side="short"`` (the trade hits the bid).
   128	        ``S=BUY   -> side="long"``  (the trade hits the ask).
   129	    """
   130	    if isinstance(raw, bytes):
   131	        try:
   132	            raw = raw.decode("utf-8", errors="replace")
   133	        except Exception:
   134	            return None
   135	    if not isinstance(raw, str) or not raw:
   136	        return None
   137	    try:
   138	        d = json.loads(raw)
   139	    except (ValueError, TypeError):
   140	        return None
   141	    if not isinstance(d, dict):
   142	        return None
   143	    if d.get("e") != "forceOrder":
   144	        return None
   145	    o = d.get("o") or {}
   146	    if not isinstance(o, dict):
   147	        return None
   148	    symbol = o.get("s")
   149	    side_raw = (o.get("S") or "").upper()
   150	    price = _coerce_float(o.get("ap") or o.get("p"))
   151	    qty = _coerce_float(o.get("q"))
   152	    event_time = d.get("E") or o.get("T")
   153	    if not symbol or side_raw not in ("BUY", "SELL"):
   154	        return None
   155	    if price is None or qty is None or event_time is None:
   156	        return None
   157	    try:
   158	        event_time_ms = int(event_time)
   159	    except (TypeError, ValueError):
   160	        return None
   161	    notional = price * qty
   162	    side = "long" if side_raw == "BUY" else "short"
   163	    return ParsedLiquidation(
   164	        symbol=symbol.upper(),
   165	        side=side,
   166	        notional=notional,
   167	        price=price,
   168	        quantity=qty,
   169	        event_time_ms=event_time_ms,
   170	    )
