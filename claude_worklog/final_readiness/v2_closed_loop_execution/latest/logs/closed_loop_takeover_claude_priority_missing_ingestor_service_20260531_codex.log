     1	"""Tests for the V2 per-symbol liquidation ingestor loop + aggregator
     2	integration.
     3	
     4	Paper-only. No torch import. No network IO in tests (uses in-memory
     5	fake redis). No legacy mutation. No exchange mutation. No silent
     6	zero-fill.
     7	"""
     8	from __future__ import annotations
     9	
    10	import importlib
    11	import json
    12	import sys
    13	from pathlib import Path
    14	
    15	
    16	class FakeRedis:
    17	    def __init__(self) -> None:
    18	        self.store: dict[str, str] = {}
    19	
    20	    def ping(self) -> bool:
    21	        return True
    22	
    23	    def get(self, key: str):
    24	        return self.store.get(key)
    25	
    26	    def set(self, key: str, value: str, ex: int | None = None) -> bool:
    27	        self.store[key] = value
    28	        return True
    29	
    30	    def scan_iter(self, match: str | None = None):
    31	        if match is None:
    32	            yield from list(self.store.keys())
    33	            return
    34	        prefix = match.rstrip("*")
    35	        for k in list(self.store.keys()):
    36	            if match.endswith("*"):
    37	                if k.startswith(prefix):
    38	                    yield k
    39	            elif k == match:
    40	                yield k
