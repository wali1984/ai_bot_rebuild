   142	def build_ingestor_status(
   143	    redis_client: Any = None,
   144	    symbols: tuple[str, ...] = ("BTCUSDT", "ETHUSDT", "SOLUSDT"),
   145	) -> dict[str, Any]:
   146	    cls = classify_liquidation_source()
   147	    per_symbol: list[dict[str, Any]] = []
   148	    aggregate_populated_count = 0
   149	    for sym in symbols:
   150	        keys_present = aggregator_keys_present(redis_client, sym)
   151	        any_populated = any(keys_present.values())
   152	        if any_populated:
   153	            aggregate_populated_count += 1
   154	        per_symbol.append(
   155	            {
   156	                "symbol": sym,
   157	                "redis_keys_populated": keys_present,
   158	                "any_populated": any_populated,
   159	            }
   160	        )
   161	    return {
   162	        "schema_version": "v2_liquidation_ingestor_status_v1",
   163	        "generated_utc": _utc_iso(),
   164	        "go_no_go": (
   165	            "V2_PER_SYMBOL_LIQUIDATION_SOURCE_READY"
   166	            if cls.classification == SOURCE_AVAILABLE_V2_NATIVE
   167	            else "V2_PER_SYMBOL_LIQUIDATION_SOURCE_BLOCKED"
   168	        ),
   169	        "source_classification": cls.classification,
   170	        "rationale": cls.rationale,
   171	        "operator_decision_required": cls.operator_decision_required,
   172	        "public_no_credential_path_known": cls.public_no_credential_path_known,
   173	        "public_no_credential_path_description": cls.public_no_credential_path_description,
   174	        "v2_write_contract": list(cls.v2_write_contract),
   175	        "symbols": list(symbols),
   176	        "per_symbol_redis_state": per_symbol,
   177	        "symbols_with_any_v2_liquidation_key_populated_count": aggregate_populated_count,
   178	        "writes_legacy_redis": False,
