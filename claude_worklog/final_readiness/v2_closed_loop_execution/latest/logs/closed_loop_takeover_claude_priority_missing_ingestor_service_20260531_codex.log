  1631	def build_parser() -> argparse.ArgumentParser:
  1632	    parser = argparse.ArgumentParser(
  1633	        prog="paper_online_runtime",
  1634	        description="Run a non-live V2 paper runtime that writes fresh local V2 runtime payloads.",
  1635	    )
  1636	    mode = parser.add_mutually_exclusive_group()
  1637	    mode.add_argument("--once", action="store_true", help="Write one runtime tick and exit.")
  1638	    mode.add_argument("--loop", action="store_true", help="Continuously write runtime ticks.")
  1639	    parser.add_argument("--interval", type=int, default=30, help="Loop interval in seconds.")
  1640	    parser.add_argument(
  1641	        "--symbol",
  1642	        default=None,
  1643	        help="Explicit single paper-runtime symbol. Omit for dynamic universe plus 25-symbol baseline.",
  1644	    )
  1645	    parser.add_argument(
  1646	        "--smoke-test",
  1647	        action="store_true",
  1648	        help="Use the first symbol from the BTC/ETH/SOL smoke-test set; never the default.",
  1649	    )
  1650	    parser.add_argument("--write-evidence", action="store_true", help="Write final readiness evidence files.")
  1651	    return parser
  1652	
  1653	
  1654	def _resolve_runtime_symbol(raw_symbol: str | None, *, smoke_test: bool) -> str:
  1655	    symbols = resolve_symbols(
  1656	        explicit=[raw_symbol] if raw_symbol else None,
  1657	        smoke_test=smoke_test,
  1658	        include_baseline=True,
  1659	    )
  1660	    return symbols[0]
  1661	
  1662	
  1663	def main(argv: list[str] | None = None) -> int:
  1664	    args = build_parser().parse_args(argv)
  1665	    interval = max(args.interval, 5)
  1666	    symbol = _resolve_runtime_symbol(args.symbol, smoke_test=args.smoke_test)
  1667	    if args.loop:
  1668	        while True:
  1669	            payload = write_runtime_payload(symbol, interval, write_evidence=False)
  1670	            print(f"{payload['generated_at']} {payload['runtime_state']} {payload['last_paper_event']['paper_action']}", flush=True)
  1671	            time.sleep(interval)
  1672	    payload = write_runtime_payload(symbol, interval, write_evidence=args.write_evidence or args.once)
  1673	    print(payload["runtime_state"])
  1674	    print(PUBLIC_RUNTIME_DIR)
  1675	    return 0 if payload["runtime_state"] == "PAPER_RUNTIME_ONLINE_ACTIVE" else 2
