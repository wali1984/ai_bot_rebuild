    98	        url,
    99	        method="GET",
   100	        headers={"User-Agent": f"ai-bot-v2-{WORKER_ID}-readonly"},
   101	    )
   102	    try:
   103	        with urllib.request.urlopen(request, timeout=8) as response:
   104	            body = response.read().decode("utf-8")
   105	            status = int(response.status)
   106	    except urllib.error.HTTPError as exc:
   107	        try:
   108	            body = exc.read().decode("utf-8")
   109	        except Exception:
   110	            body = ""
   111	        return int(exc.code), _try_json(body)
   112	    except Exception:
   113	        return 599, None
   114	    return status, _try_json(body)
