   267	def run_once(
   268	    args: argparse.Namespace,
   269	    *,
   270	    service: Optional[CoinankBridgeService] = None,
   271	    unified_features_by_symbol: Optional[Dict[str, Dict[str, Any]]] = None,
   272	    binance_force_events: Optional[List[Dict[str, Any]]] = None,
   273	    coinank_order_items: Optional[List[Dict[str, Any]]] = None,
   274	    current_prices: Optional[Dict[str, float]] = None,
   275	    fetcher=None,
   276	) -> Dict[str, Any]:
   277	    """Single bridge cycle.
   278	
   279	    Parameters other than ``args`` are dependency-injected by tests. In
   280	    production (when ``--once`` runs on a host), they default to:
   281	
   282	      - ``unified_features_by_symbol``: empty (no Redis client). The CLI
   283	        therefore reports zero-aggregate global values and labels
   284	        ``v2_liquidation_event_source_empty`` if no events were provided.
   285	      - ``binance_force_events``: empty. Labelled
   286	        ``binance_force_order_ws_owner_unbound``.
   287	      - ``coinank_order_items``: fetched via public REST when
   288	        ``--enable-coinank-rest`` is passed; otherwise empty.
   289	
   290	    The worker never synthesizes events.
   291	    """
   292	    run_started_ts = iso_now()
   293	    t0 = time.time()
   294	    if service is None:
   295	        service = CoinankBridgeService(clock=time.time)
   296	    if fetcher is None:
   297	        fetcher = http_get
   298	
   299	    # 1. Global aggregator over unified features (in-memory only).
   300	    feats = unified_features_by_symbol or {}
   301	    if not feats:
   302	        service.record_missing_api_blocker(
   303	            "v2_unified_features_empty",
   304	            "no unified-feature input — V2 worker does not read legacy Redis",
   305	        )
   306	    agg = service.compute_global_11_keys(feats, tf=args.tf)
   307	
   308	    # 2. CoinAnk liquidation orders intake.
   309	    coinank_items: List[Dict[str, Any]] = list(coinank_order_items or [])
   310	    if args.enable_coinank_rest and not coinank_items:
   311	        coinank_items = _fetch_coinank_liquidation_orders(
   312	            fetcher,
   313	            days_back=args.coinank_history_days,
   314	            record_blocker=service.record_missing_api_blocker,
   315	        )
   316	    if coinank_items:
   317	        service.bridge_coinank_orders_into_v2_events(coinank_items)
   318	    else:
   319	        service.record_missing_api_blocker(
   320	            "v2_liquidation_event_source_empty",
   321	            "no coinank liquidation_orders source available this cycle",
   322	        )
   323	
   324	    # 3. Binance force-order intake (WS owner is a separate worker).
   325	    binance_events: List[Dict[str, Any]] = list(binance_force_events or [])
   326	    if binance_events:
   327	        service.bridge_binance_force_into_v2_events(binance_events)
   328	    else:
   329	        service.record_missing_api_blocker(
   330	            "binance_force_order_ws_owner_unbound",
   331	            "no binance force_order events provided; WS owner=separate_v2_ws_worker",
   332	        )
   333	
   334	    # 4. Window aggregations.
   335	    for window in service.AGG_WINDOWS_SECONDS:
   336	        service.aggregate_force_window(window)
   337	
   338	    # 5. Per-(symbol, tf) levels.
   339	    prices = current_prices or {}
   340	    # If the operator did not pass --symbols, route through the V2 dynamic
   341	    # universe resolver (merges discovered + 25-symbol baseline; smoke-test
   342	    # only via explicit opt-in).
   343	    symbol_set = [
   344	        s.upper() for s in _v2_resolve_symbols(
   345	            explicit=args.symbols, smoke_test=getattr(args, "smoke_test", False),
   346	            include_baseline=True,
   347	        )
   348	    ]
   349	    for symbol in symbol_set:
   350	        for tf in service.BUCKET_WIDTH_PCT.keys():
   351	            service.compute_liquidation_levels_mapping(
   352	                symbol, tf, current_price=float(prices.get(symbol, 0.0))
   353	            )
   354	
   355	    # 6. Endpoint manifest + cycle runtime (V2-namespaced mirrors only).
   356	    service.endpoint_manifest_snapshot(
   357	        endpoints=list(GLOBAL_11_KEY_CONTRACT),
   358	        version="3.0.0",
   359	    )
   360	    duration_ms = int((time.time() - t0) * 1000)
   361	    service.cycle_complete_snapshot(
   362	        cycle_id=int(args.cycle_id_seed),
   363	        duration_ms=duration_ms,
   364	        endpoints_active=len(GLOBAL_11_KEY_CONTRACT),
   365	    )
   366	
   367	    status = build_status(
   368	        service,
   369	        symbols=symbol_set,
   370	        tf=args.tf,
   371	        run_started_ts=run_started_ts,
   372	        cycle_id=int(args.cycle_id_seed),
   373	        duration_ms=duration_ms,
   374	    )
   375	    status["global_aggregate_result"] = agg.to_dict()
   376	    if not args.no_write:
   377	        write_status(status, service.data_plane)
   378	    return status
