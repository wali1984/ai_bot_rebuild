   915	        _write_json(root / "paper_shadow_ledger_tail.json", payload["paper_execution_ledger"])
   916	        _write_json(root / "audit_ledger_tail.json", payload["audit_ledger"])
   917	        _write_json(root / "v2_data_plane_bridge_status.json", {
