   244	def _safe_redis_set(redis_client: Any, key: str, value: str, ex: int | None = None) -> bool:
   245	    """Refuse any write whose key does not start with v2: prefix."""
   246	    if redis_client is None:
   247	        return False
   248	    if not isinstance(key, str) or not key.startswith(V2_REDIS_PREFIX):
   249	        return False
   250	    try:
   251	        if ex is not None:
   252	            redis_client.set(key, value, ex=int(ex))
   253	        else:
   254	            redis_client.set(key, value)
   255	        return True
   256	    except Exception:
   257	        return False
