   191	
   192	async def _heartbeat_writer(
   193	    *,
   194	    symbols: tuple[str, ...],
   195	    live_state: dict,
   196	    redis_client,
   197	    worklog_path: Path,
   198	    public_paths: tuple[Path, ...],
   199	    interval_seconds: float,
   200	    heartbeat_ttl_seconds: int,
   201	) -> None:
   202	    """Background coroutine. Writes heartbeat + status files every
   203	    interval_seconds. Survives transient redis/filesystem errors and
   204	    exits cleanly when cancelled.
   205	    """
   206	    while True:
   207	        _refresh_freshness(
   208	            symbols=symbols,
   209	            live_state=live_state,
   210	            redis_client=redis_client,
   211	            worklog_path=worklog_path,
   212	            public_paths=public_paths,
   213	            heartbeat_ttl_seconds=heartbeat_ttl_seconds,
   214	        )
   215	        try:
   216	            await asyncio.sleep(interval_seconds)
   217	        except asyncio.CancelledError:
   218	            return
   219	
   220	
   221	async def _run_with_reconnect(
   222	    *,
   223	    symbols: tuple[str, ...],
   224	    max_seconds_per_session: float,
   225	    max_events_per_session: int,
   226	    total_seconds: float,
   227	    redis_client,
   228	    live_state: dict | None = None,
   229	) -> dict:
   230	    rings = {s.upper(): RetentionRing() for s in symbols}
   231	    overall_start = time.monotonic()
   232	    attempts = 0
   233	    sessions = 0
   234	    if live_state is None:
   235	        live_state = {}
   236	    for k in (
   237	        "events_received",
   238	        "events_parsed",
   239	        "events_filtered_by_symbol",
   240	        "events_written",
   241	        "parse_errors",
   242	        "redis_write_failures",
   243	        "reconnect_count",
   244	    ):
   245	        live_state.setdefault(k, 0)
   246	    live_state.setdefault("last_event_utc", None)
   247	    live_state.setdefault("sessions", 0)
   248	    while time.monotonic() - overall_start < total_seconds:
   249	        attempts += 1
   250	        try:
   251	            session_stats = await run_wss_session(
   252	                url=DEFAULT_WSS_URL,
   253	                redis_client=redis_client,
   254	                symbols=symbols,
   255	                max_seconds=max_seconds_per_session,
   256	                max_events=max_events_per_session,
   257	                rings=rings,
   258	            )
   259	            sessions += 1
   260	            attempts = 0  # reset backoff on a successful session
   261	            for k in (
   262	                "events_received",
   263	                "events_parsed",
   264	                "events_filtered_by_symbol",
   265	                "events_written",
   266	                "parse_errors",
   267	                "redis_write_failures",
   268	            ):
   269	                live_state[k] += getattr(session_stats, k)
   270	            if session_stats.last_event_utc:
   271	                live_state["last_event_utc"] = session_stats.last_event_utc
   272	            live_state["sessions"] = sessions
   273	        except Exception:
   274	            live_state["reconnect_count"] += 1
   275	            delay = compute_backoff_seconds(attempts)
   276	            try:
   277	                await asyncio.sleep(delay)
   278	            except asyncio.CancelledError:
   279	                break
   280	    live_state["sessions"] = sessions
   281	    return dict(live_state)
   282	
   283	
   284	async def _run_daemon(
   285	    *,
   286	    symbols: tuple[str, ...],
   287	    max_seconds_per_session: float,
   288	    max_events_per_session: int,
   289	    total_seconds: float,
   290	    redis_client,
   291	    worklog_path: Path,
   292	    public_paths: tuple[Path, ...],
   293	    heartbeat_interval_seconds: float,
   294	    heartbeat_ttl_seconds: int,
   295	) -> dict:
   296	    """Run the WSS reconnect loop and the heartbeat writer concurrently."""
   297	    live_state: dict = {}
   298	    _refresh_freshness(
   299	        symbols=symbols,
   300	        live_state=live_state,
   301	        redis_client=redis_client,
   302	        worklog_path=worklog_path,
   303	        public_paths=public_paths,
   304	        heartbeat_ttl_seconds=heartbeat_ttl_seconds,
   305	    )
   306	    heartbeat_task = asyncio.create_task(
   307	        _heartbeat_writer(
   308	            symbols=symbols,
   309	            live_state=live_state,
   310	            redis_client=redis_client,
   311	            worklog_path=worklog_path,
   312	            public_paths=public_paths,
   313	            interval_seconds=heartbeat_interval_seconds,
   314	            heartbeat_ttl_seconds=heartbeat_ttl_seconds,
   315	        )
   316	    )
   317	    try:
   318	        stats = await _run_with_reconnect(
   319	            symbols=symbols,
   320	            max_seconds_per_session=max_seconds_per_session,
   321	            max_events_per_session=max_events_per_session,
   322	            total_seconds=total_seconds,
   323	            redis_client=redis_client,
   324	            live_state=live_state,
   325	        )
   326	    finally:
   327	        heartbeat_task.cancel()
   328	        try:
   329	            await heartbeat_task
   330	        except (asyncio.CancelledError, Exception):
   331	            pass
   332	        _refresh_freshness(
   333	            symbols=symbols,
   334	            live_state=live_state,
   335	            redis_client=redis_client,
   336	            worklog_path=worklog_path,
   337	            public_paths=public_paths,
   338	            heartbeat_ttl_seconds=heartbeat_ttl_seconds,
   339	        )
   340	    return stats
   341	
   342	
   343	def main(argv: list[str] | None = None) -> int:
   344	    parser = argparse.ArgumentParser(prog="v2_liquidation_wss_loop")
   345	    parser.add_argument(
   346	        "--symbols",
   347	        default=None,
   348	        help="Explicit comma-separated symbols. Omit for dynamic universe plus 25-symbol baseline.",
   349	    )
   350	    parser.add_argument(
   351	        "--smoke-test",
   352	        action="store_true",
   353	        help="Use the BTC/ETH/SOL smoke-test set; never the default.",
   354	    )
   355	    parser.add_argument(
   356	        "--total-seconds",
   357	        type=float,
   358	        default=20.0,
   359	        help="Total wall-clock budget for the run (default 20s).",
   360	    )
   361	    parser.add_argument(
   362	        "--max-seconds-per-session",
   363	        type=float,
   364	        default=15.0,
   365	        help="Max seconds per WSS session before the loop yields.",
   366	    )
   367	    parser.add_argument(
   368	        "--max-events-per-session",
   369	        type=int,
   370	        default=100,
   371	        help="Max events accepted per session (caps memory).",
   372	    )
   373	    parser.add_argument(
   374	        "--heartbeat-interval-seconds",
   375	        type=float,
   376	        default=float(DEFAULT_HEARTBEAT_INTERVAL_SECONDS),
   377	        help=(
   378	            "Interval (seconds) between heartbeat + status writes during a "
   379	            "long quiet session. Must be strictly less than --heartbeat-ttl-seconds."
   380	        ),
   381	    )
   382	    parser.add_argument(
   383	        "--heartbeat-ttl-seconds",
   384	        type=int,
   385	        default=int(DEFAULT_HEARTBEAT_TTL_SECONDS),
   386	        help=(
   387	            "Redis TTL (seconds) for v2:market:liquidations:heartbeat. Must "
   388	            "be strictly greater than --heartbeat-interval-seconds."
   389	        ),
   390	    )
   391	    parser.add_argument(
   392	        "--out-worklog", type=Path, default=WORKLOG_STATUS
   393	    )
   394	    parser.add_argument(
   395	        "--out-public", type=Path, default=PUBLIC_DASHBOARD
   396	    )
   397	    parser.add_argument(
   398	        "--out-public-secondary", type=Path, default=PUBLIC_DASHBOARD_SECONDARY
   399	    )
   400	    args = parser.parse_args(argv)
   401	    symbols = tuple(
   402	        resolve_symbols(
   403	            explicit=args.symbols,
   404	            smoke_test=args.smoke_test,
   405	            include_baseline=True,
   406	        )
   407	    )
   408	    if args.heartbeat_interval_seconds >= args.heartbeat_ttl_seconds:
   409	        print(
   410	            json.dumps(
   411	                {
   412	                    "go_no_go": "V2_LIQUIDATION_WSS_CLIENT_PAPER_SHADOW_BLOCKED",
   413	                    "blocked_reason": (
   414	                        "heartbeat_interval_seconds must be strictly less than "
   415	                        "heartbeat_ttl_seconds"
   416	                    ),
   417	                }
   418	            )
   419	        )
   420	        return 2
   421	    opted = opt_in_enabled()
   422	    redis_client = _connect_redis() if opted else None
   423	    if not opted:
   424	        payload = _build_blocked_status_payload(
   425	            symbols=symbols,
   426	            blocked_reason=(
   427	                f"Operator opt-in env var {OPT_IN_ENV_VAR}!=true; "
   428	                "client did not connect."
   429	            ),
   430	        )
   431	        _write_status(
   432	            payload,
   433	            args.out_worklog,
   434	            (args.out_public, args.out_public_secondary),
   435	        )
   436	        print(json.dumps({"go_no_go": payload["go_no_go"]}))
   437	        return 0
   438	    stats = asyncio.run(
   439	        _run_daemon(
   440	            symbols=symbols,
   441	            max_seconds_per_session=args.max_seconds_per_session,
   442	            max_events_per_session=args.max_events_per_session,
   443	            total_seconds=args.total_seconds,
   444	            redis_client=redis_client,
   445	            worklog_path=args.out_worklog,
   446	            public_paths=(args.out_public, args.out_public_secondary),
   447	            heartbeat_interval_seconds=args.heartbeat_interval_seconds,
   448	            heartbeat_ttl_seconds=args.heartbeat_ttl_seconds,
   449	        )
   450	    )
   451	    print(
   452	        json.dumps(
   453	            {
   454	                "go_no_go": "V2_LIQUIDATION_WSS_CLIENT_PAPER_SHADOW_READY",
   455	                "events_written": stats.get("events_written"),
   456	                "events_received": stats.get("events_received"),
   457	                "sessions": stats.get("sessions"),
   458	                "reconnect_count": stats.get("reconnect_count"),
   459	                "last_event_utc": stats.get("last_event_utc"),
   460	            }
   461	        )
   462	    )
   463	    return 0
