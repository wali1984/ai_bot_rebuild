   193	def write_heartbeat(redis_client: Any, payload: dict[str, Any]) -> bool:
   194	    """Write the V2 liquidation ingestor heartbeat key. Refuses any
   195	    non-v2:* key path. Returns whether the write occurred.
   196	    """
   197	    if redis_client is None:
