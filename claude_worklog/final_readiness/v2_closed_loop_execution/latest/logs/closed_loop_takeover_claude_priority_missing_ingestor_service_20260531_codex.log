    10	
    11	Consumers (e.g. ``registry.py``) call these to classify ingestors
    12	into AVAILABLE_FOR_READ_ONLY_DATA / OPERATOR_SECRET_REQUIRED /
    13	operator-decision states. The decision source is paper-only and
    14	never authorizes live trading.
    15	"""
    16	from __future__ import annotations
    17	
    18	import os
    19	from datetime import datetime, timezone
    20	from pathlib import Path
    21	from typing import Iterable
    22	
    23	DEFAULT_VAULT_PATH = Path(".local_secrets/legacy.env")
    24	SCHEMA_VERSION = "v2_native_ingestor_secret_decision_v1"
    25	
    26	
    27	def _read_key_names_from_vault(path: Path) -> set[str]:
    28	    """Return the set of key NAMES present in the local vault file.
    29	
    30	    The function reads only the substring before the first ``=`` on each
    31	    non-comment line. It NEVER returns or stores values.
    32	    """
    33	    names: set[str] = set()
    34	    if not path.exists() or not path.is_file():
    35	        return names
    36	    try:
    37	        text = path.read_text()
    38	    except OSError:
    39	        return names
    40	    for raw in text.splitlines():
    41	        line = raw.strip()
    42	        if not line or line.startswith("#"):
    43	            continue
    44	        if "=" not in line:
    45	            continue
    46	        name = line.split("=", 1)[0].strip()
    47	        # Allow common shell prefixes like ``export FOO=...``.
    48	        if name.startswith("export "):
    49	            name = name[len("export "):].strip()
    50	        if name:
    51	            names.add(name)
    52	    return names
    53	
    54	
    55	def key_name_available(
    56	    name: str,
    57	    *,
    58	    vault_path: Path = DEFAULT_VAULT_PATH,
    59	    env: dict | None = None,
    60	) -> bool:
    61	    """Return True if ``name`` is present in os.environ OR in the vault.
    62	
    63	    The function does not read or return the value. ``env`` defaults to
    64	    the live process env if not supplied (useful for tests).
    65	    """
    66	    if not name:
    67	        return False
    68	    process_env = os.environ if env is None else env
    69	    if process_env.get(name):
    70	        return True
    71	    names = _read_key_names_from_vault(Path(vault_path))
    72	    return name in names
