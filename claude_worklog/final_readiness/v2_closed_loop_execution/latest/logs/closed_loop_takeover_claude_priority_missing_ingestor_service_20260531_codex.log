   476	def _probe_redis_keys_for_pattern(pattern: str | None) -> int | None:
   477	    if not pattern:
   478	        return None
   479	    text = _safe_cmd(["redis-cli", "--scan", "--pattern", pattern])
   480	    if text is None:
   481	        return None
   482	    return len([l for l in text.splitlines() if l.strip()])
   483	
   484	
   485	def _probe_public_payload_age(repo_root: Path, rel_path: str | None) -> float | None:
   486	    if not rel_path:
   487	        return None
   488	    p = repo_root / rel_path
   489	    if not p.exists():
