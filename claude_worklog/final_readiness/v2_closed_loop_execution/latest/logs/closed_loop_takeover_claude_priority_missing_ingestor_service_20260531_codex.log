   105	def classify_reconnect_attempt(attempt_index: int) -> dict:
   106	    """Classify the attempt: backoff value + label.
   107	
   108	    First attempt is index 0 -> 1.0s. After the end of the backoff
   109	    table, the value caps at the final entry but is classified as
   110	    ``BACKOFF_SATURATED`` so the caller can decide between
   111	    persistent-retry and bailout.
   112	    """
   113	    if attempt_index < 0:
   114	        raise ValueError("attempt_index must be >= 0")
   115	    if attempt_index < len(RECONNECT_BACKOFF_SECONDS):
   116	        return {
   117	            "attempt_index": attempt_index,
   118	            "backoff_seconds": float(RECONNECT_BACKOFF_SECONDS[attempt_index]),
   119	            "classification": "BACKOFF_NORMAL",
   120	        }
   121	    return {
   122	        "attempt_index": attempt_index,
   123	        "backoff_seconds": float(RECONNECT_BACKOFF_SECONDS[-1]),
   124	        "classification": "BACKOFF_SATURATED",
   125	    }
