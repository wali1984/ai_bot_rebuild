   140	def _has_env(name: str) -> bool:
   141	    """Vault-aware key-name presence check.
   142	
   143	    Returns True if ``name`` is in os.environ OR in the redacted local
   144	    secret vault (NAMES only; no values are read or returned).
   145	    """
   146	    try:
   147	        from .secret_decision import key_name_available
   148	    except Exception:
   149	        return bool(os.environ.get(name))
   150	    return key_name_available(name)
   151	
