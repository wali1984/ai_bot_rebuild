   898	        paper_runtime=paper_runtime,
   899	    )
   900	    payload = build_current_truth_payload(
   901	        generated_at=generated_at,
   902	        process_snapshot=process_snapshot,
   903	        gpu_state=gpu_state,
   904	        redis_evidence=redis_evidence,
