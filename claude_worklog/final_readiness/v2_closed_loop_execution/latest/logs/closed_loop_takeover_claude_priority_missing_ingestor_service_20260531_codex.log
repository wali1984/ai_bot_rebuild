   409	                        help="opt in to the 3-symbol smoke-test set "
   410	                             "(never the production default)")
   411	    parser.add_argument("--tf", default="15m")
   412	    parser.add_argument("--interval", type=int, default=5)
   413	    parser.add_argument("--cycle-id-seed", type=int, default=1)
   414	    parser.add_argument("--coinank-history-days", type=int, default=30)
   415	    parser.add_argument("--enable-coinank-rest", action="store_true")
   416	    parser.add_argument("--once", action="store_true")
   417	    parser.add_argument("--loop", action="store_true")
   418	    parser.add_argument("--no-write", action="store_true")
   419	    parser.add_argument("--verify-baseline-shas", action="store_true")
   420	    args = parser.parse_args(argv)
   421	    if not args.loop and not args.once:
   422	        args.once = True
   423	    return args
   424	
   425	
   426	def main(argv: Optional[List[str]] = None) -> int:
   427	    args = parse_args(argv)
   428	    if args.verify_baseline_shas:
