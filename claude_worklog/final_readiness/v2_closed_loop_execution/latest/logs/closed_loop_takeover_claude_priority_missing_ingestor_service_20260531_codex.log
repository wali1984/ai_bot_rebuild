   110	def _build_daemon_status_payload(
   111	    *,
   112	    symbols: tuple[str, ...],
   113	    live_state: dict,
   114	) -> dict:
   115	    """Build a daemon-fresh status payload from live_state.
   116	
   117	    live_state is mutated by the WSS reconnect loop and read by the
   118	    heartbeat writer task. The shape captures session counters,
   119	    reconnect counts, and the last event timestamp so consumers can
   120	    distinguish daemon-fresh status from a stale-at-session-end status.
   121	    """
   122	    now = _utc_iso()
   123	    session_count = int(live_state.get("sessions", 0) or 0)
   124	    return {
   125	        "schema_version": "v2_liquidation_wss_client_status_v2",
   126	        "generated_utc": now,
   127	        "generated_at": now,
   128	        "heartbeat_at": now,
   129	        "go_no_go": "V2_LIQUIDATION_WSS_CLIENT_PAPER_SHADOW_READY",
   130	        "process_mode": "persistent_daemon",
   131	        "service_active": True,
   132	        "opt_in_enabled": True,
   133	        "url": DEFAULT_WSS_URL,
   134	        "symbols": list(symbols),
   135	        "session_count": session_count,
   136	        "sessions": session_count,
   137	        "reconnect_count": int(live_state.get("reconnect_count", 0) or 0),
   138	        "events_received": int(live_state.get("events_received", 0) or 0),
   139	        "events_parsed": int(live_state.get("events_parsed", 0) or 0),
   140	        "events_filtered_by_symbol": int(
   141	            live_state.get("events_filtered_by_symbol", 0) or 0
   142	        ),
   143	        "events_written": int(live_state.get("events_written", 0) or 0),
   144	        "parse_errors": int(live_state.get("parse_errors", 0) or 0),
   145	        "redis_write_failures": int(live_state.get("redis_write_failures", 0) or 0),
   146	        "last_event_utc": live_state.get("last_event_utc"),
   147	        "last_session_stats": dict(live_state),
   148	        "writes_legacy_redis": False,
   149	        "writes_exchange_orders": False,
   150	        "no_synthetic_liquidation_events": True,
   151	        "no_torch_imported": True,
   152	        "no_pickle_loaded": True,
   153	        "no_legacy_filesystem_modified": True,
   154	        "live_gate": "blocked_human_only",
   155	        "live_symbols": [],
   156	        "approves_live": False,
   157	        "approves_canary": False,
   158	        "approves_legacy_shutdown": False,
   159	        "approves_redis_trim": False,
   160	    }
