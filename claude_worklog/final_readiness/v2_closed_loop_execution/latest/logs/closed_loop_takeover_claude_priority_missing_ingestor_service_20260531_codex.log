   151	def snapshot_to_dict(snapshot: Any) -> Dict[str, Any]:
   152	    """Render a FeatureSnapshot dataclass tree as a JSON-safe dict."""
   153	    if is_dataclass(snapshot):
   154	        out: Dict[str, Any] = {}
