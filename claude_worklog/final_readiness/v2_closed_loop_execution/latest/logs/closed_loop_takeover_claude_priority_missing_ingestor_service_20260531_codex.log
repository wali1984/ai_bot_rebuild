                       "global_aggregate_result": {"total_liquidations": 4.0}},
        v2_liquidation_per_symbol={
            "latest": {"notional": 250000.0, "side": "long"},
            "aggregate": {"notional_1h": 1750000.0},
            "any_populated": True,
            "v2_per_symbol_aggregator_present": True,
        },
    )
