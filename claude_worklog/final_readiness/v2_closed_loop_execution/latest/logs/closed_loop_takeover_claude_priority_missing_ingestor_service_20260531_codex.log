   138	def load_payload(args: argparse.Namespace) -> Tuple[Dict[str, Any], str]:
   139	    """Return (payload, source_payload_path)."""
   140	    if args.payload_file:
   141	        path = Path(args.payload_file)
   142	        return json.loads(path.read_text()), str(path)
   143	    if args.read_from_paper_runtime and PAPER_ONLINE_PAYLOAD.exists():
   144	        data = json.loads(PAPER_ONLINE_PAYLOAD.read_text())
