   173	class RetentionRing:
   174	    """Bounded in-memory ring of liquidation events per symbol.
   175	
   176	    - Drops oldest events when capacity exceeded.
   177	    - Drops events older than ``max_age_ms`` from windowed aggregates.
   178	    """
   179	
   180	    def __init__(
   181	        self,
   182	        capacity: int = DEFAULT_RETENTION_CAPACITY,
   183	        window_24h_ms: int = DEFAULT_WINDOW_24H_MS,
   184	    ) -> None:
   185	        if capacity <= 0:
   186	            raise ValueError("capacity must be positive")
   187	        self.capacity = capacity
   188	        self.window_24h_ms = window_24h_ms
   189	        self.events: Deque[ParsedLiquidation] = deque(maxlen=capacity)
   190	
   191	    def append(self, event: ParsedLiquidation) -> None:
   192	        self.events.append(event)
   193	
   194	    def latest(self) -> ParsedLiquidation | None:
   195	        return self.events[-1] if self.events else None
   196	
   197	    def aggregate(
   198	        self,
   199	        *,
   200	        now_ms: int,
   201	        window_1h_ms: int = DEFAULT_WINDOW_1H_MS,
   202	        window_24h_ms: int | None = None,
   203	    ) -> dict[str, Any]:
   204	        """Compute notional aggregates over rolling windows."""
   205	        if window_24h_ms is None:
   206	            window_24h_ms = self.window_24h_ms
   207	        notional_1h = 0.0
   208	        count_1h = 0
   209	        notional_24h = 0.0
   210	        count_24h = 0
   211	        long_count_1h = 0
   212	        short_count_1h = 0
   213	        for ev in self.events:
   214	            age_ms = now_ms - ev.event_time_ms
   215	            if 0 <= age_ms <= window_1h_ms:
   216	                notional_1h += ev.notional
   217	                count_1h += 1
   218	                if ev.side == "long":
   219	                    long_count_1h += 1
   220	                elif ev.side == "short":
   221	                    short_count_1h += 1
   222	            if 0 <= age_ms <= window_24h_ms:
   223	                notional_24h += ev.notional
   224	                count_24h += 1
   225	        direction_bias_1h = None
   226	        total_1h_with_side = long_count_1h + short_count_1h
   227	        if total_1h_with_side > 0:
   228	            direction_bias_1h = (long_count_1h - short_count_1h) / total_1h_with_side
   229	        return {
   230	            "notional_1h": notional_1h,
   231	            "count_1h": count_1h,
   232	            "notional_24h": notional_24h,
   233	            "count_24h": count_24h,
   234	            "long_count_1h": long_count_1h,
   235	            "short_count_1h": short_count_1h,
   236	            "direction_bias_1h": direction_bias_1h,
   237	            "as_of_ms": now_ms,
   238	            "window_1h_ms": window_1h_ms,
   239	            "window_24h_ms": window_24h_ms,
   240	            "event_count_in_ring": len(self.events),
   241	        }
