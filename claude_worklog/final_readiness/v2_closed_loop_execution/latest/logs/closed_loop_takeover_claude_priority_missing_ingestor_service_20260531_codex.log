   141	
   142	def run_once(symbols: tuple[str, ...]) -> dict:
   143	    started_at = _utc_iso()
   144	    r = _connect_redis()
   145	    redis_ok = r is not None
   146	    keys_written: list[str] = []
   147	    symbol_results: list[dict] = []
   148	    for sym in symbols:
   149	        ticker = _fetch_ticker_24hr(sym)
   150	        funding = _fetch_funding(sym)
   151	        oi = _fetch_open_interest(sym)
   152	        klines = _fetch_klines(sym, interval="1m", limit=100)
   153	        orderbook = _fetch_orderbook_top(sym, depth=20)
   154	        sym_info = {
   155	            "symbol": sym,
   156	            "ticker_present": ticker is not None,
   157	            "funding_present": funding is not None,
   158	            "open_interest_present": oi is not None,
   159	            "klines_present": klines is not None,
   160	            "orderbook_present": orderbook is not None,
   161	        }
   162	        if redis_ok:
   163	            payload = {
   164	                "symbol": sym,
   165	                "source": "binance_public_rest",
   166	                "ticker_24hr": ticker,
   167	                "funding": funding,
   168	                "open_interest": oi,
   169	                "fetched_utc": _utc_iso(),
   170	                "live_gate": "blocked_human_only",
   171	                "live_symbols": [],
   172	            }
   173	            k_price = f"{V2_REDIS_PREFIX}market:prices:{sym}"
   174	            k_funding = f"{V2_REDIS_PREFIX}market:funding:{sym}"
   175	            k_oi = f"{V2_REDIS_PREFIX}market:open_interest:{sym}"
   176	            k_ohlcv = f"{V2_REDIS_PREFIX}market:ohlcv:binance:{sym}:1m"
   177	            k_orderbook = f"{V2_REDIS_PREFIX}market:orderbook:{sym}"
   178	            if _safe_write(r, k_price, json.dumps(payload), ex=600):
   179	                keys_written.append(k_price)
   180	            if funding is not None and _safe_write(
   181	                r, k_funding, json.dumps(funding), ex=600
   182	            ):
   183	                keys_written.append(k_funding)
   184	            if oi is not None and _safe_write(r, k_oi, json.dumps(oi), ex=600):
   185	                keys_written.append(k_oi)
   186	            if klines is not None and _safe_write(
   187	                r, k_ohlcv, json.dumps(klines), ex=600
   188	            ):
   189	                keys_written.append(k_ohlcv)
   190	            if orderbook is not None and _safe_write(
   191	                r, k_orderbook, json.dumps(orderbook), ex=600
   192	            ):
   193	                keys_written.append(k_orderbook)
   194	        symbol_results.append(sym_info)
   195	    heartbeat = {
   196	        "worker_id": "v2_native_ingestors_live_loop",
   197	        "schema_version": "v2_native_ingestors_live_v1",
   198	        "started_at": started_at,
   199	        "finished_at": _utc_iso(),
   200	        "symbols": list(symbols),
   201	        "redis_ok": redis_ok,
   202	        "v2_market_keys_written": keys_written,
   203	        "v2_market_keys_written_count": len(keys_written),
   204	        "symbol_results": symbol_results,
   205	        "classification": (
   206	            "NATIVE_V2_PUBLIC_REST_OK"
   207	            if redis_ok and any(s.get("ticker_present") for s in symbol_results)
   208	            else (
   209	                "BLOCKED_BY_REDIS_UNAVAILABLE"
   210	                if not redis_ok
   211	                else "BLOCKED_BY_NETWORK_OR_API"
   212	            )
   213	        ),
   214	        "live_gate": "blocked_human_only",
   215	        "live_symbols": [],
   216	        "approves_live": False,
   217	        "approves_legacy_shutdown": False,
   218	        "writes_legacy_redis": False,
   219	        "places_exchange_orders": False,
   220	    }
   221	    if redis_ok:
   222	        _safe_write(
   223	            r,
   224	            f"{V2_REDIS_PREFIX}market:ingestor:heartbeat",
   225	            json.dumps(heartbeat),
   226	            ex=300,
   227	        )
   228	        _safe_write(
   229	            r,
   230	            f"{V2_REDIS_PREFIX}market:ingestor:status",
   231	            heartbeat["classification"],
   232	            ex=300,
   233	        )
   234	    return heartbeat
   235	
   236	
   237	def write_payload(payload: dict, path: Path) -> None:
   238	    path.parent.mkdir(parents=True, exist_ok=True)
   239	    path.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")
   240	
   241	
   242	def _build_fetch_in_progress_payload(symbols: tuple[str, ...]) -> dict:
   243	    return {
   244	        "worker_id": "v2_native_ingestors_live_loop",
   245	        "schema_version": "v2_native_ingestors_live_v1",
   246	        "started_at": _utc_iso(),
   247	        "finished_at": None,
   248	        "symbols": list(symbols),
   249	        "redis_ok": None,
   250	        "v2_market_keys_written": [],
   251	        "v2_market_keys_written_count": 0,
   252	        "symbol_results": [],
   253	        "classification": "NATIVE_V2_PUBLIC_REST_FETCH_IN_PROGRESS",
   254	        "live_gate": "blocked_human_only",
   255	        "live_symbols": [],
   256	        "approves_live": False,
   257	        "approves_legacy_shutdown": False,
   258	        "writes_legacy_redis": False,
   259	        "places_exchange_orders": False,
   260	    }
   261	
   262	
   263	def _resolve_runtime_symbols(raw_symbols: str | None, *, smoke_test: bool) -> tuple[str, ...]:
   264	    return tuple(
   265	        resolve_symbols(
   266	            explicit=raw_symbols,
   267	            smoke_test=smoke_test,
   268	            include_baseline=True,
   269	        )
   270	    )
   271	
   272	
   273	def main(argv: list[str] | None = None) -> int:
   274	    parser = argparse.ArgumentParser(prog="v2_native_ingestors_live_loop")
   275	    parser.add_argument(
   276	        "--symbols",
   277	        default=None,
   278	        help="Explicit comma-separated symbols. Omit for dynamic universe plus 25-symbol baseline.",
   279	    )
   280	    parser.add_argument(
   281	        "--smoke-test",
   282	        action="store_true",
   283	        help="Use the BTC/ETH/SOL smoke-test set; never the default.",
   284	    )
   285	    parser.add_argument("--once", action="store_true")
   286	    parser.add_argument("--loop", action="store_true")
   287	    parser.add_argument("--interval-seconds", type=int, default=60)
   288	    parser.add_argument("--out", type=Path, default=DEFAULT_PAYLOAD_PATH)
   289	    args = parser.parse_args(argv)
   290	    symbols = _resolve_runtime_symbols(args.symbols, smoke_test=args.smoke_test)
   291	    if args.loop and args.once:
   292	        print("ERROR: --loop and --once are mutually exclusive", file=sys.stderr)
   293	        return 2
   294	    if args.loop:
   295	        while True:
   296	            write_payload(_build_fetch_in_progress_payload(symbols), args.out)
   297	            hb = run_once(symbols)
   298	            write_payload(hb, args.out)
   299	            time.sleep(max(5, int(args.interval_seconds)))
   300	    hb = run_once(symbols)
   301	    write_payload(hb, args.out)
   302	    print(json.dumps({
   303	        "classification": hb["classification"],
   304	        "v2_market_keys_written_count": hb["v2_market_keys_written_count"],
   305	        "redis_ok": hb["redis_ok"],
   306	    }))
   307	    return 0
   308	
   309	
   310	if __name__ == "__main__":
   311	    sys.exit(main())

