DEFAULT_HEARTBEAT_TTL_SECONDS = 180
DEFAULT_HEARTBEAT_INTERVAL_SECONDS = 60


def write_heartbeat(
    redis_client: Any,
    payload: dict[str, Any],
    *,
    ttl_seconds: int = DEFAULT_HEARTBEAT_TTL_SECONDS,
) -> bool:
