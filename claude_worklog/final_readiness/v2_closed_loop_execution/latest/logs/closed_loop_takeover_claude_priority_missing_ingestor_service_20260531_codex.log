   284	    )
   285	    parser.add_argument("--once", action="store_true")
   286	    parser.add_argument("--loop", action="store_true")
   287	    parser.add_argument("--interval-seconds", type=int, default=60)
   288	    parser.add_argument("--out", type=Path, default=DEFAULT_PAYLOAD_PATH)
   289	    args = parser.parse_args(argv)
   290	    symbols = _resolve_runtime_symbols(args.symbols, smoke_test=args.smoke_test)
   291	    if args.loop and args.once:
