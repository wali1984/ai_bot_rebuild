   277	def test_realtime_price_provider_pattern_preserved_or_replaced_with_documented_reason() -> None:
   278	    # The legacy realtime_price_provider.PriceSource enum is preserved as
   279	    # PriceSourcePriority in the V2 service. Each labelled source from the
   280	    # legacy file (L99-106) is present and the priority order matches
   281	    # (lower number = higher priority).
   282	    labels = {p.label: p.priority for p in PriceSourcePriority}
   283	    for required in ("coinapi_ws", "binance_ws", "ccxt_rest", "kucoin_rest", "redis_cache"):
   284	        assert required in labels, f"legacy PriceSource label not preserved: {required!r}"
   285	    # coinapi_ws is highest-priority (lowest number), redis_cache is last resort
   286	    ordered = sorted(labels.items(), key=lambda kv: kv[1])
   287	    assert ordered[0][0] == "coinapi_ws"
   288	    assert ordered[-1][0] == "redis_cache"
   289	    # And the data-source priority table exposes ohlcv routing as
   290	    # CoinAPI V1 primary -> Binance REST fallback (the docstring data-source
   291	    # table from the startup script):
