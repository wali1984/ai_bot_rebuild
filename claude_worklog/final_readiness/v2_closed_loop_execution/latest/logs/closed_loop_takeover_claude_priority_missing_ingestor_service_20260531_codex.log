     1	"""V2-native paper/shadow Binance Futures liquidation WSS client.
     2	
     3	Connects to ``wss://fstream.binance.com/ws/!forceOrder@arr`` (public,
     4	no credentials), parses ``forceOrder`` events, maintains a bounded
     5	in-memory retention ring per symbol, and publishes:
     6	
     7	- ``v2:market:liquidations:latest:{symbol}``   — last event
     8	- ``v2:market:liquidations:aggregate:{symbol}`` — rolling 1h/24h aggregate
     9	- ``v2:market:liquidations:heartbeat``          — client status
    10	
    11	NEVER places, cancels, or modifies any order. NEVER writes any non-v2
    12	Redis key. NEVER deserializes pickle. NEVER imports torch. NEVER
    13	touches legacy filesystem. NEVER fabricates events: only events
    14	received over the public WSS stream are written.
    15	
    16	The default endpoint is the official Binance Futures public liquidation
    17	WebSocket. The client can be re-pointed via constructor for testing,
    18	which is how unit tests drive deterministic event streams without
    19	network IO.
    20	"""
    21	from __future__ import annotations
    22	
    23	import asyncio
    24	import dataclasses
    25	import json
    26	import os
    27	import time
    28	from collections import deque
    29	from datetime import datetime, timezone
    30	from typing import Any, Awaitable, Callable, Deque, Iterable
    31	
    32	DEFAULT_WSS_URL = "wss://fstream.binance.com/ws/!forceOrder@arr"
    33	
    34	V2_REDIS_PREFIX = "v2:"
    35	KEY_LATEST_TEMPLATE = "v2:market:liquidations:latest:{symbol}"
    36	KEY_AGGREGATE_TEMPLATE = "v2:market:liquidations:aggregate:{symbol}"
    37	KEY_PER_SYMBOL_TEMPLATE = "v2:market:liquidations:{symbol}"
    38	KEY_HEARTBEAT = "v2:market:liquidations:heartbeat"
    39	
    40	# Canonical V2 liquidation events stream consumed by
    41	# v2/legacy_owned_runtime/ingest/liquidation_levels_engine.py via
    42	# xreadgroup. WSS forwards each REAL parsed forceOrder event into this
    43	# stream so the levels engine can populate v2:unified_features:* hashes.
    44	# We never synthesize events here; if WSS receives no events the stream
    45	# stays empty.
    46	KEY_EVENTS_STREAM = "v2:liquidations:events"
    47	DEFAULT_EVENTS_STREAM_MAXLEN = 10000
    48	
    49	# Side mapping from WSS tape-side ("long"/"short") to the bridge/levels
    50	# engine semantic side ("LONG_LIQ"/"SHORT_LIQ"). WSS uses tape-side
    51	# (trade hit ask = "long"); bridge/levels use the LIQUIDATED-POSITION
    52	# side. The two are inverted: a BUY counter-order liquidates a SHORT.
    53	_TAPE_SIDE_TO_LIQ_SIDE = {
    54	    "long": "SHORT_LIQ",
    55	    "short": "LONG_LIQ",
    56	}
    57	
    58	DEFAULT_RETENTION_CAPACITY = 200  # max events kept per symbol in memory
    59	DEFAULT_WINDOW_1H_MS = 60 * 60 * 1000
    60	DEFAULT_WINDOW_24H_MS = 24 * 60 * 60 * 1000
    61	DEFAULT_BACKOFF_INITIAL_SECONDS = 1.0
    62	DEFAULT_BACKOFF_CAP_SECONDS = 30.0
    63	
    64	OPT_IN_ENV_VAR = "V2_LIQUIDATION_WSS_OPT_IN"
    65	
    66	
    67	@dataclasses.dataclass(frozen=True)
    68	class ParsedLiquidation:
    69	    symbol: str
    70	    side: str  # 'long' (BUY counter-order = short liquidation) or 'short'
    71	    notional: float
    72	    price: float
    73	    quantity: float
    74	    event_time_ms: int
    75	
    76	
    77	def _utc_iso() -> str:
    78	    return (
    79	        datetime.now(timezone.utc)
    80	        .isoformat(timespec="seconds")
    81	        .replace("+00:00", "Z")
    82	    )
