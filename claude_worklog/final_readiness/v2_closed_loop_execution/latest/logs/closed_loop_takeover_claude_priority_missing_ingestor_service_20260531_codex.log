    events_filtered_by_symbol: int = 0
    events_written: int = 0
    parse_errors: int = 0
    redis_write_failures: int = 0
    reconnect_count: int = 0
    last_event_utc: str | None = None


async def consume_events(
    *,
    event_source: Callable[[], Awaitable[Iterable[str]]],
