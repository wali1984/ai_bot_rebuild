    47	def v2_to_kucoin_spot_symbol(v2_symbol: str) -> str:
    48	    """Map V2 symbol (e.g. ``BTCUSDT``) to KuCoin spot symbol (``BTC-USDT``)."""
    49	    s = v2_symbol.upper()
    50	    if "-" in s:
    51	        return s
    52	    if s.endswith("USDT"):
    53	        return f"{s[:-4]}-USDT"
    54	    if s.endswith("USD"):
    55	        return f"{s[:-3]}-USD"
    56	    if s.endswith("BTC"):
    57	        return f"{s[:-3]}-BTC"
    58	    return s
    59	
    60	
    61	def v2_to_kucoin_futures_symbol(v2_symbol: str) -> str:
    62	    """Map V2 symbol to KuCoin USDT-margined perpetual (``XBTUSDTM``-style)."""
    63	    s = v2_symbol.upper()
    64	    # KuCoin uses XBT instead of BTC for futures.
    65	    if s.startswith("BTC"):
    66	        s = "XBT" + s[3:]
    67	    if s.endswith("USDT"):
    68	        return f"{s}M"
    69	    return s
