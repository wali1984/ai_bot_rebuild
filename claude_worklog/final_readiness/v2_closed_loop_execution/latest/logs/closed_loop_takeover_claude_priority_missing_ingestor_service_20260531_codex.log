   297	    assert DATA_SOURCE_PRIORITY["premium_index"] == ("binance_rest", None)
   298	    assert DATA_SOURCE_PRIORITY["open_interest"] == ("binance_rest", "coinank")
   299	    assert DATA_SOURCE_PRIORITY["liquidations"] == ("binance_ws", None)
   300	    assert DATA_SOURCE_PRIORITY["orderbook_depth"] == ("binance_rest_ws", None)
