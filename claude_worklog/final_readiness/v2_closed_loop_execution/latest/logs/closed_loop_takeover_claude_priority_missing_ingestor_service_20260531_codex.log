   191	    klines_result = service.ingest_klines(args.symbol, args.timeframe, args.limit)
   192	    market_data_results: Dict[str, Any] = {
   193	        "klines": klines_result.to_dict(),
   194	        "bbo": service.ingest_bbo(args.symbol),
   195	        "mark_premium_funding": service.ingest_mark_premium_funding(args.symbol),
   196	        "open_interest": service.ingest_oi(args.symbol),
