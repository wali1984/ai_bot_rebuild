   194	    def ingest_klines(
   195	        self,
   196	        symbol: str,
   197	        timeframe: str = "1m",
   198	        limit: int = 6,
   199	    ) -> IngestResult:
   200	        """Ingest OHLCV klines using the data-source priority table.
   201	
   202	        Preserved legacy behavior: CoinAPI V1 primary, Binance REST fallback.
   203	        Fail-closed on 5xx and during rate-limit backoff windows.
   204	        """
   205	        result = IngestResult(symbol=symbol, timeframe=timeframe)
   206	        now = self._clock()
   207	        if now < self._backoff_until:
   208	            result.rate_limit_state = self._rate_limit_state
   209	            result.errors.append(
   210	                f"backoff_active until {self._backoff_until} ({self._rate_limit_state})"
   211	            )
   212	            return result
   213	
   214	        # Per the data-source priority table: CoinAPI V1 primary -> Binance REST fallback.
   215	        # Cold start must still attempt CoinAPI first; health only records whether
   216	        # the prior CoinAPI sample was fresh enough.
   217	        source = "coinapi_v1"
   218	        bars = self._coinapi_v1_klines(symbol, timeframe, limit)
   219	        if bars is None:
   220	            result.errors.append("coinapi_v1_unavailable_fallback_binance_rest")
   221	            source = "binance_rest"
   222	            bars = self._binance_rest_klines(symbol, timeframe, limit, result)
   223	
   224	        if bars is None:
   225	            result.source = source
   226	            result.rate_limit_state = self._rate_limit_state
   227	            return result
   228	
   229	        # Persist into V2 namespace (NEVER legacy Redis).
   230	        bars_key = f"{V2_KEY_PREFIX}:{symbol}:ohlcv:{timeframe}"
   231	        price_key = f"{V2_KEY_PREFIX}:{symbol}:price"
   232	        self.data_plane[bars_key] = bars
   233	        last_bar = bars[-1] if bars else None
   234	        if last_bar is not None:
   235	            close = last_bar.get("close")
   236	            ts = int(last_bar.get("ts", 0))
   237	            self.data_plane[price_key] = {
   238	                "symbol": symbol,
   239	                "price": float(close) if close is not None else None,
   240	                "ts_ms": ts,
   241	                "source": source,
   242	            }
   243	            self._last_kline_ts = ts
   244	        result.klines_persisted = len(bars)
   245	        result.last_kline_ts = self._last_kline_ts
   246	        result.source = source
   247	        self._rate_limit_state = "ok"
   248	        result.rate_limit_state = self._rate_limit_state
   249	        result.v2_keys_written = [bars_key, price_key]
   250	        self._klines_persisted_total += len(bars)
   251	        self._consecutive_5xx = 0
   252	        return result
