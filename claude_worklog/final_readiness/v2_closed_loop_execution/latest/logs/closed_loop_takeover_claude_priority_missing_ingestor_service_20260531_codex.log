   309	def write_event_to_redis(
   310	    redis_client: Any,
   311	    *,
   312	    symbol: str,
   313	    latest_event: ParsedLiquidation,
   314	    aggregate: dict[str, Any],
   315	    ttl_seconds: int = 3600,
   316	) -> dict[str, bool]:
   317	    """Write the per-symbol latest event + aggregate to V2 Redis only.
   318	
   319	    Also XADDs the same parsed event into ``v2:liquidations:events`` so
   320	    the levels engine (which xreadgroups that stream) populates the
   321	    ``v2:unified_features:*`` liquidation fields without a separate
   322	    bridge step.
