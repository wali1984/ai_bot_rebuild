   399	def _field(fields: dict[str, Any], *names: str) -> Any:
   400	    lower = {str(key).lower(): value for key, value in fields.items()}
   401	    for name in names:
   402	        if name in fields and fields[name] not in (None, ""):
   403	            return fields[name]
   404	        value = lower.get(name.lower())
   405	        if value not in (None, ""):
   406	            return value
   407	    return None
   408	
   409	
   410	def _field_like(fields: dict[str, Any], *parts: str) -> Any:
   411	    for key, value in fields.items():
   412	        key_l = str(key).lower()
   413	        if all(part in key_l for part in parts) and value not in (None, ""):
   414	            return value
   415	    return None
   416	
   417	
   418	def _coerce_float(value: Any) -> float | None:
   419	    try:
   420	        if value is None or value == "":
   421	            return None
   422	        return float(value)
   423	    except (TypeError, ValueError):
   424	        return None
