   230	def _fetch_coinank_liquidation_orders(
   231	    fetcher,
   232	    *,
   233	    days_back: int,
   234	    record_blocker,
   235	) -> List[Dict[str, Any]]:
   236	    """Attempt a public CoinAnk Plan-3 liquidation_orders fetch. If the
   237	    endpoint is not reachable without credentials (the typical case in V2
   238	    REST-without-API-key mode), we label a missing_api_blocker and return
   239	    an empty list. We NEVER synthesize events.
   240	    """
   241	    url = "https://open-api.coinank.com/api/liquidation/orders"
   242	    try:
   243	        status, body = fetcher(url)
   244	    except Exception as exc:
   245	        record_blocker(
   246	            "coinank_liquidation_orders_endpoint_unreachable",
   247	            f"fetcher raised: {exc!r}",
   248	        )
   249	        return []
   250	    if not (200 <= int(status) < 300) or not isinstance(body, dict):
   251	        record_blocker(
   252	            "coinank_liquidation_orders_endpoint_unreachable",
   253	            f"http_status={status}",
   254	        )
   255	        return []
   256	    data = body.get("data") or {}
   257	    items = data.get("data") if isinstance(data, dict) else None
   258	    if not isinstance(items, list):
   259	        record_blocker(
   260	            "coinank_endpoint_no_current_key",
   261	            "liquidation_orders response had no data.data list",
   262	        )
   263	        return []
   264	    return items
