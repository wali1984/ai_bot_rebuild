    68	def _write_status(payload: dict, worklog: Path, publics: tuple[Path, ...]) -> None:
    69	    body = json.dumps(payload, indent=2, sort_keys=True) + "\n"
    70	    worklog.parent.mkdir(parents=True, exist_ok=True)
    71	    worklog.write_text(body, encoding="utf-8")
    72	    for p in publics:
    73	        p.parent.mkdir(parents=True, exist_ok=True)
    74	        p.write_text(body, encoding="utf-8")
