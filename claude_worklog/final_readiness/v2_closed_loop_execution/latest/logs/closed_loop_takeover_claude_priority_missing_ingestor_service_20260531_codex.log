    70	def classify_liquidation_source() -> LiquidationSourceClassification:
    71	    """Static classification: no network IO. Reads env-name probes only.
    72	
    73	    Today V2 has no operator-approved continuous WebSocket client
    74	    targeting `!forceOrder@arr`, and there is no public REST endpoint
    75	    for per-symbol Binance Futures liquidation history without auth.
    76	    The public WSS path is known and documented, but adopting it is an
    77	    operator-scoped decision (process lifetime, reconnect policy, rate
    78	    limit, storage cap).
    79	    """
    80	    public_path_description = (
    81	        "wss://fstream.binance.com/ws/!forceOrder@arr "
    82	        "(Binance Futures public liquidation stream; no API key required; "
    83	        "requires a continuous WSS client with operator-approved scope, "
    84	        "reconnect policy, and storage retention cap)."
    85	    )
    86	    # If a future V2 WSS client opts in by setting V2_LIQUIDATION_WSS_OPT_IN
    87	    # in .env, we can flip the classification. Default today: blocked by
    88	    # operator decision (no opt-in).
    89	    if os.environ.get("V2_LIQUIDATION_WSS_OPT_IN") == "true":
    90	        return LiquidationSourceClassification(
    91	            classification=SOURCE_AVAILABLE_V2_NATIVE,
    92	            rationale=(
    93	                "Operator opt-in observed via V2_LIQUIDATION_WSS_OPT_IN=true. "
    94	                "Adopt the public Binance Futures forceOrder WebSocket "
    95	                "stream under V2-owned client."
    96	            ),
    97	            operator_decision_required=False,
    98	            public_no_credential_path_known=True,
    99	            public_no_credential_path_description=public_path_description,
   100	            v2_write_contract=V2_LIQUIDATION_KEY_PATTERNS,
   101	        )
   102	    return LiquidationSourceClassification(
   103	        classification=SOURCE_BLOCKED_BY_OPERATOR_DECISION,
   104	        rationale=(
   105	            "No V2-native per-symbol liquidation client is currently "
   106	            "running. Public Binance Futures forceOrder WSS path is "
   107	            "known (no credentials required) but requires operator "
   108	            "approval to scope a long-running V2-owned WSS client with "
   109	            "reconnect/backoff/storage retention rules. Today: BLOCKED "
   110	            "by operator decision."
   111	        ),
   112	        operator_decision_required=True,
   113	        public_no_credential_path_known=True,
   114	        public_no_credential_path_description=public_path_description,
   115	        v2_write_contract=V2_LIQUIDATION_KEY_PATTERNS,
   116	    )
