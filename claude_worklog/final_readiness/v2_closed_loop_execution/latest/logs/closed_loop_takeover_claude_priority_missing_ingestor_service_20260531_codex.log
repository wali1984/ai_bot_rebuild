            ):
                keys_written.append(k_funding)
            if oi is not None and _safe_write(r, k_oi, json.dumps(oi), ex=600):
                keys_written.append(k_oi)
            if klines is not None and _safe_write(
                r, k_ohlcv, json.dumps(klines), ex=600
            ):
                keys_written.append(k_ohlcv)
            if orderbook is not None and _safe_write(
                r, k_orderbook, json.dumps(orderbook), ex=600
            ):
                keys_written.append(k_orderbook)
        symbol_results.append(sym_info)
    heartbeat = {
        "worker_id": "v2_native_ingestors_live_loop",
        "schema_version": "v2_native_ingestors_live_v1",
        "started_at": started_at,
        "finished_at": _utc_iso(),
        "symbols": list(symbols),
        "redis_ok": redis_ok,
        "v2_market_keys_written": keys_written,
        "v2_market_keys_written_count": len(keys_written),
        "symbol_results": symbol_results,
        "classification": (
            "NATIVE_V2_PUBLIC_REST_OK"
            if redis_ok and any(s.get("ticker_present") for s in symbol_results)
            else (
                "BLOCKED_BY_REDIS_UNAVAILABLE"
                if not redis_ok
                else "BLOCKED_BY_NETWORK_OR_API"
            )
        ),
        "live_gate": "blocked_human_only",
        "live_symbols": [],
        "approves_live": False,
        "approves_legacy_shutdown": False,
        "writes_legacy_redis": False,
        "places_exchange_orders": False,
    }
    if redis_ok:
        _safe_write(
            r,
            f"{V2_REDIS_PREFIX}market:ingestor:heartbeat",
            json.dumps(heartbeat),
            ex=300,
        )
        _safe_write(
            r,
            f"{V2_REDIS_PREFIX}market:ingestor:status",
            heartbeat["classification"],
            ex=300,
