 386:     *,
 387:     initial: float = DEFAULT_BACKOFF_INITIAL_SECONDS,
 388:     cap: float = DEFAULT_BACKOFF_CAP_SECONDS,
 389: ) -> float:
 390:     """Exponential backoff with cap. attempt=1 -> initial; doubles each
 391:     subsequent attempt up to cap.
