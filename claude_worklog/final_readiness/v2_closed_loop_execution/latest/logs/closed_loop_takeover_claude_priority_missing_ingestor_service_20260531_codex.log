    12	into AVAILABLE_FOR_READ_ONLY_DATA / OPERATOR_SECRET_REQUIRED /
    13	operator-decision states. The decision source is paper-only and
    14	never authorizes live trading.
    15	"""
    16	from __future__ import annotations
