    99	def _safe_cmd(cmd: list[str], *, timeout: float = 4.0) -> str | None:
   100	    binary = shutil.which(cmd[0])
   101	    if binary is None:
   102	        return None
   103	    try:
   104	        r = subprocess.run(
   105	            [binary, *cmd[1:]], check=False, capture_output=True,
   106	            text=True, timeout=timeout,
   107	        )
   108	    except (OSError, subprocess.TimeoutExpired):
   109	        return None
   110	    return r.stdout
