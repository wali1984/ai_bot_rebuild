   338	    aggregate_payload = {
   339	        **aggregate,
   340	        "symbol": latest_event.symbol,
   341	        "generated_utc": _utc_iso(),
   342	    }
   343	    return {
   344	        KEY_LATEST_TEMPLATE.format(symbol=symbol): _safe_redis_set(
   345	            redis_client,
