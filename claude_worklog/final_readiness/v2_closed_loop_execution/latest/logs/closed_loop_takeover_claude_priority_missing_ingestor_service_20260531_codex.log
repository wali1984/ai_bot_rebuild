   299	            time.sleep(max(5, int(args.interval_seconds)))
   300	    hb = run_once(symbols)
   301	    write_payload(hb, args.out)
   302	    print(json.dumps({
   303	        "classification": hb["classification"],
   304	        "v2_market_keys_written_count": hb["v2_market_keys_written_count"],
   305	        "redis_ok": hb["redis_ok"],
   306	    }))
   307	    return 0
   308	
   309	
   310	if __name__ == "__main__":
   311	    sys.exit(main())

