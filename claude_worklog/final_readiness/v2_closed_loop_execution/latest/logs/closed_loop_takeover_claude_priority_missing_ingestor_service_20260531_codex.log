                "live_symbols": [],
            }
            k_price = f"{V2_REDIS_PREFIX}market:prices:{sym}"
            k_funding = f"{V2_REDIS_PREFIX}market:funding:{sym}"
            k_oi = f"{V2_REDIS_PREFIX}market:open_interest:{sym}"
            k_ohlcv = f"{V2_REDIS_PREFIX}market:ohlcv:binance:{sym}:1m"
            k_orderbook = f"{V2_REDIS_PREFIX}market:orderbook:{sym}"
            if _safe_write(r, k_price, json.dumps(payload), ex=600):
                keys_written.append(k_price)
            if funding is not None and _safe_write(
