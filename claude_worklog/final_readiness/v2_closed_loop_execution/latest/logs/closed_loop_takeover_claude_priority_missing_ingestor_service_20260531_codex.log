   232	def parse_args(argv: Optional[List[str]] = None) -> argparse.Namespace:
   233	    parser = argparse.ArgumentParser(prog=WORKER_ID)
   234	    parser.add_argument(
   235	        "--symbol",
   236	        default=None,
   237	        help=(
   238	            "Symbol to ingest. If omitted, falls back to the first symbol "
   239	            "returned by the dynamic universe resolver. Pass --smoke-test "
   240	            "to opt into the BTC/ETH/SOL smoke set."
   241	        ),
   242	    )
   243	    parser.add_argument(
   244	        "--smoke-test",
   245	        action="store_true",
   246	        help="Use the BTC/ETH/SOL smoke-test set (test only).",
   247	    )
   248	    parser.add_argument("--timeframe", default="1m")
   249	    parser.add_argument("--limit", type=int, default=6)
   250	    parser.add_argument("--interval", type=int, default=15)
   251	    parser.add_argument("--once", action="store_true")
   252	    parser.add_argument("--loop", action="store_true")
   253	    parser.add_argument("--no-write", action="store_true")
   254	    parser.add_argument("--enable-kucoin", action="store_true")
   255	    parser.add_argument("--depth-limit", type=int, default=20)
   256	    parser.add_argument("--coinapi-daily-budget", type=int, default=10000)
   257	    parser.add_argument("--coinapi-v1-budget-pct", type=float, default=0.30)
   258	    parser.add_argument("--verify-baseline-shas", action="store_true")
   259	    args = parser.parse_args(argv)
   260	    if not args.loop and not args.once:
   261	        args.once = True
   262	    return args
   263	
   264	
   265	def main(argv: Optional[List[str]] = None) -> int:
   266	    args = parse_args(argv)
   267	    if args.verify_baseline_shas:
   268	        report = verify_baseline_shas()
   269	        print(json.dumps(report, indent=2, sort_keys=True))
   270	        return 0 if report["ok"] else 2
   271	    if args.once:
   272	        status = run_once(args)
   273	        return 0 if status["klines_persisted_total"] > 0 else 2
   274	    while True:
   275	        try:
   276	            run_once(args)
   277	        except KeyboardInterrupt:
   278	            return 0
   279	        except Exception:
   280	            pass
   281	        time.sleep(max(1, args.interval))
   282	
   283	
   284	if __name__ == "__main__":
   285	    sys.exit(main())

