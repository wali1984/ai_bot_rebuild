   107	def _fetch_klines(symbol: str, interval: str = "1m", limit: int = 100) -> list | None:
   108	    """Fetch a small OHLCV history from Binance public REST.
   109	
   110	    Returns a list of bars, each: [open_time, open, high, low, close, volume, ...].
   111	    Public endpoint, no key. Used by the feature pipeline to compute real
   112	    TA (RSI/MACD/EMA/ATR/BB) instead of hardcoded constants.
   113	    """
   114	    try:
   115	        data = _http_get_json(
   116	            f"{BINANCE_PUBLIC}/api/v3/klines?symbol={symbol}&interval={interval}&limit={int(limit)}"
   117	        )
   118	    except (urllib.error.URLError, urllib.error.HTTPError, TimeoutError, OSError, ValueError):
   119	        return None
   120	    if not isinstance(data, list):
   121	        return None
   122	    return data
   123	
   124	
   125	def _fetch_orderbook_top(symbol: str, depth: int = 20) -> dict | None:
   126	    """Fetch a public order-book snapshot from Binance Futures.
   127	
   128	    Returns dict with ``bids`` and ``asks`` lists of [price, qty]. Public,
   129	    no key. Used by the feature pipeline for real ``depth_imbalance``.
   130	    """
   131	    try:
   132	        data = _http_get_json(
   133	            f"{BINANCE_FAPI}/fapi/v1/depth?symbol={symbol}&limit={int(depth)}"
   134	        )
   135	    except Exception:
   136	        return None
   137	    if not isinstance(data, dict):
   138	        return None
   139	    return data
