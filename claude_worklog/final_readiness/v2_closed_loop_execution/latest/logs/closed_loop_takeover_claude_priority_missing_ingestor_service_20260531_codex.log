   381	def verify_baseline_shas(manifest_path: Path = COPIED_BASELINE_MANIFEST) -> Dict[str, Any]:
   382	    """Read the copied_baseline_manifest.json and verify each baseline file
   383	    we depend on has a SHA matching ``LEGACY_BASELINE_SHA256``.
   384	    """
   385	    result: Dict[str, Any] = {"checked": [], "mismatches": [], "ok": True}
   386	    try:
   387	        manifest = json.loads(manifest_path.read_text())
   388	    except Exception as exc:
   389	        return {"checked": [], "mismatches": [], "ok": False, "error": f"manifest_load_failed: {exc}"}
   390	    by_path: Dict[str, str] = {}
   391	    for record in manifest.get("records", []):
   392	        v2_path = record.get("v2_preserved_path")
   393	        sha = record.get("sha256")
   394	        if v2_path and sha:
   395	            by_path[v2_path] = sha
   396	    for v2_path, expected in LEGACY_BASELINE_SHA256.items():
   397	        actual = by_path.get(v2_path)
   398	        result["checked"].append({"path": v2_path, "expected": expected, "actual": actual})
   399	        if actual != expected:
   400	            result["mismatches"].append({"path": v2_path, "expected": expected, "actual": actual})
   401	            result["ok"] = False
   402	    return result
   403	
