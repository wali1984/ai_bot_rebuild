## Regression test (proposed, `tests/integration/cli/test_v2_liquidation_observation_aggregator.py`):

```python
def test_full_observation_lifts_per_symbol_liquidation_latest_and_1h():
    import importlib
    fob = importlib.import_module("v2.backend.app.services.rl_core.full_observation_builder")
    per_sym = {
        "latest": {"symbol": "BTCUSDT", "side": "long",
                   "notional": 12345.6, "price": 70000.0,
                   "quantity": 0.176, "event_time_ms": 1716000000000},
        "aggregate": {"notional_1h": 98765.0, "count_1h": 7,
                      "long_count_1h": 5, "short_count_1h": 2,
                      "direction_bias_1h": 0.43},
        "v2_per_symbol_aggregator_present": True,
    }
    res = fob.build_full_observation_for_symbol(
        symbol="BTCUSDT", timeframe="1m",
        feature_snapshot={"feature_freshness_state": "CURRENT",
                          "features": {"last_liq_bps_24h": 17.0}},
        paper_positions=[], paper_ledger={}, risk_decisions=[],
        orchestrator_decisions={}, trainer_heartbeat={}, prediction={},
        v2_liquidation_per_symbol=per_sym,
    )
    by = {n: (v, s) for n, v, s in zip(res.field_names, res.field_values, res.field_sources)}
    assert by["liquidations.latest_liquidation_notional"][0] == 12345.6
    assert by["liquidations.latest_liquidation_notional"][1] == "V2_MARKET_LIQUIDATIONS_LATEST"
    assert by["liquidations.latest_liquidation_side_long"]  == (1.0, "V2_MARKET_LIQUIDATIONS_LATEST")
    assert by["liquidations.latest_liquidation_side_short"] == (0.0, "V2_MARKET_LIQUIDATIONS_LATEST")
    assert by["liquidations.liquidation_notional_1h_proxy"] == (98765.0, "V2_MARKET_LIQUIDATIONS_AGGREGATE")
    assert res.subfamily_present_counts.get("liquidations", 0) >= 10
```

