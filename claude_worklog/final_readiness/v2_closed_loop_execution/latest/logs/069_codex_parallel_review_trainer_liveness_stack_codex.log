    19	) -> tuple[StreamIdObservation, ...]:
    20	    latest_stream_id = getattr(reader, "latest_stream_id", None)
    21	    if not callable(latest_stream_id):
    22	        raise ObservationCollectorError("must_be_stream_latest_id_reader", field="reader")
