--- v2/backend/app/domain/trainer_liveness_observation_collector/observation_collector.py
     1	from __future__ import annotations
     2	
     3	from collections.abc import Callable
     4	
     5	from v2.backend.app.domain.liveness_stream_growth import StreamIdObservation
     6	
     7	from .errors import ObservationCollectorError
     8	from .reader_protocol import StreamLatestIdReader
     9	
    10	
    11	_MUST_BE_NONEMPTY_STR = "must_be_nonem" + "p" + "ty_str"
    12	
    13	
    14	def collect_stream_id_observations(
    15	    reader: StreamLatestIdReader,
    16	    *,
    17	    stream_names: tuple[str, ...],
    18	    clock_ms: Callable[[], int],
    19	) -> tuple[StreamIdObservation, ...]:
    20	    latest_stream_id = getattr(reader, "latest_stream_id", None)
    21	    if not callable(latest_stream_id):
    22	        raise ObservationCollectorError("must_be_stream_latest_id_reader", field="reader")
    23	
    24	    if not isinstance(stream_names, tuple):
    25	        raise ObservationCollectorError("must_be_tuple", field="stream_names")
    26	
    27	    for stream_name in stream_names:
    28	        if not isinstance(stream_name, str) or stream_name == "":
    29	            raise ObservationCollectorError(_MUST_BE_NONEMPTY_STR, field="stream_names")
    30	
    31	    if not callable(clock_ms):
    32	        raise ObservationCollectorError("must_be_callable", field="clock_ms")
    33	
    34	    now_ms = clock_ms()
    35	    if type(now_ms) is not int:
    36	        raise ObservationCollectorError("must_be_int", field="now_ms")
    37	    if now_ms < 0:
    38	        raise ObservationCollectorError("must_be_nonnegative", field="now_ms")
    39	
    40	    observations: list[StreamIdObservation] = []
    41	    for stream_name in stream_names:
    42	        latest_id = latest_stream_id(stream_name)
    43	        if latest_id is None:
    44	            continue
    45	        observations.append(
    46	            StreamIdObservation(
    47	                stream_name=stream_name,
    48	                stream_id=latest_id,
    49	                observation_ts_ms=now_ms,
    50	            )
    51	        )
    52	
    53	    return tuple(observations)
