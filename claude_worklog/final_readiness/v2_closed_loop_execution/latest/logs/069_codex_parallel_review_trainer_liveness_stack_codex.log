    33	
    34	class FakeRunner:
    35	    def __init__(self) -> None:
    36	        self.calls: list[FakeRunCall] = []
    37	        self.result: SubprocessRunResult | None = None
    38	        self.side_effect: Exception | None = None
    39	
    40	    def run(
    41	        self,
    42	        argv: list[str],
    43	        *,
    44	        env: dict[str, str],
    45	        cwd: str,
    46	        timeout_s: float,
    47	        stdout_path: str,
    48	        stderr_path: str,
    49	    ) -> SubprocessRunResult:
    50	        call = FakeRunCall(
    51	            argv=list(argv),
    52	            env=dict(env),
    53	            cwd=cwd,
    54	            timeout_s=timeout_s,
    55	            stdout_path=stdout_path,
    56	            stderr_path=stderr_path,
    57	        )
    58	        self.calls.append(call)
    59	        if self.side_effect is not None:
    60	            raise self.side_effect
    61	        if self.result is not None:
    62	            return self.result
    63	        return SubprocessRunResult(
    64	            returncode=0,
