def test_duplicate_source_name_raises() -> None:
    with pytest.raises(TrainerParityLineageError):
        FeatureFreshnessEnvelope(
            per_source_freshness_ms=(("a", 100), ("a", 200)),
            oldest_source_age_ms=200,
