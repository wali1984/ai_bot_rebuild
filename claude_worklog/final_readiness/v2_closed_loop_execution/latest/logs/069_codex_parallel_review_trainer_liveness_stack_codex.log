    13	@dataclass(frozen=True, slots=True)
    14	class ConfidenceExplainability:
    15	    """Mandatory legacy-preservation explainability bundle for a prediction.
    16	
    17	    The constructor enforces only the invariants that make the payload
    18	    constructible-but-malformed impossible (empty component name, non-finite
    19	    contribution). Duplicate-name, empty-set, and empty-calibration checks live
    20	    in `validate_stage_a_explainability` for defense-in-depth.
    21	    """
