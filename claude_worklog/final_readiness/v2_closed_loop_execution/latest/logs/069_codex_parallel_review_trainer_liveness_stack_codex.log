### v2/backend/app/domain/trainer_parity/freshness_metadata.py
     1	"""Per-feature freshness metadata value object.
     2	
     3	`FreshnessMetadata` is the per-feature freshness view aligned with the freshness
     4	policy in `claude_worklog/v2_requirements/02_FEATURE_SNAPSHOT_SCHEMA.md`. It is
     5	distinct from `FeatureFreshnessEnvelope` (per-source) and the two coexist on
     6	every Stage A record per the contract bullet list.
     7	"""
     8	
     9	from __future__ import annotations
    10	
    11	from dataclasses import dataclass
    12	
    13	from .errors import TrainerParityLineageError
    14	
    15	_ALLOWED_FRESHNESS_STATUSES: frozenset[str] = frozenset(
    16	    {"fresh", "warning", "stale", "missing"}
    17	)
    18	
    19	
    20	@dataclass(frozen=True, slots=True)
    21	class FreshnessMetadata:
    22	    """Per-feature last-update, age, and freshness-status payload.
    23	
    24	    Each tuple is ordered by the producing pipeline. The three tuples must cover
    25	    the same set of feature names (membership identical, ordering independent).
    26	    """
    27	
    28	    per_feature_last_update_ms: tuple[tuple[str, int], ...]
    29	    per_feature_age_ms: tuple[tuple[str, int], ...]
    30	    per_feature_status: tuple[tuple[str, str], ...]
    31	
    32	    def __post_init__(self) -> None:
    33	        if (
    34	            not self.per_feature_last_update_ms
    35	            and not self.per_feature_age_ms
    36	            and not self.per_feature_status
    37	        ):
    38	            raise TrainerParityLineageError(
    39	                (
    40	                    "freshness_metadata cannot be empty; the active model consumes at least "
    41	                    "one feature"
    42	                ),
    43	                field="freshness_metadata",
    44	            )
    45	
    46	        last_update_names = self._unique_names(
    47	            self.per_feature_last_update_ms, "per_feature_last_update_ms"
    48	        )
    49	        age_names = self._unique_names(
    50	            self.per_feature_age_ms, "per_feature_age_ms"
    51	        )
    52	        status_names = self._unique_names(
    53	            self.per_feature_status, "per_feature_status"
    54	        )
    55	
    56	        if last_update_names != age_names or last_update_names != status_names:
    57	            raise TrainerParityLineageError(
    58	                (
    59	                    "freshness_metadata feature-name set must be identical across "
    60	                    "per_feature_last_update_ms, per_feature_age_ms, and per_feature_status"
    61	                ),
    62	                field="freshness_metadata",
    63	            )
    64	
    65	        for name, last_update_ts_ms in self.per_feature_last_update_ms:
    66	            if last_update_ts_ms < 0:
    67	                raise TrainerParityLineageError(
    68	                    (
    69	                        f"freshness_metadata feature {name!r} last_update_ts_ms "
    70	                        "must be >= 0"
    71	                    ),
    72	                    field="freshness_metadata.per_feature_last_update_ms",
    73	                )
    74	
    75	        for name, age_ms in self.per_feature_age_ms:
    76	            if age_ms < 0:
    77	                raise TrainerParityLineageError(
    78	                    f"freshness_metadata feature {name!r} age_ms must be >= 0",
    79	                    field="freshness_metadata.per_feature_age_ms",
    80	                )
    81	
    82	        for name, status in self.per_feature_status:
    83	            if status not in _ALLOWED_FRESHNESS_STATUSES:
    84	                raise TrainerParityLineageError(
    85	                    (
    86	                        f"freshness_metadata feature {name!r} status {status!r} not in "
    87	                        "allowed set"
    88	                    ),
    89	                    field="freshness_metadata.per_feature_status",
    90	                )
    91	
    92	    @staticmethod
    93	    def _unique_names(
    94	        entries: tuple[tuple[str, object], ...], field_name: str
    95	    ) -> frozenset[str]:
    96	        names: list[str] = []
    97	        for raw_name, _ in entries:
    98	            if not raw_name:
    99	                raise TrainerParityLineageError(
   100	                    f"freshness_metadata.{field_name} contains empty feature name",
   101	                    field=f"freshness_metadata.{field_name}",
   102	                )
   103	            names.append(raw_name)
   104	        if len(set(names)) != len(names):
   105	            raise TrainerParityLineageError(
   106	                f"freshness_metadata.{field_name} contains duplicate feature names",
   107	                field=f"freshness_metadata.{field_name}",
   108	            )
   109	        return frozenset(names)
### v2/backend/app/domain/trainer_parity/lineage_validator.py
     1	"""Pure-function lineage validators binding Stage B -> Stage A -> snapshot -> symbol.
     2	
     3	These functions perform no I/O and import no legacy modules. They are the
     4	defense-in-depth layer behind dataclass `__post_init__` invariants and the
     5	single source of structured-reason strings for downstream observability.
     6	"""
     7	
     8	from __future__ import annotations
     9	
    10	from .errors import TrainerParityLineageError
    11	from .stage_a_record import StageATrainerRecord
    12	from .stage_b_record import StageBTrainerRecord
    13	
    14	
    15	def validate_stage_a_lineage(record: StageATrainerRecord) -> None:
    16	    """Defense-in-depth validation of Stage A lineage fields."""
    17	    if not record.prediction_id:
    18	        raise TrainerParityLineageError("prediction_id", field="prediction_id")
    19	    if not record.feature_snapshot_id:
    20	        raise TrainerParityLineageError(
    21	            "feature_snapshot_id", field="feature_snapshot_id"
    22	        )
    23	    if not record.symbol:
    24	        raise TrainerParityLineageError("symbol", field="symbol")
    25	
    26	
    27	def validate_stage_b_lineage(
    28	    stage_b: StageBTrainerRecord, stage_a: StageATrainerRecord
    29	) -> None:
    30	    """Confirm Stage B record is derived from the supplied Stage A record."""
    31	    if stage_b.prediction_id != stage_a.prediction_id:
    32	        raise TrainerParityLineageError("prediction_id", field="prediction_id")
    33	    if stage_b.feature_snapshot_id != stage_a.feature_snapshot_id:
    34	        raise TrainerParityLineageError(
    35	            "feature_snapshot_id", field="feature_snapshot_id"
    36	        )
    37	    if stage_b.symbol != stage_a.symbol:
    38	        raise TrainerParityLineageError("symbol", field="symbol")
    39	    if stage_b.signal_ts_ms < stage_a.prediction_ts_ms:
    40	        raise TrainerParityLineageError(
    41	            "signal_ts_ms_before_prediction_ts_ms", field="signal_ts_ms"
    42	        )
