### v2/backend/app/domain/trainer_parity/explainability_validator.py
     1	"""Pure-function explainability validator for Stage A trainer records.
     2	
     3	Enforces the mandatory legacy-preservation explainability field set described
     4	in `claude_worklog/phase2_core_rebuild/trainer_gpu_parity/04_REWARD_AND_CONFIDENCE_PARITY_MAP.md`.
     5	Missing or malformed fields raise `TrainerParityLineageError`.
     6	"""
     7	
     8	from __future__ import annotations
     9	
    10	import math
    11	
    12	from .errors import TrainerParityLineageError
    13	from .stage_a_record import StageATrainerRecord
    14	
    15	
    16	def validate_stage_a_explainability(record: StageATrainerRecord) -> None:
    17	    explain = record.confidence_explainability
    18	
    19	    if not explain.confidence_components:
    20	        raise TrainerParityLineageError(
    21	            "confidence_components must be non-empty",
    22	            field="confidence_explainability.confidence_components",
    23	        )
    24	
    25	    seen_names: set[str] = set()
    26	    for component_name, contribution in explain.confidence_components:
    27	        if not component_name:
    28	            raise TrainerParityLineageError(
    29	                "confidence_components contains empty component name",
    30	                field="confidence_explainability.confidence_components",
    31	            )
    32	        if not math.isfinite(contribution):
    33	            raise TrainerParityLineageError(
    34	                (
    35	                    f"confidence_components component {component_name!r} "
    36	                    "contribution must be finite"
    37	                ),
    38	                field="confidence_explainability.confidence_components",
    39	            )
    40	        if component_name in seen_names:
    41	            raise TrainerParityLineageError(
    42	                f"confidence_components contains duplicate component name {component_name!r}",
    43	                field="confidence_explainability.confidence_components",
    44	            )
    45	        seen_names.add(component_name)
    46	
    47	    if not explain.calibration_model_version:
    48	        raise TrainerParityLineageError(
    49	            "calibration_model_version must be non-empty",
    50	            field="confidence_explainability.calibration_model_version",
    51	        )
    52	    if not explain.calibration_method:
    53	        raise TrainerParityLineageError(
    54	            "calibration_method must be non-empty",
    55	            field="confidence_explainability.calibration_method",
    56	        )
    57	
    58	    if not record.top_positive_features and not record.top_negative_features:
    59	        raise TrainerParityLineageError(
    60	            "top_positive_features and top_negative_features cannot both be empty",
    61	            field="explainability.top_features",
    62	        )
    63	    if not record.source_key_references:
    64	        raise TrainerParityLineageError(
    65	            "source_key_references must be non-empty",
    66	            field="explainability.source_key_references",
    67	        )
    68	
    69	    fm = record.freshness_metadata
    70	    if (
    71	        not fm.per_feature_last_update_ms
    72	        and not fm.per_feature_age_ms
    73	        and not fm.per_feature_status
    74	    ):
    75	        raise TrainerParityLineageError(
    76	            "freshness_metadata must be non-empty",
    77	            field="explainability.freshness_metadata",
    78	        )
### v2/backend/app/domain/trainer_parity/feature_status_flags.py
     1	"""Feature status flag and per-source freshness envelope value objects."""
     2	
     3	from __future__ import annotations
     4	
     5	from dataclasses import dataclass
     6	
     7	from .errors import TrainerParityLineageError
     8	
     9	
    10	@dataclass(frozen=True, slots=True)
    11	class FeatureStatusFlags:
    12	    """Per-feature category flags. A feature appears in at most one category."""
    13	
    14	    stale: tuple[str, ...]
    15	    missing: tuple[str, ...]
    16	    unused: tuple[str, ...]
    17	
    18	    def __post_init__(self) -> None:
    19	        for category, values in (
    20	            ("stale", self.stale),
    21	            ("missing", self.missing),
    22	            ("unused", self.unused),
    23	        ):
    24	            if len(set(values)) != len(values):
    25	                raise TrainerParityLineageError(
    26	                    f"feature_status_flags.{category} contains duplicate feature names",
    27	                    field=f"feature_status_flags.{category}",
    28	                )
    29	
    30	        seen: set[str] = set()
    31	        for category, values in (
    32	            ("stale", self.stale),
    33	            ("missing", self.missing),
    34	            ("unused", self.unused),
    35	        ):
    36	            for feature_name in values:
    37	                if feature_name in seen:
    38	                    raise TrainerParityLineageError(
    39	                        (
    40	                            f"feature {feature_name!r} appears in multiple "
    41	                            "feature_status_flags categories"
    42	                        ),
    43	                        field="feature_status_flags",
    44	                    )
    45	                seen.add(feature_name)
    46	
    47	
    48	@dataclass(frozen=True, slots=True)
    49	class FeatureFreshnessEnvelope:
    50	    """Per-source freshness view of the feature snapshot the trainer consumed."""
    51	
    52	    per_source_freshness_ms: tuple[tuple[str, int], ...]
