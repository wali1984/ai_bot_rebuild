    35	    if type(now_ms) is not int:
    36	        raise ObservationCollectorError("must_be_int", field="now_ms")
    37	    if now_ms < 0:
    38	        raise ObservationCollectorError("must_be_nonnegative", field="now_ms")
    39	
    40	    observations: list[StreamIdObservation] = []
    41	    for stream_name in stream_names:
    42	        latest_id = latest_stream_id(stream_name)
    43	        if latest_id is None:
    44	            continue
    45	        observations.append(
    46	            StreamIdObservation(
