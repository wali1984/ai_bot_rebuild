     1	from __future__ import annotations
     2	
     3	from v2.backend.app.domain.liveness_stream_growth import StreamIdObservation
     4	
     5	from .errors import ObservationCollectorError
     6	
     7	
     8	def extend_observation_history(
     9	    history: tuple[StreamIdObservation, ...],
    10	    new: tuple[StreamIdObservation, ...],
    11	    *,
    12	    max_total: int,
    13	) -> tuple[StreamIdObservation, ...]:
    14	    if not isinstance(history, tuple):
    15	        raise ObservationCollectorError("must_be_tuple", field="history")
    16	
    17	    if not isinstance(new, tuple):
    18	        raise ObservationCollectorError("must_be_tuple", field="new")
    19	
    20	    for observation in history:
    21	        if not isinstance(observation, StreamIdObservation):
    22	            raise ObservationCollectorError("must_be_stream_id_observation", field="history")
    23	
    24	    for observation in new:
    25	        if not isinstance(observation, StreamIdObservation):
    26	            raise ObservationCollectorError("must_be_stream_id_observation", field="new")
    27	
    28	    if type(max_total) is not int:
    29	        raise ObservationCollectorError("must_be_int", field="max_total")
    30	
    31	    if max_total < 1:
    32	        raise ObservationCollectorError("must_be_positive", field="max_total")
    33	
    34	    combined = history + new
    35	    if len(combined) <= max_total:
    36	        return combined
    37	    return combined[-max_total:]
