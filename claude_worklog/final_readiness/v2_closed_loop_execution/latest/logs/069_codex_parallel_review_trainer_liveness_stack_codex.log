    43	    # (start_ts_ms == 1000) and once after the runner returns
    44	    # (end_ts_ms == 2000). The runner-supplied end_ts_ms (222) must
    45	    # NOT leak into the audit event; this guards the Phase 2E1.A
    46	    # spec rule that audit timing is adapter-clock-sourced on every
    47	    # path including success.
    48	    assert audit_capture[0].start_ts_ms == 1000
    49	    assert audit_capture[0].end_ts_ms == 2000
    50	    assert audit_capture[0].end_ts_ms != 222
    51	
    52	
    53	def test_invoke_audit_event_carries_stdout_and_stderr_digests(
    54	    adapter, fake_runner, audit_capture
    55	):
    56	    fake_runner.result = SubprocessRunResult(
    57	        returncode=0,
    58	        stdout=b"out",
    59	        stderr=b"err",
    60	        pid=42,
    61	        start_ts_ms=111,
    62	        end_ts_ms=222,
    63	    )
    64	    adapter.invoke(task_id="task1", mode=TrainerSubprocessMode.STATUS)
    65	    assert audit_capture[0].stdout_digest_sha256 == hashlib.sha256(b"out").hexdigest()
    66	    assert audit_capture[0].stderr_digest_sha256 == hashlib.sha256(b"err").hexdigest()
    67	
    68	
    69	def test_invoke_audit_event_carries_stdout_and_stderr_paths_under_capture_dir(
    70	    adapter, fake_runner, audit_capture
    71	):
    72	    adapter.invoke(task_id="task1", mode=TrainerSubprocessMode.STATUS)
    73	    assert audit_capture[0].stdout_path.endswith("task1/stdout.bin")
    74	    assert audit_capture[0].stderr_path.endswith("task1/stderr.bin")
