    26	
    27	def compose_liveness_snapshot_with_growth(
    28	    base_inputs: LivenessSnapshotBaseInputs,
    29	    *,
    30	    prediction_observations: tuple[StreamIdObservation, ...],
    31	    proposal_observations: tuple[StreamIdObservation, ...],
    32	    growth_config: GrowthWindowConfig,
    33	    now_ms: int,
    34	    prediction_stream_name: str,
    35	    proposal_stream_name: str,
    36	) -> LivenessSignalSnapshot:
    37	    if not isinstance(base_inputs, LivenessSnapshotBaseInputs):
    38	        raise TrainerLivenessCompositionError(
    39	            "must_be_liveness_snapshot_base_inputs",
    40	            field="base_inputs",
    41	        )
    42	
    43	    checked_prediction_observations = _ensure_observation_tuple(
    44	        prediction_observations,
    45	        field="prediction_observations",
    46	    )
    47	    checked_proposal_observations = _ensure_observation_tuple(
    48	        proposal_observations,
    49	        field="proposal_observations",
    50	    )
    51	
    52	    if not isinstance(growth_config, GrowthWindowConfig):
    53	        raise TrainerLivenessCompositionError(
    54	            "must_be_growth_window_config",
    55	            field="growth_config",
    56	        )
    57	    if type(now_ms) is not int:
    58	        raise TrainerLivenessCompositionError("must_be_int", field="now_ms")
    59	    if now_ms < 0:
    60	        raise TrainerLivenessCompositionError("must_be_nonnegative", field="now_ms")
    61	
    62	    checked_prediction_stream_name = _ensure_stream_name(
    63	        prediction_stream_name,
    64	        field="prediction_stream_name",
    65	    )
    66	    checked_proposal_stream_name = _ensure_stream_name(
    67	        proposal_stream_name,
    68	        field="proposal_stream_name",
    69	    )
    70	    if checked_prediction_stream_name == checked_proposal_stream_name:
    71	        raise TrainerLivenessCompositionError(
    72	            "stream_names_must_differ",
    73	            field="proposal_stream_name",
    74	        )
    75	
    76	    prediction_stream_id_growth = compute_stream_id_growth_in_window(
    77	        checked_prediction_observations,
    78	        growth_config,
    79	        now_ms,
    80	        stream_name=checked_prediction_stream_name,
    81	    )
    82	    proposal_stream_id_growth = compute_stream_id_growth_in_window(
    83	        checked_proposal_observations,
    84	        growth_config,
    85	        now_ms,
    86	        stream_name=checked_proposal_stream_name,
    87	    )
    88	
    89	    return LivenessSignalSnapshot(
    90	        trainer_pid=base_inputs.trainer_pid,
    91	        trainer_rss_bytes=base_inputs.trainer_rss_bytes,
    92	        trainer_heartbeat_ts_ms=base_inputs.trainer_heartbeat_ts_ms,
    93	        prediction_worker_pid=base_inputs.prediction_worker_pid,
    94	        prediction_worker_alive=base_inputs.prediction_worker_alive,
    95	        last_prediction_ts_ms=base_inputs.last_prediction_ts_ms,
    96	        last_gpu_batch_ts_ms=base_inputs.last_gpu_batch_ts_ms,
    97	        last_deconflict_ts_ms=base_inputs.last_deconflict_ts_ms,
    98	        last_proposal_ts_ms=base_inputs.last_proposal_ts_ms,
    99	        prediction_stream_id_growth=prediction_stream_id_growth,
   100	        proposal_stream_id_growth=proposal_stream_id_growth,
   101	        fatal_log_signature_observed=base_inputs.fatal_log_signature_observed,
   102	        observation_ts_ms=base_inputs.observation_ts_ms,
   103	    )
