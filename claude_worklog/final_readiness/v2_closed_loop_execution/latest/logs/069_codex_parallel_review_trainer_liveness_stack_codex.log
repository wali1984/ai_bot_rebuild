     1	"""validate_stage_a_lineage tests including defense-in-depth via object.__new__."""
     2	
     3	from __future__ import annotations
     4	
     5	import pytest
     6	
     7	from v2.backend.app.domain.trainer_parity.errors import TrainerParityLineageError
