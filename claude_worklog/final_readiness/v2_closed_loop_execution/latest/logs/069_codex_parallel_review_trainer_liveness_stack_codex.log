    19	from .errors import TrainerParityServiceError
    20	from .evaluation import TrainerLivenessEvaluation
    21	
    22	
    23	def evaluate_trainer_liveness(
    24	    reader: StreamLatestIdReader,
    25	    *,
    26	    base_inputs: LivenessSnapshotBaseInputs,
    27	    prediction_history: tuple[StreamIdObservation, ...],
    28	    proposal_history: tuple[StreamIdObservation, ...],
    29	    growth_config: GrowthWindowConfig,
    30	    now_ms_clock: Callable[[], int],
    31	    prediction_stream_name: str,
    32	    proposal_stream_name: str,
    33	    max_history_per_stream: int,
    34	) -> TrainerLivenessEvaluation:
    35	    latest_stream_id = getattr(reader, "latest_stream_id", None)
    36	    if not callable(latest_stream_id):
    37	        raise TrainerParityServiceError("must_be_stream_latest_id_reader", field="reader")
    38	
    39	    if not isinstance(base_inputs, LivenessSnapshotBaseInputs):
    40	        raise TrainerParityServiceError("must_be_liveness_snapshot_base_inputs", field="base_inputs")
    41	
    42	    if not isinstance(prediction_history, tuple):
    43	        raise TrainerParityServiceError("must_be_tuple", field="prediction_history")
    44	
    45	    if not isinstance(proposal_history, tuple):
    46	        raise TrainerParityServiceError("must_be_tuple", field="proposal_history")
    47	
    48	    for observation in prediction_history:
    49	        if not isinstance(observation, StreamIdObservation):
    50	            raise TrainerParityServiceError("must_be_stream_id_observation", field="prediction_history")
    51	
    52	    for observation in proposal_history:
    53	        if not isinstance(observation, StreamIdObservation):
    54	            raise TrainerParityServiceError("must_be_stream_id_observation", field="proposal_history")
    55	
    56	    if not isinstance(growth_config, GrowthWindowConfig):
    57	        raise TrainerParityServiceError("must_be_growth_window_config", field="growth_config")
    58	
    59	    if not callable(now_ms_clock):
    60	        raise TrainerParityServiceError("must_be_callable", field="now_ms_clock")
    61	
    62	    if not isinstance(prediction_stream_name, str) or prediction_stream_name == "":
    63	        raise TrainerParityServiceError("must_be_nonempty_str", field="prediction_stream_name")
    64	
    65	    if not isinstance(proposal_stream_name, str) or proposal_stream_name == "":
    66	        raise TrainerParityServiceError("must_be_nonempty_str", field="proposal_stream_name")
    67	
    68	    if prediction_stream_name == proposal_stream_name:
    69	        raise TrainerParityServiceError("stream_names_must_differ", field="proposal_stream_name")
