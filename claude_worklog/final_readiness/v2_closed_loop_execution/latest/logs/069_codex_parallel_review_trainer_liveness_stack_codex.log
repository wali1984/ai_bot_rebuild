    10	)
    11	from v2.backend.app.domain.trainer_parity.stage_a_record import StageATrainerRecord
    12	
    13	
    14	def _record_with_blanked_field(
    15	    base: StageATrainerRecord, target_field: str
    16	) -> StageATrainerRecord:
    17	    blank = object.__new__(StageATrainerRecord)
    18	    for slot in StageATrainerRecord.__slots__:
    19	        value = "" if slot == target_field else getattr(base, slot)
    20	        object.__setattr__(blank, slot, value)
    21	    return blank
    22	
    23	
    24	def test_valid_record_passes(valid_stage_a_record: StageATrainerRecord) -> None:
    25	    validate_stage_a_lineage(valid_stage_a_record)
    26	
    27	
    28	def test_blank_prediction_id_raises(valid_stage_a_record: StageATrainerRecord) -> None:
    29	    blanked = _record_with_blanked_field(valid_stage_a_record, "prediction_id")
    30	    with pytest.raises(TrainerParityLineageError) as exc:
    31	        validate_stage_a_lineage(blanked)
    32	    assert exc.value.reason == "prediction_id"
    33	
    34	
