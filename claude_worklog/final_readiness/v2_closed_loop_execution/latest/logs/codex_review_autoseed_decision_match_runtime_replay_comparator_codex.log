DEFAULT_FEE_BPS = 5.0
DEFAULT_SLIPPAGE_BPS = 2.0
# Cost-model marker MUST include the literal ``OPERATOR_DECISION_REQUIRED``
# so every default cost model emitted in a bundle / metrics summary is
