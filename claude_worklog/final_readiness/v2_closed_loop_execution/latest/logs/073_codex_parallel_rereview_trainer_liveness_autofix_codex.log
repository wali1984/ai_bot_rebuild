--- v2/backend/app/domain/trainer_liveness/alert.py
     1	from __future__ import annotations
     2	
     3	from dataclasses import dataclass
     4	
     5	from .errors import LivenessDomainError
     6	from .signal_snapshot import LivenessSignalSnapshot
     7	
     8	
     9	LIVENESS_REASON_PREDICTION_AGE_EXCEEDS_SLA = "prediction_age_exceeds_sla"
    10	LIVENESS_REASON_GPU_BATCH_AGE_EXCEEDS_SLA = "gpu_batch_age_exceeds_sla"
    11	LIVENESS_REASON_PROPOSAL_AGE_EXCEEDS_SLA = "proposal_age_exceeds_sla"
    12	LIVENESS_REASON_PREDICTION_STREAM_ZERO_GROWTH = "prediction_stream_zero_growth"
    13	LIVENESS_REASON_PREDICTION_WORKER_DEAD = "prediction_worker_dead"
    14	LIVENESS_REASON_FATAL_LOG_SIGNATURE_OBSERVED = "fatal_log_signature_observed"
    15	
    16	_ALLOWED_LIVENESS_REASONS = frozenset(
    17	    {
    18	        LIVENESS_REASON_PREDICTION_AGE_EXCEEDS_SLA,
    19	        LIVENESS_REASON_GPU_BATCH_AGE_EXCEEDS_SLA,
    20	        LIVENESS_REASON_PROPOSAL_AGE_EXCEEDS_SLA,
    21	        LIVENESS_REASON_PREDICTION_STREAM_ZERO_GROWTH,
    22	        LIVENESS_REASON_PREDICTION_WORKER_DEAD,
    23	        LIVENESS_REASON_FATAL_LOG_SIGNATURE_OBSERVED,
    24	    }
    25	)
    26	
    27	LIVENESS_ALERT_CODE = "TRAINER_INTERNAL_LIVENESS_CRITICAL"
    28	
    29	
    30	@dataclass(frozen=True, slots=True)
    31	class LivenessAlert:
    32	    alert_code: str
    33	    reasons: tuple[str, ...]
    34	    observation_ts_ms: int
    35	    snapshot: LivenessSignalSnapshot
    36	
    37	    def __post_init__(self) -> None:
    38	        if self.alert_code != LIVENESS_ALERT_CODE:
    39	            raise LivenessDomainError("invalid_alert_code", field="alert_code")
    40	        if not self.reasons:
    41	            raise LivenessDomainError("must_have_reasons", field="reasons")
    42	        if len(set(self.reasons)) != len(self.reasons):
    43	            raise LivenessDomainError("duplicate_reasons", field="reasons")
    44	        unknown = [reason for reason in self.reasons if reason not in _ALLOWED_LIVENESS_REASONS]
    45	        if unknown:
    46	            raise LivenessDomainError("unknown_reason", field="reasons")
    47	        if self.observation_ts_ms != self.snapshot.observation_ts_ms:
    48	            raise LivenessDomainError("must_match_snapshot", field="observation_ts_ms")
--- v2/backend/app/domain/trainer_liveness/errors.py
     1	class LivenessDomainError(ValueError):
     2	    def __init__(self, reason: str, *, field: str | None = None) -> None:
     3	        self.reason = reason
     4	        self.field = field
     5	        message = reason if field is None else f"{field}: {reason}"
     6	        super().__init__(message)
--- v2/backend/app/domain/trainer_liveness/evaluator.py
     1	from __future__ import annotations
     2	
     3	from .alert import (
     4	    LIVENESS_ALERT_CODE,
     5	    LIVENESS_REASON_FATAL_LOG_SIGNATURE_OBSERVED,
     6	    LIVENESS_REASON_GPU_BATCH_AGE_EXCEEDS_SLA,
     7	    LIVENESS_REASON_PREDICTION_AGE_EXCEEDS_SLA,
     8	    LIVENESS_REASON_PREDICTION_STREAM_ZERO_GROWTH,
     9	    LIVENESS_REASON_PREDICTION_WORKER_DEAD,
    10	    LIVENESS_REASON_PROPOSAL_AGE_EXCEEDS_SLA,
    11	    LivenessAlert,
    12	)
    13	from .errors import LivenessDomainError
    14	from .signal_snapshot import LivenessSignalSnapshot
    15	from .sla_config import LivenessSLAConfig
    16	
    17	
    18	def evaluate_liveness(
    19	    snapshot: LivenessSignalSnapshot,
    20	    sla: LivenessSLAConfig,
    21	    now_ms: int,
    22	) -> LivenessAlert | None:
    23	    if now_ms < 0:
    24	        raise LivenessDomainError("must_be_nonnegative", field="now_ms")
    25	    if now_ms < snapshot.observation_ts_ms:
    26	        raise LivenessDomainError("now_before_observation", field="now_before_observation")
    27	
    28	    reasons: list[str] = []
    29	
    30	    # Missing timestamps mean the component has never emitted; alpha treats that through stream growth.
    31	    if (
    32	        snapshot.last_prediction_ts_ms is not None
    33	        and now_ms - snapshot.last_prediction_ts_ms > sla.prediction_age_max_ms
    34	    ):
    35	        reasons.append(LIVENESS_REASON_PREDICTION_AGE_EXCEEDS_SLA)
    36	
    37	    if (
    38	        snapshot.last_gpu_batch_ts_ms is not None
    39	        and now_ms - snapshot.last_gpu_batch_ts_ms > sla.gpu_batch_age_max_ms
    40	    ):
    41	        reasons.append(LIVENESS_REASON_GPU_BATCH_AGE_EXCEEDS_SLA)
    42	
    43	    if (
    44	        snapshot.last_proposal_ts_ms is not None
    45	        and now_ms - snapshot.last_proposal_ts_ms > sla.proposal_age_max_ms
    46	    ):
    47	        reasons.append(LIVENESS_REASON_PROPOSAL_AGE_EXCEEDS_SLA)
    48	
    49	    if (
    50	        snapshot.prediction_stream_id_growth == 0
    51	        and snapshot.trainer_pid is not None
    52	        and snapshot.trainer_rss_bytes is not None
    53	        and snapshot.trainer_rss_bytes > 0
    54	    ):
    55	        reasons.append(LIVENESS_REASON_PREDICTION_STREAM_ZERO_GROWTH)
    56	
    57	    # Worker-dead evidence is independent of stream growth; nonzero growth must not suppress it.
    58	    if snapshot.prediction_worker_alive is False:
    59	        reasons.append(LIVENESS_REASON_PREDICTION_WORKER_DEAD)
    60	
    61	    if snapshot.fatal_log_signature_observed is True:
    62	        reasons.append(LIVENESS_REASON_FATAL_LOG_SIGNATURE_OBSERVED)
    63	
    64	    if not reasons:
    65	        return None
    66	
    67	    return LivenessAlert(
    68	        alert_code=LIVENESS_ALERT_CODE,
    69	        reasons=tuple(reasons),
    70	        observation_ts_ms=snapshot.observation_ts_ms,
    71	        snapshot=snapshot,
    72	    )
--- v2/backend/app/domain/trainer_liveness/signal_snapshot.py
     1	from __future__ import annotations
     2	
     3	from dataclasses import dataclass
     4	
     5	from .errors import LivenessDomainError
     6	
     7	
     8	def _ensure_optional_nonnegative(value: int | None, field: str) -> None:
     9	    if value is not None and value < 0:
    10	        raise LivenessDomainError("must_be_nonnegative", field=field)
    11	
    12	
    13	def _ensure_optional_positive(value: int | None, field: str) -> None:
    14	    if value is not None and value <= 0:
    15	        raise LivenessDomainError("must_be_positive", field=field)
    16	
    17	
    18	@dataclass(frozen=True, slots=True)
    19	class LivenessSignalSnapshot:
    20	    trainer_pid: int | None
    21	    trainer_rss_bytes: int | None
    22	    trainer_heartbeat_ts_ms: int | None
    23	    prediction_worker_pid: int | None
    24	    prediction_worker_alive: bool
    25	    last_prediction_ts_ms: int | None
    26	    last_gpu_batch_ts_ms: int | None
    27	    # Captured for lineage/explainability; alpha liveness does not alert on deconflict freshness.
    28	    last_deconflict_ts_ms: int | None
    29	    last_proposal_ts_ms: int | None
    30	    prediction_stream_id_growth: int
    31	    proposal_stream_id_growth: int
    32	    fatal_log_signature_observed: bool
    33	    observation_ts_ms: int
    34	
    35	    def __post_init__(self) -> None:
    36	        if not isinstance(self.prediction_worker_alive, bool):
    37	            raise LivenessDomainError("must_be_bool", field="prediction_worker_alive")
    38	        if not isinstance(self.fatal_log_signature_observed, bool):
    39	            raise LivenessDomainError("must_be_bool", field="fatal_log_signature_observed")
    40	        if self.observation_ts_ms < 0:
    41	            raise LivenessDomainError("must_be_nonnegative", field="observation_ts_ms")
    42	        if self.prediction_stream_id_growth < 0:
    43	            raise LivenessDomainError("must_be_nonnegative", field="prediction_stream_id_growth")
    44	        if self.proposal_stream_id_growth < 0:
    45	            raise LivenessDomainError("must_be_nonnegative", field="proposal_stream_id_growth")
    46	
    47	        _ensure_optional_positive(self.trainer_pid, "trainer_pid")
    48	        _ensure_optional_positive(self.prediction_worker_pid, "prediction_worker_pid")
    49	        _ensure_optional_nonnegative(self.trainer_rss_bytes, "trainer_rss_bytes")
    50	        _ensure_optional_nonnegative(self.trainer_heartbeat_ts_ms, "trainer_heartbeat_ts_ms")
    51	        _ensure_optional_nonnegative(self.last_prediction_ts_ms, "last_prediction_ts_ms")
    52	        _ensure_optional_nonnegative(self.last_gpu_batch_ts_ms, "last_gpu_batch_ts_ms")
    53	        _ensure_optional_nonnegative(self.last_deconflict_ts_ms, "last_deconflict_ts_ms")
    54	        _ensure_optional_nonnegative(self.last_proposal_ts_ms, "last_proposal_ts_ms")
    55	
    56	        if self.trainer_pid is None and self.trainer_rss_bytes is not None:
    57	            raise LivenessDomainError("rss_requires_trainer_pid", field="trainer_rss_bytes")
    58	        if self.prediction_worker_pid is None and self.prediction_worker_alive is True:
    59	            raise LivenessDomainError("alive_requires_worker_pid", field="prediction_worker_alive")
