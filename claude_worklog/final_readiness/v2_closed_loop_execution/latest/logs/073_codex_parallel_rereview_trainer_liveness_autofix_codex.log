    17	            "prediction_age_max_ms",
    18	            "gpu_batch_age_max_ms",
    19	            "proposal_age_max_ms",
    20	            "prediction_stream_zero_growth_window_ms",
    21	        ):
    22	            if getattr(self, field) < 1:
    23	                raise LivenessDomainError("must_be_at_least_one", field=field)
