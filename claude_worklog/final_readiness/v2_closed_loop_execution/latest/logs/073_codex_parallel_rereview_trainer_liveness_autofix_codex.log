     6	
     7	
     8	@dataclass(frozen=True, slots=True)
     9	class LivenessSLAConfig:
    10	    prediction_age_max_ms: int
    11	    gpu_batch_age_max_ms: int
    12	    proposal_age_max_ms: int
    13	    prediction_stream_zero_growth_window_ms: int
    14	
    15	    def __post_init__(self) -> None:
