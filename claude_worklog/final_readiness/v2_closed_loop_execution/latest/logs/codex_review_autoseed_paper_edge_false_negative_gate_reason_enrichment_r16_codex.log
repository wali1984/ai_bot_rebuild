def test_false_negative_resolves_paper_gate_reason_from_trainer_output_when_decision_is_empty():
    bundle = _bundle(
        "false_negative",
        paper_fill_allowed=False,
        paper_reasons=[],
        altdata={"score": 0.5},
        after_cost_5m=11.0,
    )
    bundle["trainer_output"]["paper_fill_gate_block_reasons"] = [
        "v2_native_trainer_not_implemented",
        "checkpoint_operator_decision_required",
    ]

    report, _ = build_false_negative_root_cause_report([bundle])
    cls = report["classifications"][0]

    assert cls["paper_fill_gate_block_reasons_source"] == "trainer_output"
    assert cls["paper_fill_gate_block_reasons_resolved"] == [
        "v2_native_trainer_not_implemented",
        "checkpoint_operator_decision_required",
    ]
    assert "paper_fill_gate_block" in cls["root_causes"]
    assert "paper_fill_gate_block_unrecorded_reason" not in cls["root_causes"]
    assert "MISSING_SOURCE" not in cls["root_causes"]


def test_false_negative_marks_missing_source_when_no_evidence_in_any_source():
    bundle = _bundle(
        "false_negative",
        paper_fill_allowed=False,
        paper_reasons=[],
        altdata={"score": 0.5},
        after_cost_5m=11.0,
    )

    report, _ = build_false_negative_root_cause_report([bundle])
    cls = report["classifications"][0]

    assert cls["paper_fill_gate_block_reasons_resolved"] == []
    assert cls["paper_fill_gate_block_reasons_source"] == "MISSING_SOURCE"
    assert cls["paper_fill_gate_block_reasons_sources_checked"] == [
        "paper_gate_decision",
        "trainer_output",
        "paper_intent",
        "orchestrator_held_by_paper_fill_gate",
    ]
    assert "MISSING_SOURCE" in cls["root_causes"]
    assert "paper_fill_gate_block_unrecorded_reason" in cls["root_causes"]


def test_false_negative_resolves_paper_gate_reason_from_orchestrator_held_list():
    bundle = _bundle(
        "false_negative",
        paper_fill_allowed=False,
        paper_reasons=[],
        altdata={"score": 0.5},
        after_cost_5m=9.0,
    )
    pred_id = bundle["orchestrator_decision"]["bucket_winners"][0]["winner_proposal_id"]
    bundle["orchestrator_decision"]["held_by_paper_fill_gate"] = [
        {
            "prediction_id": pred_id,
            "symbol": bundle["symbol"],
            "paper_fill_gate_block_reasons": [
                "contract_only_or_baseline_prediction_not_tradeable",
                "live_gate_blocked_human_only",
            ],
        }
    ]

    report, _ = build_false_negative_root_cause_report([bundle])
    cls = report["classifications"][0]

    assert (
        cls["paper_fill_gate_block_reasons_source"]
        == "orchestrator_held_by_paper_fill_gate"
    )
    assert cls["paper_fill_gate_block_reasons_resolved"] == [
        "contract_only_or_baseline_prediction_not_tradeable",
        "live_gate_blocked_human_only",
    ]
    assert "MISSING_SOURCE" not in cls["root_causes"]
    assert "paper_fill_gate_block_unrecorded_reason" not in cls["root_causes"]
