```tsx
import { Panel } from '../cockpitComponents';
import { usePayloadFile, fmtAge, ageClass } from '../../hooks/usePayloadFile';

const UNIVERSE_PATH = '/operator_runtime/symbol_universe/latest/symbol_universe_status.json';

interface SymbolUniverse {
  generated_at: string;
  binance_usdm_confirmed_symbols: string[];
  discovered_symbols: string[];
  dynamic_discovered_symbols: string[];
  dynamic_symbol_sources: string[];
  legacy_active_symbols: string[];
  legacy_active_symbols_are_full_universe: boolean;
  live_blocked_symbols: string[];
  live_gate: string;
  live_symbol_policy: string;
  live_symbols: string[];
  observed_symbols: string[];
  paper_symbols: string[];
  requested_paper_symbols: string[];
  requested_training_symbols: string[];
  training_symbols: string[];
  rejected_paper_symbols: string[];
  rejected_training_symbols: string[];
  symbol_scope_policy: string;
  symbol_selection_score_factors: string[];
  symbol_universe_payload_evidence_gaps: string[];
  symbol_universe_source_path: string;
  source_paths: string[];
  trade_all_discovered_symbols: boolean;
  train_all_discovered_symbols: boolean;
}

export default function SymbolsPage(): JSX.Element {
  const { data, error, ageSeconds } = usePayloadFile<SymbolUniverse>(UNIVERSE_PATH, 15_000);
  const ac = ageClass(ageSeconds, 120);

  return (
    <article className="enterprise-cockpit-page grid-bg" data-testid="page-symbols">
      <header className="ent-page-hero panel bracketed hatch">
        <span className="br-bl" aria-hidden="true" /><span className="br-br" aria-hidden="true" />
        <div className="ent-hero-copy">
          <p className="eyebrow">Markets / Symbols</p>
          <h1>Symbol Universe</h1>
          <p>Authoritative universe membership. Live trading symbols are BLOCKED — only paper symbols may execute paper ticks.</p>
        </div>
        <div className="ent-hero-chips">
          <span className="chip solid-block">LIVE SYMBOLS: {data?.live_symbols?.length ?? 0}</span>
          <span className={`chip solid-${ac}`}>{fmtAge(ageSeconds)}</span>
          <span className="chip">{data?.live_gate ?? 'blocked_human_only'}</span>
          {error ? <span className="chip solid-block">PAYLOAD ERROR</span> : null}
        </div>
      </header>

      <Panel id="universe-source-of-truth" title="Source of Truth"
        right={<span className="chip">runtime payload</span>}>
        <div className="cockpit-card-grid">
          <div className="truth-state-card truth-state-card--paper">
            <span className="truth-state-card__label">Universe Payload</span>
            <strong>{ageSeconds == null ? 'MISSING_EVIDENCE' : 'V2_SYMBOL_UNIVERSE_PUBLIC_PAYLOAD'}</strong>
            <small><code>{UNIVERSE_PATH}</code> · age {fmtAge(ageSeconds)}</small>
          </div>
          <div className="truth-state-card truth-state-card--paper">
            <span className="truth-state-card__label">Service Source</span>
            <strong>v2.backend.app.services.symbol_universe</strong>
            <small><code>{data?.symbol_universe_source_path ?? 'MISSING_EVIDENCE'}</code></small>
          </div>
          <div className="truth-state-card truth-state-card--bad">
            <span className="truth-state-card__label">Live Symbols</span>
            <strong>{(data?.live_symbols?.length ?? 0) === 0 ? 'BLOCKED (empty)' : data!.live_symbols.join(', ')}</strong>
            <small>policy: <code>{data?.live_symbol_policy ?? 'MISSING_EVIDENCE'}</code></small>
          </div>
        </div>
      </Panel>

      <Panel id="universe-bucketed" title="Universe by Bucket"
        right={<span className={`chip solid-${ac}`}>{fmtAge(ageSeconds)}</span>}>
        <div className="cockpit-card-grid">
          {[
            { label: 'discovered', arr: data?.discovered_symbols, note: `sources: ${data?.dynamic_symbol_sources?.join(', ') ?? 'MISSING_EVIDENCE'}` },
            { label: 'binance USDM confirmed', arr: data?.binance_usdm_confirmed_symbols, note: 'verified on Binance USDM' },
            { label: 'legacy active (current 25)', arr: data?.legacy_active_symbols, note: data?.legacy_active_symbols_are_full_universe ? 'full universe' : 'subset only' },
            { label: 'paper symbols', arr: data?.paper_symbols, note: `requested: ${data?.requested_paper_symbols?.join(', ') || 'MISSING_EVIDENCE'}` },
            { label: 'observed symbols', arr: data?.observed_symbols, note: 'currently producing ticks' },
            { label: 'training symbols', arr: data?.training_symbols, note: `requested: ${data?.requested_training_symbols?.join(', ') || 'MISSING_EVIDENCE'}` },
            { label: 'live blocked', arr: data?.live_blocked_symbols, note: 'symbols never auto-promoted to live' },
          ].map(({ label, arr, note }) => (
            <div key={label} className="truth-state-card truth-state-card--paper">
              <span className="truth-state-card__label">{label} ({arr?.length ?? 0})</span>
              <strong style={{ fontSize: '12px', lineHeight: 1.4 }}>
                {arr && arr.length > 0 ? arr.slice(0, 12).join(', ') + (arr.length > 12 ? `, +${arr.length - 12}` : '') : 'MISSING_EVIDENCE'}
              </strong>
              <small>{note}</small>
            </div>
          ))}
        </div>
      </Panel>

      <Panel id="universe-policy" title="Symbol Scope Policy"
        right={<span className="chip">non-live</span>}>
        <div className="cockpit-lineage-grid">
          <div><span>symbol_scope_policy</span><strong>{data?.symbol_scope_policy ?? 'MISSING_EVIDENCE'}</strong></div>
          <div><span>trade_all_discovered_symbols</span><strong>{String(data?.trade_all_discovered_symbols ?? 'MISSING_EVIDENCE')}</strong></div>
          <div><span>train_all_discovered_symbols</span><strong>{String(data?.train_all_discovered_symbols ?? 'MISSING_EVIDENCE')}</strong></div>
          <div><span>live_gate</span><strong>{data?.live_gate ?? 'MISSING_EVIDENCE'}</strong></div>
          <div><span>rejected paper</span><strong>{data?.rejected_paper_symbols?.length === 0 ? 'none' : data?.rejected_paper_symbols?.join(', ') ?? 'MISSING_EVIDENCE'}</strong></div>
          <div><span>rejected training</span><strong>{data?.rejected_training_symbols?.length === 0 ? 'none' : data?.rejected_training_symbols?.join(', ') ?? 'MISSING_EVIDENCE'}</strong></div>
        </div>
      </Panel>

      <Panel id="universe-selection-factors" title="Selection Score Factors">
        {data?.symbol_selection_score_factors?.length ? (
          <div className="symbol-pill-grid">
            {data.symbol_selection_score_factors.map((f) => <span key={f} className="symbol-pill">{f.replace(/_/g, ' ')}</span>)}
          </div>
        ) : (
          <div className="missing-evidence-board">
            <div className="missing-evidence-card">
              <strong>MISSING_EVIDENCE — selection factors not declared</strong>
              <p>Source: <code>{UNIVERSE_PATH}</code> field <code>symbol_selection_score_factors</code></p>
            </div>
          </div>
        )}
      </Panel>

      <Panel id="universe-evidence-gaps" title="Evidence Gaps"
        right={<span className="chip solid-warn">{data?.symbol_universe_payload_evidence_gaps?.length ?? 0} gap(s)</span>}>
        {data?.symbol_universe_payload_evidence_gaps && data.symbol_universe_payload_evidence_gaps.length > 0 ? (
          <div className="missing-evidence-board">
            {data.symbol_universe_payload_evidence_gaps.map((g) => (
              <div key={g} className="missing-evidence-card">
                <strong>{g}</strong>
                <p>declared by universe service</p>
              </div>
            ))}
          </div>
        ) : (
          <p className="ent-placeholder">No declared evidence gaps from the universe service.</p>
        )}
        {data?.source_paths?.length ? (
          <div style={{ marginTop: '10px', fontSize: '11px', color: 'var(--text-mid)' }}>
            <strong>Cross-referenced sources:</strong>
            <ul style={{ marginTop: '4px' }}>
              {data.source_paths.map((p) => <li key={p}><code>{p}</code></li>)}
            </ul>
          </div>
        ) : null}
      </Panel>
    </article>
  );
}
```

