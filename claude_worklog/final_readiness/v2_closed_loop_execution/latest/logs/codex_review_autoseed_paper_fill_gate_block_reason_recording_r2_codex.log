   253	def append_price_snapshot(symbol: str) -> dict[str, Any]:
   254	    sym = symbol.upper()
   255	    point = _read_market_price(sym)
   256	    if point is None:
   257	        return {"symbol": sym, "appended": False, "reason": "no_market_price"}
   258	    ts, price = point
   259	    STATE_DIR.mkdir(parents=True, exist_ok=True)
   260	    path = _price_timeline_path(sym)

--- middle ---
   260	    path = _price_timeline_path(sym)
   261	    # Avoid appending if the same ts has been recorded already.
   262	    last_ts = _last_recorded_ts(path)
   263	    if last_ts is not None and ts <= last_ts:
   264	        return {
   265	            "symbol": sym,
   266	            "appended": False,
   267	            "reason": "no_new_market_tick",
   268	            "last_recorded_ts": last_ts,
   269	            "candidate_ts": ts,
   270	        }
   271	    with path.open("a", encoding="utf-8") as f:
   272	        f.write(json.dumps({"ts": ts, "price": price}) + "\n")
   273	    return {"symbol": sym, "appended": True, "ts": ts, "price": price}
