   892	def backfill_bundle_cost_model(row: Mapping[str, Any]) -> tuple[dict[str, Any], bool]:
   893	    """Return (re-tagged row, changed_flag).
   894	
   895	    Only the ``market_snapshot`` sub-document is mutated. Protected
   896	    fields (intent_id, timestamps, future_outcomes, label, paper gate /
   897	    risk / orchestrator decisions, etc.) are left untouched. Existing
   898	    operator-set overrides (e.g. an operator-supplied fee_bps that is
   899	    not the default 5.0) are NOT clobbered: only the marker literal and
   900	    the visible-override metadata are added when missing.
   901	    """
   902	    out = dict(row)
   903	    market = dict(out.get("market_snapshot") or {})
   904	    changed = False
   905	    source = market.get("cost_model_source")
   906	    if isinstance(source, str) and source == LEGACY_COST_MODEL_MARKER:
   907	        market["cost_model_source"] = REQUIRED_COST_MODEL_MARKER
   908	        changed = True
   909	    elif not isinstance(source, str) or REQUIRED_COST_MODEL_LITERAL not in source:
   910	        # Defensive: when source is missing or carries some other tag
   911	        # without the literal, append the required marker. This never
   912	        # silently rewrites an operator-set marker that already includes
   913	        # the literal.
   914	        market["cost_model_source"] = REQUIRED_COST_MODEL_MARKER
   915	        changed = True
   916	    if "operator_decision_required" not in market:
   917	        market["operator_decision_required"] = True
   918	        changed = True
   919	    if "operator_override_required" not in market:
   920	        market["operator_override_required"] = True
   921	        changed = True
   922	    if "default_fee_bps_visible" not in market:
   923	        market["default_fee_bps_visible"] = DEFAULT_FEE_BPS
   924	        changed = True
   925	    if "default_slippage_estimate_bps_visible" not in market:
   926	        market["default_slippage_estimate_bps_visible"] = DEFAULT_SLIPPAGE_BPS
   927	        changed = True
   928	    out["market_snapshot"] = market
   929	    return out, changed
