   620	def _merge_new_paper_rows(
   621	    existing: list[dict[str, Any]],
   622	    paper_rows: list[dict[str, Any]],
   623	) -> tuple[list[dict[str, Any]], int]:
   624	    """Return (merged, newly_added_count)."""
   625	    by_intent: dict[str, dict[str, Any]] = {
   626	        b["prediction_id"]: b for b in existing if b.get("prediction_id")
   627	    }
   628	    added = 0
   629	    for row in paper_rows:
   630	        intent_id = row.get("intent_id")
   631	        if not intent_id:
   632	            continue
   633	        if intent_id in by_intent:
   634	            continue
   635	        new_bundle = _new_bundle_from_row(row)
   636	        by_intent[intent_id] = new_bundle
   637	        added += 1
   638	    # Sort by anchor_ts ascending so the JSONL stays time-ordered.
   639	    merged = sorted(
   640	        by_intent.values(),
   641	        key=lambda b: (b.get("anchor_ts") or 0),
   642	    )
   643	    return merged, added
