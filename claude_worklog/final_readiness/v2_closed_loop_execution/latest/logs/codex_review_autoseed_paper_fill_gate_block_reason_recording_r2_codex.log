   317	def _classify_false_negative(bundle: dict[str, Any]) -> dict[str, Any]:
   318	    causes: list[str] = []
   319	    notes: list[str] = []
   320	
   321	    trainer_output = bundle.get("trainer_output") or {}
   322	    risk_decision = bundle.get("risk_decision") or {}
   323	    paper_gate = bundle.get("paper_gate_decision") or {}
   324	    altdata = bundle.get("altdata_snapshot")
   325	    paper_intent = bundle.get("paper_intent") or {}
   326	
   327	    if trainer_output.get("selected_action") in (None, "hold"):
   328	        causes.append("model_hold_due_checkpoint")
   329	        notes.append("trainer selected_action was hold or absent")
   330	
   331	    if not risk_decision.get("pre_trade_allowed", True):
   332	        causes.append("risk_gate_block")
   333	        notes.append(
   334	            f"risk gate blocked: churn={risk_decision.get('churn_reason')} "
   335	            f"fee={risk_decision.get('fee_gate_reason')}"
   336	        )
   337	
   338	    paper_allowed = paper_gate.get("paper_fill_allowed")
   339	    paper_reasons = paper_gate.get("paper_fill_gate_block_reasons") or []
   340	    paper_reason_lineage = paper_gate.get("paper_fill_gate_block_reasons_lineage") or {}
   341	    paper_reason_state = (
   342	        paper_reason_lineage.get("state")
   343	        if isinstance(paper_reason_lineage, dict)
   344	        else None
   345	    )
   346	    if paper_allowed is False:
   347	        causes.append("paper_fill_gate_block")
   348	        if not paper_reasons:
   349	            if paper_reason_state == "MISSING_SOURCE":
   350	                notes.append(
   351	                    "paper_fill_allowed=false with empty "
   352	                    "paper_fill_gate_block_reasons and explicit "
   353	                    "MISSING_SOURCE lineage; no block reason was fabricated"
   354	                )
   355	            else:
   356	                causes.append("paper_fill_gate_block_unrecorded_reason")
   357	                causes.append("observation_gap")
   358	                notes.append(
   359	                    "paper_fill_allowed=false with empty "
   360	                    "paper_fill_gate_block_reasons — block reason is not "
   361	                    "observable from the bundle"
   362	                )
   363	        else:
   364	            notes.append(f"paper gate reasons: {paper_reasons}")
   365	
   366	    if altdata is None:
   367	        causes.append("altdata_missing")
   368	        notes.append("altdata_snapshot is null")
   369	    elif isinstance(altdata, dict) and altdata.get("status") == "MISSING_SOURCE":
   370	        causes.append("altdata_missing")
   371	        notes.append("altdata_snapshot explicitly records MISSING_SOURCE")
   372	
   373	    if paper_intent.get("decision") == "SHADOW_OBSERVATION_ONLY":
   374	        notes.append(
   375	            "paper intent recorded as SHADOW_OBSERVATION_ONLY — fill path "
   376	            "was not exercised even though risk/edge cleared"
   377	        )
   378	
   379	    # Deduplicate while preserving order.
   380	    seen: set[str] = set()
   381	    deduped = [c for c in causes if not (c in seen or seen.add(c))]
   382	    return {
   383	        "symbol": bundle.get("symbol"),
   384	        "anchor_ts": bundle.get("anchor_ts"),
   385	        "feature_snapshot_id": bundle.get("feature_snapshot_id"),
   386	        "prediction_id": (
   387	            (bundle.get("orchestrator_decision") or {})
   388	            .get("bucket_winners", [{}])[0]
   389	            .get("winner_proposal_id")
   390	            if bundle.get("orchestrator_decision")
   391	            else None
   392	        ),
   393	        "expected_move_after_cost_bps": trainer_output.get(
   394	            "expected_move_after_cost_bps"
   395	        ),
   396	        "outcome_after_cost": bundle.get("outcome_after_cost"),
   397	        "paper_gate_decision": paper_gate,
   398	        "paper_fill_gate_block_reason_state": paper_reason_state,
   399	        "risk_decision": risk_decision,
   400	        "altdata_snapshot_present": altdata is not None,
   401	        "altdata_snapshot_explicit_missing": (
   402	            isinstance(altdata, dict) and altdata.get("status") == "MISSING_SOURCE"
   403	        ),
   404	        "trainer_selected_action": trainer_output.get("selected_action"),
   405	        "root_causes": deduped,
   406	        "notes": notes,
   407	    }
