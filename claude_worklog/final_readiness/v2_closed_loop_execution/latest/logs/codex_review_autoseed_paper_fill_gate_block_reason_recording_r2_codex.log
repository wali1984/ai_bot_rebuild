  1053	def backfill_jsonl_store(path: Path) -> dict[str, Any]:
  1054	    """Apply ``backfill_bundle_cost_model`` to every row in a JSONL file.
  1055	
  1056	    Returns a status dict describing rows scanned, rows re-tagged,
  1057	    validation errors, and protected-field-diff drift (which would be
  1058	    a hard failure but should never happen given the backfill only
  1059	    touches market_snapshot).
  1060	    """
  1061	    if not path.exists():
  1062	        return {"path": str(path), "exists": False, "rows": 0, "changed": 0, "errors": []}
  1063	    original_rows: list[dict[str, Any]] = []
  1064	    parse_errors: list[str] = []
  1065	    with path.open("r", encoding="utf-8") as f:
  1066	        for i, line in enumerate(f):
  1067	            line = line.rstrip("\n")
  1068	            if not line.strip():
  1069	                continue
  1070	            try:
  1071	                original_rows.append(json.loads(line))
  1072	            except Exception as exc:  # noqa: BLE001
  1073	                parse_errors.append(f"row_{i}_invalid_json:{exc}")
  1074	    new_rows: list[dict[str, Any]] = []
  1075	    changed_count = 0
  1076	    protected_drift: list[str] = []
  1077	    validation_errors: list[str] = []
  1078	    for i, orig in enumerate(original_rows):
  1079	        sig_before = _row_protected_signature(orig)
  1080	        cost_row, cost_changed = backfill_bundle_cost_model(orig)
  1081	        sig_after = _row_protected_signature(cost_row)
  1082	        if sig_before != sig_after:
  1083	            protected_drift.append(
  1084	                f"row_{i}_protected_field_drift:{orig.get('intent_id')}"
  1085	            )
  1086	        new_row, context_changed = backfill_bundle_replay_context(cost_row)
  1087	        changed = cost_changed or context_changed
  1088	        if changed:
  1089	            changed_count += 1
  1090	        errs = validate_bundle_row(new_row)
  1091	        if errs:
  1092	            validation_errors.extend(
  1093	                f"row_{i}_{err}" for err in errs
  1094	            )
  1095	        new_rows.append(new_row)
  1096	    # Atomic replace.
  1097	    if changed_count > 0 and not protected_drift and not validation_errors:
  1098	        tmp = path.with_suffix(path.suffix + ".tmp")
  1099	        with tmp.open("w", encoding="utf-8") as f:
  1100	            for r in new_rows:
  1101	                f.write(json.dumps(r, sort_keys=True, default=str) + "\n")
  1102	        os.replace(tmp, path)
  1103	    return {
  1104	        "path": str(path),
  1105	        "exists": True,
  1106	        "rows": len(original_rows),
  1107	        "changed": changed_count,
  1108	        "parse_errors": parse_errors,
  1109	        "protected_field_drift": protected_drift,
  1110	        "validation_errors": validation_errors,
  1111	        "validation_passed": (
  1112	            not parse_errors and not protected_drift and not validation_errors
  1113	        ),
  1114	    }
  1115	
  1116	
  1117	def backfill_all_replay_bundle_stores() -> dict[str, Any]:
  1118	    """Backfill every persisted replay bundle store and verify the
  1119	    canonical marker/override fields are present on every row."""
  1120	    targets = [
  1121	        WORKLOG_DIR / "replay_outcome_bundles.jsonl",
  1122	        PUBLIC_DIR / "replay_outcome_bundles.jsonl",
  1123	        REPLAY_BUNDLES_PATH,
  1124	    ]
  1125	    return {
  1126	        "stores": [backfill_jsonl_store(p) for p in targets],
  1127	        "required_cost_model_literal": REQUIRED_COST_MODEL_LITERAL,
  1128	        "required_cost_model_marker": REQUIRED_COST_MODEL_MARKER,
  1129	        "required_market_snapshot_keys": list(REQUIRED_MARKET_SNAPSHOT_KEYS),
  1130	    }

