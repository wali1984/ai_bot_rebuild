   932	def backfill_bundle_replay_context(row: Mapping[str, Any]) -> tuple[dict[str, Any], bool]:
   933	    """Attach explicit paper-gate lineage and alt-data source state.
   934	
   935	    This remediation is intentionally evidence-only. It records existing
   936	    gate reasons and explicit missing-source states, but it does not
   937	    fabricate a block reason and does not recalculate labels/outcomes.
   938	    """
   939	    out = dict(row)
   940	    changed = False
   941	    symbol = str(out.get("symbol") or "").upper()
   942	    if not isinstance(out.get("altdata_snapshot"), Mapping):
   943	        out["altdata_snapshot"] = build_altdata_snapshot(symbol)
   944	        changed = True
   945	
   946	    paper_gate = dict(out.get("paper_gate_decision") or {})
   947	    if "paper_fill_allowed" not in paper_gate and "paper_fill_allowed" in out:
   948	        paper_gate["paper_fill_allowed"] = out.get("paper_fill_allowed")
   949	    trainer_output = dict(out.get("trainer_output") or {})
   950	    resolver_row = dict(out)
   951	    resolver_row["paper_gate_decision"] = paper_gate
   952	    resolver_row["trainer_output"] = trainer_output
   953	    reasons, lineage = _resolve_paper_fill_gate_block_reasons(resolver_row)
   954	    if paper_gate.get("paper_fill_gate_block_reasons") != reasons:
   955	        paper_gate["paper_fill_gate_block_reasons"] = reasons
   956	        changed = True
   957	    if paper_gate.get("paper_fill_gate_block_reasons_lineage") != lineage:
   958	        paper_gate["paper_fill_gate_block_reasons_lineage"] = lineage
   959	        changed = True
   960	    if trainer_output.get("paper_fill_gate_block_reasons") != reasons:
   961	        trainer_output["paper_fill_gate_block_reasons"] = reasons
   962	        changed = True
   963	    if trainer_output.get("paper_fill_gate_block_reasons_lineage") != lineage:
   964	        trainer_output["paper_fill_gate_block_reasons_lineage"] = lineage
   965	        changed = True
   966	    status = "BLOCK_REASON_RECORDED" if reasons else lineage["state"]
   967	    mirrors = {
   968	        "paper_fill_allowed": paper_gate.get("paper_fill_allowed"),
   969	        "paper_fill_gate_status": status,
   970	        "paper_fill_gate_block_reasons": reasons,
   971	        "paper_fill_gate_block_reasons_lineage": lineage,
   972	    }
   973	    for key, value in mirrors.items():
   974	        if out.get(key) != value:
   975	            out[key] = value
   976	            changed = True
   977	    out["paper_gate_decision"] = paper_gate
   978	    out["trainer_output"] = trainer_output
   979	    return out, changed
