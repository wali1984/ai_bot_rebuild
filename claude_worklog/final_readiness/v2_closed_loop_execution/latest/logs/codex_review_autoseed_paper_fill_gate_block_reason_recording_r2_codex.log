  1048	def _row_protected_signature(row: Mapping[str, Any]) -> dict[str, Any]:
  1049	    """Snapshot of the bundle's protected fields for diff verification."""
  1050	    return {k: row.get(k) for k in _PROTECTED_BUNDLE_FIELDS}
