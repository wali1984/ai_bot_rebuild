   159	def test_comparator_attaches_passthrough_integrity_note() -> None:
   160	    comp = importlib.import_module("v2.backend.app.cli.v2_production_equivalence_comparator")
   161	    reasons = ["BLOCK_NEGATIVE_EXPECTED_MOVE_AFTER_COST"]
   162	    per_symbol = [{
   163	        "symbol": "SOLUSDT",
   164	        "timeframe": "1m",
   165	        "legacy": {"exists": True, "action": "open_long"},
   166	        "v2": {
   167	            "exists": True,
   168	            "selected_action": "hold",
   169	            "paper_fill_allowed": False,
   170	            "paper_fill_gate_block_reasons": reasons,
   171	        },
   172	        "match": False,
   173	        "notes": [],
   174	    }]
   175	    orch_held = [{
   176	        "symbol": "SOLUSDT",
   177	        "paper_fill_gate_block_reasons": reasons,
   178	    }]
   179	    paper_held = [{
   180	        "symbol": "SOLUSDT",
   181	        "paper_fill_gate_block_reasons": reasons,
   182	    }]
   183	    comp._attach_held_passthrough(per_symbol, orch_held, paper_held)
   184	    notes = per_symbol[0]["notes"]
   185	    passthrough_note = next(
   186	        (n for n in notes if n.startswith("block_reasons_passthrough:")), None
