   105	def _utc_iso() -> str:
   106	    return (
   107	        datetime.now(timezone.utc)
   108	        .isoformat(timespec="seconds")
   109	        .replace("+00:00", "Z")
   110	    )
   111	
   112	
   113	def _parse_iso(ts: Any) -> float | None:
   114	    if not isinstance(ts, str):
   115	        return None
   116	    s = ts
   117	    if s.endswith("Z"):
   118	        s = s[:-1] + "+00:00"
   119	    try:
   120	        return datetime.fromisoformat(s).timestamp()
   121	    except Exception:  # noqa: BLE001
   122	        return None
   123	
   124	
   125	def _coerce_float(value: Any) -> float | None:
   126	    try:
   127	        if value is None:
   128	            return None
   129	        return float(value)
   130	    except (TypeError, ValueError):
   131	        return None
   132	
   133	
   134	def _safe_redis_read(key: str) -> Any:
   135	    """v2:* only. Never writes. Returns parsed JSON or None."""
   136	    if not key.startswith("v2:"):
   137	        return None
   138	    try:
   139	        import redis  # type: ignore
   140	
   141	        r = redis.Redis(decode_responses=True, socket_connect_timeout=2)
   142	        r.ping()
   143	        raw = r.get(key)
   144	        if raw is None:
   145	            return None
   146	        try:
   147	            return json.loads(raw)
   148	        except Exception:  # noqa: BLE001
   149	            return raw
   150	    except Exception:  # noqa: BLE001
   151	        return None
   152	
   153	
   154	def _list_from_any(value: Any) -> list[str]:
   155	    if value is None:
   156	        return []
   157	    if isinstance(value, str):
   158	        return [value] if value.strip() else []
   159	    if isinstance(value, Iterable) and not isinstance(value, (dict, bytes)):
   160	        out: list[str] = []
   161	        for item in value:
   162	            if item is None:
   163	                continue
   164	            s = str(item).strip()
   165	            if s:
   166	                out.append(s)
   167	        return out
   168	    return []
   169	
   170	
   171	def _dedupe_strings(values: Iterable[str]) -> list[str]:
   172	    seen: set[str] = set()
   173	    out: list[str] = []
   174	    for value in values:
   175	        if value in seen:
   176	            continue
   177	        seen.add(value)
   178	        out.append(value)
   179	    return out
   180	
   181	
   182	def _sanitize_public_mapping(doc: Mapping[str, Any]) -> dict[str, Any]:
   183	    """Copy a public V2 payload while redacting accidental credential fields."""
   184	    sanitized: dict[str, Any] = {}
   185	    for key, value in doc.items():
   186	        lowered = str(key).lower()
   187	        if any(token in lowered for token in ("secret", "api_key", "apikey", "token")):
   188	            sanitized[str(key)] = "REDACTED_FIELD_NAME_PRESENT"
   189	            continue
   190	        if isinstance(value, Mapping):
   191	            sanitized[str(key)] = _sanitize_public_mapping(value)
   192	        elif isinstance(value, list):
   193	            sanitized[str(key)] = [
   194	                _sanitize_public_mapping(v) if isinstance(v, Mapping) else v
   195	                for v in value
   196	            ]
   197	        else:
   198	            sanitized[str(key)] = value
   199	    return sanitized
   200	
   201	
   202	def build_altdata_snapshot(symbol: str) -> dict[str, Any]:
   203	    """Return an explicit alt-data snapshot state for a replay bundle.
   204	
   205	    The miner reads only the V2-owned per-symbol score key. When the
   206	    source is absent, the bundle records MISSING_SOURCE rather than
   207	    fabricating a neutral score.
   208	    """
   209	    sym = symbol.upper()
   210	    key = ALTDATA_SYMBOL_SCORE_KEY_TEMPLATE.format(symbol=sym)
   211	    doc = _safe_redis_read(key)
   212	    if isinstance(doc, Mapping):
   213	        return {
   214	            "symbol": sym,
   215	            "status": "ATTACHED",
   216	            "source_label": "V2_NATIVE_PUBLIC_PAYLOAD",
   217	            "source_key": key,
   218	            "payload": _sanitize_public_mapping(doc),
   219	        }
   220	    return {
   221	        "symbol": sym,
   222	        "status": PAPER_FILL_GATE_MISSING_SOURCE,
   223	        "source_label": PAPER_FILL_GATE_MISSING_SOURCE,
   224	        "source_key": key,
   225	        "missing_reason": "v2_altdata_symbol_score_key_missing",
   226	        "payload": None,
   227	    }
