   275	
   276	def _last_recorded_ts(path: Path) -> float | None:
   277	    if not path.exists():
   278	        return None
   279	    last = None
   280	    try:
   281	        with path.open("r", encoding="utf-8") as f:
   282	            for line in f:
   283	                try:
   284	                    row = json.loads(line)
   285	                    last = row.get("ts")
   286	                except Exception:  # noqa: BLE001
   287	                    continue
   288	    except Exception:  # noqa: BLE001
   289	        return None
   290	    return last
   291	
   292	
   293	def load_price_timeline(symbol: str) -> list[tuple[float, float]]:
   294	    path = _price_timeline_path(symbol.upper())
   295	    if not path.exists():
   296	        return []
   297	    rows: list[tuple[float, float]] = []
   298	    with path.open("r", encoding="utf-8") as f:
   299	        for line in f:
   300	            try:
   301	                row = json.loads(line)
   302	                ts = float(row.get("ts"))
   303	                price = float(row.get("price"))
   304	                rows.append((ts, price))
   305	            except Exception:  # noqa: BLE001
   306	                continue
   307	    rows.sort(key=lambda x: x[0])
   308	    return rows
