   649	
   650	def _compute_window(
   651	    *,
   652	    timeline: list[tuple[float, float]],
   653	    anchor_ts: float | None,
   654	    entry_price: float | None,
   655	    side: str | None,
   656	    window_id: str,
   657	    window_seconds: int,
   658	    fee_bps: float,
   659	    slippage_bps: float,
   660	) -> dict[str, Any]:
   661	    if anchor_ts is None or entry_price is None or entry_price <= 0:
   662	        return {
   663	            "window_id": window_id,
   664	            "window_seconds": window_seconds,
   665	            "return_bps": None,
   666	            "after_cost_return_bps": None,
   667	            "drawdown_bps": None,
   668	            "max_favorable_bps": None,
   669	            "max_adverse_bps": None,
   670	            "fee_drag_bps": None,
   671	            "slippage_estimate_bps": None,
   672	            "samples": 0,
   673	            "stop_hit": False,
   674	            "source": "INSUFFICIENT_EVIDENCE_NO_ANCHOR_OR_ENTRY_PRICE",
   675	        }
   676	    sl = _find_window_slice(timeline, anchor_ts, window_seconds)
   677	    if sl is None:
   678	        return {
   679	            "window_id": window_id,
   680	            "window_seconds": window_seconds,
   681	            "return_bps": None,
   682	            "after_cost_return_bps": None,
   683	            "drawdown_bps": None,
   684	            "max_favorable_bps": None,
   685	            "max_adverse_bps": None,
   686	            "fee_drag_bps": None,
   687	            "slippage_estimate_bps": None,
   688	            "samples": 0,
   689	            "stop_hit": False,
   690	            "source": "INSUFFICIENT_EVIDENCE_AWAITING_FUTURE_TIMELINE",
   691	        }
   692	    # End price = first sample at or after window endpoint.
   693	    window_end = anchor_ts + window_seconds
   694	    end_price = next(
   695	        (price for ts, price in sl if ts >= window_end),
   696	        sl[-1][1],
   697	    )
   698	    sign = 1.0 if (side or "").lower() == "long" else -1.0 if (side or "").lower() == "short" else 0.0
   699	    raw_return_bps = ((end_price - entry_price) / entry_price) * 10_000.0
   700	    signed_return_bps = sign * raw_return_bps if sign != 0 else raw_return_bps
   701	    cost_drag = fee_bps + slippage_bps
   702	    after_cost = signed_return_bps - cost_drag
   703	    # Max favorable / max adverse across the slice, signed.
   704	    if sign == 0:
   705	        signed_path = [((p - entry_price) / entry_price) * 10_000.0 for _, p in sl]
   706	    else:
   707	        signed_path = [
   708	            sign * ((p - entry_price) / entry_price) * 10_000.0 for _, p in sl
   709	        ]
   710	    max_favorable_bps = max(signed_path) if signed_path else None
   711	    max_adverse_bps = min(signed_path) if signed_path else None
   712	    drawdown_bps = -max_adverse_bps if max_adverse_bps is not None else None
   713	    return {
   714	        "window_id": window_id,
   715	        "window_seconds": window_seconds,
   716	        "return_bps": raw_return_bps,
   717	        "after_cost_return_bps": after_cost,
   718	        "drawdown_bps": drawdown_bps,
   719	        "max_favorable_bps": max_favorable_bps,
   720	        "max_adverse_bps": max_adverse_bps,
   721	        "fee_drag_bps": fee_bps,
   722	        "slippage_estimate_bps": slippage_bps,
   723	        "samples": len(sl),
   724	        "stop_hit": False,
   725	        "source": "V2_MINER_PRICE_TIMELINE",
   726	    }
