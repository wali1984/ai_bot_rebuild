   238	def _read_market_price(symbol: str) -> tuple[float, float] | None:
   239	    """Return (utc_seconds, last_price_float) or None if unavailable."""
   240	    doc = _safe_redis_read(f"v2:market:prices:{symbol.upper()}")
   241	    if not isinstance(doc, dict):
   242	        return None
   243	    fetched_utc = doc.get("fetched_utc")
   244	    ticker = doc.get("ticker_24hr") or {}
   245	    price_str = ticker.get("lastPrice") or ticker.get("bidPrice")
   246	    ts = _parse_iso(fetched_utc)
   247	    price = _coerce_float(price_str)
   248	    if ts is None or price is None or price <= 0:
   249	        return None
   250	    return ts, price
