   100	def _bootstrap_mean_ci(
   101	    values: Sequence[float], iters: int = 2000, alpha: float = 0.05
   102	) -> tuple[float, float, float]:
   103	    """Return (mean, lower_ci, upper_ci) via percentile bootstrap.
   104	
   105	    Pure / deterministic-ish: uses ``statistics.fmean`` on bootstrap
   106	    resamples drawn from ``values`` with replacement. Falls back to
   107	    point estimates when ``values`` is too small.
   108	    """
   109	    if not values:
   110	        return (0.0, 0.0, 0.0)
   111	    if len(values) < 5:
   112	        m = statistics.fmean(values)
   113	        return (m, m, m)
   114	    # Deterministic seeded resampling to keep CI reproducible for tests.
   115	    import random
   116	    rng = random.Random(0xED6E_5EED)  # spelled out: "edge seed"
   117	    n = len(values)
   118	    means: list[float] = []
   119	    for _ in range(iters):
   120	        sample = [values[rng.randint(0, n - 1)] for _ in range(n)]
   121	        means.append(statistics.fmean(sample))
   122	    means.sort()
   123	    lo_idx = int(iters * (alpha / 2))
   124	    hi_idx = int(iters * (1 - alpha / 2))
   125	    return (
   126	        statistics.fmean(values),
   127	        means[max(0, min(lo_idx, iters - 1))],
   128	        means[max(0, min(hi_idx, iters - 1))],
   129	    )
