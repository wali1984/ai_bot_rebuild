   188	    assert passthrough_note is not None
   189	    body = json.loads(passthrough_note.split("block_reasons_passthrough:", 1)[1])
   190	    assert body["prediction"] == reasons
   191	    assert body["orchestrator_held"] == reasons
   192	    assert body["paper_intent_held"] == reasons
