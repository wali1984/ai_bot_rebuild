   310	
   311	def _find_window_slice(
   312	    timeline: list[tuple[float, float]],
   313	    anchor_ts: float,
   314	    window_seconds: int,
   315	) -> list[tuple[float, float]] | None:
   316	    """Return the timeline slice in [anchor_ts, anchor_ts + window_seconds]
   317	    if the slice contains at least one point on or after the window
   318	    endpoint, else None (window not yet sourceable).
   319	    """
   320	    if not timeline:
   321	        return None
   322	    window_end = anchor_ts + window_seconds
   323	    slice_: list[tuple[float, float]] = []
   324	    has_endpoint = False
   325	    for ts, price in timeline:
   326	        if ts < anchor_ts:
   327	            continue
   328	        if ts > window_end + 1:  # +1s tolerance
   329	            break
   330	        slice_.append((ts, price))
   331	        if ts >= window_end:
   332	            has_endpoint = True
   333	    if not slice_ or not has_endpoint:
   334	        return None
   335	    return slice_
