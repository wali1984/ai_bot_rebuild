   260	def test_default_paper_cost_model_contains_operator_decision_required_literal() -> None:

--- passthrough test ---
     1	"""Tests for the strict P0.2F paper-fill gate block-reason passthrough:
     2	prediction -> orchestrator decision -> paper intent -> comparator.
     3	
     4	Loop spec: ensure SOLUSDT (and any gate-blocked symbol) surfaces its exact
     5	block reasons through every layer without changing gate behavior, without
     6	loosening thresholds, and without producing fills.
     7	"""
     8	from __future__ import annotations
     9	
    10	import importlib
    11	import json
    12	from typing import Any
    13	
    14	
    15	class FakeRedis:
    16	    """Minimal in-memory stand-in for the small subset of redis-py we use:
    17	    get/set/scan_iter. Keys are strings; values are strings.
    18	    """
    19	
    20	    def __init__(self) -> None:
    21	        self.store: dict[str, str] = {}
    22	
    23	    def ping(self) -> bool:
    24	        return True
    25	
    26	    def get(self, key: str) -> str | None:
    27	        return self.store.get(key)
    28	
    29	    def set(self, key: str, value: str, ex: int | None = None) -> bool:
    30	        # ex (ttl) is ignored in the in-memory fake.
    31	        self.store[key] = value
    32	        return True
    33	
    34	    def scan_iter(self, match: str | None = None):
    35	        if match is None:
    36	            yield from list(self.store.keys())
    37	            return
    38	        # Trivial glob support for "v2:prediction:*"
    39	        prefix = match.rstrip("*")
    40	        for k in list(self.store.keys()):
    41	            if match.endswith("*"):
    42	                if k.startswith(prefix):
    43	                    yield k
    44	            elif k == match:
    45	                yield k
    46	
    47	    def type(self, key: str) -> str:
    48	        return "string" if key in self.store else "none"
    49	
    50	
    51	def _patch_connect(monkeypatch, module_path: str, fake: FakeRedis) -> None:
    52	    mod = importlib.import_module(module_path)
    53	    monkeypatch.setattr(mod, "_connect_redis", lambda: fake)
    54	
    55	
    56	def _make_blocked_prediction(symbol: str, block_reasons: list[str]) -> dict[str, Any]:
    57	    return {
    58	        "prediction_id": f"pred_{symbol}",
    59	        "feature_snapshot_id": f"fs_{symbol}",
    60	        "symbol": symbol,
    61	        "timeframe": "1m",
    62	        "trainer_source": "v2_native_policy_cpu_forward_v1",
    63	        "checkpoint_id": "CHECKPOINT_WEIGHT_BLOB_OPERATOR_REQUIRED",
    64	        "checkpoint_blocker": "CHECKPOINT_WEIGHT_BLOB_OPERATOR_REQUIRED",
    65	        "expected_move_bps": -3.0,
    66	        "expected_move_after_cost_bps": -5.0,
    67	        "confidence_raw": 0.4,
    68	        "confidence_calibrated": 0.4,
    69	        "feature_freshness_state": "fresh",
    70	        "selected_action": "hold",
    71	        "policy_action_probabilities": [0.5, 0.1, 0.1, 0.2, 0.1],
    72	        "hedge_action_classification": "no_hedge",
    73	        "paper_fill_gate_status": "BLOCKED_BY_TRAINER_OUTPUT_MALFORMED",
    74	        "paper_fill_allowed": False,
    75	        "paper_fill_gate_block_reasons": list(block_reasons),
    76	        "generated_utc": "2026-05-17T05:00:00Z",
    77	        "live_gate": "blocked_human_only",
    78	        "live_symbols": [],
    79	    }
    80	
    81	
    82	def test_orchestrator_emits_held_by_paper_fill_gate_with_reasons(monkeypatch) -> None:
    83	    fake = FakeRedis()
    84	    reasons = ["BLOCK_NEGATIVE_EXPECTED_MOVE_AFTER_COST"]
    85	    fake.store["v2:prediction:SOLUSDT:1m"] = json.dumps(
    86	        _make_blocked_prediction("SOLUSDT", reasons)
    87	    )
    88	    orch = importlib.import_module("v2.backend.app.cli.v2_orchestrator_arbitration_loop")
    89	    _patch_connect(monkeypatch, "v2.backend.app.cli.v2_orchestrator_arbitration_loop", fake)
    90	    status = orch.run_once()
    91	    # Held passthrough is reflected in heartbeat status.
    92	    assert status["predictions_held_by_paper_fill_gate"] == 1
    93	    held = status["held_by_paper_fill_gate"]
    94	    assert len(held) == 1
    95	    assert held[0]["symbol"] == "SOLUSDT"
    96	    assert held[0]["decision"] == "HELD_BY_PAPER_FILL_GATE"
    97	    assert held[0]["paper_fill_gate_block_reasons"] == reasons
    98	    assert held[0]["places_real_order"] is False
    99	    # The Redis-emitted decisions payload mirrors the same reasons.
   100	    decisions = json.loads(fake.store["v2:orchestrator:decisions"])
   101	    assert decisions["held_by_paper_fill_gate_count"] == 1
   102	    assert decisions["held_by_paper_fill_gate"][0]["paper_fill_gate_block_reasons"] == reasons
   103	    assert status["live_gate"] == "blocked_human_only"
   104	    assert status["live_symbols"] == []
   105	    assert status["writes_legacy_redis"] is False
