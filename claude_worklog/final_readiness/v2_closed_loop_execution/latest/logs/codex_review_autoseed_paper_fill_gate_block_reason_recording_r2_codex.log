   394	
   395	def _harvest_paper_evidence() -> list[dict[str, Any]]:
   396	    """Extract paper evidence rows from v2:paper:ledger and v2:paper:intents.
   397	
   398	    Each row becomes one candidate replay bundle (deduplicated downstream
   399	    by intent_id). Only data that is already inside V2 keys is read;
   400	    legacy current truth is never consulted.
   401	    """
   402	    rows: list[dict[str, Any]] = []
   403	    ledger = _safe_redis_read("v2:paper:ledger") or {}
   404	    intents = _safe_redis_read("v2:paper:intents") or []
   405	    held = _safe_redis_read("v2:paper:intents_held_by_paper_fill_gate") or []
   406	    risk = _safe_redis_read("v2:risk:decisions") or []
   407	    orch = _safe_redis_read("v2:orchestrator:decisions") or {}
   408	
   409	    risk_by_symbol = {
   410	        (r.get("symbol") or "").upper(): r
   411	        for r in (risk if isinstance(risk, list) else [])
   412	        if isinstance(r, dict)
   413	    }
   414	
   415	    def _decorate(row: Mapping[str, Any], decision: str) -> dict[str, Any]:
   416	        return {
   417	            "intent_id": row.get("intent_id"),
   418	            "symbol": (row.get("symbol") or "").upper(),
   419	            "side": row.get("side"),
   420	            "ts": _parse_iso(row.get("generated_utc")),
   421	            "generated_utc": row.get("generated_utc"),
   422	            "entry_price": _coerce_float(row.get("entry_price")),
   423	            "expected_move_after_cost_bps": _coerce_float(
   424	                row.get("expected_move_after_cost_bps")
   425	            ),
   426	            "confidence_calibrated": _coerce_float(row.get("confidence_calibrated")),
   427	            "pre_trade_allowed": row.get("pre_trade_allowed"),
   428	            "fee_gate_allowed": row.get("fee_gate_allowed"),
   429	            "churn_blocked": row.get("churn_blocked"),
   430	            "paper_fill_allowed": row.get("paper_fill_allowed"),
   431	            "decision": decision,
   432	            "risk_decision": risk_by_symbol.get((row.get("symbol") or "").upper()),
   433	            "orchestrator_decision": orch if isinstance(orch, dict) else None,
   434	            "raw_row": dict(row),
   435	        }
   436	
   437	    for r in (ledger.get("accepted") or []):
   438	        if isinstance(r, dict):
   439	            rows.append(_decorate(r, "ACCEPTED_PAPER_FILL"))
   440	    for r in (ledger.get("shadow_observations") or []):
   441	        if isinstance(r, dict):
   442	            rows.append(_decorate(r, "SHADOW_OBSERVATION_ONLY"))
   443	    for r in (ledger.get("held_by_paper_fill_gate") or []):
   444	        if isinstance(r, dict):
   445	            rows.append(_decorate(r, "HELD_BY_PAPER_FILL_GATE"))
   446	    for r in (intents if isinstance(intents, list) else []):
   447	        if isinstance(r, dict):
   448	            decision = "ACCEPTED_PAPER_FILL" if r.get("paper_fill_allowed") else "PAPER_INTENT_OBSERVED"
   449	            rows.append(_decorate(r, decision))
   450	    for r in (held if isinstance(held, list) else []):
   451	        if isinstance(r, dict):
   452	            rows.append(_decorate(r, "HELD_BY_PAPER_FILL_GATE"))
   453	    return rows
   454	
   455	
   456	def _resolve_paper_fill_gate_block_reasons(
   457	    row: Mapping[str, Any],
   458	) -> tuple[list[str], dict[str, Any]]:
   459	    raw = row.get("raw_row") if isinstance(row.get("raw_row"), Mapping) else {}
   460	    paper_gate = row.get("paper_gate_decision") if isinstance(
   461	        row.get("paper_gate_decision"), Mapping
   462	    ) else {}
   463	    trainer_output = row.get("trainer_output") if isinstance(
   464	        row.get("trainer_output"), Mapping
   465	    ) else {}
   466	
   467	    reasons: list[str] = []
   468	    evidence_sources: list[dict[str, Any]] = []
   469	
   470	    def _add_reasons(field: str, values: Any) -> None:
   471	        extracted = _list_from_any(values)
   472	        if not extracted:
   473	            return
   474	        reasons.extend(extracted)
   475	        evidence_sources.append({
   476	            "field": field,
   477	            "state": PAPER_FILL_GATE_REASON_STATE_RECORDED,
   478	            "count": len(extracted),
   479	        })
   480	
   481	    _add_reasons(
   482	        "paper_fill_gate_block_reasons",
   483	        row.get("paper_fill_gate_block_reasons") or raw.get("paper_fill_gate_block_reasons"),
   484	    )
   485	    _add_reasons(
   486	        "paper_gate_decision.paper_fill_gate_block_reasons",
   487	        paper_gate.get("paper_fill_gate_block_reasons"),
   488	    )
   489	    _add_reasons(
   490	        "trainer_output.paper_fill_gate_block_reasons",
   491	        trainer_output.get("paper_fill_gate_block_reasons"),
   492	    )
   493	
   494	    explicit_bool_reasons: list[tuple[str, str, bool]] = [
   495	        ("pre_trade_allowed", "PRE_TRADE_GATE_BLOCKED", row.get("pre_trade_allowed") is False),
   496	        ("fee_gate_allowed", "FEE_GATE_BLOCKED", row.get("fee_gate_allowed") is False),
   497	        ("churn_blocked", "CHURN_BLOCKED", row.get("churn_blocked") is True),
   498	    ]
   499	    for field, reason, triggered in explicit_bool_reasons:
   500	        if not triggered:
   501	            continue
   502	        reasons.append(reason)
   503	        evidence_sources.append({
   504	            "field": field,
   505	            "state": PAPER_FILL_GATE_REASON_STATE_RECORDED,
   506	            "reason": reason,
   507	        })
   508	
   509	    unique_reasons = _dedupe_strings(reasons)
   510	    paper_fill_allowed = row.get("paper_fill_allowed")
   511	    if paper_fill_allowed is None:
   512	        paper_fill_allowed = paper_gate.get("paper_fill_allowed")
   513	    paper_intent = row.get("paper_intent") if isinstance(row.get("paper_intent"), Mapping) else {}
   514	    decision = str(row.get("decision") or paper_intent.get("decision") or "").upper()
   515	    expected = paper_fill_allowed is False or decision in {
   516	        "HELD_BY_PAPER_FILL_GATE",
   517	        "BLOCKED",
   518	    }
   519	    if unique_reasons:
   520	        state = PAPER_FILL_GATE_REASON_STATE_RECORDED
   521	        missing_reason = None
   522	    elif expected:
   523	        state = PAPER_FILL_GATE_MISSING_SOURCE
   524	        missing_reason = "paper_fill_gate_block_reason_missing_from_v2_sources"
   525	    else:
   526	        state = PAPER_FILL_GATE_REASON_STATE_NOT_APPLICABLE
   527	        missing_reason = None
   528	    return unique_reasons, {
   529	        "state": state,
   530	        "missing_reason": missing_reason,
   531	        "evidence_sources_considered": list(PAPER_FILL_GATE_EVIDENCE_SOURCES),
   532	        "evidence_sources": evidence_sources,
   533	    }
   534	
   535	
   536	def _new_bundle_from_row(row: Mapping[str, Any]) -> dict[str, Any]:
   537	    sym = row.get("symbol") or ""
   538	    side = (row.get("side") or "").lower()
   539	    block_reasons, block_reason_lineage = _resolve_paper_fill_gate_block_reasons(row)
   540	    altdata_snapshot = build_altdata_snapshot(str(sym))
   541	    return {
   542	        "schema_version": REPLAY_BUNDLE_SCHEMA_VERSION,
   543	        "feature_snapshot_id": (
   544	            f"{sym}:1m:{row.get('generated_utc')}"
   545	        ),
   546	        "prediction_id": row.get("intent_id") or f"{sym}:{row.get('generated_utc')}",
   547	        "symbol": sym,
