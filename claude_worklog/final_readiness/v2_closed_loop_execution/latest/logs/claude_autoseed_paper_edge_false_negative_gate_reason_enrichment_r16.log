**Patch 1 of 3 — `v2/backend/app/services/war_room/parallel_recovery_24h.py`**

Replace the `ROOT_CAUSE_CODES` block and `_classify_false_negative` function (lines ~303–388) with:

```python
ROOT_CAUSE_CODES = {
    "model_hold_due_checkpoint",
    "feature_missing",
    "risk_gate_block",
    "paper_fill_gate_block",
    "paper_fill_gate_block_unrecorded_reason",
    "stale_feature",
    "insufficient_liquidation_data",
    "no_policy_architecture",
    "observation_gap",
    "altdata_missing",
    "MISSING_SOURCE",
}


_PAPER_GATE_REASON_SOURCES: tuple[str, ...] = (
    "paper_gate_decision",
    "trainer_output",
    "paper_intent",
    "orchestrator_held_by_paper_fill_gate",
)


def _resolve_paper_gate_block_reasons(bundle: dict[str, Any]) -> dict[str, Any]:
    sources_checked: list[str] = []
    source = "MISSING_SOURCE"
    reasons: list[str] = []

    paper_gate = bundle.get("paper_gate_decision") or {}
    trainer_output = bundle.get("trainer_output") or {}
    paper_intent = bundle.get("paper_intent") or {}
    orchestrator = bundle.get("orchestrator_decision") or {}
    prediction_id = (
        (orchestrator.get("bucket_winners") or [{}])[0].get("winner_proposal_id")
        if orchestrator else None
    ) or paper_intent.get("intent_id")
    symbol = (bundle.get("symbol") or "").upper()

    candidates: list[tuple[str, list[str]]] = []
    for src in _PAPER_GATE_REASON_SOURCES:
        sources_checked.append(src)
        if src == "paper_gate_decision":
            values = paper_gate.get("paper_fill_gate_block_reasons") or []
        elif src == "trainer_output":
            values = trainer_output.get("paper_fill_gate_block_reasons") or []
        elif src == "paper_intent":
            values = paper_intent.get("paper_fill_gate_block_reasons") or []
        elif src == "orchestrator_held_by_paper_fill_gate":
            held = orchestrator.get("held_by_paper_fill_gate") or []
            values = []
            for entry in held if isinstance(held, list) else []:
                if not isinstance(entry, dict):
                    continue
                entry_pred = (
                    entry.get("prediction_id")
                    or entry.get("winner_proposal_id")
                    or entry.get("intent_id")
                )
                entry_symbol = (entry.get("symbol") or "").upper()
                if prediction_id and entry_pred and entry_pred != prediction_id:
                    continue
                if not prediction_id and symbol and entry_symbol and entry_symbol != symbol:
                    continue
                values.extend(entry.get("paper_fill_gate_block_reasons") or [])
        else:
            values = []
        if values:
            candidates.append((src, list(values)))

    if candidates:
        source = candidates[0][0]
        seen_r: set[str] = set()
        for _src, vals in candidates:
            for r in vals:
                if r in seen_r:
                    continue
                seen_r.add(r)
                reasons.append(r)

    return {"reasons": reasons, "source": source, "sources_checked": sources_checked}


def _classify_false_negative(bundle: dict[str, Any]) -> dict[str, Any]:
    causes: list[str] = []
    notes: list[str] = []

    trainer_output = bundle.get("trainer_output") or {}
    risk_decision = bundle.get("risk_decision") or {}
    paper_gate = bundle.get("paper_gate_decision") or {}
    altdata = bundle.get("altdata_snapshot")
    paper_intent = bundle.get("paper_intent") or {}

    if trainer_output.get("selected_action") in (None, "hold"):
        causes.append("model_hold_due_checkpoint")
        notes.append("trainer selected_action was hold or absent")

    if not risk_decision.get("pre_trade_allowed", True):
        causes.append("risk_gate_block")
        notes.append(
            f"risk gate blocked: churn={risk_decision.get('churn_reason')} "
            f"fee={risk_decision.get('fee_gate_reason')}"
        )

    paper_allowed = paper_gate.get("paper_fill_allowed")
    resolved = _resolve_paper_gate_block_reasons(bundle)
    resolved_reasons = resolved["reasons"]
    resolved_source = resolved["source"]

    if paper_allowed is False:
        causes.append("paper_fill_gate_block")
        if resolved_reasons:
            notes.append(
                f"paper gate reasons resolved from source={resolved_source}: "
                f"{resolved_reasons}"
            )
        else:
            causes.append("paper_fill_gate_block_unrecorded_reason")
            causes.append("MISSING_SOURCE")
            causes.append("observation_gap")
            notes.append(
                "paper_fill_allowed=false with empty "
                "paper_fill_gate_block_reasons in every checked source "
                f"({resolved['sources_checked']}) — marked MISSING_SOURCE "
                "rather than guessing"
            )

    if altdata is None:
        causes.append("altdata_missing")
        notes.append("altdata_snapshot is null")

    if paper_intent.get("decision") == "SHADOW_OBSERVATION_ONLY":
        notes.append(
            "paper intent recorded as SHADOW_OBSERVATION_ONLY — fill path "
            "was not exercised even though risk/edge cleared"
        )

    seen: set[str] = set()
    deduped = [c for c in causes if not (c in seen or seen.add(c))]
    return {
        "symbol": bundle.get("symbol"),
        "anchor_ts": bundle.get("anchor_ts"),
        "feature_snapshot_id": bundle.get("feature_snapshot_id"),
        "prediction_id": (
            (bundle.get("orchestrator_decision") or {})
            .get("bucket_winners", [{}])[0]
            .get("winner_proposal_id")
            if bundle.get("orchestrator_decision") else None
        ),
        "expected_move_after_cost_bps": trainer_output.get(
            "expected_move_after_cost_bps"
        ),
        "outcome_after_cost": bundle.get("outcome_after_cost"),
        "paper_gate_decision": paper_gate,
        "paper_fill_gate_block_reasons_resolved": resolved_reasons,
        "paper_fill_gate_block_reasons_source": resolved_source,
        "paper_fill_gate_block_reasons_sources_checked": resolved["sources_checked"],
        "risk_decision": risk_decision,
        "altdata_snapshot_present": altdata is not None,
        "trainer_selected_action": trainer_output.get("selected_action"),
        "root_causes": deduped,
        "notes": notes,
    }
