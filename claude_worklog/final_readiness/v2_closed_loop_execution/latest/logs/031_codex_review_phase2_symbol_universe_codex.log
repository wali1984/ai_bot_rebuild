   178	def resolve_symbol_alias(source_symbol: str, source: str, identities: Iterable[SymbolIdentity]) -> Optional[SymbolIdentity]:
   179	    wanted = source_symbol.upper()
   180	    source_key = source.lower()
   181	    for identity in identities:
   182	        aliases = {a.upper() for a in identity.alias_set}
   183	        if identity.source == source_key and wanted in aliases:
   184	            return identity
   185	    for identity in identities:
   186	        if wanted in {a.upper() for a in identity.alias_set}:
   187	            return identity
   188	    return None
