   150	def _normalize_generic(source: str, payload: Dict[str, Any], exchange: str, family: str) -> SymbolIdentity:
   151	    source_symbol = str(payload.get("symbol") or payload.get("source_symbol") or payload.get("id") or "")
   152	    pair = str(payload.get("pair") or payload.get("source_pair") or source_symbol)
   153	    base = normalize_asset(payload.get("baseAsset") or payload.get("base") or pair.split("-")[0].split("/")[0])
   154	    default_quote = "USDT" if "USDT" in pair.upper() else "USD"
   155	    quote = normalize_asset(payload.get("quoteAsset") or payload.get("quote") or default_quote)
   156	    settlement = normalize_asset(payload.get("settlementAsset") or payload.get("settlement") or quote)
   157	    contract_type = normalize_contract_type(payload.get("contractType") or payload.get("contract_type"), source_symbol)
   158	    identity = SymbolIdentity(
   159	        canonical_symbol_id=canonical_id(base, quote, contract_type, family, exchange, payload.get("deliveryDate")),
   160	        base_asset=base,
   161	        quote_asset=quote,
   162	        settlement_asset=settlement,
   163	        market_type=MarketType.FUTURES.value,
   164	        contract_family=family,
   165	        contract_type=contract_type,
   166	        exchange=exchange,
   167	        source=source,
   168	        source_symbol=source_symbol,
   169	        source_pair=pair,
   170	        legacy_symbol=payload.get("legacy_symbol"),
   171	        normalization_confidence=payload.get("normalization_confidence", NormalizationConfidence.MEDIUM.value),
   172	        status=payload.get("status"),
   173	        metadata={k: v for k, v in payload.items() if k not in {"symbol", "pair", "base", "quote"}},
   174	    )
   175	    return SymbolIdentity(**{**identity.__dict__, "alias_set": build_alias_set(identity)})
   176	
   177	
   178	def resolve_symbol_alias(source_symbol: str, source: str, identities: Iterable[SymbolIdentity]) -> Optional[SymbolIdentity]:
   179	    wanted = source_symbol.upper()
   180	    source_key = source.lower()
   181	    for identity in identities:
   182	        aliases = {a.upper() for a in identity.alias_set}
   183	        if identity.source == source_key and wanted in aliases:
   184	            return identity
   185	    for identity in identities:
   186	        if wanted in {a.upper() for a in identity.alias_set}:
   187	            return identity
   188	    return None
   189	
   190	
   191	def match_cross_source_symbol(identity_a: SymbolIdentity, identity_b: SymbolIdentity) -> str:
   192	    if identity_a.canonical_symbol_id == identity_b.canonical_symbol_id:
   193	        return NormalizationConfidence.HIGH.value
   194	    same_base_quote = identity_a.base_asset == identity_b.base_asset and identity_a.quote_asset == identity_b.quote_asset
   195	    if same_base_quote and (
   196	        identity_a.contract_type != identity_b.contract_type
   197	        or identity_a.contract_family != identity_b.contract_family
   198	        or identity_a.settlement_asset != identity_b.settlement_asset
   199	    ):
   200	        return "none"
   201	    same_contract = (
   202	        same_base_quote
   203	        and identity_a.settlement_asset == identity_b.settlement_asset
   204	        and identity_a.contract_type == identity_b.contract_type
   205	        and identity_a.contract_family == identity_b.contract_family
   206	    )
   207	    if same_contract:
   208	        return NormalizationConfidence.HIGH.value
   209	    same_market = (
   210	        identity_a.base_asset == identity_b.base_asset
   211	        and identity_a.quote_asset == identity_b.quote_asset
   212	        and identity_a.contract_type == identity_b.contract_type
   213	    )
   214	    if same_market:
   215	        return NormalizationConfidence.MEDIUM.value
   216	    if identity_a.contract_type == identity_b.contract_type and identity_a.contract_family == identity_b.contract_family and set(identity_a.alias_set) & set(identity_b.alias_set):
   217	        return NormalizationConfidence.LOW.value
   218	    return "none"
