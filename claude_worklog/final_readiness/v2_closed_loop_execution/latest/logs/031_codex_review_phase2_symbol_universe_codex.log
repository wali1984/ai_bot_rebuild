   150	def _normalize_generic(source: str, payload: Dict[str, Any], exchange: str, family: str) -> SymbolIdentity:
   151	    source_symbol = str(payload.get("symbol") or payload.get("source_symbol") or payload.get("id") or "")
   152	    pair = str(payload.get("pair") or payload.get("source_pair") or source_symbol)
   153	    base = normalize_asset(payload.get("baseAsset") or payload.get("base") or pair.split("-")[0].split("/")[0])
   154	    default_quote = "USDT" if "USDT" in pair.upper() else "USD"
   155	    quote = normalize_asset(payload.get("quoteAsset") or payload.get("quote") or default_quote)
   156	    settlement = normalize_asset(payload.get("settlementAsset") or payload.get("settlement") or quote)
   157	    contract_type = normalize_contract_type(payload.get("contractType") or payload.get("contract_type"), source_symbol)
   158	    identity = SymbolIdentity(
   159	        canonical_symbol_id=canonical_id(base, quote, contract_type, family, exchange, payload.get("deliveryDate")),
   160	        base_asset=base,
   161	        quote_asset=quote,
   162	        settlement_asset=settlement,
   163	        market_type=MarketType.FUTURES.value,
   164	        contract_family=family,
   165	        contract_type=contract_type,
   166	        exchange=exchange,
   167	        source=source,
   168	        source_symbol=source_symbol,
   169	        source_pair=pair,
   170	        legacy_symbol=payload.get("legacy_symbol"),
   171	        normalization_confidence=payload.get("normalization_confidence", NormalizationConfidence.MEDIUM.value),
   172	        status=payload.get("status"),
   173	        metadata={k: v for k, v in payload.items() if k not in {"symbol", "pair", "base", "quote"}},
   174	    )
   175	    return SymbolIdentity(**{**identity.__dict__, "alias_set": build_alias_set(identity)})
   176	
