   199	
   200	def confirm_coinank_against_usdm(
   201	    coinank_identity: SymbolIdentity,
   202	    usdm_identities: Iterable[SymbolIdentity],
   203	) -> Optional[SymbolIdentity]:
   204	    if coinank_identity.source != "coinank":
   205	        return None
   206	    metadata = coinank_identity.metadata or {}
   207	    if not metadata.get("candidate_for_usdm_confirmation"):
   208	        return None
