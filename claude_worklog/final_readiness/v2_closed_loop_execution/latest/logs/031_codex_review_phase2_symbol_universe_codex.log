    16	STOCK_LIKE_BASES: frozenset[str] = frozenset({
    17	    "AAPL", "TSLA", "GOOGL", "GOOG", "AMZN", "NVDA", "META", "MSFT",
    18	    "NFLX", "AMD", "INTC", "IBM", "ORCL", "QQQ", "SPY",
    19	    "GOLD", "SILVER", "OIL", "WTI", "BRENT", "COPPER", "NATGAS",
    20	    "SP500", "DOW", "NASDAQ",
    21	})
    22	
    23	BINANCE_USDM_EXCHANGE_SLUGS: frozenset[str] = frozenset({
    24	    "BINANCE", "BINANCE_USDM", "BINANCE_FUTURES", "BINANCE_PERP",
    25	})
    26	
    27	DATED_SUFFIX_RE = re.compile(r"_(\d{6})$")
    28	PERP_SUFFIX_RE = re.compile(r"_PERP$")
    29	
    30	
    31	@dataclass(frozen=True)
    32	class CoinAnkRawRow:
    33	    symbol: str
    34	    baseCoin: str
    35	    exchangeName: str
    36	    expireAt: Optional[int]
    37	    updateAt: Optional[int]
    38	    productType: Optional[str] = None
    39	    quoteCoin: Optional[str] = None
    40	    tradingPair: Optional[str] = None
    41	    marketType: Optional[str] = None
    42	    is_synthetic: bool = False
    43	
    44	
    45	def _is_chinese(value: str) -> bool:
    46	    return any(ord(c) > 0x7F for c in (value or ""))
    47	
    48	
    49	def _normalize_ascii_letters(value: str) -> str:
    50	    return "".join(c for c in (value or "").upper() if c.isascii() and c.isalnum())
    51	
    52	
    53	def _stable_cjk_token(value: str) -> str:
    54	    return "CJK" + hashlib.sha1((value or "").encode("utf-8")).hexdigest()[:8].upper()
    55	
    56	
    57	def _classify_quote_kind(symbol: str, explicit_quote: Optional[str]) -> str:
    58	    upper = (symbol or "").upper()
    59	    if explicit_quote:
    60	        eu = explicit_quote.upper()
    61	        if eu in {"USDT", "USDC", "USD", "BTC", "ETH"}:
    62	            return eu
    63	    stem = upper
    64	    perp_match = PERP_SUFFIX_RE.search(stem)
    65	    if perp_match:
    66	        stem = stem[: perp_match.start()]
    67	    else:
    68	        dated_match = DATED_SUFFIX_RE.search(stem)
    69	        if dated_match:
    70	            stem = stem[: dated_match.start()]
    71	    if stem.endswith("USDT"):
    72	        return "USDT"
    73	    if stem.endswith("USDC"):
    74	        return "USDC"
    75	    if stem.endswith("USD"):
    76	        return "USD"
    77	    if stem.endswith("BTC"):
    78	        return "BTC"
    79	    if stem.endswith("ETH"):
    80	        return "ETH"
    81	    return "OTHER"
    82	
    83	
    84	def _exchange_slug(exchange_name: str) -> str:
    85	    cleaned = re.sub(r"[^A-Za-z0-9]+", "_", (exchange_name or "")).upper().strip("_")
    86	    return cleaned or "UNKNOWN"
    87	
    88	
    89	def classify_coinank_row(row: CoinAnkRawRow) -> Dict[str, Any]:
    90	    symbol = row.symbol or ""
    91	    base_coin = row.baseCoin or ""
    92	    is_chinese_name = _is_chinese(symbol) or _is_chinese(base_coin)
    93	    base_token = _normalize_ascii_letters(base_coin)
    94	    is_stock_like = base_token in STOCK_LIKE_BASES
    95	    is_dated = bool(row.expireAt and int(row.expireAt) > 0) or bool(DATED_SUFFIX_RE.search(symbol))
    96	    quote_kind = _classify_quote_kind(symbol, row.quoteCoin)
    97	    is_perp_inverse = bool(PERP_SUFFIX_RE.search(symbol)) and quote_kind == "USD"
    98	    is_usdc = quote_kind == "USDC"
    99	    is_usdt = quote_kind == "USDT"
   100	    candidate_for_usdm_confirmation = (
   101	        not is_chinese_name
   102	        and not is_stock_like
   103	        and not is_dated
   104	        and not is_perp_inverse
   105	        and quote_kind in {"USDT", "USDC"}
   106	    )
   107	    return {
   108	        "is_chinese_name": is_chinese_name,
   109	        "is_stock_like": is_stock_like,
   110	        "is_dated": is_dated,
   111	        "is_perp_inverse": is_perp_inverse,
   112	        "is_usdc": is_usdc,
   113	        "is_usdt": is_usdt,
   114	        "quote_kind": quote_kind,
   115	        "candidate_for_usdm_confirmation": candidate_for_usdm_confirmation,
   116	        "exchange_slug": _exchange_slug(row.exchangeName),
   117	        "requires_confirmation": True,
   118	    }
   119	
   120	
   121	def coinank_identity_from_row(row: CoinAnkRawRow) -> SymbolIdentity:
   122	    flags = classify_coinank_row(row)
   123	    base_token = _normalize_ascii_letters(row.baseCoin) or _stable_cjk_token(row.baseCoin)
   124	    quote = flags["quote_kind"] if flags["quote_kind"] != "OTHER" else "OTHER"
   125	    if flags["is_perp_inverse"]:
   126	        type_part = "INVERSE_PERP"
   127	        contract_type = ContractType.PERPETUAL.value
   128	    elif flags["is_dated"]:
   129	        if row.expireAt and int(row.expireAt) > 0:
   130	            type_part = f"DATED{int(row.expireAt)}"
   131	        else:
   132	            match = DATED_SUFFIX_RE.search(row.symbol)
   133	            type_part = f"DATED{match.group(1)}" if match else "DATED"
   134	        contract_type = ContractType.DATED_DELIVERY.value
   135	    elif PERP_SUFFIX_RE.search(row.symbol):
   136	        type_part = "PERP"
   137	        contract_type = ContractType.PERPETUAL.value
   138	    elif quote in {"USDT", "USDC"}:
   139	        type_part = "PERP"
   140	        contract_type = ContractType.PERPETUAL.value
   141	    else:
   142	        type_part = "UNKNOWN"
   143	        contract_type = ContractType.UNKNOWN.value
   144	    canonical = "-".join(["COINANK-DISC", flags["exchange_slug"], base_token, quote, type_part])
   145	    metadata: Dict[str, Any] = {
   146	        "coinank_raw": {
   147	            "symbol": row.symbol,
   148	            "baseCoin": row.baseCoin,
   149	            "exchangeName": row.exchangeName,
   150	            "expireAt": row.expireAt,
   151	            "updateAt": row.updateAt,
   152	            "productType": row.productType,
   153	            "quoteCoin": row.quoteCoin,
   154	            "tradingPair": row.tradingPair,
   155	            "marketType": row.marketType,
   156	        },
   157	        "is_synthetic": row.is_synthetic,
   158	    }
   159	    metadata.update(flags)
   160	    market_type = (
   161	        MarketType.FUTURES.value
   162	        if flags["exchange_slug"] in BINANCE_USDM_EXCHANGE_SLUGS
   163	        else "unknown"
   164	    )
   165	    return SymbolIdentity(
   166	        canonical_symbol_id=canonical,
   167	        base_asset=base_token,
   168	        quote_asset=quote,
   169	        settlement_asset="UNKNOWN",
   170	        market_type=market_type,
   171	        contract_family=ContractFamily.UNKNOWN.value,
   172	        contract_type=contract_type,
   173	        exchange="coinank",
   174	        source="coinank",
   175	        source_symbol=row.symbol,
   176	        source_pair=row.tradingPair or row.symbol,
   177	        legacy_symbol=None,
   178	        normalization_confidence=NormalizationConfidence.LOW.value,
   179	        alias_set=[],
   180	        status="discovery_only",
   181	        metadata=metadata,
   182	    )
   183	
   184	
   185	def coinank_row_from_payload(payload: Dict[str, Any]) -> CoinAnkRawRow:
   186	    return CoinAnkRawRow(
   187	        symbol=str(payload.get("symbol", "")),
   188	        baseCoin=str(payload.get("baseCoin", "")),
   189	        exchangeName=str(payload.get("exchangeName", "")),
   190	        expireAt=payload.get("expireAt"),
   191	        updateAt=payload.get("updateAt"),
   192	        productType=payload.get("productType"),
   193	        quoteCoin=payload.get("quoteCoin"),
   194	        tradingPair=payload.get("tradingPair"),
   195	        marketType=payload.get("marketType"),
   196	        is_synthetic=bool(payload.get("is_synthetic", False)),
   197	    )
