    61	def normalize_source_symbol(source: str, raw_symbol_payload: Dict[str, Any]) -> SymbolIdentity:
    62	    source_key = source.lower()
    63	    if source_key == "binance_usdm":
    64	        return _normalize_binance_usdm(raw_symbol_payload)
    65	    if source_key == "binance_coinm":
    66	        return _normalize_binance_coinm(raw_symbol_payload)
    67	    if source_key == "coinank":
    68	        from .coinank_rows import coinank_identity_from_row, coinank_row_from_payload
    69	        identity = coinank_identity_from_row(coinank_row_from_payload(raw_symbol_payload))
    70	        return SymbolIdentity(**{**identity.__dict__, "alias_set": build_alias_set(identity)})
    71	    if source_key == "coinapi_ws":
    72	        return _normalize_generic(source_key, raw_symbol_payload, exchange="coinapi", family=ContractFamily.USD_M.value)
    73	    if source_key == "coinapi_rest":
    74	        return _normalize_generic(source_key, raw_symbol_payload, exchange="coinapi", family=ContractFamily.USD_M.value)
    75	    if source_key == "kucoin":
    76	        return _normalize_generic(source_key, raw_symbol_payload, exchange="kucoin", family=ContractFamily.USD_M.value)
    77	    raise ValueError(f"unsupported symbol source: {source}")
