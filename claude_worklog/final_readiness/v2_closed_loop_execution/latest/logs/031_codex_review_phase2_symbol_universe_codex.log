    53	def can_transition(current: str, target: str) -> bool:
    54	    return target in ALLOWED_TRANSITIONS.get(current, set())
    55	
    56	
    57	def transition(record: SymbolStateRecord, target: str, reason: str) -> SymbolStateRecord:
    58	    if not can_transition(record.state, target):
    59	        raise ValueError(f"invalid symbol transition: {record.state} -> {target}")
    60	    if target not in {SymbolState.DISABLED.value, SymbolState.REMOVED.value} and not record.identity.is_trading():
    61	        raise ValueError("non-trading symbols cannot become active without manual override")
    62	    return SymbolStateRecord(identity=record.identity, state=target, override=record.override, state_reason=reason)
    63	
    64	
    65	def apply_override(record: SymbolStateRecord, override: SymbolOverride) -> SymbolStateRecord:
    66	    action = override.action
    67	    if action == ManualOverride.FORCE_OBSERVE.value:
    68	        target = SymbolState.OBSERVED.value
    69	    elif action == ManualOverride.FORCE_TRAIN.value:
    70	        target = SymbolState.TRAINING_ACTIVE.value
    71	    elif action == ManualOverride.FORCE_DISABLE.value:
    72	        target = SymbolState.DISABLED.value
    73	    elif action == ManualOverride.FORCE_PAPER.value:
    74	        target = SymbolState.PAPER_TRADING.value
    75	    elif action == ManualOverride.FORCE_SHADOW_CANDIDATE.value:
    76	        target = SymbolState.SHADOW_CANDIDATE.value
    77	    elif action == ManualOverride.REMOVE.value:
    78	        target = SymbolState.REMOVED.value
    79	    elif action in {ManualOverride.SET_PRIORITY.value, ManualOverride.SET_MAX_RISK.value, ManualOverride.PAUSE_SYMBOL.value}:
    80	        target = SymbolState.MANUAL_OVERRIDE.value
    81	    else:
    82	        raise ValueError(f"unknown manual override: {action}")
    83	    return SymbolStateRecord(
    84	        identity=record.identity,
    85	        state=target,
    86	        override=override,
    87	        state_reason=f"manual_override:{action}",
    88	    )
