    94	        return apply_override(record, override)
    95	
    96	    def make_universe_version(
    97	        self,
    98	        previous: Iterable[SymbolIdentity],
    99	        current: Iterable[SymbolIdentity],
   100	        reason: str,
   101	        approval_state: str = "pending_review",
   102	    ) -> UniverseVersion:
   103	        prev_ids = {i.canonical_symbol_id for i in previous}
   104	        curr_ids = {i.canonical_symbol_id for i in current}
   105	        added = sorted(curr_ids - prev_ids)
   106	        removed = sorted(prev_ids - curr_ids)
   107	        changed = sorted(added + removed)
   108	        digest = hashlib.sha256(json.dumps(changed, sort_keys=True).encode("utf-8")).hexdigest()[:16]
   109	        return UniverseVersion(
   110	            universe_version_id=f"universe-{digest}",
   111	            generated_ts=dt.datetime.now(dt.timezone.utc).isoformat(),
   112	            source_snapshot_ids=[],
   113	            changed_symbols=changed,
   114	            added_symbols=added,
   115	            removed_symbols=removed,
   116	            disabled_symbols=[],
   117	            override_symbols=[],
   118	            reason=reason,
   119	            approval_state=approval_state,
   120	            hot_reload_required_components=HOT_RELOAD_COMPONENTS if changed else [],
   121	        )
