     9	def normalize_contract_type(raw: Optional[str], symbol: str = "") -> str:
    10	    value = (raw or "").upper()
    11	    if value == "PERPETUAL" or symbol.endswith("_PERP"):
    12	        return ContractType.PERPETUAL.value
    13	    if value == "CURRENT_QUARTER":
    14	        return ContractType.CURRENT_QUARTER.value
    15	    if value == "NEXT_QUARTER":
    16	        return ContractType.NEXT_QUARTER.value
    17	    if value or re.search(r"_\d{6}$", symbol):
    18	        return ContractType.DATED_DELIVERY.value
    19	    return ContractType.UNKNOWN.value
    20	
    21	
    22	def normalize_asset(value: Optional[str]) -> str:
    23	    return (value or "").upper().replace("-", "").replace("_", "")
    24	
    25	
    26	def canonical_id(
    27	    base_asset: str,
    28	    quote_asset: str,
    29	    contract_type: str,
    30	    contract_family: str,
    31	    exchange: str,
    32	    delivery_date: Optional[Any] = None,
    33	) -> str:
    34	    type_part = "PERP" if contract_type == ContractType.PERPETUAL.value else str(delivery_date or contract_type).upper()
    35	    return "-".join([
    36	        normalize_asset(base_asset),
    37	        normalize_asset(quote_asset),
    38	        type_part,
    39	        contract_family.replace("_", "").upper(),
    40	        exchange.upper(),
    41	    ])
