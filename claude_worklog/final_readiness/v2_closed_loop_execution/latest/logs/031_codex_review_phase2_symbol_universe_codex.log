   191	def match_cross_source_symbol(identity_a: SymbolIdentity, identity_b: SymbolIdentity) -> str:
   192	    if identity_a.canonical_symbol_id == identity_b.canonical_symbol_id:
   193	        return NormalizationConfidence.HIGH.value
   194	    same_base_quote = identity_a.base_asset == identity_b.base_asset and identity_a.quote_asset == identity_b.quote_asset
   195	    if same_base_quote and (
   196	        identity_a.contract_type != identity_b.contract_type
   197	        or identity_a.contract_family != identity_b.contract_family
   198	        or identity_a.settlement_asset != identity_b.settlement_asset
   199	    ):
   200	        return "none"
   201	    same_contract = (
   202	        same_base_quote
   203	        and identity_a.settlement_asset == identity_b.settlement_asset
   204	        and identity_a.contract_type == identity_b.contract_type
   205	        and identity_a.contract_family == identity_b.contract_family
   206	    )
   207	    if same_contract:
   208	        return NormalizationConfidence.HIGH.value
   209	    same_market = (
   210	        identity_a.base_asset == identity_b.base_asset
   211	        and identity_a.quote_asset == identity_b.quote_asset
   212	        and identity_a.contract_type == identity_b.contract_type
   213	    )
   214	    if same_market:
   215	        return NormalizationConfidence.MEDIUM.value
   216	    if identity_a.contract_type == identity_b.contract_type and identity_a.contract_family == identity_b.contract_family and set(identity_a.alias_set) & set(identity_b.alias_set):
   217	        return NormalizationConfidence.LOW.value
   218	    return "none"
