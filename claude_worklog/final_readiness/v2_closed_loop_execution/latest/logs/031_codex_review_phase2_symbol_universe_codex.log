    80	def _normalize_binance_usdm(payload: Dict[str, Any]) -> SymbolIdentity:
    81	    symbol = str(payload.get("symbol", ""))
    82	    pair = str(payload.get("pair", "")) or symbol
    83	    base = normalize_asset(payload.get("baseAsset") or re.sub(r"(USDT|USDC|USD)$", "", pair))
    84	    quote = normalize_asset(payload.get("quoteAsset") or ("USDC" if symbol.endswith("USDC") else "USDT"))
    85	    settlement = normalize_asset(payload.get("marginAsset") or quote)
    86	    contract_type = normalize_contract_type(payload.get("contractType"), symbol)
    87	    type_part = "PERP" if contract_type == ContractType.PERPETUAL.value else str(payload.get("deliveryDate") or contract_type).upper()
    88	    metadata = {
    89	        "deliveryDate": payload.get("deliveryDate"),
    90	        "onboardDate": payload.get("onboardDate"),
    91	        "filters": payload.get("filters", []),
    92	        "pricePrecision": payload.get("pricePrecision"),
    93	        "quantityPrecision": payload.get("quantityPrecision"),
    94	        "linear": True,
    95	    }
    96	    identity = SymbolIdentity(
    97	        canonical_symbol_id=f"BINANCE-USDM-{base}-{quote}-{type_part}",
    98	        base_asset=base,
    99	        quote_asset=quote,
   100	        settlement_asset=settlement,
   101	        market_type=MarketType.FUTURES.value,
   102	        contract_family=ContractFamily.USD_M.value,
   103	        contract_type=contract_type,
   104	        exchange="binance",
   105	        source="binance_usdm",
   106	        source_symbol=symbol,
   107	        source_pair=pair,
   108	        legacy_symbol=symbol if quote in {"USDT", "USDC"} else payload.get("legacy_symbol"),
   109	        normalization_confidence=NormalizationConfidence.HIGH.value,
   110	        status=str(payload.get("status") or payload.get("contractStatus") or ""),
   111	        metadata=metadata,
   112	    )
   113	    return SymbolIdentity(**{**identity.__dict__, "alias_set": build_alias_set(identity)})
   114	
   115	
   116	def _normalize_binance_coinm(payload: Dict[str, Any]) -> SymbolIdentity:
   117	    symbol = str(payload.get("symbol", ""))
   118	    pair = str(payload.get("pair", "")) or symbol.split("_", 1)[0]
   119	    base = normalize_asset(payload.get("baseAsset") or re.sub(r"(USD|USDT)$", "", pair))
   120	    quote = normalize_asset(payload.get("quoteAsset") or "USD")
   121	    settlement = normalize_asset(payload.get("marginAsset") or base)
   122	    contract_type = normalize_contract_type(payload.get("contractType"), symbol)
   123	    metadata = {
   124	        "deliveryDate": payload.get("deliveryDate"),
   125	        "onboardDate": payload.get("onboardDate"),
   126	        "filters": payload.get("filters", []),
   127	        "pricePrecision": payload.get("pricePrecision"),
   128	        "quantityPrecision": payload.get("quantityPrecision"),
   129	    }
   130	    identity = SymbolIdentity(
   131	        canonical_symbol_id=canonical_id(base, quote, contract_type, ContractFamily.COIN_M.value, "binance", payload.get("deliveryDate")),
   132	        base_asset=base,
   133	        quote_asset=quote,
   134	        settlement_asset=settlement,
   135	        market_type=MarketType.FUTURES.value,
   136	        contract_family=ContractFamily.COIN_M.value,
   137	        contract_type=contract_type,
   138	        exchange="binance",
   139	        source="binance_coinm",
   140	        source_symbol=symbol,
   141	        source_pair=pair,
   142	        legacy_symbol=payload.get("legacy_symbol"),
   143	        normalization_confidence=NormalizationConfidence.HIGH.value,
   144	        status=str(payload.get("contractStatus") or payload.get("status") or ""),
   145	        metadata=metadata,
   146	    )
   147	    return SymbolIdentity(**{**identity.__dict__, "alias_set": build_alias_set(identity)})
   148	
