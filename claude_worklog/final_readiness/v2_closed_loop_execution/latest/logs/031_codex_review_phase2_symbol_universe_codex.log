    44	def build_alias_set(identity: SymbolIdentity) -> list[str]:
    45	    aliases: Set[str] = {
    46	        identity.canonical_symbol_id,
    47	        identity.source_symbol,
    48	        identity.source_symbol.replace("_", ""),
    49	    }
    50	    if identity.source_pair:
    51	        aliases.add(identity.source_pair)
    52	    if identity.legacy_symbol:
    53	        aliases.add(identity.legacy_symbol)
    54	    aliases.add(f"{identity.base_asset}{identity.quote_asset}")
    55	    aliases.add(f"{identity.base_asset}-{identity.quote_asset}")
    56	    if identity.contract_type == ContractType.PERPETUAL.value:
    57	        aliases.add(f"{identity.base_asset}{identity.quote_asset}_PERP")
    58	    return sorted(a for a in aliases if a)
