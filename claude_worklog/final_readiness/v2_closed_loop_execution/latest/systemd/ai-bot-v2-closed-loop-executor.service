[Unit]
Description=AI BOT V2 Closed-Loop Claude/Codex Execution Engine (coordinator, one-shot)
Documentation=file:%h/Desktop/AI%%20BOT%%20REBUILD/claude_worklog/final_readiness/v2_closed_loop_execution/latest/GO_NO_GO.md
ConditionPathExists=%h/Desktop/AI BOT REBUILD/claude_worklog/tools/v2_closed_loop_claude_codex_executor.py
After=network.target

[Service]
Type=oneshot
WorkingDirectory=%h/Desktop/AI BOT REBUILD
Environment=PYTHONUNBUFFERED=1
Environment="PYTHONPATH=%h/Desktop/AI BOT REBUILD:%h/Desktop/AI BOT REBUILD/claude_worklog/tools"
Environment=V2_LIVE=blocked
Environment=V2_CANARY=0
Environment=V2_REDIS_TRIM=0
ExecStart="%h/Desktop/AI BOT REBUILD/.venv/bin/python3" "%h/Desktop/AI BOT REBUILD/claude_worklog/tools/v2_closed_loop_claude_codex_executor.py" --once --claude-lanes 3 --codex-lanes 3 --target-lanes 3
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false

[Install]
WantedBy=default.target
