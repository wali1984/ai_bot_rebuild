  "legacy_edge_cases": [
    "signal_expired_before_execution -> v2 fail-closed MISSING_CHAIN_RECORDS",
    "trainer_pause_no_signal -> v2 chain complete but signal_record.actionable=false (non_directional_side)",
    "stale_feature_snapshot -> v2 signal_record.actionable=false (non_actionable_market_freshness)",
    "risk_gateway_denied_missing_field -> v2 stage explanation collapses to EVIDENCE_MISSING_LABEL",
    "signal_id_collision -> v2 deterministic SHA-256 prefix of prediction_id|run_ts",
    "bundle_clock_skew -> v2 prefers generated_at_ms; absent both -> STALE_RUNTIME_EVIDENCE"
  ],
  "legacy_failure_modes": [
    "trainer_not_running -> MISSING_RUNTIME_EVIDENCE",
    "router_not_running -> MISSING_CHAIN_RECORDS at downstream stages",
    "trader_logs_but_no_publish -> MISSING_CHAIN_RECORDS:paper_execution_result",
    "redis_stream_truncated -> v2 file-based bundle is atomic; partial bundles -> INVALID_PAYLOAD",
    "operator_unable_to_attribute_risk_denial -> v2 explicit risk_reason_code citation"
  ],
