[Unit]
Description=AI BOT V2 Closed-Loop Spark Codex Lane %i
Documentation=file:%h/Desktop/AI%%20BOT%%20REBUILD/claude_worklog/final_readiness/v2_codex_spark_parallel_closed_loop/latest/GO_NO_GO.md
After=network.target

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=45s
Restart=always
RestartSec=5s
StateDirectory=ai-bot-v2/closed-loop
RuntimeDirectory=ai-bot-v2/closed-loop
Environment=PYTHONUNBUFFERED=1
Environment=V2_LIVE=blocked
Environment=V2_CANARY=0
Environment=V2_REDIS_TRIM=0
LoadCredential=live_credentials.env
NoNewPrivileges=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectSystem=strict
ProtectHome=read-only
Environment="PYTHONPATH=%h/Desktop/AI BOT REBUILD:%h/Desktop/AI BOT REBUILD/claude_worklog/tools"
ExecStart="%h/Desktop/AI BOT REBUILD/.venv/bin/python3" "%h/Desktop/AI BOT REBUILD/claude_worklog/tools/v2_closed_loop_codex_worker.py" --worker-id=%i --lane-group=%i
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=ai-bot-v2-closed-loop.target
