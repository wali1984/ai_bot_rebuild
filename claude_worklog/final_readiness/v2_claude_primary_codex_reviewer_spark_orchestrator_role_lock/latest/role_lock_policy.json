      "rule": "Report Center must surface verbatim: Executor=Claude Code, Reviewer=Codex, Orchestrator=Spark, Runtime=V2 primary paper/shadow, Live=blocked.",
      "applies_to": "operator_dashboard_payload.json, executive_status_payload.json, and safe_summaries",
      "violation_response": "REJECT_PAYLOAD_RENDER"
    },
