  "policy_rules": [
    {
      "rule_id": "rule_1_implementation_ownership",
      "rule": "owner=CLAUDE for code/runtime implementation tasks. agent=claude or claude_code for primary implementation. Spark may create/lease/dispatch the task but must NOT be listed as implementation owner.",
      "applies_to": "every task whose category implies V2 runtime/model/proof implementation",
      "violation_response": "REJECT_TASK_DESCRIPTOR"
    },
    {
      "rule_id": "rule_2_review_ownership",
      "rule": "owner=CODEX for review tasks. agent=codex for review/approval. Spark may enqueue the review task but must NOT be listed as reviewer.",
      "applies_to": "every paired review task that follows a Claude implementation task",
      "violation_response": "REJECT_TASK_DESCRIPTOR"
    },
    {
      "rule_id": "rule_3_spark_ownership_scope",
      "rule": "owner=SPARK only for orchestration, queue, lease, timer, metrics, report-center truth, and infrastructure-control tasks. Spark cannot replace Claude implementation lanes. Spark cannot replace Codex review lanes.",
      "applies_to": "every Spark-authored task",
      "violation_response": "REJECT_TASK_DESCRIPTOR"
    },
    {
      "rule_id": "rule_4_lane_registry_enforcement",
      "rule": "runtime-claude lanes execute runtime implementation. model-claude lanes execute model/trainer implementation. proof-claude lanes execute evidence/proof implementation. runtime-codex / model-codex / proof-codex lanes review corresponding Claude output. Spark lanes only coordinate.",
      "applies_to": "report center lane registration and dispatch routing",
      "lane_kinds": {
        "runtime-claude": "Claude implementation of runtime services",
        "model-claude": "Claude implementation of model/trainer code",
        "proof-claude": "Claude implementation of evidence/proof generators",
        "runtime-codex": "Codex review of runtime-claude output",
        "model-codex": "Codex review of model-claude output",
        "proof-codex": "Codex review of proof-claude output",
        "spark-orchestration": "Spark orchestration/control-plane (no runtime implementation, no review)"
      },
      "violation_response": "REJECT_LANE_REGISTRATION"
    },
    {
      "rule_id": "rule_5_descriptor_validation",
      "rule": "Reject any task descriptor where (a) implementation task owner is SPARK instead of CLAUDE, (b) review task owner is SPARK instead of CODEX, (c) Spark task modifies V2 runtime code outside orchestration/control-plane scope, (d) Spark task claims Codex PASS/FAIL, (e) Spark task claims Claude implementation completed.",
      "violation_response": "REJECT_TASK_DESCRIPTOR_AND_EMIT_ROLE_VIOLATION_TO_REPORT_CENTER"
