{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "legacy_behavior_mapping",
  "description": "Structured equivalent of LEGACY_BASELINE_ANALYSIS.md. Every claude_port_v2_* worker must emit this file before implementation; every codex_review_v2_* review fails if it is missing, empty, or contradicts the analysis markdown.",
  "type": "object",
  "required": [
    "worker_id",
    "legacy_source_paths",
    "legacy_functions_preserved",
    "legacy_inputs",
    "legacy_outputs",
    "legacy_redis_keys_read_only_reference",
    "legacy_config_dependencies",
    "legacy_edge_cases",
    "legacy_failure_modes",
    "legacy_tests_or_expected_behavior",
    "v2_mapping",
    "intentional_changes",
    "removed_or_deprecated_behavior",
    "greenfield_justification_if_legacy_absent"
  ],
  "properties": {
    "worker_id": {"type": "string"},
    "as_of_utc": {"type": "string", "format": "date-time"},
    "legacy_source_paths": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 0,
      "description": "Concrete file paths under legacy_reference/. If empty, greenfield_justification_if_legacy_absent must be filled."
    },
    "legacy_functions_preserved": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["legacy_symbol", "legacy_file", "description", "v2_location", "preserved"],
        "properties": {
          "legacy_symbol": {"type": "string"},
          "legacy_file": {"type": "string"},
          "description": {"type": "string"},
          "v2_location": {"type": "string"},
          "preserved": {"type": "boolean"},
          "change_reason": {"type": "string"}
        }
      }
    },
    "legacy_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["legacy_input", "source", "v2_mapping", "preserved"],
        "properties": {
          "legacy_input": {"type": "string"},
          "source": {"type": "string"},
          "freshness_contract": {"type": "string"},
          "v2_mapping": {"type": "string"},
          "preserved": {"type": "boolean"},
          "change_reason": {"type": "string"}
        }
      }
    },
    "legacy_outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["legacy_output", "sink", "v2_mapping", "preserved"],
        "properties": {
          "legacy_output": {"type": "string"},
          "sink": {"type": "string"},
          "format": {"type": "string"},
          "v2_mapping": {"type": "string"},
          "preserved": {"type": "boolean"},
          "v2_namespacing_note": {"type": "string"}
        }
      }
    },
    "legacy_redis_keys_read_only_reference": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key_or_stream", "direction_in_legacy", "v2_stance"],
        "properties": {
          "key_or_stream": {"type": "string"},
          "direction_in_legacy": {"type": "string", "enum": ["read", "write", "read_and_write"]},
          "v2_stance": {"type": "string", "enum": ["read_only_reference_only", "not_used"]},
          "note": {"type": "string"}
        }
      }
    },
    "legacy_config_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["legacy_config_key", "type", "v2_resolution"],
        "properties": {
          "legacy_config_key": {"type": "string"},
          "type": {"type": "string", "enum": ["env_var", "file", "secret", "constant", "cli_flag", "other"]},
          "v2_resolution": {"type": "string"}
        }
      }
    },
    "legacy_edge_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["edge_case", "legacy_handling", "v2_handling"],
        "properties": {
          "edge_case": {"type": "string"},
          "legacy_handling": {"type": "string"},
          "v2_handling": {"type": "string"}
        }
      }
    },
    "legacy_failure_modes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["failure_mode", "legacy_behavior", "v2_mitigation"],
        "properties": {
          "failure_mode": {"type": "string"},
          "legacy_behavior": {"type": "string"},
          "v2_mitigation": {"type": "string"}
        }
      }
    },
    "legacy_tests_or_expected_behavior": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["legacy_test_or_runbook", "pins", "v2_test_that_covers_it"],
        "properties": {
          "legacy_test_or_runbook": {"type": "string"},
          "pins": {"type": "string"},
          "v2_test_that_covers_it": {"type": "string"}
        }
      }
    },
    "v2_mapping": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["legacy_responsibility", "v2_file_or_function"],
        "properties": {
          "legacy_responsibility": {"type": "string"},
          "v2_file_or_function": {"type": "string"},
          "notes": {"type": "string"}
        }
      }
    },
    "intentional_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["change", "rationale"],
        "properties": {
          "change": {"type": "string"},
          "rationale": {"type": "string"}
        }
      }
    },
    "removed_or_deprecated_behavior": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["removed_behavior", "reason"],
        "properties": {
          "removed_behavior": {"type": "string"},
          "reason": {"type": "string"},
          "risk_if_user_expected_it": {"type": "string"}
        }
      }
    },
    "greenfield_justification_if_legacy_absent": {
      "type": ["string", "null"],
      "description": "Required when legacy_source_paths is empty. Cite the legacy_reference inventory entries that prove there is no legacy equivalent."
    },
    "v2_safety_upgrades": {
      "type": "array",
      "items": {"type": "string"}
    },
    "open_questions_for_operator": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
