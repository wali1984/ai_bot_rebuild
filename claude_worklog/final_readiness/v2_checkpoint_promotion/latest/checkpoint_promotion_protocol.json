{
  "schema_version": "v2_checkpoint_promotion_protocol_v2_torch_native_shape_contract",
  "approved_local_path": ".local_models/",
  "required_operator_files": [
    {
      "kind": "blob",
      "patterns": [
        ".local_models/<name>.pt",
        ".local_models/<name>.safetensors"
      ]
    },
    {
      "kind": "sidecar_metadata",
      "patterns": [
        ".local_models/<name>_metadata.json"
      ]
    }
  ],
  "required_metadata_fields": [
    "checkpoint_id",
    "source_legacy_path",
    "source_legacy_sha256",
    "training_window_utc",
    "obs_dim",
    "action_count",
    "action_labels",
    "tensor_shapes_per_layer",
    "operator_signature_id",
    "paper_only",
    "approves_live",
    "approves_canary",
    "approves_legacy_shutdown"
  ],
  "optional_metadata_fields": [
    "tensor_shape_layout"
  ],
  "tensor_shape_layout_field_semantics": {
    "field_name": "tensor_shape_layout",
    "default_if_absent": "TORCH_OUTPUT_FIRST",
    "valid_values": ["TORCH_OUTPUT_FIRST", "INPUT_FIRST"],
    "torch_output_first_meaning": "Per-layer shapes are stored as [out, in] (torch nn.Linear weight orientation). Scanner accepts the shapes as-is.",
    "input_first_meaning": "Per-layer shapes are stored as [in, out] (legacy producer orientation). Scanner transposes per-layer weights to [out, in] before contract comparison and tags the candidate METADATA_INPUT_FIRST_NORMALIZED.",
    "any_other_value_meaning": "Fail-closed with shape_contract_orientation=SHAPE_MISMATCH."
  },
  "v2_policy_shape_contract": {
    "obs_dim": 26,
    "hidden_dim": 16,
    "action_count": 5,
    "action_labels": ["hold", "long", "short", "close", "hedge"],
    "tensor_shape_layout_convention": "TORCH_NATIVE_OUTPUT_FIRST_OUT_IN",
    "tensor_shape_layout_rationale": "v2/backend/app/services/rl_core/policy.py::_linear iterates the flat weight buffer as w[j*in_dim+i] with j as the output index, matching torch nn.Linear(in,out).weight=[out,in].",
    "tensor_shapes_per_layer": {
      "w1": [16, 26],
      "b1": [16],
      "w2": [5, 16],
      "b2": [5],
      "w_exp": [1, 16],
      "b_exp": [1]
    },
    "tensor_shapes_per_layer_input_first_legacy_normalizable_form": {
      "w1": [26, 16],
      "b1": [16],
      "w2": [16, 5],
      "b2": [5],
      "w_exp": [16, 1],
      "b_exp": [1]
    },
    "tensor_flat_counts": {
      "w1": 416,
      "b1": 16,
      "w2": 80,
      "b2": 5,
      "w_exp": 16,
      "b_exp": 1
    }
  },
  "rules": [
    "no raw checkpoint committed to Git",
    "no V2 process loads arbitrary pickle checkpoint without Codex approval",
    "shape inspection must be paper-only",
    "no live trading approval",
    "no exchange mutation",
    "no legacy modification, no legacy start/stop",
    "V2 paper-fill strict gate remains active",
    "scanner must not import torch, must not deserialize pickle, must not read outside .local_models/"
  ],
  "outcome_states": [
    "CHECKPOINT_PROMOTION_READY_FOR_CODEX_SHAPE_REVIEW",
    "CHECKPOINT_METADATA_PRESENT_SHAPE_MISMATCH",
    "CHECKPOINT_METADATA_MISSING",
    "CHECKPOINT_BLOB_MISSING",
    "CHECKPOINT_OPERATOR_REQUIRED"
  ],
  "shape_contract_orientation_values": [
    "TORCH_OUTPUT_FIRST",
    "METADATA_INPUT_FIRST_NORMALIZED",
    "SHAPE_MISMATCH",
    "NOT_EVALUATED"
  ],
  "live_gate": "blocked_human_only",
  "live_symbols": [],
  "approves_live": false,
  "approves_canary": false,
  "approves_legacy_shutdown": false,
  "approves_redis_trim": false
}
