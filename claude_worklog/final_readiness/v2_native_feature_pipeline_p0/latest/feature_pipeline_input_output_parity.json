{
  "approves_live": false,
  "explicit_missing_flags_never_zero_filled": true,
  "explicit_stale_flags_per_input": true,
  "feature_snapshot_id_emitted_per_snapshot": true,
  "generated_utc": "2026-05-16",
  "inputs_required_for_full_snapshot": [
    "ohlcv_window (>=26 bars for TA indicators; >=2 for returns)",
    "bid_price + ask_price (orderbook top)",
    "bid_size + ask_size (optional, for depth_imbalance / micro_price)",
    "higher_tf_close_window (>=2 for returns; >=14 for RSI)",
    "funding_rate (latest)",
    "open_interest + open_interest_prior (for oi_change_pct)",
    "last_liquidation_notional_24h (for last_liq_bps_24h)",
    "paper_position_notional + paper_position_entry_price (paper-aware)"
  ],
  "live_gate": "blocked_human_only",
  "live_symbols": [],
  "no_exchange_mutation": true,
  "no_legacy_redis_reads_as_authoritative": true,
  "no_legacy_redis_writes": true,
  "outputs_emitted": [
    "schema_version",
    "symbol",
    "timeframe",
    "generated_utc",
    "feature_snapshot_id (v2_fsnap_<sha256>)",
    "feature_count",
    "categories_present (ohlcv_derived, ta_indicators, multi_timeframe, microstructure, funding_oi_liquidation, portfolio_aware, freshness)",
    "missing_feature_flags",
    "stale_feature_flags",
    "source_inputs_age_seconds",
    "features (dict of named numeric features)",
    "legacy_behavior_mapping (sha256 cited)",
    "live_gate",
    "live_symbols"
  ],
  "schema_version": "1.0.0",
  "subproject": "v2_native_feature_pipeline_p0"
}
