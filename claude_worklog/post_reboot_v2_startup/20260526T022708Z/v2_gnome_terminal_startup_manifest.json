    {
      "category": "redis_status_monitor",
      "command": "while true; do clear; date -u; echo '---PING---'; redis-cli ping; echo '---DBSIZE---'; redis-cli dbsize; echo '---v2:* keys---'; redis-cli --scan --pattern 'v2:*' | wc -l; echo '---v2:prediction:* sample---'; redis-cli --scan --pattern 'v2:prediction:*' | head -5; sleep 5; done",
      "expected_public_payload": null,
      "expected_redis_keys": [
        "v2:*"
      ],
      "log_path": "(tty only)",
      "paper_only": true,
      "restart_behavior": "manual_keep_open",
      "safety_env": {
        "DISABLE_LIVE_TRADING": "true",
        "LIVE_GATE": "blocked_human_only",
        "LIVE_SYMBOLS": "[]",
        "PYTHONPATH": "/home/wali/Desktop/AI BOT REBUILD",
        "V2_PAPER_ONLY": "true"
      },
      "terminal_title": "V2 Redis status monitor",
      "working_directory": "/home/wali/Desktop/AI BOT REBUILD"
    },
