[Unit]
StartLimitBurst=5
StartLimitIntervalSec=600
Description=AI Bot V2 LunarCrush alt-data loop (paper-shadow, V2 namespace only)
After=network-online.target ai-bot-v2-symbol-universe-publisher.service

[Service]
Type=simple
WorkingDirectory=/home/wali/Desktop/AI BOT REBUILD
ExecStartPre=/usr/bin/env bash -lc 'exec ./claude_worklog/tools/v2_automation_safety_preflight.sh ai-bot-v2-lunarcrush-altdata-loop'
ExecStart=/usr/bin/env bash -lc 'mkdir -p v2/runtime; while true; do ./.venv/bin/python3 -m v2.backend.app.cli.v2_lunarcrush_altdata_ingestor >> v2/runtime/v2_lunarcrush_altdata_loop.log 2>&1 || true; sleep 21600; done'
Restart=always
RestartSec=10
NoNewPrivileges=true

[Install]
WantedBy=default.target
