[Unit]
Description=AI Bot V2 automation liveness watchdog
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/wali/Desktop/AI BOT REBUILD
ExecStartPre=/usr/bin/env bash -lc 'exec ./claude_worklog/tools/v2_automation_safety_preflight.sh ai-bot-v2-automation-liveness-watchdog'
ExecStart=/usr/bin/env bash -lc 'mkdir -p claude_worklog/agent_supervisor/logs/control_plane; exec ./.venv/bin/python3 claude_worklog/tools/v2_automation_liveness_watchdog.py --write >> claude_worklog/agent_supervisor/logs/control_plane/v2_automation_liveness_watchdog.log 2>&1'
NoNewPrivileges=true
