[Unit]
Description=AI Bot V2 paper shadow outcome observer
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/wali/Desktop/AI BOT REBUILD
ExecStartPre=/usr/bin/env bash -lc 'exec ./claude_worklog/tools/v2_automation_safety_preflight.sh ai-bot-v2-paper-shadow-outcome-observer'
ExecStart=/usr/bin/env bash -lc 'mkdir -p claude_worklog/agent_supervisor/logs/control_plane; exec ./.venv/bin/python3 -m v2.backend.app.cli.paper_shadow_outcome_observer --once --write >> claude_worklog/agent_supervisor/logs/control_plane/paper_shadow_outcome_observer.log 2>&1'
NoNewPrivileges=true

[Install]
WantedBy=default.target
