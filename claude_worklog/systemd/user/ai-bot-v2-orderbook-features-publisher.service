[Unit]
Description=AI Bot V2 canonical direct-orderbook feature-pair supervisor (summary only; paper-safe)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/wali/Desktop/AI BOT REBUILD
Environment="PYTHONPATH=/home/wali/Desktop/AI BOT REBUILD"
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=LIVE_GATE=blocked_human_only
ExecStart="/home/wali/Desktop/AI BOT REBUILD/.venv/bin/python" -m v2.backend.app.cli.v2_orderbook_features_publisher --loop --interval-seconds 20
Restart=always
RestartSec=10
Nice=10
NoNewPrivileges=true

[Install]
WantedBy=default.target
