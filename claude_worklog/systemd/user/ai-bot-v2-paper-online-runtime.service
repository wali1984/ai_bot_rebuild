[Unit]
Description=AI Bot V2 paper online runtime
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/wali/Desktop/AI BOT REBUILD
ExecStartPre=/usr/bin/env bash -lc 'exec ./claude_worklog/tools/v2_automation_safety_preflight.sh ai-bot-v2-paper-online-runtime'
ExecStart=/usr/bin/env bash -lc 'mkdir -p v2/runtime claude_worklog/agent_supervisor/logs/control_plane; exec ./.venv/bin/python3 -m v2.backend.app.cli.paper_online_runtime --loop --interval 30 >> v2/runtime/paper_online_runtime.log 2>&1'
Restart=always
RestartSec=10
NoNewPrivileges=true

[Install]
WantedBy=default.target
