[Unit]
Description=AI BOT V2 8h war-room cycle (paper/shadow only; one-shot per timer tick)
After=ai-bot-v2-liquidation-wss-paper-shadow.service
After=ai-bot-v2-continuous-legacy-log-remediation.service

[Service]
Type=oneshot
WorkingDirectory=/home/wali/Desktop/AI BOT REBUILD
Environment="PYTHONPATH=/home/wali/Desktop/AI BOT REBUILD"
Environment="LIVE_GATE=blocked_human_only"
ExecStart=/usr/bin/env bash -lc 'exec /home/wali/Desktop/AI\ BOT\ REBUILD/.venv/bin/python3 /home/wali/Desktop/AI\ BOT\ REBUILD/claude_worklog/tools/v2_8h_war_room_daemon.py --once'
StandardOutput=append:/home/wali/Desktop/AI BOT REBUILD/claude_worklog/agent_supervisor/logs/control_plane/v2_8h_war_room.log
StandardError=append:/home/wali/Desktop/AI BOT REBUILD/claude_worklog/agent_supervisor/logs/control_plane/v2_8h_war_room.err

[Install]
WantedBy=default.target
