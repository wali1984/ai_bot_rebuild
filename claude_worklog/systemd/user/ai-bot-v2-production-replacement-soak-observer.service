[Unit]
Description=AI BOT V2 production replacement soak observer (paper-only)
After=ai-bot-v2-production-replacement-runtime-guard.service

[Service]
Type=simple
WorkingDirectory=/home/wali/Desktop/AI BOT REBUILD
Environment="PYTHONPATH=/home/wali/Desktop/AI BOT REBUILD"
Environment="LIVE_GATE=blocked_human_only"
ExecStart=/usr/bin/env bash -lc 'exec "/home/wali/Desktop/AI BOT REBUILD/.venv/bin/python3" -m v2.backend.app.cli.v2_production_replacement_soak_observer --loop --interval-seconds 300'
StandardOutput=append:/home/wali/Desktop/AI BOT REBUILD/claude_worklog/agent_supervisor/logs/control_plane/v2_production_replacement_soak_observer.log
StandardError=append:/home/wali/Desktop/AI BOT REBUILD/claude_worklog/agent_supervisor/logs/control_plane/v2_production_replacement_soak_observer.err
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
