[Unit]
Description=AI BOT V2 trainer training live loop (signal-only, V2 namespace)
After=network-online.target ai-bot-v2-feature-pipeline-native-loop.service ai-bot-v2-rl-core-inference-loop.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/wali/Desktop/AI BOT REBUILD
Environment="PYTHONPATH=/home/wali/Desktop/AI BOT REBUILD"
Environment="LIVE_GATE=blocked_human_only"
Environment="V2_LIVE=0"
Environment="V2_CANARY=0"
ExecStartPre=/usr/bin/env bash -lc 'exec ./claude_worklog/tools/v2_automation_safety_preflight.sh ai-bot-v2-trainer-training-live-loop'
ExecStart=/usr/bin/env bash -lc 'exec "/home/wali/Desktop/AI BOT REBUILD/.venv/bin/python3" -m v2.backend.app.cli.v2_trainer_training_live_loop --loop --interval-seconds 300 --minimum-train-rows 64 --v2-redis-ttl-seconds 900'
StandardOutput=append:/home/wali/Desktop/AI BOT REBUILD/claude_worklog/agent_supervisor/logs/control_plane/ai-bot-v2-trainer-training-live-loop.log
StandardError=append:/home/wali/Desktop/AI BOT REBUILD/claude_worklog/agent_supervisor/logs/control_plane/ai-bot-v2-trainer-training-live-loop.err
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
