ExecStartPre=/usr/bin/env bash -lc 'exec ./claude_worklog/tools/v2_automation_safety_preflight.sh ai-bot-v2-profiled-base-feature-publisher'
ExecStartPre=/usr/bin/install -d -m 0700 /home/wali/ai_bot_local_data/v2_native_trainer/profiled_base_publisher_v1
ExecStart="/home/wali/Desktop/AI BOT REBUILD/.venv/bin/python3" -m v2.backend.app.cli.v2_profiled_base_feature_publisher
Restart=on-failure
RestartPreventExitStatus=2 78
RestartSec=60
TimeoutStartSec=90
TimeoutStopSec=45
KillSignal=SIGTERM
KillMode=mixed
CPUQuota=200%
MemoryHigh=2G
MemoryMax=4G
TasksMax=128
LimitNOFILE=4096
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/home/wali/ai_bot_local_data/v2_native_trainer
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ai-bot-v2-profiled-base-feature-publisher
LogRateLimitIntervalSec=60
LogRateLimitBurst=30

[Install]
