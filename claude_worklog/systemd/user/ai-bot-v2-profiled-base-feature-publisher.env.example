# Copy this file outside the repository to:
#   /home/wali/.config/ai-bot-v2/profiled-base-feature-publisher.env
# and set mode 0600. Never commit populated values.

# The credential reference must remain account-specific and contain READONLY.
ALPHAFORGE_INITIAL_TRADER_BINANCE_CREDENTIAL_REF=ALPHAFORGE_BINANCE_WAJIDALI1984_READONLY
ALPHAFORGE_BINANCE_WAJIDALI1984_READONLY_API_KEY=
ALPHAFORGE_BINANCE_WAJIDALI1984_READONLY_API_SECRET=

# Independent secret used only to HMAC the credential-binding fingerprint.
# Supply at least 32 bytes; do not reuse the Binance API secret.
PROFILED_BASE_COMMISSION_FINGERPRINT_HMAC_SECRET=
