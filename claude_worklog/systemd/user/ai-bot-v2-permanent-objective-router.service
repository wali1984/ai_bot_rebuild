[Unit]
Description=AI Bot V2 permanent objective router (read-only blocker-to-task router)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/wali/Desktop/AI BOT REBUILD
ExecStart=/usr/bin/env bash -lc 'mkdir -p claude_worklog/agent_supervisor/logs/control_plane; exec ./.venv/bin/python3 claude_worklog/tools/v2_permanent_objective_router.py >> claude_worklog/agent_supervisor/logs/control_plane/v2_permanent_objective_router.log 2>&1'
NoNewPrivileges=true

[Install]
WantedBy=default.target
