[Unit]
Description=AI BOT V2 full TA-Lib compatibility loop (paper/shadow, V2 namespace only)
After=network-online.target ai-bot-v2-native-ingestors-live-loop.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/wali/Desktop/AI BOT REBUILD
Environment="PYTHONPATH=/home/wali/Desktop/AI BOT REBUILD"
Environment="LIVE_GATE=blocked_human_only"
Environment="V2_LIVE=0"
Environment="V2_CANARY=0"
ExecStartPre=/usr/bin/env bash -lc 'exec ./claude_worklog/tools/v2_automation_safety_preflight.sh ai-bot-v2-full-talib-ta-loop'
ExecStart=/usr/bin/env bash -lc 'exec "/home/wali/Desktop/AI BOT REBUILD/.venv/bin/python3" -m v2.backend.app.cli.v2_full_talib_ta_loop --loop --interval-seconds 60 --ttl-seconds 900'
StandardOutput=append:/home/wali/Desktop/AI BOT REBUILD/claude_worklog/agent_supervisor/logs/control_plane/ai-bot-v2-full-talib-ta-loop.log
StandardError=append:/home/wali/Desktop/AI BOT REBUILD/claude_worklog/agent_supervisor/logs/control_plane/ai-bot-v2-full-talib-ta-loop.err
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
