[Unit]
StartLimitBurst=5
StartLimitIntervalSec=600
Description=AI BOT V2 CoinAnk global bridge loop (paper-only, V2 namespace only)
After=network-online.target redis.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/wali/Desktop/AI BOT REBUILD
Environment="PYTHONPATH=/home/wali/Desktop/AI BOT REBUILD"
Environment="LIVE_GATE=blocked_human_only"
ExecStart=/usr/bin/env bash -lc 'exec "/home/wali/Desktop/AI BOT REBUILD/.venv/bin/python3" -m v2.backend.app.cli.v2_coinank_and_liquidation_bridge --loop --interval 60 --tf 1m --write-v2-redis --v2-redis-ttl-seconds 600'
StandardOutput=append:/home/wali/Desktop/AI BOT REBUILD/claude_worklog/agent_supervisor/logs/control_plane/ai-bot-v2-coinank-global-bridge-loop.log
StandardError=append:/home/wali/Desktop/AI BOT REBUILD/claude_worklog/agent_supervisor/logs/control_plane/ai-bot-v2-coinank-global-bridge-loop.err
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
