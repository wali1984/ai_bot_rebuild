ReadOnlyPaths=/home/wali/ai_bot_local_data/v2_native_trainer
ReadWritePaths="/home/wali/Desktop/AI BOT REBUILD/.local_models/v2_native_rl_masa_ppo"
ReadWritePaths=-/home/wali/ai_bot_local_data/v2_native_trainer/local_profiled_research_v1
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ai-bot-v2-native-cuda-trainer-persistent
LogRateLimitIntervalSec=60
LogRateLimitBurst=60

[Install]
WantedBy=default.target
