ExecStartPre=+/usr/bin/install -d -m 0700 /home/wali/ai_bot_local_data/v2_native_trainer/local_profiled_research_v1
ExecStart="/home/wali/Desktop/AI BOT REBUILD/.venv/bin/python3" -B -m v2.backend.app.cli.v2_native_cuda_trainer_persistent_loop --mode locally-authenticated-profiled-research-publisher --repo-root "/home/wali/Desktop/AI BOT REBUILD" --ledger-path "/home/wali/ai_bot_local_data/v2_native_trainer/durable_feature_snapshot_ledger.sqlite3" --trusted-cost-store-root "/home/wali/ai_bot_local_data/v2_native_trainer/profiled_base_publisher_v1/profiled-training-enrichment-cas" --interval-seconds 30 --publisher-status-path "/home/wali/ai_bot_local_data/v2_native_trainer/profiled_base_publisher_v1/profiled_base_publisher_status_v1.json" --label-archive-path "/home/wali/ai_bot_local_data/v2_native_trainer/canonical_finalized_5m_label_archive.sqlite3" --local-research-runtime-root "/home/wali/ai_bot_local_data/v2_native_trainer/local_profiled_research_v1" --model-dir "/home/wali/Desktop/AI BOT REBUILD/.local_models/v2_native_rl_masa_ppo" --status-path "/home/wali/ai_bot_local_data/v2_native_trainer/local_profiled_research_v1/status.json" --manifest-auth-key-id profiled-observation-manifest-v1 --local-research-auth-key-id profiled-local-research-v1 --page-limit 256 --scan-limit 250000 --validation-fraction 0.2 --optimizer-input-byte-budget 8388608 --state-resource-budget-bytes 67108864 --checkpoint-serialization-byte-budget 134217728
Restart=always
RestartPreventExitStatus=2 78
RestartSec=30
TimeoutStartSec=120
TimeoutStopSec=90
KillSignal=SIGTERM
KillMode=mixed
CPUQuota=1600%
MemoryHigh=72G
MemoryMax=75G
TasksMax=4096
LimitNOFILE=8192
Nice=5
NoNewPrivileges=true
PrivateDevices=false
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths="/home/wali/Desktop/AI BOT REBUILD"
