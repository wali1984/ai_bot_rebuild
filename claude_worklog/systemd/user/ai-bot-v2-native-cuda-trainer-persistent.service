[Service]
Type=simple
WorkingDirectory=/home/wali/Desktop/AI BOT REBUILD
Environment=LIVE_GATE=blocked_human_only
Environment="PYTHONPATH=/home/wali/Desktop/AI BOT REBUILD"
Environment=PYTHONDONTWRITEBYTECODE=1
Environment="XDG_CACHE_HOME=/home/wali/ai_bot_local_data/v2_native_trainer/local_profiled_research_v1/cache"
Environment="CUDA_CACHE_PATH=/home/wali/ai_bot_local_data/v2_native_trainer/local_profiled_research_v1/cache/nv"
