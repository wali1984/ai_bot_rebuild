[Unit]
StartLimitBurst=5
StartLimitIntervalSec=600
Description=AI Bot V2 Codex shutdown-readiness takeover
After=network-online.target ai-bot-v2-agent-supervisor.service

[Service]
Type=simple
WorkingDirectory=/home/wali/Desktop/AI BOT REBUILD
ExecStartPre=/usr/bin/env bash -lc 'exec ./claude_worklog/tools/v2_automation_safety_preflight.sh ai-bot-v2-codex-shutdown-readiness-takeover'
ExecStart=/usr/bin/env bash -lc 'mkdir -p claude_worklog/agent_supervisor/logs/control_plane; exec ./.venv/bin/python3 claude_worklog/tools/codex_legacy_shutdown_readiness_takeover.py --daemon --poll-seconds 120 >> claude_worklog/agent_supervisor/logs/control_plane/codex_shutdown_readiness_takeover.log 2>&1'
Restart=always
RestartSec=10
NoNewPrivileges=true

[Install]
WantedBy=default.target
