[Unit]
Description=AI Bot V2 parallel capacity scheduler
After=network-online.target ai-bot-v2-agent-supervisor.service

[Service]
Type=simple
WorkingDirectory=/home/wali/Desktop/AI BOT REBUILD
ExecStartPre=/usr/bin/env bash -lc 'exec ./claude_worklog/tools/v2_automation_safety_preflight.sh ai-bot-v2-parallel-scheduler'
ExecStart=/usr/bin/env bash -lc 'mkdir -p claude_worklog/agent_supervisor/logs/control_plane; exec ./.venv/bin/python3 claude_worklog/tools/parallel_capacity_scheduler.py --daemon --poll-seconds 600 >> claude_worklog/agent_supervisor/logs/control_plane/parallel_capacity_scheduler.log 2>&1'
Restart=always
RestartSec=10
NoNewPrivileges=true

[Install]
WantedBy=default.target
